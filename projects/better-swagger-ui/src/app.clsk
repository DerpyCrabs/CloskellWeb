(import "./model.clsk" [AppState])
(import "./messages.clsk" [AppMsg UpdateResult])
(import "./features/source/flow.clsk" [no-cmd])
(import "./features/shell/index.clsk" [(init as app-init) (view as app-view)])
(import "./features/source/index.clsk" [(try-source-update as source-update) (source-subscriptions as source-subs)])
(import "./features/document/index.clsk" [(try-document-update as document-update)])
(import "./features/auth/index.clsk" [(try-auth-update as auth-update)])
(import "./features/try-it/index.clsk" [(try-request-update as request-update)])

(defn init [boot]
  (app-init boot))

(defn subscriptions [state]
  (source-subs state))

(ann update (Fn [AppState AppMsg] UpdateResult))
(defn update [state msg]
  (match (source-update state msg)
    (some result) result
    nil (match (document-update state msg)
          (some result) result
          nil (match (auth-update state msg)
                (some result) result
                nil (match (request-update state msg)
                      (some result) result
                      nil (no-cmd state))))))

(defn view [state]
  (app-view state))
