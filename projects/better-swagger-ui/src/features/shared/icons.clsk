(def virtualJsonViewerInstalled
  (install-virtual-json-viewer))

(defn lucideClass [name extraClass]
  (if (= extraClass "")
      (str "lucide lucide-icon lucide-" name)
      (str "lucide lucide-icon lucide-" name " " extraClass)))

(defn iconUpload [size extraClass]
  #html <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" width={size} height={size} stroke="currentColor" stroke-width="2" class={(lucideClass "upload" extraClass)}><path d="M12 3v12" key="1x0j5s"></path><path d="m17 8-5-5-5 5" key="7q97r8"></path><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" key="ih7n3h"></path></svg>)

