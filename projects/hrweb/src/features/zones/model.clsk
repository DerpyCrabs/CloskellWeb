(import "../../model.clsk" [HeartZone])
(import "../../messages.clsk" [AppMsg])

(type ZonesState
  {:appStatus String
   :message String
   :statusMode String
   :mobile? Bool
   :targetZoneId Number
   :zones (Vector HeartZone)
