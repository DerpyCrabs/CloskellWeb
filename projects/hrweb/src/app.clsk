(import "./domain.clsk" [initial-state zones-storage-key exercise-log-storage-key clock-timer-id simulated-monitor-id stop-hold-timer-id stop-hold-frame-id stop-hold-ms delete-hold-timer-id delete-hold-frame-id delete-hold-ms zone-drag-move-id zone-drag-up-id zone-drag-cancel-id])
(import "./zones.clsk" [default-zone-state load-zone-state zone-state-payload zone-for-bpm zone-label-for-bpm set-zone-min set-zone-max set-zone-boundary boundary-controls])
(import "./log.clsk" [all-types-filter untyped-filter current-elapsed workout-entry newest-first visible-log filtered-log selected-log first-visible-id hide-entry update-entry-type load-log-entries import-log-error import-success-message log-payload export-log-json export-log-filename duration-label date-label entry-type-label exercise-types reconciled-selected-id])
(import "./metrics.clsk" [stat-value average-bpm min-bpm max-bpm zone-display-stats get-metrics-for-type metric-enabled? group-entries-by-type build-zone2-trend build-hrr-trend build-trimp-bars])
(import "./model.clsk" [HeartReading HeartZone WorkoutEntry MonitorInfo JsonPayload HeartChartRect WindowEventPayload])
(import "./chart.clsk" [heart-chart-command heart-chart-batch])
(import "./metric_charts.clsk" [metric-chart-ref metric-chart-command metric-chart-batch])
(import "./ui-effects.clsk" [no-cmd])

(type AppState
  {:appStatus String
   :message String
   :statusMode String
   :dev? Bool
   :mobile? Bool
   :detailView String
   :exerciseState String
   :connected? Bool
   :simulated? Bool
   :deviceName String
   :elapsedMs Number
    :displayElapsedMs Number
    :startedAt (Option Number)
    :sessionStartedAt (Option Number)
    :idleStartedAt (Option Number)
    :pendingStoppedAt (Option Number)
   :latestBpm Number
   :lastRate (Option Number)
   :trend String
   :readings (Vector HeartReading)
   :entries (Vector WorkoutEntry)
   :selectedLogId (Option String)
   :logTypeFilter String
   :targetZoneId Number
   :zones (Vector HeartZone)
   :activeExerciseType String
   :typeDraft String
   :typePickerEntryId (Option String)
   :typePickerDraft String
   :stopHold? Bool
   :stopHoldStartedAt Number
   :stopHoldProgress Number
   :deleteHold? Bool
   :deleteHoldStartedAt Number
   :deleteHoldProgress Number
   :chartWidth Number
   :chartHeight Number
   :zoneTrackLeft Number
   :zoneTrackWidth Number
   :zoneDragIndex (Option Number)
   :zoneStatus String
   :importStatus String
   :metricsGrouping String})

(type AppMsg
  (Union
    {:kind :zones-loaded :payload JsonPayload}
    {:kind :zones-load-failed :error String}
    {:kind :log-loaded :payload JsonPayload}
    {:kind :log-load-failed :error String}
    {:kind :media-changed :id String :media String :matches Bool}
    {:kind :chart-resized :id String :ref String :x Number :y Number :width Number :height Number :top Number :right Number :bottom Number :left Number :value HeartChartRect}
    {:kind :chart-error :error String}
    {:kind :dev-key :id String :value WindowEventPayload}
    {:kind :dev-opened}
    {:kind :select-tab :view String}
    {:kind :metrics-grouping :value String}
    {:kind :filter-log-type :value String}
    {:kind :active-type-edited :text String}
    {:kind :connect-monitor}
    {:kind :monitor-connected :info MonitorInfo}
    {:kind :monitor-error :error String}
    {:kind :monitor-disconnected}
    {:kind :disconnect-monitor}
    {:kind :disconnect-paused-at :timestamp Number}
    {:kind :connect-simulated}
    {:kind :sim-zone-picked :roll Number}
    {:kind :sim-bpm-picked :bpm Number}
    {:kind :sim-connected :info MonitorInfo}
    {:kind :start}
    {:kind :started-at :timestamp Number}
    {:kind :pause}
    {:kind :paused-at :timestamp Number}
    {:kind :resume}
    {:kind :resumed-at :timestamp Number}
    {:kind :clock-tick}
    {:kind :clocked-at :timestamp Number}
    {:kind :heart-rate :bpm Number}
    {:kind :heart-rate-at :bpm Number :timestamp Number}
    {:kind :idle-started-at :timestamp Number}
    {:kind :stop}
    {:kind :stop-hold-start}
    {:kind :stop-hold-key-down :key String}
    {:kind :stop-hold-key-up :key String}
    {:kind :stop-hold-started :timestamp Number}
    {:kind :stop-hold-frame :id String :timestamp Number :value Number}
    {:kind :stop-hold-cancel}
    {:kind :stop-hold-cancelled}
    {:kind :stop-hold-complete}
    {:kind :stopped-at :timestamp Number}
    {:kind :id-roll :roll Number}
    {:kind :target-zone :id Number}
    {:kind :zone-min-edited :id Number :raw String}
    {:kind :zone-max-edited :id Number :raw String}
    {:kind :zone-boundary :index Number :bpm Number}
    {:kind :zone-boundary-key :index Number :key String}
    {:kind :zone-boundary-drag-start :index Number :clientX Number}
    {:kind :zone-boundary-track-measured :index Number :clientX Number :left Number :width Number :value HeartChartRect}
    {:kind :zone-boundary-track-error :error String}
    {:kind :zone-boundary-drag-move :id String :value WindowEventPayload}
    {:kind :zone-boundary-drag-end :id String :value WindowEventPayload}
    {:kind :zones-saved}
    {:kind :zones-save-failed :error String}
    {:kind :select-log :id String}
    {:kind :edit-type-draft :text String}
    {:kind :type-draft-key :key String}
    {:kind :type-picker-draft :text String}
    {:kind :type-picker-key :key String}
    {:kind :confirm-type-picker}
    {:kind :skip-type-picker}
    {:kind :type-picker-focused}
    {:kind :type-picker-focus-failed :error String}
    {:kind :save-type}
    {:kind :delete-hold-start}
    {:kind :delete-hold-key-down :key String}
    {:kind :delete-hold-key-up :key String}
    {:kind :delete-hold-started :timestamp Number}
    {:kind :delete-hold-frame :id String :timestamp Number :value Number}
    {:kind :delete-hold-cancel}
    {:kind :delete-hold-cancelled}
    {:kind :delete-hold-complete}
    {:kind :delete-selected-at :timestamp Number}
    {:kind :log-saved}
    {:kind :log-save-failed :error String}
    {:kind :open-import}
    {:kind :import-opened}
    {:kind :read-import}
    {:kind :log-imported :payload JsonPayload}
    {:kind :import-cancelled}
    {:kind :import-failed :error String}
    {:kind :export-log}
    {:kind :export-log-at :timestamp Number}
    {:kind :export-failed :error String}
    {:kind :exported}))

(type InitResult
  [AppState (Cmd AppMsg)])

(type UpdateResult
  [AppState (Cmd AppMsg)])

(ann init (Fn [] InitResult))
(ann update (Fn [AppState AppMsg] UpdateResult))
(ann subscriptions (Fn [AppState] (Sub AppMsg)))
(ann view (Fn [AppState] Html))

(defn startup-command []
  (Cmd.batch [(Cmd.storage/get zones-storage-key :json (Msg.mapper :zones-loaded :payload) :zones-load-failed)
              (Cmd.storage/get exercise-log-storage-key :json (Msg.mapper :log-loaded :payload) :log-load-failed)]))

(defn active-chart-command [state]
  (Cmd.batch [(heart-chart-command state)
              (metric-chart-command state)]))

(defn active-chart-batch [state]
  (Cmd.batch [(heart-chart-batch state)
              (metric-chart-batch state)]))

(defn with-active-chart-command [state command]
  (Cmd.batch [command
              (active-chart-command state)]))

(defmacro active-chart-result [state-expr] `(let [next-state# ~state-expr] [next-state# (active-chart-command next-state#)]))
(defmacro active-chart-batch-result [state-expr] `(let [next-state# ~state-expr] [next-state# (active-chart-batch next-state#)]))
(defmacro metric-chart-batch-result [state-expr] `(let [next-state# ~state-expr] [next-state# (metric-chart-batch next-state#)]))
(defmacro with-active-chart-result [state-expr command-expr] `(let [next-state# ~state-expr] [next-state# (with-active-chart-command next-state# ~command-expr)]))

(defn init []
  (let [dev? (env-dev?)
        state (merge initial-state
                     {:dev? dev?
                      :zones default-zone-state.zones
                      :targetZoneId default-zone-state.targetZoneId})]
    [state
      (Cmd.batch [(startup-command)
                  (active-chart-batch state)])]))

(defn subscriptions [state]
  (Sub.batch
    [(Sub.media-query "mobile" "(max-width: 700px)" :media-changed)
     (if state.dev?
         (Sub.window/event-with "dev-hotkey"
                                "keydown"
                                :dev-key
                                {:preventDefault {:key "h"
                                                  :ctrlKey true
                                                  :shiftKey true
                                                  :altKey false
                                                  :metaKey false}})
         Sub.none)
     (if (some? state.zoneDragIndex)
         (Sub.window/event-with zone-drag-move-id
                                "pointermove"
                                :zone-boundary-drag-move
                                {:preventDefault true
                                 :options {:passive false}})
         Sub.none)
     (if (some? state.zoneDragIndex)
         (Sub.window/event-with zone-drag-up-id
                                "pointerup"
                                :zone-boundary-drag-end
                                {:preventDefault true
                                 :options {:passive false}})
         Sub.none)
     (if (some? state.zoneDragIndex)
         (Sub.window/event-with zone-drag-cancel-id
                                "pointercancel"
                                :zone-boundary-drag-end
                                {:preventDefault true
                                 :options {:passive false}})
         Sub.none)]))

(defn set-status [state status message mode]
  (merge state
         {:appStatus status
          :message message
          :statusMode mode}))

(defn reading [bpm elapsed-ms]
  {:bpm (round bpm)
   :time (max 0 (round elapsed-ms))})

(defn trend-label [last-rate bpm]
  (if (some? last-rate)
      (let [delta (- bpm last-rate)]
        (if (= delta 0)
            "Recording"
            (if (> delta 0)
                (str (abs delta) " bpm up")
                (str (abs delta) " bpm down"))))
      "Recording"))

(defn idle-elapsed [state timestamp]
  (match state.idleStartedAt
    (some started-at) (max 0 (- timestamp started-at))
    nil state.elapsedMs))

(defn live-elapsed [state timestamp]
  (if (= state.exerciseState "running")
      (current-elapsed state timestamp)
      (if (= state.exerciseState "idle")
          (idle-elapsed state timestamp)
          state.elapsedMs)))

(defn heart-rate-trend [state bpm]
  (if (= state.exerciseState "running")
      (trend-label state.lastRate bpm)
      (if (= state.exerciseState "paused")
          "Paused"
          (if (= state.exerciseState "stopped")
              "Stopped"
              "Idle"))))

(defn append-live-reading? [state]
  (or (= state.exerciseState "running")
      (= state.exerciseState "idle")))

(defn ensure-idle-start [state timestamp]
  (if (and (= state.exerciseState "idle")
           (not (some? state.idleStartedAt)))
      (merge state {:idleStartedAt timestamp})
      state))

(defn add-heart-rate-at [state bpm timestamp]
  (let [rounded (round bpm)
        timed-state (ensure-idle-start state timestamp)
        elapsed (live-elapsed timed-state timestamp)
        next-readings (if (append-live-reading? timed-state)
                          (conj timed-state.readings (reading rounded elapsed))
                          timed-state.readings)]
    (merge timed-state
           {:latestBpm rounded
            :lastRate (if (append-live-reading? timed-state)
                          rounded
                          timed-state.lastRate)
            :trend (heart-rate-trend timed-state rounded)
            :readings next-readings
            :displayElapsedMs elapsed
            :message (zone-label-for-bpm timed-state.zones rounded)})))

(defn clear-idle-live-state [state]
  (if (= state.exerciseState "idle")
      (merge state
             {:idleStartedAt nil
              :displayElapsedMs 0
              :readings []})
      state))

(defn low-zone-bpm [zones]
  (let [zone (nth zones 0)]
    zone.min))

(defn high-zone-bpm [zones]
  (let [zone (last zones)]
    zone.max))

(defn target-zone-from-roll [zones roll]
  (nth zones (floor roll)))

(defn log-and-persist-command [entries]
  (Cmd.batch [(Cmd.timer/cancel clock-timer-id)
              (Cmd.storage/set exercise-log-storage-key (log-payload entries) (Msg.of :log-saved) :log-save-failed)]))

(defn persist-zone-command [zones target-zone-id]
  (Cmd.storage/set zones-storage-key (zone-state-payload zones target-zone-id) (Msg.of :zones-saved) :zones-save-failed))

(defn persist-zone-silent-command [zones target-zone-id]
  (Cmd.storage/set-silent zones-storage-key (zone-state-payload zones target-zone-id) :zones-save-failed))

(defn persist-log-command [entries]
  (Cmd.storage/set exercise-log-storage-key (log-payload entries) (Msg.of :log-saved) :log-save-failed))

(defn clock-command []
  (Cmd.timer/every clock-timer-id 250 (Msg.of :clock-tick)))

(defn cancel-clock-command []
  (Cmd.timer/cancel clock-timer-id))

(defn stop-connections-command []
  (Cmd.batch [(Cmd.simulation/stop simulated-monitor-id)
              (cancel-clock-command)
              (Cmd.bluetooth/disconnect "hrm" (Msg.of :monitor-disconnected))]))

(defn connected-off-state [state]
  (clear-idle-live-state
    (merge state
           {:connected? false
            :simulated? false
            :deviceName ""})))

(defn disconnected-status-state [state]
  (set-status
    (connected-off-state state)
    "Disconnected"
    "Monitor disconnected"
    "warn"))

(defn pause-for-disconnect-state [state timestamp]
  (let [elapsed (current-elapsed state timestamp)]
    (disconnected-status-state
      (merge state
             {:exerciseState "paused"
              :elapsedMs elapsed
              :displayElapsedMs elapsed
              :startedAt nil
              :trend "Paused"}))))

(defn disconnect-monitor-command [state]
  (if (= state.exerciseState "running")
      (Cmd.time/now (Msg.mapper :disconnect-paused-at :timestamp))
      (stop-connections-command)))

(defn start-stop-progress-command []
  (Cmd.batch [(Cmd.timer/after stop-hold-timer-id stop-hold-ms (Msg.of :stop-hold-complete))
              (Cmd.animation/frame stop-hold-frame-id :stop-hold-frame)]))

(defn cancel-stop-command []
  (Cmd.batch [(Cmd.timer/cancel stop-hold-timer-id)
              (Cmd.animation/cancel stop-hold-frame-id (Msg.of :stop-hold-cancelled))]))

(defn start-delete-progress-command []
  (Cmd.batch [(Cmd.timer/after delete-hold-timer-id delete-hold-ms (Msg.of :delete-hold-complete))
              (Cmd.animation/frame delete-hold-frame-id :delete-hold-frame)]))

(defn cancel-delete-command []
  (Cmd.batch [(Cmd.timer/cancel delete-hold-timer-id)
              (Cmd.animation/cancel delete-hold-frame-id (Msg.of :delete-hold-cancelled))]))

(def zone-boundary-track-ref "zone-boundary-track")

(defn zone-boundary-bpm-from-client-x [state client-x]
  (let [first-zone (nth state.zones 0)
        last-zone (last state.zones)
        width (max 1 state.zoneTrackWidth)
        ratio (max 0 (min 1 (/ (- client-x state.zoneTrackLeft) width)))]
    (+ first-zone.min (* ratio (- last-zone.max first-zone.min)))))

(defn zone-boundary-key-delta [key]
  (if (or (= key "ArrowLeft") (= key "ArrowDown"))
      -1
      (if (or (= key "ArrowRight") (= key "ArrowUp"))
          1
          0)))

(defn hold-key? [key]
  (or (= key "Enter")
      (or (= key " ")
          (= key "Space"))))

(defn stop-hold-allowed? [state]
  (and (or (= state.exerciseState "running")
           (= state.exerciseState "paused"))
       (not state.stopHold?)))

(defn start-stop-hold-state [state]
  (merge state
         {:stopHold? true
          :stopHoldStartedAt 0
          :stopHoldProgress 0
          :message "Hold to stop"}))

(defn cancel-stop-hold-state [state]
  (merge state
         {:stopHold? false
          :stopHoldStartedAt 0
          :stopHoldProgress 0
          :message "Stop cancelled"}))

(defn delete-hold-allowed? [state]
  (and (some? (selected-log state.entries state.selectedLogId))
       (not state.deleteHold?)))

(defn start-delete-hold-state [state]
  (merge state
         {:deleteHold? true
          :deleteHoldStartedAt 0
          :deleteHoldProgress 0
          :message "Hold to delete"}))

(defn cancel-delete-hold-state [state]
  (merge state
         {:deleteHold? false
          :deleteHoldStartedAt 0
          :deleteHoldProgress 0
          :message "Delete cancelled"}))

(defn zone-boundary-status [zones index]
  (let [boundary (nth zones index)]
    (str "Boundary " boundary.max)))

(defn zone-drag-measure-command [index client-x]
  (Cmd.dom-ref/measure zone-boundary-track-ref
                       (fn [rect]
                         {:kind :zone-boundary-track-measured
                          :index index
                          :clientX client-x
                          :left rect.left
                          :width rect.width
                          :value {:x rect.x
                                  :y rect.y
                                  :width rect.width
                                  :height rect.height
                                  :top rect.top
                                  :right rect.right
                                  :bottom rect.bottom
                                  :left rect.left}})
                       :zone-boundary-track-error))

(defn hold-progress-for [duration-ms started-at timestamp]
  (max 0 (min 1 (/ (- timestamp started-at) duration-ms))))

(defn stop-progress-for [started-at timestamp]
  (hold-progress-for stop-hold-ms started-at timestamp))

(defn progress-for [started-at timestamp]
  (hold-progress-for delete-hold-ms started-at timestamp))

(defn progress-width [progress]
  (str (round (* progress 100)) "%"))

(defn selected-type-draft [entries selected-id]
  (match (selected-log entries selected-id)
    (some entry)
      (if (some? entry.exerciseType)
          entry.exerciseType
          "")
    nil ""))

(defn reconcile-log-state [state]
  (let [selected-id (reconciled-selected-id state.entries state.logTypeFilter state.selectedLogId)]
    (merge state
           {:selectedLogId selected-id
            :typeDraft (selected-type-draft state.entries selected-id)})))

(def type-picker-ref "type-picker-input")

(defn focus-type-picker-command []
  (Cmd.dom-ref/focus type-picker-ref (Msg.of :type-picker-focused) :type-picker-focus-failed))

(defn selected-type-picker? [state entry]
  (match state.typePickerEntryId
    (some id) (= id entry.id)
    nil false))

(defmacro save-entry-type-result [state selected-id draft]
  `(let [selected-id# ~selected-id
         draft# ~draft]
     (if (some? (selected-log (get ~state :entries) selected-id#))
      (let [entries (update-entry-type (get ~state :entries) selected-id# draft#)]
        (let [next-state (reconcile-log-state
                           (merge ~state
                                  {:entries entries
                                   :typePickerEntryId nil
                                   :typePickerDraft ""
                                   :message "Workout type saved"}))]
          [next-state
           (with-active-chart-command next-state (persist-log-command entries))]))
      (no-cmd ~state))))

(defn update [state msg]
  (match msg
    {:kind :zones-loaded :payload payload}
      (let [zone-state (load-zone-state payload)]
        (active-chart-result
          (set-status
            (merge state
                   {:zones zone-state.zones
                    :targetZoneId zone-state.targetZoneId
                    :zoneStatus "Zones loaded"})
            "Ready"
            "Zones loaded"
            "muted")))
    {:kind :zones-load-failed :error error}
      (active-chart-result
        (set-status
          (merge state
                 {:zones default-zone-state.zones
                  :targetZoneId default-zone-state.targetZoneId
                  :zoneStatus "Using default zones"})
          "Ready"
          error
          "warn"))
    {:kind :log-loaded :payload payload}
      (let [entries (load-log-entries payload)
            selected-id (first-visible-id entries)]
        (active-chart-result
          (reconcile-log-state
            (set-status
              (merge state
                     {:entries entries
                      :selectedLogId selected-id
                      :typePickerEntryId nil
                      :typePickerDraft ""
                      :importStatus "Ready"})
              "Ready"
              (str "Loaded " (count (visible-log entries)) " workouts")
              "muted"))))
    {:kind :log-load-failed :error error}
      (active-chart-result
        (set-status
          (merge state
                 {:entries []
                  :selectedLogId nil
                  :logTypeFilter all-types-filter
                  :importStatus "Log reset"})
          "Ready"
          error
          "warn"))
    {:kind :media-changed :matches matches}
      (active-chart-batch-result (merge state {:mobile? matches}))
    {:kind :chart-resized :width width :height height}
      (active-chart-result (merge state {:chartWidth width :chartHeight height}))
    {:kind :chart-error :error error}
      (no-cmd (merge state {:message error}))
    {:kind :dev-key :value event}
      (if (and state.dev?
               event.ctrlKey
               event.shiftKey
               (not event.altKey)
               (not event.metaKey)
               (= (lower-case event.key) "h"))
           (if state.simulated?
               [(if (= state.exerciseState "running")
                    (set-status state "Disconnecting" "Pausing workout" "warn")
                    (disconnected-status-state state))
               (disconnect-monitor-command state)]
               (if (not state.connected?)
                   [state (Cmd.dom-ref/click "simulate-monitor" (Msg.of :dev-opened))]
                   (no-cmd state)))
           (no-cmd state))
    {:kind :dev-opened}
      (no-cmd state)
    {:kind :select-tab :view view}
      (active-chart-batch-result (merge state {:detailView view}))
    {:kind :metrics-grouping :value value}
      (metric-chart-batch-result (merge state {:metricsGrouping value}))
    {:kind :filter-log-type :value value}
      (active-chart-result
        (reconcile-log-state
          (merge state
                 {:logTypeFilter value
                  :typePickerEntryId nil
                  :typePickerDraft ""
                  :message (if (= value all-types-filter)
                               "Showing all workout types"
                               (if (= value untyped-filter)
                                   "Showing untyped workouts"
                                   (str "Showing " value)))})))
    {:kind :active-type-edited :text text}
      (no-cmd (merge state {:activeExerciseType text}))
    {:kind :connect-monitor}
      (if state.connected?
          (no-cmd state)
          [(set-status state "Pairing" "Pairing heart-rate monitor" "warn")
           (Cmd.bluetooth/connect-heart-rate "hrm"
                                             {:filters [{:services ["heart_rate"]}]
                                              :optionalServices ["heart_rate"]}
                                             (Msg.mapper :monitor-connected :info)
                                             :heart-rate
                                             :monitor-disconnected
                                             :monitor-error)])
    {:kind :monitor-connected :info info}
      (with-active-chart-result
        (set-status
          (merge state
                 {:connected? true
                  :simulated? false
                  :deviceName info.deviceName})
          "Live"
          "Heart-rate monitor connected"
          "live")
        (if (= state.exerciseState "idle")
            (Cmd.time/now (Msg.mapper :idle-started-at :timestamp))
            Cmd.none))
    {:kind :monitor-error :error error}
      [(set-status
         (merge state {:connected? false})
         "Unavailable"
         error
         "warn")
       Cmd.none]
    {:kind :monitor-disconnected}
      [(disconnected-status-state state)
       (cancel-clock-command)]
    {:kind :disconnect-monitor}
      [(if (= state.exerciseState "running")
           (set-status state "Disconnecting" "Pausing workout" "warn")
           (disconnected-status-state state))
       (disconnect-monitor-command state)]
    {:kind :disconnect-paused-at :timestamp timestamp}
      [(pause-for-disconnect-state state timestamp)
       (stop-connections-command)]
    {:kind :connect-simulated}
      (if (or (not (env-dev?)) state.connected?)
          (no-cmd state)
          [(set-status state "Pairing" "Choosing simulated zone" "warn")
           (Cmd.random/number 0 (count state.zones) (Msg.mapper :sim-zone-picked :roll))])
    {:kind :sim-zone-picked :roll roll}
      (let [zone (target-zone-from-roll state.zones roll)]
        [(set-status
           (merge state {:targetZoneId zone.id})
           "Pairing"
           "Choosing simulated BPM"
           "warn")
         (Cmd.random/number zone.min zone.max (Msg.mapper :sim-bpm-picked :bpm))])
    {:kind :sim-bpm-picked :bpm bpm}
      (with-active-chart-result
        (set-status
          (merge state
                 {:connected? true
                  :simulated? true
                  :deviceName "Simulated HRM"})
          "Live"
          "Simulated monitor"
          "live")
        (Cmd.batch [(Cmd.time/now (fn [timestamp] (Msg.with2 :heart-rate-at :bpm (round bpm) :timestamp timestamp)))
                    (Cmd.simulation/heart-rate simulated-monitor-id
                                               {:ms 1000
                                                :min (low-zone-bpm state.zones)
                                                :max (high-zone-bpm state.zones)
                                                :jitter 3.5
                                                :start (round bpm)
                                                :deviceName "Simulated HRM"}
                                               (Msg.mapper :sim-connected :info)
                                               :heart-rate
                                               :monitor-error)]))
    {:kind :sim-connected}
      (no-cmd state)
    {:kind :start}
      (if (or (not (= state.exerciseState "idle"))
              (not state.connected?))
           [(if state.connected?
                state
                (set-status state "Disconnected" "Not connected" "warn"))
           Cmd.none]
          [(set-status state "Starting" "Starting workout" "warn")
           (Cmd.time/now (Msg.mapper :started-at :timestamp))])
    {:kind :started-at :timestamp now}
      (with-active-chart-result
        (set-status
          (merge state
                 {:exerciseState "running"
                  :elapsedMs 0
                  :displayElapsedMs 0
                  :startedAt now
                  :sessionStartedAt now
                  :idleStartedAt nil
                  :lastRate nil
                  :detailView "live"
                  :readings []})
          "Recording"
          "Workout in progress"
          "live")
        (clock-command))
    {:kind :pause}
      (if (= state.exerciseState "running")
          [(set-status state "Pausing" "Pausing workout" "warn")
           (Cmd.time/now (Msg.mapper :paused-at :timestamp))]
          (no-cmd state))
    {:kind :paused-at :timestamp now}
      (with-active-chart-result
        (set-status
          (merge state
                 {:exerciseState "paused"
                  :elapsedMs (current-elapsed state now)
                  :displayElapsedMs (current-elapsed state now)
                  :startedAt nil})
          "Paused"
          "Workout paused"
          "warn")
        (cancel-clock-command))
    {:kind :resume}
      (if (and (= state.exerciseState "paused")
               state.connected?)
          [(set-status state "Resuming" "Resuming workout" "warn")
           (Cmd.time/now (Msg.mapper :resumed-at :timestamp))]
          [(if state.connected?
               state
               (set-status state "Disconnected" "Not connected" "warn"))
           Cmd.none])
    {:kind :resumed-at :timestamp now}
      (with-active-chart-result
        (set-status
          (merge state
                 {:exerciseState "running"
                  :startedAt now})
          "Recording"
          "Workout in progress"
          "live")
        (clock-command))
    {:kind :clock-tick}
      [state (Cmd.time/now (Msg.mapper :clocked-at :timestamp))]
    {:kind :clocked-at :timestamp now}
      (active-chart-result (merge state {:displayElapsedMs (live-elapsed state now)}))
    {:kind :heart-rate :bpm bpm}
      [state (Cmd.time/now (fn [timestamp] (Msg.with2 :heart-rate-at :bpm bpm :timestamp timestamp)))]
    {:kind :heart-rate-at :bpm bpm :timestamp timestamp}
      (with-active-chart-result
        (add-heart-rate-at state bpm timestamp)
        (if (and (= state.exerciseState "idle")
                 (not (some? state.idleStartedAt)))
            (clock-command)
            Cmd.none))
    {:kind :idle-started-at :timestamp timestamp}
      (with-active-chart-result
        (if (and (= state.exerciseState "idle")
                 state.connected?)
            (merge state
                   {:idleStartedAt timestamp
                    :displayElapsedMs 0})
            state)
        (if (and (= state.exerciseState "idle")
                 state.connected?)
            (clock-command)
            Cmd.none))
    {:kind :stop-hold-start}
      (if (stop-hold-allowed? state)
          [(start-stop-hold-state state)
           (Cmd.time/now (Msg.mapper :stop-hold-started :timestamp))]
          (no-cmd state))
    {:kind :stop-hold-key-down :key key}
      (if (and (hold-key? key)
               (stop-hold-allowed? state))
          [(start-stop-hold-state state)
           (Cmd.time/now (Msg.mapper :stop-hold-started :timestamp))]
          (no-cmd state))
    {:kind :stop-hold-started :timestamp timestamp}
      (if state.stopHold?
          [(merge state {:stopHoldStartedAt timestamp})
           (start-stop-progress-command)]
          (no-cmd state))
    {:kind :stop-hold-frame :timestamp timestamp}
      (if state.stopHold?
          (let [progress (stop-progress-for state.stopHoldStartedAt timestamp)]
            [(merge state
                    {:stopHoldProgress progress
                     :message (str "Stopping " (progress-width progress))})
             (if (< progress 1)
                 (Cmd.animation/frame stop-hold-frame-id :stop-hold-frame)
                 Cmd.none)])
          (no-cmd state))
    {:kind :stop-hold-cancel}
      (if state.stopHold?
          [(cancel-stop-hold-state state)
           (cancel-stop-command)]
          (no-cmd state))
    {:kind :stop-hold-key-up :key key}
      (if (and (hold-key? key)
               state.stopHold?)
          [(cancel-stop-hold-state state)
           (cancel-stop-command)]
          (no-cmd state))
    {:kind :stop-hold-cancelled}
      (no-cmd state)
    {:kind :stop-hold-complete}
      (if state.stopHold?
          [(set-status
             (merge state {:stopHoldProgress 1})
             "Stopping"
             "Finalizing workout"
             "warn")
           (Cmd.batch [(Cmd.animation/cancel stop-hold-frame-id (Msg.of :stop-hold-cancelled))
                       (Cmd.time/now (Msg.mapper :stopped-at :timestamp))])]
          (no-cmd state))
    {:kind :stop}
      (if (or (= state.exerciseState "running")
              (= state.exerciseState "paused"))
          [(set-status state "Stopping" "Finalizing workout" "warn")
           (Cmd.time/now (Msg.mapper :stopped-at :timestamp))]
          (no-cmd state))
    {:kind :stopped-at :timestamp stopped-at}
      [(merge state {:pendingStoppedAt stopped-at})
       (Cmd.random/number 0 1 (Msg.mapper :id-roll :roll))]
    {:kind :id-roll :roll roll}
      (let [stopped-at (if (some? state.pendingStoppedAt)
                           state.pendingStoppedAt
                           0)
            entry (workout-entry state stopped-at roll)
            entries (newest-first (conj state.entries entry))]
        (let [next-state (set-status
                           (merge state
                                  {:exerciseState "idle"
                                   :elapsedMs 0
                                    :displayElapsedMs 0
                                    :startedAt nil
                                    :sessionStartedAt nil
                                    :idleStartedAt nil
                                    :pendingStoppedAt nil
                                    :readings []
                                   :entries entries
                                   :selectedLogId entry.id
                                   :typeDraft (selected-type-draft entries entry.id)
                                   :typePickerEntryId entry.id
                                   :typePickerDraft state.activeExerciseType
                                   :stopHold? false
                                   :stopHoldStartedAt 0
                                   :stopHoldProgress 0
                                   :detailView "log"})
                           "Saved"
                           "Workout added to log"
                           "muted")]
          [next-state
           (Cmd.batch [(log-and-persist-command entries)
                       (active-chart-command next-state)
                       (focus-type-picker-command)])]))
    {:kind :target-zone :id id}
      (with-active-chart-result
        (merge state
               {:targetZoneId id
                :zoneStatus (str "Target " id)})
        (persist-zone-command state.zones id))
    {:kind :zone-min-edited :id id :raw raw}
      (let [zones (set-zone-min state.zones id raw)]
        (with-active-chart-result
          (merge state
                 {:zones zones
                  :zoneStatus "Zones edited"})
          (persist-zone-command zones state.targetZoneId)))
    {:kind :zone-max-edited :id id :raw raw}
      (let [zones (set-zone-max state.zones id raw)]
        (with-active-chart-result
          (merge state
                 {:zones zones
                  :zoneStatus "Zones edited"})
          (persist-zone-command zones state.targetZoneId)))
    {:kind :zone-boundary :index index :bpm bpm}
      (let [zones (set-zone-boundary state.zones index bpm)]
        (with-active-chart-result
          (merge state
                 {:zones zones
                  :zoneStatus "Boundary moved"})
          (persist-zone-command zones state.targetZoneId)))
    {:kind :zone-boundary-key :index index :key key}
      (let [delta (zone-boundary-key-delta key)]
        (if (= delta 0)
            (no-cmd state)
            (let [left (nth state.zones index)
                  zones (set-zone-boundary state.zones index (+ left.max delta))]
              (with-active-chart-result
                (merge state
                       {:zones zones
                        :zoneStatus (zone-boundary-status zones index)})
                (persist-zone-command zones state.targetZoneId)))))
    {:kind :zone-boundary-drag-start :index index :clientX client-x}
      [(merge state {:zoneStatus "Measuring boundary"})
       (zone-drag-measure-command index client-x)]
    {:kind :zone-boundary-track-measured :index index :clientX client-x :left left :width width}
      (let [measured-state (merge state
                                  {:zoneTrackLeft left
                                   :zoneTrackWidth (max 1 width)
                                   :zoneDragIndex index})
            zones (set-zone-boundary measured-state.zones
                                     index
                                     (zone-boundary-bpm-from-client-x measured-state client-x))]
        (with-active-chart-result
          (merge measured-state
                 {:zones zones
                  :zoneStatus (zone-boundary-status zones index)})
          (persist-zone-silent-command zones state.targetZoneId)))
    {:kind :zone-boundary-track-error :error error}
      (no-cmd (merge state
                     {:zoneDragIndex nil
                      :zoneStatus error}))
    {:kind :zone-boundary-drag-move :value event}
      (if (some? state.zoneDragIndex)
          (let [zones (set-zone-boundary state.zones
                                         state.zoneDragIndex
                                         (zone-boundary-bpm-from-client-x state event.clientX))]
            (with-active-chart-result
              (merge state
                     {:zones zones
                      :zoneStatus (zone-boundary-status zones state.zoneDragIndex)})
              (persist-zone-silent-command zones state.targetZoneId)))
          (no-cmd state))
    {:kind :zone-boundary-drag-end}
      (no-cmd (merge state
                     {:zoneDragIndex nil
                      :zoneStatus "Boundary set"}))
    {:kind :zones-saved}
      (no-cmd (merge state {:zoneStatus "Zones saved"}))
    {:kind :zones-save-failed :error error}
      [(set-status
         (merge state {:zoneStatus error})
         "Save failed"
         error
         "warn")
       Cmd.none]
    {:kind :select-log :id id}
      (active-chart-result
        (reconcile-log-state
          (merge state
                 {:selectedLogId id
                  :typePickerEntryId nil
                  :typePickerDraft ""
                  :detailView "log"})))
    {:kind :edit-type-draft :text text}
      (no-cmd (merge state {:typeDraft text}))
    {:kind :type-draft-key :key key}
      (if (= key "Enter")
          (save-entry-type-result state state.selectedLogId state.typeDraft)
          (no-cmd state))
    {:kind :type-picker-draft :text text}
      (no-cmd (merge state {:typePickerDraft text}))
    {:kind :type-picker-key :key key}
      (if (= key "Enter")
          (save-entry-type-result state state.typePickerEntryId state.typePickerDraft)
          (no-cmd state))
    {:kind :confirm-type-picker}
      (save-entry-type-result state state.typePickerEntryId state.typePickerDraft)
    {:kind :skip-type-picker}
      [(reconcile-log-state
         (merge state
                {:typePickerEntryId nil
                 :typePickerDraft ""
                 :message "Workout type skipped"}))
       Cmd.none]
    {:kind :type-picker-focused}
      (no-cmd state)
    {:kind :type-picker-focus-failed :error error}
      (no-cmd (merge state {:message error}))
    {:kind :save-type}
      (save-entry-type-result state state.selectedLogId state.typeDraft)
    {:kind :delete-hold-start}
      (if (delete-hold-allowed? state)
          [(start-delete-hold-state state)
           (Cmd.time/now (Msg.mapper :delete-hold-started :timestamp))]
          (no-cmd state))
    {:kind :delete-hold-key-down :key key}
      (if (and (hold-key? key)
               (delete-hold-allowed? state))
          [(start-delete-hold-state state)
           (Cmd.time/now (Msg.mapper :delete-hold-started :timestamp))]
          (no-cmd state))
    {:kind :delete-hold-started :timestamp timestamp}
      (if state.deleteHold?
          [(merge state {:deleteHoldStartedAt timestamp})
           (start-delete-progress-command)]
          (no-cmd state))
    {:kind :delete-hold-frame :timestamp timestamp}
      (if state.deleteHold?
          (let [progress (progress-for state.deleteHoldStartedAt timestamp)]
            [(merge state
                    {:deleteHoldProgress progress
                     :message (str "Deleting " (progress-width progress))})
             (if (< progress 1)
                 (Cmd.animation/frame delete-hold-frame-id :delete-hold-frame)
                 Cmd.none)])
          (no-cmd state))
    {:kind :delete-hold-cancel}
      (if state.deleteHold?
          [(cancel-delete-hold-state state)
           (cancel-delete-command)]
          (no-cmd state))
    {:kind :delete-hold-key-up :key key}
      (if (and (hold-key? key)
               state.deleteHold?)
          [(cancel-delete-hold-state state)
           (cancel-delete-command)]
          (no-cmd state))
    {:kind :delete-hold-cancelled}
      (no-cmd state)
    {:kind :delete-hold-complete}
      (if state.deleteHold?
          [(merge state
                  {:deleteHoldProgress 1
                   :message "Deleting workout"})
           (Cmd.time/now (Msg.mapper :delete-selected-at :timestamp))]
          (no-cmd state))
    {:kind :delete-selected-at :timestamp timestamp}
      (let [entries (hide-entry state.entries state.selectedLogId timestamp)
            selected-id (first-visible-id entries)]
        (with-active-chart-result
          (reconcile-log-state
            (merge state
                   {:entries entries
                    :selectedLogId selected-id
                    :deleteHold? false
                    :deleteHoldStartedAt 0
                    :deleteHoldProgress 0
                    :typePickerEntryId nil
                    :typePickerDraft ""
                    :message "Workout deleted"}))
          (persist-log-command entries)))
    {:kind :log-saved}
      (no-cmd state)
    {:kind :log-save-failed :error error}
      [(set-status
         (merge state {:importStatus error})
         "Save failed"
         error
         "warn")
       Cmd.none]
    {:kind :open-import}
      [(merge state {:importStatus "Opening import"})
       (Cmd.dom-ref/click "import-file" (Msg.of :import-opened) :import-failed)]
    {:kind :import-opened}
      (no-cmd (merge state {:importStatus "Choose a JSON file"}))
    {:kind :read-import}
      [(merge state {:importStatus "Reading import"})
       (Cmd.file/read-selected "import-file" :json (Msg.mapper :log-imported :payload) :import-failed :import-cancelled)]
    {:kind :log-imported :payload payload}
      (let [entries (load-log-entries payload)
            error (import-log-error payload entries)]
        (if (some? error)
            (no-cmd (merge state {:importStatus error}))
            (let [selected-id (first-visible-id entries)]
              (with-active-chart-result
                (reconcile-log-state
                  (merge state
                         {:entries entries
                          :selectedLogId selected-id
                          :logTypeFilter all-types-filter
                          :typePickerEntryId nil
                          :typePickerDraft ""
                          :importStatus (import-success-message (count entries))
                          :detailView "log"}))
                (persist-log-command entries)))))
    {:kind :import-cancelled}
      (no-cmd (merge state {:importStatus "Import cancelled"}))
    {:kind :import-failed :error error}
      (no-cmd (merge state {:importStatus error}))
    {:kind :export-log}
      [(merge state {:importStatus "Exporting log"})
       (Cmd.time/now (Msg.mapper :export-log-at :timestamp))]
    {:kind :export-log-at :timestamp timestamp}
      [(merge state {:importStatus "Exporting log"})
       (Cmd.file/download (export-log-filename timestamp)
                          (export-log-json (visible-log state.entries))
                          "application/json"
                          (Msg.of :exported)
                          :export-failed)]
    {:kind :export-failed :error error}
      [(set-status
         (merge state {:importStatus error})
         "Export failed"
         error
         "warn")
       Cmd.none]
    {:kind :exported}
      (no-cmd (merge state {:importStatus "Exported log"}))
    _ (no-cmd state)))

(defn latest-bpm-label [state]
  (if (> state.latestBpm 0)
      (str state.latestBpm)
      "--"))

(defn connection-label [state]
  (if state.connected?
      (if state.simulated?
          "Simulated"
          "Bluetooth")
      "Disconnected"))

(def card-class
  "rounded-lg border border-[#dbe2dc]/90 bg-white/95 shadow-[0_18px_45px_rgba(24,31,27,0.11)]")

(def primary-button-class
  "flex min-h-[46px] cursor-pointer items-center justify-center rounded-lg border border-transparent bg-[#d9184b] px-4 text-center text-[1rem] font-extrabold leading-none text-white hover:bg-[#a80f37] disabled:cursor-not-allowed disabled:opacity-50")

(def secondary-button-class
  "flex min-h-[46px] cursor-pointer items-center justify-center rounded-lg border border-[#dbe2dc] bg-white px-4 text-center text-[0.95rem] font-bold leading-none text-[#172019] hover:not-disabled:border-[#aebcaf] hover:not-disabled:bg-[#fbfcfb] disabled:cursor-not-allowed disabled:border-[#e5ebe6] disabled:bg-[#fbfcfb] disabled:text-[#9aa39c]")

(def stat-tile-class
  "min-w-16 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] px-2.5 py-2 text-right")

(defn mobile-button-class [state base text-size]
  (str base
       (if state.mobile?
           (str " !min-h-10 !px-2.5 " text-size)
           "")))

(defn control-grid-class [state]
  (str "grid "
       (if state.connected? "grid-cols-3" "grid-cols-2")
       " gap-2.5 "
       (if state.mobile? "!gap-1.5" "")))

(defn exercise-button-label [state]
  (if (= state.exerciseState "running")
      "Pause"
      (if (= state.exerciseState "paused")
          "Resume"
          "Start")))

(defn exercise-button-msg [state]
  (if (= state.exerciseState "running")
      {:kind :pause}
      (if (= state.exerciseState "paused")
          {:kind :resume}
          {:kind :start})))

(defn exercise-button-class [state]
  (mobile-button-class
    state
    (if (= state.exerciseState "running")
        (str secondary-button-class " border-[#986b00]/35 bg-[#986b00]/10 text-[#986b00]")
        primary-button-class)
    "text-[0.95rem]"))

(defn stop-button-class [state]
  (mobile-button-class
    state
    (str secondary-button-class
         " hold-stop relative overflow-hidden"
         (if (> state.stopHoldProgress 0)
             " border-[#d9184b]/45 text-[#d9184b]"
             ""))
    "text-[0.95rem]"))

(defn connection-pane-class [state]
  (str card-class
       " connection-pane flex min-h-[560px] flex-col p-6 max-[820px]:min-h-0 "
       (if state.mobile?
           "!min-h-0 !p-[10px_12px_8px]"
           "")))

(defn monitor-head-class [state]
  (str "flex items-start justify-between gap-4 "
       (if state.mobile? "hidden" "")))

(defn latest-bpm-wrap-class [state]
  (str "my-auto mb-8 max-[820px]:my-[34px] max-[820px]:mb-7 "
       (if state.mobile? "!m-0 !mb-2.5" "")))

(defn latest-bpm-number-class [state]
  (str "text-[clamp(5.5rem,18vw,10.5rem)] font-extrabold leading-[0.9] tracking-normal tabular-nums "
       (if state.mobile?
           "!text-[clamp(8.8rem,38vw,12rem)] !leading-[0.82]"
           "")))

(defn bpm-unit-class [state]
  (str "font-extrabold text-[#617066] "
       (if state.mobile? "text-[1.05rem]" "")))

(defn trend-line-class [state]
  (str "mt-3.5 min-h-[26px] font-semibold text-[#617066] "
       (if state.mobile? "!mt-0.5 min-h-[18px] text-[0.95rem]" "")))

(defn status-pill-class [state]
  (str "status-pill flex-none rounded-full border px-2.5 py-1.5 text-[0.78rem] font-bold "
       (if (= state.statusMode "live")
           "border-[#087f5b]/25 bg-[#087f5b]/10 text-[#087f5b]"
           (if (= state.statusMode "warn")
               "border-[#986b00]/30 bg-[#986b00]/10 text-[#986b00]"
               "border-[#dbe2dc] bg-[#f9faf8] text-[#617066]"))))

(defn latest-bpm-color [state]
  (let [zone (zone-for-bpm state.zones state.latestBpm)]
    (if (some? zone)
        zone.color
        "#172019")))

(defn monitor-status-label [state]
  (if state.connected?
      (connection-label state)
      (if (= state.statusMode "warn")
          state.appStatus
          "Idle")))

(defn tab-class [state view]
  (str "tab min-h-9 rounded-md px-3 text-[0.9rem] font-extrabold "
       (if (= state.detailView view)
           "bg-white text-[#172019] shadow-sm"
           "text-[#617066]")))

(defn tab-button [state view label]
  #html <button type="button"
                class={(tab-class state view)}
                data-active={(= state.detailView view)}
                on:click={{:kind :select-tab
                           :view view}}>{label}</button>)

(defn desktop-tab-strip [state]
  #html <div id="chart-title"
              class="tabs grid grid-cols-3 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] p-1"
              data-testid="exercise-tabs-desktop"
              aria-label="Exercise view">
          {(tab-button state "live" "Live")}
          {(tab-button state "log" "Log")}
          {(tab-button state "metrics" "Metrics")}
        </div>)

(defn mobile-tab-strip [state]
  #html <div class="tabs mt-2 grid grid-cols-3 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] p-1"
              data-testid="exercise-tabs-mobile"
              aria-label="Exercise view">
          {(tab-button state "live" "Live")}
          {(tab-button state "log" "Log")}
          {(tab-button state "metrics" "Metrics")}
        </div>)

(defn summary-stat-tile-class [state]
  (str stat-tile-class
       " summary-stat-tile "
       (if state.mobile?
           "!min-w-0 !p-[5px_6px] text-left [&_span]:text-[1.05rem] [&_span]:font-extrabold [&_span]:tabular-nums [&_small]:text-[0.68rem] [&_small]:whitespace-nowrap"
           "w-20 [&_span]:text-[1.1rem] [&_span]:font-extrabold [&_span]:tabular-nums [&_span]:whitespace-nowrap")))

(defn summary-stat-tile [state label value]
  #html <div class={(summary-stat-tile-class state)}>
          <span class="block">{value}</span>
          <small class="block font-bold text-[#617066]">{label}</small>
        </div>)

(defn format-zone-duration [duration-ms]
  (if (<= duration-ms 0)
      "0:00"
      (let [total-seconds (floor (/ duration-ms 1000))
            hours (floor (/ total-seconds 3600))
            minutes (floor (/ (mod total-seconds 3600) 60))
            seconds (mod total-seconds 60)]
        (if (> hours 0)
            (str hours
                 ":"
                 (pad-start (str minutes) 2 "0")
                 ":"
                 (pad-start (str seconds) 2 "0"))
            (str minutes ":" (pad-start (str seconds) 2 "0"))))))

(defn live-stats-entry-from [display-elapsed-ms readings target-zone-id zones active-exercise-type]
  {:id "live"
   :startedAt 0
   :stoppedAt 0
   :durationMs display-elapsed-ms
   :readings readings
   :targetZoneId target-zone-id
   :zones zones
   :exerciseType active-exercise-type
   :hiddenAt nil})

(defn live-stats-entry [state]
  (live-stats-entry-from state.displayElapsedMs
                         state.readings
                         state.targetZoneId
                         state.zones
                         state.activeExerciseType))

(defn zone-time-card [item mobile?]
  #html <div class={(str "zone-time-card min-w-0 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] p-2 "
                         (if mobile? "!p-[5px_6px]" ""))}
              data-testid={(str "zone-time-" item.id)}
              data-percent={item.percent}>
          <div class="zone-time-meter mb-1 h-1.5 overflow-hidden rounded-full bg-[#e5ebe6]">
            <span class="block h-full rounded-full"
                  style={{:width (str item.percent "%")
                          :background item.color}}></span>
          </div>
          <strong class={(str "block truncate font-extrabold tabular-nums "
                              (if mobile? "text-[0.82rem]" "text-[0.95rem]"))}>{(format-zone-duration item.durationMs)}</strong>
          <small class={(str "block truncate font-bold text-[#617066] "
                             (if mobile? "text-[0.62rem]" "text-[0.72rem]"))}>{item.name}</small>
        </div>)

(defn zone-time-stats [stats mobile?]
  #html <div class={(str "zone-time-stats mt-3 grid grid-cols-5 gap-2 "
                         (if mobile? "!mt-2 !gap-1" ""))}
              data-testid="zone-time-stats"
              aria-label="Time in heart rate zones">
          {(for [item stats :key item.id]
             #html <div>{(zone-time-card item mobile?)}</div>)}
        </div>)

(defn quiet-import-status? [status]
  (or (= status "Ready")
      (= status "Log reset")
      (= status "Opening import")
      (= status "Choose a JSON file")
      (= status "Reading import")
      (= status "Import cancelled")
      (= status "Exporting log")
      (= status "Exported log")))

(defn import-status-class [status]
  (if (quiet-import-status? status)
      "hidden"
      "m-0 text-sm font-semibold text-[#617066]"))

(defn monitor-card [state]
  #html <section class={(connection-pane-class state)}
                 data-testid="connection-pane"
                 aria-labelledby="app-title">
          <div class={(monitor-head-class state)} data-testid="monitor-heading">
            <div>
              <h1 id="app-title"
                  class="m-0 max-w-[250px] text-[clamp(2rem,5vw,3.5rem)] leading-[0.98] tracking-normal">Heart Rate Monitor</h1>
            </div>
            <span class={(status-pill-class state)} data-testid="status-pill">
              <span data-testid="connection-status">{(monitor-status-label state)}</span>
            </span>
          </div>

          <div class={(latest-bpm-wrap-class state)} data-testid="latest-bpm" aria-live="polite">
            <div>
              <strong class={(latest-bpm-number-class state)}
                      style={{:color (latest-bpm-color state)}}>{(latest-bpm-label state)}</strong>
              <span class={(bpm-unit-class state)}>bpm</span>
            </div>
            <div class={(trend-line-class state)}>{state.trend}</div>
          </div>

          <div class={(control-grid-class state)} aria-label="Bluetooth and exercise controls">
            <button type="button"
                    class="sr-only"
                    tabindex="-1"
                    ref="simulate-monitor"
                    data-testid="simulate-monitor"
                    on:click={{:kind :connect-simulated}}
                    disabled={(or state.connected? (not state.dev?))}>Simulate</button>
            {(if state.connected?
                 #html <button type="button"
                               class={(mobile-button-class state secondary-button-class "text-[0.9rem]")}
                               on:click={{:kind :disconnect-monitor}}>Disconnect</button>
                 #html <button type="button"
                               class={(str (mobile-button-class state primary-button-class "text-[0.95rem]") " col-span-full")}
                               on:click={{:kind :connect-monitor}}>Connect monitor</button>)}
            <button type="button"
                    class={(exercise-button-class state)}
                    disabled={not state.connected?}
                    on:click={(exercise-button-msg state)}>{(exercise-button-label state)}</button>
            <button type="button"
                    class={(stop-button-class state)}
                    data-testid="stop-workout"
                    data-holding={state.stopHold?}
                    disabled={(and (not (= state.exerciseState "running"))
                                   (not (= state.exerciseState "paused")))}
                    on:pointerdown={(Event.prevent {:kind :stop-hold-start})}
                    on:pointerup={{:kind :stop-hold-cancel}}
                    on:pointerleave={{:kind :stop-hold-cancel}}
                    on:pointercancel={{:kind :stop-hold-cancel}}
                    on:keydown={(if (hold-key? event.key)
                                    (Event.prevent {:kind :stop-hold-key-down
                                                    :key event.key})
                                    {:kind :stop-hold-key-down
                                     :key event.key})}
                    on:keyup={{:kind :stop-hold-key-up
                                :key event.key}}>
              <span class="absolute inset-y-0 left-0 bg-[#d9184b]/12"
                    style={{:width (progress-width state.stopHoldProgress)}}></span>
              <strong class="relative">{(if state.stopHold? "Hold..." "Stop")}</strong>
            </button>
          </div>
        </section>)

(defn zones-pane [state]
  #html <section class="zones-pane mt-[18px] max-[820px]:mt-2.5" data-testid="zones-pane" data-status={state.zoneStatus}>
          <div>
            {(if state.mobile?
                 #html <div class="hidden"></div>
                 #html <p id="zones-title" class="m-0 mb-1.5 text-[0.77rem] font-bold uppercase tracking-normal text-[#617066]">Training zones</p>)}
          </div>
          <div class="relative mt-3 pb-12 pt-0 max-[820px]:mt-0.5"
               ref={zone-boundary-track-ref}
               data-testid="zone-boundary-track"
               data-dragging={(some? state.zoneDragIndex)}>
            <div class="zone-strip flex h-8 overflow-hidden rounded-full border border-[#172019]/20 bg-[#f1f4f1]">
              {(for [zone state.zones :key zone.id]
                 #html <button type="button"
                               class={(str "min-w-[18px] cursor-pointer border-0 p-0 text-transparent "
                                           (if (= zone.id state.targetZoneId)
                                               "opacity-100 shadow-[inset_0_0_0_3px_rgba(23,32,25,0.28)]"
                                               "opacity-75"))}
                               data-testid={(str "target-zone-" zone.id)}
                               data-selected={(= zone.id state.targetZoneId)}
                               style={{:background zone.color
                                       :flex (str (+ (- zone.max zone.min) 1) " 1 0")}}
                               on:click={{:kind :target-zone
                                          :id zone.id}}>{(if (= zone.id state.targetZoneId)
                                                            (str zone.name " target")
                                                            zone.name)}</button>)}
            </div>
            {(for [control (boundary-controls state.zones) :key control.id]
               #html <button type="button"
                             class="boundary-button absolute h-10 w-[18px] -translate-x-1/2 cursor-ew-resize touch-none rounded-full border-2 border-white bg-[#172019] text-white shadow-[0_4px_12px_rgba(23,32,25,0.22)]"
                             role="slider"
                             data-testid={(str "boundary-" control.id)}
                             aria-label={(str control.name " upper boundary")}
                             aria-valuemin={control.min}
                             aria-valuemax={control.nextMax}
                             aria-valuenow={control.max}
                             style={{:left (str control.leftPercent "%")
                                     :top "-4px"}}
                             on:pointerdown={(Event.prevent {:kind :zone-boundary-drag-start
                                                             :index control.index
                                                             :clientX event.clientX})}
                             on:keydown={{:kind :zone-boundary-key
                                          :index control.index
                                          :key event.key}}>
                       <span class="absolute top-[42px] left-1/2 min-w-[34px] -translate-x-1/2 text-center text-[0.72rem] font-extrabold text-[#617066]">{control.max}</span>
                     </button>)}
          </div>
          <div class="sr-only">
            {(for [zone state.zones :key zone.id]
             #html <div>
                      <span data-testid={(str "zone-" zone.id "-min")}>{zone.min}</span>
                      <span data-testid={(str "zone-" zone.id "-max")}>{zone.max}</span>
                    </div>)}
          </div>
        </section>)

(defn live-pane [state]
  (let [zone-stats (zone-display-stats (live-stats-entry state))]
    #html <section class="live-pane" data-testid="live-pane">
            <div class={(str "heart-chart-wrap mt-5 w-full aspect-[16/9] min-h-[360px] "
                             (if state.mobile? "!mt-2" ""))}>
              <canvas ref="live-heart-chart"
                      class="heart-chart block h-full w-full rounded-lg border border-[#dbe2dc] bg-[#fffdfa]"
                      data-testid="live-heart-chart"
                      aria-label="Heart rate line chart"></canvas>
            </div>
            {(zone-time-stats zone-stats state.mobile?)}
            {(zones-pane state)}
          </section>))

(def empty-workout-entry
  {:id ""
   :startedAt 0
   :stoppedAt 0
   :durationMs 0
   :readings []
   :targetZoneId 0
   :zones []
   :exerciseType nil
   :hiddenAt nil})

(defn selected-log-present? [entry]
  (match entry
    (some selected-entry) true
    nil false))

(defn selected-log-value [entry]
  (match entry
    (some selected-entry) selected-entry
    nil empty-workout-entry))

(defn display-stats-entry [detail-view entries selected-log-id display-elapsed-ms readings target-zone-id zones active-exercise-type]
  (if (= detail-view "log")
      (selected-log-value (selected-log entries selected-log-id))
      (live-stats-entry-from display-elapsed-ms
                             readings
                             target-zone-id
                             zones
                             active-exercise-type)))

(defn summary-stat-grid [state]
  (let [entry (display-stats-entry state.detailView
                                   state.entries
                                   state.selectedLogId
                                   state.displayElapsedMs
                                   state.readings
                                   state.targetZoneId
                                   state.zones
                                   state.activeExerciseType)]
    #html <div class={(str "grid grid-cols-4 gap-2 "
                           (if state.mobile? "!w-full !grid-cols-4 !gap-1" ""))}
               data-testid="summary-stats">
            {(summary-stat-tile state "Time" (duration-label entry.durationMs))}
            {(summary-stat-tile state "Min HR" (stat-value (min-bpm entry.readings)))}
            {(summary-stat-tile state "Avg HR" (stat-value (average-bpm entry.readings)))}
            {(summary-stat-tile state "Max HR" (stat-value (max-bpm entry.readings)))}
          </div>))

(defn exercise-type-options [list-id types]
  #html <datalist id={list-id}>
          {(for [kind types :key kind]
             #html <option value={kind}></option>)}
        </datalist>)

(defn type-editor-form [state types]
  #html <div class="type-form grid gap-2" data-testid="type-editor">
          <label class="text-[0.78rem] font-bold text-[#617066]" for="exercise-type-options">Exercise type</label>
          <div class="flex items-center gap-2">
            <input id="exercise-type-options"
                  data-testid="type-draft"
                  class="min-h-9 min-w-0 flex-1 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] px-3 text-[0.9rem] font-semibold text-[#172019] outline-none focus:border-[#d9184b]/45"
                  list="exercise-type-options-list"
                  type="text"
                  value={state.typeDraft}
                  placeholder="Select or enter type"
                  on:input={{:kind :edit-type-draft
                             :text event.currentTarget.value}}
                  on:keydown={(if (= event.key "Enter")
                                  (Event.prevent {:kind :type-draft-key
                                                  :key event.key})
                                  {:kind :type-draft-key
                                   :key event.key})}></input>
            <button type="button"
                    class={(str primary-button-class " type-save !min-h-9 !shrink-0 !px-3 !text-[0.82rem]")}
                    on:click={{:kind :save-type}}>Save</button>
          </div>
          {(exercise-type-options "exercise-type-options-list" types)}
        </div>)

(defn type-picker-form [state types]
  #html <div class="type-form type-picker grid gap-2 rounded-lg border border-[#dbe2dc] bg-white p-3" data-testid="type-picker">
          <label class="text-[0.78rem] font-bold text-[#617066]" for="exercise-type-picker-options">Exercise type</label>
          <div class="flex items-center gap-2">
            <input ref={type-picker-ref}
                   id="exercise-type-picker-options"
                   data-testid="type-picker-input"
                   class="min-h-9 min-w-0 flex-1 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] px-3 text-[0.9rem] font-semibold text-[#172019] outline-none focus:border-[#d9184b]/45"
                   list="exercise-type-picker-options-list"
                   type="text"
                   value={state.typePickerDraft}
                   placeholder="Select or enter type"
                   on:input={{:kind :type-picker-draft
                              :text event.currentTarget.value}}
                   on:keydown={(if (= event.key "Enter")
                                   (Event.prevent {:kind :type-picker-key
                                                   :key event.key})
                                   {:kind :type-picker-key
                                    :key event.key})}></input>
            <button type="button"
                    class={(str primary-button-class " type-save !min-h-9 !shrink-0 !px-3 !text-[0.82rem]")}
                    data-testid="type-picker-save"
                    on:click={{:kind :confirm-type-picker}}>Save</button>
            <button type="button"
                    class={(str secondary-button-class " type-skip !min-h-9 !shrink-0 !px-3 !text-[0.82rem]")}
                    data-testid="type-picker-skip"
                    on:click={{:kind :skip-type-picker}}>Skip</button>
          </div>
          {(exercise-type-options "exercise-type-picker-options-list" types)}
        </div>)

(defn log-pane [state]
  (let [entries (filtered-log state.entries state.logTypeFilter)
        visible-count (count (newest-first state.entries))
        types (exercise-types state.entries)
        entry (selected-log state.entries state.selectedLogId)
        selected-entry (selected-log-value entry)
        selected-zone-stats (zone-display-stats selected-entry)
        has-selected-entry? (selected-log-present? entry)]
    #html <section class="log-pane grid grid-cols-[minmax(180px,260px)_1fr] gap-3 max-[940px]:grid-cols-1 max-[820px]:gap-2"
                   data-testid="log-pane"
                   data-count={count entries}
                   data-filter={state.logTypeFilter}>
            <input ref="import-file"
                   class="file-input absolute h-px w-px opacity-0 pointer-events-none"
                   type="file"
                   accept="application/json,.json"
                   on:change={{:kind :read-import}}></input>
            <div class="flex min-h-[220px] flex-col rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] p-2">
              <label class="mb-2 grid gap-1">
                <span class="text-[0.72rem] font-bold uppercase tracking-[0.04em] text-[#617066]">Filter by type</span>
                <select data-testid="log-type-filter"
                        class="min-h-9 rounded-lg border border-[#dbe2dc] bg-white px-2.5 text-[0.85rem] font-bold text-[#172019]"
                        value={state.logTypeFilter}
                        on:change={{:kind :filter-log-type
                                    :value event.currentTarget.value}}>
                  <option value={all-types-filter}>All types</option>
                  <option value={untyped-filter}>Untyped</option>
                  {(for [kind types :key kind]
                     #html <option value={kind}>{kind}</option>)}
                </select>
              </label>
              {(if (> (count entries) 0)
                  #html <div class="log-list grid gap-1.5" data-testid="log-list">
                          {(for [item entries :key item.id]
                             #html <button type="button"
                                           class={(str "log-row rounded-md border px-3 py-2 text-left "
                                                       (if (match state.selectedLogId
                                                             (some selected-id) (= item.id selected-id)
                                                             nil false)
                                                           "border-[#d9184b]/35 bg-white text-[#172019]"
                                                           "border-transparent text-[#617066] hover:bg-white"))}
                                           data-testid={(str "log-row-" item.id)}
                                           data-type={(entry-type-label item)}
                                           data-selected={(= item.id state.selectedLogId)}
                                           on:click={{:kind :select-log
                                                      :id item.id}}>
                                     <span class="block text-[0.9rem] font-extrabold">{(date-label item.startedAt)}</span>
                                     <span class="block text-[0.78rem] font-bold">{(str (duration-label item.durationMs)
                                                                                         " - "
                                                                                         (count item.readings)
                                                                                         " readings"
                                                                                         (if (some? item.exerciseType)
                                                                                             (str " - " item.exerciseType)
                                                                                             ""))}</span>
                                   </button>)}
                        </div>
                  #html <article class="empty-state compact rounded-lg border border-[#dbe2dc] bg-white p-3.5" data-testid="empty-filtered-log">
                          <h3 class="m-0 text-[1.05rem] font-extrabold">{(if (> visible-count 0) "No matching workouts" "No workouts yet")}</h3>
                          <p class="m-0 mt-2 text-sm font-semibold text-[#596a60]">{(if (> visible-count 0)
                                                                                        "No exercises match this type filter."
                                                                                        "Start a session or import an HRWeb log.")}</p>
                        </article>)}
              <div class="mt-auto grid grid-cols-3 gap-2 border-t border-[#dbe2dc] pt-2">
                <button type="button"
                        class={(str secondary-button-class " !min-h-9 !px-2 !text-[0.82rem]")}
                        disabled={(= (count (visible-log state.entries)) 0)}
                        on:click={{:kind :export-log}}>Export</button>
                <button type="button"
                        class={(str secondary-button-class " !min-h-9 !px-2 !text-[0.82rem]")}
                        on:click={{:kind :open-import}}>Import</button>
                <button type="button"
                        class={(str secondary-button-class " relative !min-h-9 overflow-hidden !px-2 !text-[0.82rem] "
                                    (if (> state.deleteHoldProgress 0)
                                        "border-[#d9184b]/45 text-[#d9184b]"
                                        ""))}
                        data-testid="delete-log"
                        data-holding={state.deleteHold?}
                        disabled={not has-selected-entry?}
                        on:pointerdown={(Event.prevent {:kind :delete-hold-start})}
                        on:pointerup={{:kind :delete-hold-cancel}}
                        on:pointerleave={{:kind :delete-hold-cancel}}
                        on:pointercancel={{:kind :delete-hold-cancel}}
                        on:keydown={(if (hold-key? event.key)
                                      (Event.prevent {:kind :delete-hold-key-down
                                                      :key event.key})
                                      {:kind :delete-hold-key-down
                                       :key event.key})}
                        on:keyup={{:kind :delete-hold-key-up
                                    :key event.key}}>
                  <span class="absolute inset-y-0 left-0 bg-[#d9184b]/12"
                        style={{:width (progress-width state.deleteHoldProgress)}}></span>
                  <span class="relative">{(if state.deleteHold? "Hold" "Delete")}</span>
                </button>
              </div>
            </div>
            <div class="min-w-0">
              {(if has-selected-entry?
                  #html <article class="log-detail min-w-0" data-testid="log-detail">
                          {(if (selected-type-picker? state selected-entry)
                               #html <div>{(type-picker-form state types)}</div>
                               #html <div>{(type-editor-form state types)}</div>)}
                          <div class={(str "heart-chart-wrap log-heart-chart-wrap mt-5 w-full aspect-[16/9] min-h-[360px] "
                                           (if state.mobile? "!mt-2" ""))}>
                            <canvas ref="log-heart-chart"
                                    class="heart-chart block h-full w-full rounded-lg border border-[#dbe2dc] bg-[#fffdfa]"
                                    data-testid="log-heart-chart"
                                    aria-label="Heart rate line chart"></canvas>
                          </div>
                          {(zone-time-stats selected-zone-stats state.mobile?)}
                        </article>
                  #html <article class="empty-state rounded-lg border border-[#dbe2dc] bg-white p-3.5" data-testid="empty-log">
                          <h3 class="m-0 text-[1.05rem] font-extrabold">No workouts yet</h3>
                          <p class="m-0 mt-2 text-sm font-semibold text-[#596a60]">Start a session or import an HRWeb log.</p>
                        </article>)}
            </div>
            <p class={(import-status-class state.importStatus)} data-testid="import-status">{state.importStatus}</p>
          </section>))

(defn workout-count-label [count]
  (str count (if (= count 1) " workout" " workouts")))

(defn metric-card [group-type id title caption points suffix mobile?]
  #html <article class="metric-summary min-w-0" data-metric={id}>
          <div class="mb-2">
            <p class="m-0 text-[0.82rem] font-extrabold uppercase tracking-[0.03em] text-[#617066]">{title}</p>
            <p class="m-0 mt-0.5 text-[0.78rem] font-semibold text-[#617066]">{caption}</p>
          </div>
          <div class={(str "metric-chart-wrap aspect-[16/7] w-full min-w-0 max-w-full "
                           (if mobile? "" "min-h-[220px]"))}>
            <canvas ref={(metric-chart-ref group-type id)}
                    class="metric-chart block h-full w-full min-w-0 max-w-full rounded-lg border border-[#dbe2dc] bg-[#fffdfa]"
                    data-testid={(metric-chart-ref group-type id)}
                    width="520"
                    height="220"
                    aria-label={(str title " chart")}></canvas>
          </div>
        </article>)

(defn metric-group-card [state group]
  (let [enabled (get-metrics-for-type group.type)
        zone2-points (build-zone2-trend group.entries state.metricsGrouping)
        hrr-points (build-hrr-trend group.entries state.metricsGrouping)
        trimp-points (build-trimp-bars group.entries 20)]
    #html <section class="metric-group min-w-0 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] p-4"
                   data-testid={(str "metric-group-" group.type)}
                   data-type={group.type}
                   data-count={(count group.entries)}>
            <div class="metric-group-head mb-3 flex flex-wrap items-baseline justify-between gap-2">
              <h3 class="m-0 text-[1.05rem] font-extrabold text-[#172019]">{group.type}</h3>
              <span class="text-[0.78rem] font-bold text-[#617066]">{(workout-count-label (count group.entries))}</span>
            </div>
            <div class="metric-summary-grid grid gap-4">
              {(if (metric-enabled? enabled "zone2")
                   #html <div class="metric-slot min-w-0">
                           {(metric-card group.type
                                         "zone2"
                                         "Zone 2 adherence"
                                         "Share of session time in Zone 2 - aerobic base expansion"
                                         zone2-points
                                         "%"
                                         state.mobile?)}
                         </div>
                   #html <div class="metric-slot metric-placeholder hidden"></div>)}
              {(if (metric-enabled? enabled "hrr")
                   #html <div class="metric-slot min-w-0">
                           {(metric-card group.type
                                         "hrr"
                                         "HRR 1 min"
                                         "Peak HR minus HR one minute later - parasympathetic recovery"
                                         hrr-points
                                         " bpm"
                                         state.mobile?)}
                         </div>
                   #html <div class="metric-slot metric-placeholder hidden"></div>)}
              {(if (metric-enabled? enabled "trimp")
                   #html <div class="metric-slot min-w-0">
                           {(metric-card group.type
                                         "trimp"
                                         "Training load (TRIMP)"
                                         "Cumulative stress: time in each zone x zone coefficient"
                                         trimp-points
                                         ""
                                         state.mobile?)}
                         </div>
                   #html <div class="metric-slot metric-placeholder hidden"></div>)}
            </div>
          </section>))

(defn metrics-pane [state]
  (let [groups (group-entries-by-type (visible-log state.entries))]
    #html <section class="metrics-pane min-w-0 space-y-4"
                   data-testid="metrics-pane"
                   data-grouping={state.metricsGrouping}
                   data-count={(count groups)}>
            <div class="section-head flex flex-wrap items-center justify-between gap-3">
              <p class="m-0 text-[0.95rem] font-extrabold text-[#172019]">Metrics by exercise type</p>
              <label class="select-field grid gap-1">
                <span class="text-[0.72rem] font-bold uppercase text-[#617066]">Trend grouping</span>
                <select data-testid="metrics-grouping"
                        class="min-h-9 rounded-lg border border-[#dbe2dc] bg-white px-2.5 text-[0.85rem] font-bold text-[#172019]"
                        value={state.metricsGrouping}
                        on:change={{:kind :metrics-grouping
                                    :value event.currentTarget.value}}>
                  <option value="week">By week</option>
                  <option value="month">By month</option>
                </select>
              </label>
            </div>
            {(if (> (count groups) 0)
                #html <div class="metric-groups space-y-4">
                        {(for [group groups :key group.type]
                           #html <div>{(metric-group-card state group)}</div>)}
                      </div>
                #html <p class="empty-state m-0 rounded-lg border border-[#dbe2dc] bg-[#fbfcfb] p-4 text-sm font-semibold text-[#617066]">
                        Complete a workout and assign an exercise type to see metrics.
                      </p>)}
          </section>))

(defn detail-content-class [state]
  (str "workspace-content mt-5 min-h-[617px] min-w-0 "
       (if state.mobile? "!mt-2 !min-h-[520px]" "")))

(defn metrics-content-class [state]
  (str (detail-content-class state)
       (if state.mobile?
           " overflow-x-hidden"
           " max-h-[617px] overflow-y-auto")))

(defn detail-pane [state]
  #html <div class={(if (= state.detailView "metrics")
                        (metrics-content-class state)
                        (detail-content-class state))}
              data-testid={(if (= state.detailView "metrics")
                              "metrics-content"
                              "detail-content")}>
          {(if (= state.detailView "live")
              (live-pane state)
              (if (= state.detailView "metrics")
                  (metrics-pane state)
                  (log-pane state)))}
        </div>)

(defn view [state]
  #html <div class="min-h-screen bg-[radial-gradient(circle_at_top_left,rgba(217,24,75,0.13),transparent_30rem),linear-gradient(145deg,#f6f7f4_0%,#eef4f2_45%,#faf7f2_100%)] text-[#172019]"
             data-testid="hrweb-app"
             data-state={state.exerciseState}
             data-status={state.statusMode}
             data-message={state.message}
             data-mobile={state.mobile?}>
          <main class={(str "dashboard mx-auto grid w-[min(1180px,calc(100vw-32px))] grid-cols-[minmax(300px,390px)_1fr] gap-[18px] py-8 max-[820px]:grid-cols-1 max-[820px]:py-[18px] "
                            (if state.mobile? "!w-[calc(100vw-14px)] !gap-2 !py-2" ""))}>
            {(monitor-card state)}
            <section class={(str card-class " workspace min-w-0 p-[22px] "
                                 (if state.mobile? "!p-[8px_8px_10px]" ""))} aria-labelledby="chart-title">
              <div class={(str "topbar flex items-start justify-between gap-4 "
                               (if state.mobile? "!block" ""))}
                   data-testid="workspace-topbar">
                {(if state.mobile?
                     #html <div class="hidden"></div>
                     #html <div>{(desktop-tab-strip state)}</div>)}
                {(summary-stat-grid state)}
              </div>
              {(if state.mobile?
                   #html <div>{(mobile-tab-strip state)}</div>
                   #html <div class="hidden"></div>)}
              {(detail-pane state)}
            </section>
          </main>
        </div>)
