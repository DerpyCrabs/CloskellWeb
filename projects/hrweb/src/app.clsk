    {:kind :save-type}
    {:kind :delete-hold-start}
    {:kind :delete-hold-key-down :key String}
    {:kind :delete-hold-key-up :key String}
    {:kind :delete-hold-started :timestamp Number}
    {:kind :delete-hold-frame :id String :timestamp Number :value Number}
    {:kind :delete-hold-cancel}
    {:kind :delete-hold-cancelled}
    {:kind :delete-hold-complete}
    {:kind :delete-selected-at :timestamp Number}
    {:kind :log-saved}
    {:kind :log-save-failed :error String}
    {:kind :open-import}
