(import "./domain.clsk" [initial-state])
(import "./zones.clsk" [default-zone-state])
(import "./model.clsk" [HeartReading HeartZone WorkoutEntry MonitorInfo JsonPayload HeartChartRect WindowEventPayload AppState])
(import "./messages.clsk" [AppMsg InitResult UpdateResult])
(import "./features/shared/workflow.clsk" [startup-command active-chart-batch])
(import "./ui-effects.clsk" [no-cmd])
(import "./features/shell/index.clsk" [(try-shell-update as shell-update) (shell-subscriptions as shell-subs) (view as app-view) (desktop-tab-strip as app-desktop-tab-strip)])
(import "./features/session/index.clsk" [(try-session-update as session-update) (monitor-card as app-monitor-card)])
(import "./features/zones/index.clsk" [(try-zones-update as zones-update) (zones-subscriptions as zones-subs)])
(import "./features/logbook/index.clsk" [(try-logbook-update as logbook-update)])
(import "./features/metrics/index.clsk" [(try-metrics-update as metrics-update)])

(ann init (Fn [] InitResult))
(ann update (Fn [AppState AppMsg] UpdateResult))
(ann subscriptions (Fn [AppState] (Sub AppMsg)))
(ann view (Fn [AppState] Html))

(defn init []
  (let [dev? (env-dev?)
        state (merge initial-state
                     {:dev? dev?
                      :zones default-zone-state.zones
                      :targetZoneId default-zone-state.targetZoneId})]
    [state
      (Cmd.batch [(startup-command)
                  (active-chart-batch state)])]))

(defn subscriptions [state]
  (Sub.batch
    [(shell-subs state)
     (zones-subs state)]))

(defn update [state msg]
  (match (shell-update state msg)
    (some result) result
    nil (match (session-update state msg)
          (some result) result
          nil (match (zones-update state msg)
                (some result) result
                nil (match (logbook-update state msg)
                      (some result) result
                      nil (match (metrics-update state msg)
                            (some result) result
                            nil (no-cmd state)))))))

(defn desktop-tab-strip [state]
  (app-desktop-tab-strip state))

(defn monitor-card [state]
  (app-monitor-card state))

(defn view [state]
  (app-view state))
