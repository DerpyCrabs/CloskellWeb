(ann startup-command (Fn [Bool] (Cmd AppMsg)))
(defn startup-command [dev?]
  {:kind :batch
   :commands [{:kind :storage/get
               :key zones-storage-key
               :format :json
               :toMessage msg-zones-loaded
               :onError :zones-load-failed}
              {:kind :storage/get
               :key exercise-log-storage-key
               :format :json
               :toMessage msg-log-loaded
               :onError :log-load-failed}
              {:kind :media-query/watch
               :id "mobile"
               :query "(max-width: 700px)"
               :onChange :media-changed}
              (if dev?
                  {:kind :window/event-watch
                   :id "dev-hotkey"
                   :type "keydown"
                   :preventDefault {:key "h"
                                    :ctrlKey true
                                    :shiftKey true
                                    :altKey false
                                    :metaKey false}
                   :onEvent :dev-key}
                  {:kind :none})]})

(ann active-chart-command (Fn [AppState] (Cmd AppMsg)))
(defn active-chart-command [state]
  {:kind :batch
   :commands [(heart-chart-command state)
              (metric-chart-command state)]})

(ann active-chart-batch (Fn [AppState] (Cmd AppMsg)))
(defn active-chart-batch [state]
  {:kind :batch
   :commands [(heart-chart-batch state)
              (metric-chart-batch state)]})

(ann with-active-chart-command (Fn [AppState (Cmd AppMsg)] (Cmd AppMsg)))
(defn with-active-chart-command [state command]
  {:kind :batch
   :commands [command
              (active-chart-command state)]})

(defn init []
  (let [dev? (env-dev?)
        state (merge initial-state
                     {:dev? dev?
                      :zones default-zone-state.zones
                      :targetZoneId default-zone-state.targetZoneId})]
    [state
     {:kind :batch
      :commands [(startup-command dev?)
                 (active-chart-batch state)]}]))

(ann command-none (Fn [] (Cmd AppMsg)))
(defn command-none []
  {:kind :none})

(defn set-status [state status message mode]
  (merge state
         {:appStatus status
          :message message
          :statusMode mode}))

(defn reading [bpm elapsed-ms]
  {:bpm (round bpm)
   :time (max 0 (round elapsed-ms))})

(defn trend-label [last-rate bpm]
  (if (some? last-rate)
      (let [delta (- bpm last-rate)]
        (if (= delta 0)
            "Recording"
            (if (> delta 0)
                (str (abs delta) " bpm up")
                (str (abs delta) " bpm down"))))
      "Recording"))

(defn idle-elapsed [state timestamp]
  (match state.idleStartedAt
    (some started-at) (max 0 (- timestamp started-at))
    nil state.elapsedMs))

(defn live-elapsed [state timestamp]
  (if (= state.exerciseState "running")
      (current-elapsed state timestamp)
      (if (= state.exerciseState "idle")
          (idle-elapsed state timestamp)
          state.elapsedMs)))

(defn heart-rate-trend [state bpm]
  (if (= state.exerciseState "running")
      (trend-label state.lastRate bpm)
      (if (= state.exerciseState "paused")
          "Paused"
          (if (= state.exerciseState "stopped")
              "Stopped"
              "Idle"))))

(defn append-live-reading? [state]
  (or (= state.exerciseState "running")
      (= state.exerciseState "idle")))

(defn ensure-idle-start [state timestamp]
  (if (and (= state.exerciseState "idle")
           (not (some? state.idleStartedAt)))
      (merge state {:idleStartedAt timestamp})
      state))

(defn add-heart-rate-at [state bpm timestamp]
  (let [rounded (round bpm)
        timed-state (ensure-idle-start state timestamp)
        elapsed (live-elapsed timed-state timestamp)
        next-readings (if (append-live-reading? timed-state)
                          (conj timed-state.readings (reading rounded elapsed))
                          timed-state.readings)]
    (merge timed-state
           {:latestBpm rounded
            :lastRate (if (append-live-reading? timed-state)
                          rounded
                          timed-state.lastRate)
            :trend (heart-rate-trend timed-state rounded)
            :readings next-readings
            :displayElapsedMs elapsed
            :message (zone-label-for-bpm timed-state.zones rounded)})))

(defn clear-idle-live-state [state]
  (if (= state.exerciseState "idle")
      (merge state
             {:idleStartedAt nil
              :displayElapsedMs 0
              :readings []})
      state))

(defn low-zone-bpm [zones]
  (let [zone (nth zones 0)]
    zone.min))

(defn high-zone-bpm [zones]
  (let [zone (last zones)]
    zone.max))

(defn clamp-to-zones [zones bpm]
  (max (low-zone-bpm zones)
       (min (high-zone-bpm zones) bpm)))

(defn target-zone-from-roll [zones roll]
  (nth zones (floor roll)))

(ann log-and-persist-command (Fn [(Vector WorkoutEntry)] (Cmd AppMsg)))
(defn log-and-persist-command [entries]
  {:kind :batch
   :commands [{:kind :timer/cancel
               :id clock-timer-id}
              {:kind :storage/set
               :key exercise-log-storage-key
               :value (log-payload entries)
               :onError :log-save-failed
               :msg (msg-log-saved)}]})

(ann persist-zone-command (Fn [(Vector HeartZone) Number] (Cmd AppMsg)))
(defn persist-zone-command [zones target-zone-id]
  {:kind :storage/set
   :key zones-storage-key
   :value (zone-state-payload zones target-zone-id)
   :onError :zones-save-failed
   :msg (msg-zones-saved)})

(ann persist-zone-silent-command (Fn [(Vector HeartZone) Number] (Cmd AppMsg)))
(defn persist-zone-silent-command [zones target-zone-id]
  {:kind :storage/set
   :key zones-storage-key
   :value (zone-state-payload zones target-zone-id)
   :onError :zones-save-failed})

(ann persist-log-command (Fn [(Vector WorkoutEntry)] (Cmd AppMsg)))
(defn persist-log-command [entries]
  {:kind :storage/set
   :key exercise-log-storage-key
   :value (log-payload entries)
   :onError :log-save-failed
   :msg (msg-log-saved)})

(ann clock-command (Fn [] (Cmd AppMsg)))
(defn clock-command []
  {:kind :timer/every
   :id clock-timer-id
   :ms 250
   :msg (msg-clock-tick)})

(ann cancel-clock-command (Fn [] (Cmd AppMsg)))
(defn cancel-clock-command []
  {:kind :timer/cancel
   :id clock-timer-id})

(ann stop-connections-command (Fn [] (Cmd AppMsg)))
(defn stop-connections-command []
  {:kind :batch
   :commands [{:kind :simulation/stop
                :id simulated-monitor-id}
              (cancel-clock-command)
              {:kind :bluetooth/disconnect
                :id "hrm"
                :msg (msg-monitor-disconnected)}]})

(defn connected-off-state [state]
  (clear-idle-live-state
    (merge state
           {:connected? false
            :simulated? false
            :deviceName ""})))

(defn disconnected-status-state [state]
  (set-status
    (connected-off-state state)
    "Disconnected"
    "Monitor disconnected"
    "warn"))

(defn pause-for-disconnect-state [state timestamp]
  (let [elapsed (current-elapsed state timestamp)]
    (disconnected-status-state
      (merge state
             {:exerciseState "paused"
              :elapsedMs elapsed
              :displayElapsedMs elapsed
              :startedAt nil
              :trend "Paused"}))))

(ann disconnect-monitor-command (Fn [AppState] (Cmd AppMsg)))
(defn disconnect-monitor-command [state]
  (if (= state.exerciseState "running")
      {:kind :time/now
       :toMessage msg-disconnect-paused-at}
      (stop-connections-command)))

