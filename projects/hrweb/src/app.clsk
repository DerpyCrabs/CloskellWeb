    {:kind :read-import}
    {:kind :log-imported :payload JsonPayload}
    {:kind :import-cancelled}
    {:kind :import-failed :error String}
    {:kind :export-log}
    {:kind :export-log-at :timestamp Number}
    {:kind :export-failed :error String}
    {:kind :exported}))

