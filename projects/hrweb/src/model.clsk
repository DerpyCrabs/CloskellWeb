(type HeartReading
  {:bpm Number
   :time Number})

(type HeartZone
  {:id Number
   :name String
   :min Number
   :max Number
   :color String})

(type WorkoutEntry
  {:id String
   :startedAt Number
   :stoppedAt Number
   :durationMs Number
   :readings (Vector HeartReading)
   :targetZoneId Number
   :zones (Vector HeartZone)
   :exerciseType (Option String)
   :hiddenAt (Option Number)})

(type MonitorInfo
  {:id String
   :deviceName String
   :connected Bool})

(type JsonPayload {})

(type HeartChartRect
  {:x Number
   :y Number
   :width Number
   :height Number
   :top Number
   :right Number
   :bottom Number
   :left Number})

(type WindowEventPayload
  {:type String
   :clientX Number
   :clientY Number
   :pageX Number
   :pageY Number
   :screenX Number
   :screenY Number
   :movementX Number
   :movementY Number
   :button Number
   :buttons Number
   :pointerId Number
   :pointerType String
   :isPrimary Bool
   :key String
   :code String
   :altKey Bool
   :ctrlKey Bool
   :metaKey Bool
   :shiftKey Bool})

(type AppState
  {:appStatus String
   :message String
   :statusMode String
   :dev? Bool
   :mobile? Bool
   :detailView String
   :exerciseState String
   :connected? Bool
   :simulated? Bool
   :deviceName String
   :elapsedMs Number
    :displayElapsedMs Number
    :startedAt (Option Number)
    :sessionStartedAt (Option Number)
    :idleStartedAt (Option Number)
    :pendingStoppedAt (Option Number)
   :latestBpm Number
   :lastRate (Option Number)
   :trend String
   :readings (Vector HeartReading)
   :entries (Vector WorkoutEntry)
   :selectedLogId (Option String)
   :logTypeFilter String
   :targetZoneId Number
   :zones (Vector HeartZone)
   :activeExerciseType String
   :typeDraft String
   :typePickerEntryId (Option String)
   :typePickerDraft String
   :stopHold? Bool
   :stopHoldStartedAt Number
   :stopHoldProgress Number
   :deleteHold? Bool
   :deleteHoldStartedAt Number
   :deleteHoldProgress Number
   :chartWidth Number
   :chartHeight Number
   :zoneTrackLeft Number
   :zoneTrackWidth Number
   :zoneDragIndex (Option Number)
   :zoneStatus String
   :importStatus String
   :metricsGrouping String})
