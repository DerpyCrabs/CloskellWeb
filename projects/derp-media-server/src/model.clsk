(type LoginPayload
  {:success (Option Bool)
   :error (Option String)})

(type LoginResponse
  {:ok Bool
   :status Number
   :body LoginPayload})

(type AuthResponse
  {:ok Bool
   :status Number
   :body AuthConfig})

(type SettingsResponse
  {:ok Bool
   :status Number
   :body GlobalSettings})

(type FilesPayload
  {:files (Vector FileItem)})

(type FilesResponse
  {:ok Bool
   :status Number
   :body FilesPayload})

(type SharesPayload
  {:shares (Vector ShareLink)})

(type SharesResponse
  {:ok Bool
   :status Number
   :body SharesPayload})

(type ShareInfo
  {:name String
   :path (Option String)
   :isDirectory Bool
   :editable Bool
   :mediaType String
   :extension String
   :editable Bool
   :restrictions (Option ShareRestrictions)
   :needsPasscode Bool
   :authorized Bool
   :adminViewMode (Option String)
   :workspaceTaskbarPins (Option (Vector WorkspaceTaskbarPin))
   :workspaceLayoutPresets (Option (Vector WorkspaceLayoutPreset))})

(type ShareInfoResponse
  {:ok Bool
   :status Number
   :body ShareInfo})

(type BasicPayload
  {:success (Option Bool)
   :error (Option String)
   :message (Option String)
   :favorites (Option (Vector String))
   :knowledgeBases (Option (Vector String))
   :viewCount (Option Number)
   :uploaded (Option Number)
   :path (Option String)
   :fileName (Option String)
   :workspaceLayoutPresets (Option (Vector WorkspaceLayoutPreset))})

(type BasicResponse
  {:ok Bool
   :status Number
   :body BasicPayload})

(type ViewStatsPayload
  {:views (Map String Number)
   :shareViews (Map String Number)})

(type ViewStatsResponse
  {:ok Bool
   :status Number
   :body ViewStatsPayload})

(type AudioMetadataPayload
  {:duration (Option Number)
   :title (Option String)
   :artist (Option String)
   :coverArt (Option String)
   :error (Option String)})

(type AudioMetadataResponse
  {:ok Bool
   :status Number
   :body AudioMetadataPayload})

(type TextResponse
  {:ok Bool
   :status Number
   :body String})
