(import "../lib/types.clsk" [FileItem AuthConfig GlobalSettings ShareLink ShareRestrictions MediaRootSummary WorkspaceLayoutPreset WorkspaceTaskbarPin ViewModesByPath])
(import "./features/workspace/assist-grid.clsk" [AssistGridSpan])
(import "./features/workspace/geometry.clsk" [WorkspaceBounds])
(import "./features/workspace/types.clsk" [WorkspaceState])

(type WindowEventPayload
  {:type String
   :clientX Number
   :clientY Number
   :pageX Number
   :pageY Number
   :screenX Number
   :screenY Number
   :movementX Number
   :movementY Number
   :button Number
   :buttons Number
   :pointerId Number
   :pointerType String
   :isPrimary Bool
   :key String
   :code String
   :altKey Bool
   :ctrlKey Bool
   :metaKey Bool
   :shiftKey Bool})

(type WorkspaceWindowDragSession
  {:groupId String
   :windowId String
   :grabDx Number
   :grabDy Number
   :canvasLeft Number
   :canvasTop Number
   :canvasWidth Number
   :canvasHeight Number
   :clientX Number
   :clientY Number
   :assistActive Bool
   :liveBounds WorkspaceBounds
   :snapSpan (Option AssistGridSpan)})

(type WorkspaceWindowResizeSession
  {:windowId String
   :direction String
   :startX Number
   :startY Number
   :canvasWidth Number
   :canvasHeight Number
   :startBounds WorkspaceBounds})

(type WorkspaceTabDragSession
  {:groupId String
   :tabId String
   :startX Number
   :startY Number
   :canvasLeft Number
   :canvasTop Number
   :canvasWidth Number
   :canvasHeight Number})

(type WorkspaceSplitResizeSession
  {:groupId String
   :groupLeft Number
   :groupWidth Number})

(type RouteState
  {:currentUrl String
   :pathname String
   :search String
   :currentDir String
   :viewingPath (Option String)
   :playingPath (Option String)
   :audioOnly Bool
   :shareToken (Option String)
   :sharePasscodeParam (Option String)})

