(import "../../model.clsk" [AppState])
(import "../../../lib/types.clsk" [FileItem MediaType])
(import "../download.clsk" [fileDownloadHref])
(import "../media-urls.clsk" [buildMediaUrl buildThumbnailUrl])
(import "../media-utils.clsk" [formatFileSize])
(import "../text-editor/views.clsk" [AdminTextViewer])
(import "./state.clsk" [selectedSharePlayingFile
                        selectedFile
                        selectedFileOrEmpty
                        selectedPlayingFile
                        unsupportedSelected?
                        showAdminAudioChrome?
                        adminImageFilesForUpdate
                        adminImageIndexForUpdate
                        imageZoomLabel
                        imageZoomScale
	                        shareFileMediaUrl
	                        shareFileMatchesPath?
	                        shareFileThumbnailUrl])

(def jsDocument (js-global document))

(ann mediaCurrentTime (Fn [String] Number))
(defn mediaCurrentTime [selector]
  (let [el (jsDocument.querySelector selector)
        value (if (some? el) el.currentTime 0)]
    (if (number? value) value 0)))

