(import "../../model.clsk" [AppState])
(import "../../../lib/types.clsk" [FileItem MediaType])
(import "../browser/state.clsk" [cardClass
                                  fileThumbnailTestId
                                  rowClass
                                  showThumbnail?
                                  viewModeButtonClass])
(import "../media-utils.clsk" [formatFileSize])
(import "../media-player/state.clsk" [selectedShareViewingFile
                                      shareFileMediaUrl
                                      shareFileThumbnailUrl])
(import "../text-editor/views.clsk" [ShareTextViewer])

(ann shareViewPathParts (Fn [String] (Vector String)))
(defn shareViewPathParts [path]
  (filter (split (if (string? path) path "") "/") (fn [part] (not (= part "")))))

(ann shareParentDir (Fn [String] String))
(defn shareParentDir [path]
  (let [parts (shareViewPathParts path)]
    (if (<= (count parts) 1)
        ""
        (join (slice parts 0 (- (count parts) 1)) "/"))))

(ann shareCrumbPathAt (Fn [String Number] String))
(defn shareCrumbPathAt [path index]
  (join (slice (shareViewPathParts path) 0 (+ index 1)) "/"))

(ann shareFileIconLabel (Fn [FileItem] String))
(defn shareFileIconLabel [file]
  (if file.isDirectory
      "DIR"
      (if (= file.type MediaType.IMAGE)
          "IMG"
          (if (= file.type MediaType.VIDEO)
              "VID"
              (if (= file.type MediaType.AUDIO)
                  "AUD"
                  (if (= file.type MediaType.PDF)
                      "PDF"
                      (if (= file.type MediaType.TEXT) "TXT" "FILE")))))))

(ann shareFileSubtitle (Fn [FileItem] String))
(defn shareFileSubtitle [file]
  (if file.isDirectory
      "Folder"
      (str (if (= file.extension "") file.type file.extension)
           " - "
           (formatFileSize file.size))))

