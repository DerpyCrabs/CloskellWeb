(import "./source-context.clsk" [normalizeSlashes stripSharePrefix])

(type MediaShareContext
  {:token String
   :sharePath String})

(ann encodeSegments (Fn [String] String))
(defn encodeSegments [path]
  (let [safePath (if (string? path) path "")]
    (join (map (split safePath "/") (fn [segment] (encode-uri-component segment))) "/")))

(ann shareRelativePath (Fn [String String] String))
(defn shareRelativePath [shareBasePath filePath]
  (let [relative (stripSharePrefix filePath (normalizeSlashes shareBasePath))]
    (if (= relative "") "." relative)))

(ann buildAdminMediaUrl (Fn [String] String))
(defn buildAdminMediaUrl [filePath]
  (str "/api/media/" (encodeSegments filePath)))

(ann buildShareMediaUrl (Fn [String String String] String))
(defn buildShareMediaUrl [shareToken shareBasePath filePath]
  (str "/api/share/"
       shareToken
       "/media/"
       (encodeSegments (shareRelativePath shareBasePath filePath))))

(ann buildMediaUrl (Fn [String (Option MediaShareContext)] String))
(defn buildMediaUrl [filePath ctx]
  (match ctx
    (some current) (buildShareMediaUrl current.token current.sharePath filePath)
    nil (buildAdminMediaUrl filePath)))

(ann buildAdminAudioExtractUrl (Fn [String] String))
(defn buildAdminAudioExtractUrl [filePath]
  (str "/api/audio/extract/" filePath))

(ann buildShareAudioExtractUrl (Fn [String String String] String))
