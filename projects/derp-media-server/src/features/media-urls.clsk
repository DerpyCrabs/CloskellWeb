(ann buildAdminThumbnailUrl (Fn [String] String))
(defn buildAdminThumbnailUrl [filePath]
  (str "/api/thumbnail/" (encodeSegments filePath)))

(ann buildShareThumbnailUrl (Fn [String String String] String))
