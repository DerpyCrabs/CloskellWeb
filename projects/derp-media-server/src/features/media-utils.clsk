(def videoExtensions ["mp4" "webm" "ogg" "mov" "avi" "mkv" "m4v"])
(def audioExtensions ["mp3" "wav" "ogg" "m4a" "flac" "aac" "opus"])
(def imageExtensions ["jpg" "jpeg" "png" "gif" "webp" "bmp" "svg" "ico"])
(def pdfExtensions ["pdf"])
(def textExtensions ["txt"
                     "md"
                     "json"
                     "xml"
                     "csv"
                     "log"
                     "yaml"
                     "yml"
                     "ini"
                     "conf"
                     "sh"
                     "bat"
                     "ps1"
                     "js"
                     "ts"
                     "jsx"
                     "tsx"
                     "css"
                     "scss"
                     "html"
                     "py"
                     "java"
                     "c"
                     "cpp"
                     "h"
                     "cs"
                     "go"
                     "rs"
                     "php"
                     "rb"
                     "swift"
                     "kt"
                     "sql"])

(def mimeTypes
  {"mp4" "video/mp4"
   "webm" "video/webm"
   "ogg" "video/ogg"
   "mov" "video/quicktime"
   "avi" "video/x-msvideo"
   "mkv" "video/x-matroska"
   "m4v" "video/x-m4v"
   "mp3" "audio/mpeg"
   "wav" "audio/wav"
   "m4a" "audio/mp4"
   "flac" "audio/flac"
   "aac" "audio/aac"
   "opus" "audio/opus"
   "jpg" "image/jpeg"
   "jpeg" "image/jpeg"
   "png" "image/png"
   "gif" "image/gif"
   "webp" "image/webp"
   "bmp" "image/bmp"
   "svg" "image/svg+xml"
   "ico" "image/x-icon"
   "pdf" "application/pdf"
   "txt" "text/plain"
   "md" "text/markdown"
   "json" "application/json"
   "xml" "application/xml"
   "csv" "text/csv"
   "log" "text/plain"
   "yaml" "text/yaml"
   "yml" "text/yaml"
   "ini" "text/plain"
   "conf" "text/plain"
   "sh" "text/x-shellscript"
   "bat" "text/plain"
   "ps1" "text/plain"
   "js" "text/javascript"
   "ts" "text/typescript"
   "jsx" "text/javascript"
   "tsx" "text/typescript"
   "css" "text/css"
   "scss" "text/x-scss"
   "html" "text/html"
   "py" "text/x-python"
   "java" "text/x-java"
   "c" "text/x-c"
   "cpp" "text/x-c++"
   "h" "text/x-c"
   "cs" "text/x-csharp"
   "go" "text/x-go"
   "rs" "text/x-rust"
   "php" "text/x-php"
   "rb" "text/x-ruby"
   "swift" "text/x-swift"
   "kt" "text/x-kotlin"
   "sql" "text/x-sql"})

(def kib 1024)
(def mib (* kib kib))
(def gib (* mib kib))
(def tib (* gib kib))

(ann getMediaType (Fn [String] String))
(defn getMediaType [extension]
  (let [ext (lower-case (if (string? extension) extension ""))]
    (if (includes? videoExtensions ext)
        "video"
        (if (includes? audioExtensions ext)
            "audio"
            (if (includes? imageExtensions ext)
                "image"
                (if (includes? pdfExtensions ext)
                    "pdf"
                    (if (includes? textExtensions ext)
                        "text"
                        "other")))))))

(ann getMimeType (Fn [String] String))
(defn getMimeType [extension]
  (let [mime (object-get mimeTypes (lower-case (if (string? extension) extension "")))]
    (if (string? mime) mime "application/octet-stream")))

(ann fileSizeIndex (Fn [Number] Number))
(defn fileSizeIndex [bytes]
  (if (< bytes kib)
      0
      (if (< bytes mib)
          1
          (if (< bytes gib)
              2
              (if (< bytes tib) 3 4)))))

(ann fileSizeDivisor (Fn [Number] Number))
(defn fileSizeDivisor [index]
  (if (= index 0)
      1
      (if (= index 1)
          kib
          (if (= index 2)
              mib
              (if (= index 3) gib tib)))))

(ann fileSizeUnit (Fn [Number] String))
(defn fileSizeUnit [index]
  (if (= index 0)
      "Bytes"
      (if (= index 1)
          "KB"
          (if (= index 2)
              "MB"
              (if (= index 3) "GB" "TB")))))

(ann formatFileSize (Fn [Number] String))
(defn formatFileSize [bytes]
  (if (= bytes 0)
      "0 Bytes"
      (let [index (fileSizeIndex bytes)
            divisor (fileSizeDivisor index)
            size (/ (round (* (/ bytes divisor) 100)) 100)]
        (str size " " (fileSizeUnit index)))))
