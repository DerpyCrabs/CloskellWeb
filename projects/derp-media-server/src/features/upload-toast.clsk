(ann uploadToastPanelClass (Fn [Js] String))
(defn uploadToastPanelClass [anchor]
  (let [value (if (string? anchor) anchor "viewport")
        pos (if (= value "window") "absolute" "fixed")]
    (str pos
         " bottom-4 right-4 z-50 min-w-[280px] max-w-sm rounded-lg border border-border bg-background shadow-lg p-3 text-foreground")))
