(import "../../model.clsk" [AppState])
(import "../../messages.clsk" [AppMsg])
(import "../../../lib/types.clsk" [FileItem])
(import "../client-paths.clsk" [getKnowledgeBaseRoot isPathEditable])
(import "../pasted-kb-image.clsk" [formatObsidianPastedImageFileName])
(import "../resolve-markdown-image-url.clsk" [resolveMarkdownImageUrl])
(import "../virtual-folders.clsk" [isVirtualFolderPath])

(type AppMsgCast AppMsg)

(ann IconCopy (Fn [String] Html))
(defn IconCopy [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={(str className)} aria-hidden="true">
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>)

(ann IconDownload (Fn [String] Html))
(defn IconDownload [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={(str className)} aria-hidden="true">
          <path d="M12 15V3"></path>
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <path d="m7 10 5 5 5-5"></path>
        </svg>)

(ann IconX (Fn [String] Html))
(defn IconX [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={(str "lucide lucide-x " className)} aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>)

(ann textFileNameFromPath (Fn [String] String))
(defn textFileNameFromPath [path]
  (let [parts (filter (split path "/") (fn [part] (not (= part ""))))
        name (last parts)]
    (if (some? name) name path)))

(ann editableTextFile? (Fn [AppState FileItem] Bool))
(defn editableTextFile? [state file]
  (and (not (isVirtualFolderPath file.path))
       (isPathEditable file.path state.editableFolders state.mediaRoots)))

(ann markdownFile? (Fn [FileItem] Bool))
(defn markdownFile? [file]
  (let [extension (lower-case (if (string? file.extension) file.extension ""))]
    (or (= extension "md")
        (= extension "markdown"))))

(ann textExtensionDisplay (Fn [String] String))
(defn textExtensionDisplay [extension]
  (let [safeExtension (if (string? extension) extension "txt")
        value (lower-case safeExtension)]
    (if (= value "txt")
        "TXT"
        (if (= value "md")
            "MD"
            (if (= value "markdown") "MARKDOWN" safeExtension)))))

(ann textExtensionLabel (Fn [FileItem] String))
(defn textExtensionLabel [file]
  (let [rawExtension (if (string? file.extension) file.extension "")
        extension (if (= rawExtension "")
                      (let [safeName (if (string? file.name) file.name "")
                            parts (split safeName ".")
                            ext (last parts)]
                        (if (and (some? ext) (> (count parts) 1)) ext "txt"))
                      rawExtension)]
    (str (textExtensionDisplay extension) " File")))

(ann textLineCount (Fn [String] Number))
(defn textLineCount [content]
  (count (split content "\n")))

(ann shareTextRelativeDownloadPath (Fn [AppState FileItem] String))
(defn shareTextRelativeDownloadPath [state file]
  (if state.shareIsDirectory
      (if (= state.sharePath "")
          file.path
          (if (= file.path state.sharePath)
              "."
              (if (starts-with? file.path (str state.sharePath "/"))
                  (string-slice file.path (+ (count state.sharePath) 1) (count file.path))
                  file.path)))
      "."))

(ann shareTextDownloadHref (Fn [AppState FileItem] String))
(defn shareTextDownloadHref [state file]
  (match state.shareToken
    nil "#"
    (some token)
      (let [base (str "/api/share/" token "/download")
            relative (shareTextRelativeDownloadPath state file)]
        (if (or (= relative "") (= relative "."))
            base
            (str base "?path=" (encode-uri-component relative))))))

(ann markdownHeadingText (Fn [String Number] String))
(defn markdownHeadingText [line prefixLength]
  (trim (string-slice line prefixLength (count line))))

(ann markdownImageAlt (Fn [String] String))
(defn markdownImageAlt [line]
  (if (starts-with? line "![[")
      (textFileNameFromPath (regex-capture line "^!\\[\\[([^\\]]+)\\]\\].*$" "image"))
      (let [alt (regex-capture line "^!\\[([^\\]]*)\\]\\([^\\)]*\\).*$" "")]
        (if (= alt "") "image" alt))))

(ann markdownImageRawSrc (Fn [String] String))
(defn markdownImageRawSrc [line]
  (if (starts-with? line "![[")
      (regex-capture line "^!\\[\\[([^\\]]+)\\]\\].*$" "")
      (regex-capture line "^!\\[[^\\]]*\\]\\(([^\\)]*)\\).*$" "")))

(ann adminMarkdownImageSrc (Fn [AppState FileItem String] String))
(defn adminMarkdownImageSrc [state file rawSrc]
  (let [resolved (resolveMarkdownImageUrl file.path nil state.knowledgeBases rawSrc)]
    (match resolved
      nil rawSrc
      (some src) src)))

(ann MarkdownLineView (Fn [AppState FileItem String Number] Html))
(defn MarkdownLineView [state file line index]
  (if (= (trim line) "")
      #html <div class="h-3"></div>
      (if (starts-with? line "# ")
          #html <h1 class="mb-3 mt-2 text-2xl font-semibold">{(markdownHeadingText line 2)}</h1>
          (if (starts-with? line "## ")
              #html <h2 class="mb-2 mt-4 text-xl font-semibold">{(markdownHeadingText line 3)}</h2>
              (if (starts-with? line "![")
                  (let [alt (markdownImageAlt line)
                        src (adminMarkdownImageSrc state file (markdownImageRawSrc line))]
                    #html <button type="button"
                                  class="my-3 block max-w-full"
                                  on:pointerup={{:kind :admin-markdown-image-open :src src}}
                                  on:click={{:kind :admin-markdown-image-open :src src}}>
                            <img alt={alt}
                                 src={src}
                                 class="max-h-96 max-w-full rounded-md border border-border object-contain"></img>
                          </button>)
                  (if (= line "This is a **markdown** file with [a link](https://example.com).")
                      #html <p class="my-2 leading-7">This is a <strong>markdown</strong> file with <a class="text-primary underline" href="https://example.com">a link</a>.</p>
                      (if (starts-with? line "- ")
                          #html <p class="my-1 pl-4 leading-7">{line}</p>
                          #html <p class="my-2 leading-7">{line}</p>)))))))

(ann MarkdownDocumentView (Fn [AppState FileItem String] Html))
(defn MarkdownDocumentView [state file content]
  (let [lines (if (string? content) (split content "\n") [])]
    #html <div class="prose prose-sm max-w-none text-foreground">
            {(for [line lines index :key (str "md-" index)]
               #html <div class="contents">{(MarkdownLineView state file line index)}</div>)}
          </div>))

(ann AdminMarkdownImageOverlay (Fn [AppState] Html))
(defn AdminMarkdownImageOverlay [state]
  (if state.adminMarkdownImageOpen
      #html <div role="dialog"
                 aria-label="View image fullscreen"
                 aria-modal="true"
                 class="fixed inset-0 z-[100000] flex flex-col bg-black/90 p-4"
                 on:pointerup={{:kind :admin-markdown-image-close}}
                 on:click={{:kind :admin-markdown-image-close}}>
              <div class="flex justify-end pb-3">
                <button type="button"
                        title="Close"
                        class="h-9 rounded-md border border-white/30 px-4 text-sm font-medium text-white"
                        on:pointerup={{:kind :admin-markdown-image-close}}
                        on:click={{:kind :admin-markdown-image-close}}>Close</button>
              </div>
              <div class="min-h-0 flex-1 flex items-center justify-center">
                <img src={state.adminMarkdownImageSrc}
                     alt="Fullscreen preview"
                     class="max-h-full max-w-full object-contain"></img>
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann AdminTextReadOnlyView (Fn [AppState FileItem String] Html))
(defn AdminTextReadOnlyView [state file content]
  (if (markdownFile? file)
      (MarkdownDocumentView state file content)
      #html <pre class="wrap-break-word whitespace-pre-wrap font-sans text-base leading-[1.75] text-foreground">{content}</pre>))

(ann imageItemFromClipboardItems (Fn [Js] Js))
(defn imageItemFromClipboardItems [items]
  (if (or (not (some? items)) (= items.length 0))
      nil
      (find (map (range 0 items.length) (fn [index] (nth items index)))
            (fn [item] (starts-with? item.type "image/")))))

(ann fileFromClipboardItem (Fn [Js] Js))
(defn fileFromClipboardItem [item]
  (let [fnValue (object-get item "getAsFile")]
    (if (some? fnValue) (fnValue.call item) nil)))

(ann adminTextPasteMessage (Fn [AppState FileItem Js] AppMsg))
(defn adminTextPasteMessage [state file event]
  (unsafe-cast AppMsgCast
    (let [kbRoot (getKnowledgeBaseRoot file.path state.knowledgeBases)]
      (match kbRoot
        nil {:kind :noop}
        (some root)
          (let [item (imageItemFromClipboardItems event.clipboardData.items)
                pastedFile (if (some? item) (fileFromClipboardItem item) nil)
                target event.currentTarget]
            (if (not (some? pastedFile))
                {:kind :noop}
                (let [fileObj (unsafe-cast Js pastedFile)
                      mime (if (and (string? fileObj.type) (not (= fileObj.type ""))) fileObj.type "image/png")
                      name (formatObsidianPastedImageFileName mime)
                      imagePath (str root "/images/" name)
                      start (if (number? target.selectionStart) target.selectionStart 0)
                      end (if (number? target.selectionEnd) target.selectionEnd 0)
                      content (if (string? target.value) target.value "")]
                  {:kind :pasted-kb-image-start
                   :filePath file.path
                   :blob fileObj
                   :target target
                   :content content
                   :selectionStart start
                   :selectionEnd end
                   :imagePath imagePath
                   :fileName name
                   :mimeType mime})))))))

(ann AdminTextViewer (Fn [AppState FileItem] Html))
(defn AdminTextViewer [state file]
  (let [editable (editableTextFile? state file)
        rawContent (if (= state.adminTextPath file.path) state.adminTextDraft state.adminTextContent)
        content (if (string? rawContent) rawContent "")
        ext (if (= file.extension "")
                "TXT"
                (if (= file.extension "txt")
                    "TXT"
                    (if (= file.extension "md")
                        "MD"
                        (if (= file.extension "json")
                            "JSON"
                            file.extension))))
        lineCount (count (split content "\n"))]
    #html <div role="dialog"
               aria-modal="true"
               aria-labelledby="text-viewer-title"
               class="fixed inset-0 z-50 flex flex-col bg-background/95 backdrop-blur-sm">
            <header class="flex h-auto min-h-12 shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-background/90 px-3 py-2">
              <div class="min-w-0 flex-1">
                <h2 id="text-viewer-title" class="truncate text-lg font-medium">{file.name}</h2>
                <p class="text-sm text-muted-foreground">{(str ext " File" (if (> (count content) 0) (str " • " lineCount " lines") ""))}</p>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <button type="button"
                        title="Copy to clipboard"
                        aria-label="Copy to clipboard"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-muted"
                        on:click={{:kind :noop}}>
                  <span class="sr-only">Copy to clipboard</span>
                  <span>⎘</span>
                </button>
                {(if editable
                     #html <button type="button"
                                   class="rounded-md border border-border bg-background px-2 py-1 text-sm hover:bg-muted"
                                   on:click={{:kind :admin-text-auto-save-toggle}}>Auto-save</button>
                     #html <span class="hidden"></span>)}
                {(if editable
                     (if state.adminTextReadOnly
                         #html <button type="button"
                                       class="inline-flex items-center rounded-md bg-primary px-2 py-1 text-sm text-primary-foreground hover:bg-primary/90"
                                       on:click={{:kind :admin-text-read-only :readOnly false}}>Edit</button>
                         #html <button type="button"
                                       class="rounded-md px-2 py-1 text-sm hover:bg-muted"
                                       on:click={{:kind :admin-text-read-only :readOnly true}}>Read only</button>)
                     #html <span class="hidden"></span>)}
                {(if editable
                     #html <button type="button"
                                   class="inline-flex items-center rounded-md bg-primary px-2 py-1 text-sm text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
                                   disabled={state.adminTextSaving}
                                   on:click={{:kind :admin-text-save}}>Save</button>
                     #html <span class="hidden"></span>)}
                <button type="button"
                        title="Close"
                        aria-label="Close"
                        class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-muted"
                        on:click={{:kind :close-viewer}}>
                  <span class="sr-only">Close</span>
                  <span>×</span>
                </button>
              </div>
            </header>
            <div class="min-h-0 flex-1 overflow-hidden">
              {(if state.adminTextPending
                   #html <p class="p-4 text-sm text-muted-foreground">Loading...</p>
                   (if (some? state.adminTextError)
                       #html <p class="m-4 rounded-md border border-destructive/40 bg-destructive/10 p-3 text-sm text-destructive">{state.adminTextError}</p>
                       (if (and editable (not state.adminTextReadOnly))
                           #html <textarea class="h-full min-h-[70vh] w-full resize-none border-0 bg-background p-4 font-mono text-sm shadow-xs focus-visible:outline-none"
                                           value={content}
                                           on:input={{:kind :admin-text-input :value event.currentTarget.value}}
                                           on:paste={(Event.prevent (adminTextPasteMessage state file event))}
                                           on:blur={{:kind :admin-text-save-if-needed}}></textarea>
                           #html <div class="h-full overflow-auto p-4">
                                   {(AdminTextReadOnlyView state file content)}
                                 </div>)))}
            </div>
            {(AdminMarkdownImageOverlay state)}
          </div>))

(ann ShareTextViewer (Fn [AppState FileItem] Html))
(defn ShareTextViewer [state file]
  #html <div role="dialog"
             aria-labelledby="share-text-viewer-title"
             aria-modal="true"
             class="fixed inset-0 z-50 flex flex-col bg-background/95 text-foreground backdrop-blur-sm">
          <header class="flex h-auto min-h-12 shrink-0 flex-wrap items-center justify-between gap-2 border-b border-border bg-background/90 px-3 py-2">
            <div class="min-w-0 flex-1">
              <h2 id="share-text-viewer-title" class="truncate text-lg font-medium">{file.name}</h2>
              <p class="text-sm text-muted-foreground">
                {(textExtensionLabel file)}
                {(if (not (= state.shareTextContent ""))
                     #html <span>{(str " • " (textLineCount state.shareTextContent) " lines")}</span>
                     #html <span class="hidden"></span>)}
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button type="button"
                      title="Copy to clipboard"
                      class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-muted"
                      on:click={{:kind :share-text-copy}}>
                <span class="sr-only">Copy to clipboard</span>
                <span aria-hidden="true">⎘</span>
              </button>
              <button type="button"
                      title="Download"
                      aria-label="Download"
                      class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-muted"
                      on:click={{:kind :download-url
                                 :url (shareTextDownloadHref state file)
                                 :filename file.name}}>
                {(IconDownload "h-5 w-5")}
              </button>
              <button type="button"
                      title="Close"
                      class="inline-flex h-8 w-8 items-center justify-center rounded-md hover:bg-muted"
                      on:click={{:kind :share-close-viewer}}>
                <span class="sr-only">Close</span>
                <span aria-hidden="true">×</span>
              </button>
            </div>
          </header>
          <div class="min-h-0 flex-1 overflow-hidden">
            {(if state.shareTextPending
                 #html <p class="p-4 text-sm text-muted-foreground">Loading…</p>
                 (if (some? state.shareTextError)
                     #html <p class="p-4 text-sm text-destructive">{state.shareTextError}</p>
                     (if state.shareAllowEdit
                         #html <div class="h-full p-4">
                                 <textarea class="h-full min-h-[60vh] w-full resize-none rounded-lg border border-input bg-background p-4 font-sans text-base leading-[1.75] text-foreground shadow-xs wrap-break-word whitespace-pre-wrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                           value={state.shareTextContent}
                                           on:input={{:kind :share-text-input :value event.currentTarget.value}}
                                           on:paste={(Event.prevent (adminTextPasteMessage state file event))}
                                           on:blur={{:kind :share-text-save}}></textarea>
                               </div>
                         #html <div class="h-full overflow-auto p-4">
                                 <pre class="wrap-break-word whitespace-pre-wrap font-sans text-base leading-[1.75] text-foreground">{state.shareTextContent}</pre>
                               </div>)))}
          </div>
        </div>)
