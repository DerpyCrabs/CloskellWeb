(import "../../model.clsk" [AppState])
(import "../../../lib/types.clsk" [WorkspaceLayoutPreset])
(import "./state-core.clsk" [serializeWorkspaceLayoutState])
(import "./tab-icon-colors.clsk" [workspaceTabIconSwatches])

(ann workspaceLayoutDirty? (Fn [AppState] Bool))
(defn workspaceLayoutDirty? [state]
  (match state.workspaceLayoutBaselineSnapshot
    nil false
    (some snapshot)
      (not (= (serializeWorkspaceLayoutState state.workspace)
              (serializeWorkspaceLayoutState snapshot)))))

(def workspaceSettingsIconNames
  ["Heart"
   "Star"
   "Bookmark"
   "Folder"
   "FolderHeart"
   "Music"
   "Film"
   "Image"
   "FileText"
   "Book"
   "Code"
   "Package"
   "Download"
   "Upload"
   "Archive"
   "Pin"
   "Flag"
   "Bell"
   "AlertCircle"
   "CheckCircle"
   "Info"
   "Sparkles"
   "Zap"
   "Crown"
   "KeySquare"
   "KeyRound"])

(def workspaceSettingsThemeModes
  [{:value "light" :label "Light"}
   {:value "dark" :label "Dark"}
   {:value "system" :label "System"}])

(def workspaceSettingsThemePalettes
  [{:value "default" :label "Default"}
   {:value "caffeine" :label "Caffeine"}
   {:value "cosmic-night" :label "Cosmic Night"}])

(ann optionString (Fn [(Option String)] String))
(defn optionString [value]
  (match value
    nil ""
    (some text) text))

(ann workspaceSettingsBrowserTabTitle (Fn [AppState] String))
(defn workspaceSettingsBrowserTabTitle [state]
  (optionString state.workspace.browserTabTitle))

(ann workspaceSettingsBrowserTabIcon (Fn [AppState] String))
(defn workspaceSettingsBrowserTabIcon [state]
  (optionString state.workspace.browserTabIcon))

(ann workspaceSettingsBrowserTabIconColor (Fn [AppState] String))
(defn workspaceSettingsBrowserTabIconColor [state]
  (optionString state.workspace.browserTabIconColor))

(ann workspaceSettingsChoiceClass (Fn [Bool] String))
(defn workspaceSettingsChoiceClass [selected]
  (str "flex items-center gap-2 rounded-md border px-3 py-2 text-left text-sm transition-colors "
       (if selected
           "border-primary bg-primary/10 text-primary"
           "border-border bg-muted/50 hover:bg-muted")))

(ann workspaceSettingsIconButtonClass (Fn [Bool] String))
(defn workspaceSettingsIconButtonClass [selected]
  (str "flex items-center justify-center rounded-lg border-2 p-3 transition-all hover:bg-muted/50 "
       (if selected
           "border-primary bg-primary/10"
           "border-border hover:border-primary/50")))

(ann workspaceSettingsSwatchClass (Fn [String Bool] String))
(defn workspaceSettingsSwatchClass [twBg selected]
  (str "h-8 w-8 shrink-0 rounded-md border-2 disabled:opacity-40 "
       twBg
       " "
       (if selected
           "border-primary"
           "border-black/25 dark:border-white/30")))

(ann IconCheck (Fn [String] Html))
(defn IconCheck [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>)

(ann IconMoon (Fn [String] Html))
(defn IconMoon [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
        </svg>)

(ann IconMonitor (Fn [String] Html))
(defn IconMonitor [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
          <rect width="20" height="14" x="2" y="3" rx="2"></rect>
          <line x1="8" x2="16" y1="21" y2="21"></line>
          <line x1="12" x2="12" y1="17" y2="21"></line>
        </svg>)

(ann IconSun (Fn [String] Html))
(defn IconSun [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>)

(ann WorkspaceSettingsModeIcon (Fn [String String] Html))
(defn WorkspaceSettingsModeIcon [mode className]
  #html <span class="contents">
          {(if (= mode "light") (IconSun className) #html <span class="hidden"></span>)}
          {(if (= mode "dark") (IconMoon className) #html <span class="hidden"></span>)}
          {(if (= mode "system") (IconMonitor className) #html <span class="hidden"></span>)}
        </span>)

(ann WorkspaceSettingsIconGlyph (Fn [String String] Html))
(defn WorkspaceSettingsIconGlyph [name className]
  #html <span class="contents">
          {(if (= name "Heart")
               #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
                       <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"></path>
                     </svg>
