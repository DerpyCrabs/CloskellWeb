                       <path d="M20 2v4"></path>
                       <path d="M22 4h-4"></path>
                       <circle cx="4" cy="20" r="2"></circle>
                     </svg>
               #html <span class="hidden"></span>)}
          {(if (= name "Zap")
               #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
                       <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path>
                     </svg>
               #html <span class="hidden"></span>)}
          {(if (= name "Crown")
               #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
                       <path d="M11.562 3.266a.5.5 0 0 1 .876 0L15.39 8.87a1 1 0 0 0 1.516.294L21.183 5.5a.5.5 0 0 1 .798.519l-2.834 10.246a1 1 0 0 1-.956.734H5.81a1 1 0 0 1-.957-.734L2.02 6.02a.5.5 0 0 1 .798-.519l4.276 3.664a1 1 0 0 0 1.516-.294z"></path>
                       <path d="M5 21h14"></path>
                     </svg>
               #html <span class="hidden"></span>)}
          {(if (= name "KeySquare")
               #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
                       <path d="M12.4 2.7a2.5 2.5 0 0 1 3.4 0l5.5 5.5a2.5 2.5 0 0 1 0 3.4l-3.7 3.7a2.5 2.5 0 0 1-3.4 0L8.7 9.8a2.5 2.5 0 0 1 0-3.4z"></path>
                       <path d="m14 7 3 3"></path>
                       <path d="m9.4 10.6-6.814 6.814A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814"></path>
                     </svg>
               #html <span class="hidden"></span>)}
          {(if (= name "KeyRound")
               #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
                       <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z"></path>
                       <circle cx="16.5" cy="7.5" r=".5" fill="currentColor"></circle>
                     </svg>
               #html <span class="hidden"></span>)}
        </span>)

(ann WorkspaceSettingsDialog (Fn [AppState] Html))
(defn WorkspaceSettingsDialog [state]
  (if state.workspaceSettingsOpen
      (let [browserTitle (workspaceSettingsBrowserTabTitle state)
            browserIcon (workspaceSettingsBrowserTabIcon state)
            browserIconColor (workspaceSettingsBrowserTabIconColor state)
            iconColorDisabled (= browserIcon "")]
        #html <div class="contents">
                <div class="fixed inset-0 z-[100000] bg-black/40"
                     role="presentation"
                     on:click={{:kind :workspace-settings-close}}></div>
                <div role="dialog"
                     aria-modal="true"
                     aria-labelledby="workspace-settings-title"
                     class="ring-foreground/10 fixed left-1/2 top-1/2 z-[100001] max-h-[85vh] w-[min(100%-2rem,32rem)] -translate-x-1/2 -translate-y-1/2 overflow-y-auto rounded-lg border border-border bg-popover p-6 text-popover-foreground shadow-lg ring-1"
                     on:click={(Event.stop {:kind :noop})}>
                  <h2 id="workspace-settings-title" class="text-lg font-semibold">Settings</h2>
                  <div class="mt-6 grid gap-6">
                    <div>
                      <div class="mb-2 text-xs font-medium text-muted-foreground">Browser tab</div>
                      <label class="mb-2 block text-sm font-medium">Title</label>
                      <input type="text"
                             class="mb-3 flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm"
                             placeholder="Workspace"
                             maxlength="120"
                             value={browserTitle}
                             on:input={{:kind :workspace-browser-tab-title :value event.currentTarget.value}}></input>
                      <label class="mb-2 block text-sm font-medium">Icon</label>
                      <div class="grid grid-cols-4 gap-2 sm:grid-cols-5 md:grid-cols-6">
                        {(for [iconName workspaceSettingsIconNames :key iconName]
                           #html <button type="button"
                                         title={iconName}
                                         class={(workspaceSettingsIconButtonClass (= browserIcon iconName))}
                                         on:click={{:kind :workspace-browser-tab-icon :value iconName}}>
                                   {(WorkspaceSettingsIconGlyph iconName "h-6 w-6")}
                                 </button>)}
                      </div>
                      <label class="mb-2 mt-3 block text-sm font-medium">Icon color</label>
                      <div class="flex flex-wrap gap-2">
                        <button type="button"
                                disabled={iconColorDisabled}
                                class={(str "h-8 min-w-8 shrink-0 rounded-md border-2 px-2 text-xs font-medium disabled:opacity-40 "
                                            (if (= browserIconColor "")
                                                "border-primary bg-primary/10"
                                                "border-border bg-muted/60 hover:bg-muted"))}
                                on:click={{:kind :workspace-browser-tab-icon-color :value ""}}>
                          Auto
                        </button>
                        {(for [swatch workspaceTabIconSwatches :key swatch.key]
                           #html <button type="button"
                                         disabled={iconColorDisabled}
                                         title={swatch.key}
                                         class={(workspaceSettingsSwatchClass swatch.twBg (= browserIconColor swatch.key))}
                                         on:click={{:kind :workspace-browser-tab-icon-color :value swatch.key}}></button>)}
                      </div>
                      <button type="button"
                              class="mt-3 text-xs font-medium text-muted-foreground underline decoration-muted-foreground/50 underline-offset-2 hover:text-foreground"
                              on:click={{:kind :workspace-browser-tab-reset}}>
                        Reset tab appearance
                      </button>
                    </div>
                    <div>
                      <div class="mb-2 text-xs font-medium text-muted-foreground">Open files in</div>
                      <div class="flex flex-col gap-2">
                        <button type="button"
                                title="Open in the active tab’s window group (next to the focused tab when possible)."
                                class={(workspaceSettingsChoiceClass (= state.workspaceFileOpenTarget "new-tab"))}
                                on:click={{:kind :workspace-file-open-target :target "new-tab"}}>
                          <span class="flex-1">New tab</span>
                          {(if (= state.workspaceFileOpenTarget "new-tab") (IconCheck "h-4 w-4 shrink-0") #html <span class="hidden"></span>)}
                        </button>
                        <button type="button"
                                title="Open as a separate floating workspace window."
                                class={(workspaceSettingsChoiceClass (= state.workspaceFileOpenTarget "new-window"))}
                                on:click={{:kind :workspace-file-open-target :target "new-window"}}>
                          <span class="flex-1">New window</span>
                          {(if (= state.workspaceFileOpenTarget "new-window") (IconCheck "h-4 w-4 shrink-0") #html <span class="hidden"></span>)}
                        </button>
                      </div>
                    </div>
                    <div>
                      <div class="mb-2 text-xs font-medium text-muted-foreground">Mode</div>
                      <div class="flex flex-wrap gap-2">
                        {(for [mode workspaceSettingsThemeModes :key mode.value]
                           #html <button type="button"
                                         class={(workspaceSettingsChoiceClass (= state.themeMode mode.value))}
                                         on:click={{:kind :theme-pick :mode mode.value}}>
                                   {(WorkspaceSettingsModeIcon mode.value "h-4 w-4 shrink-0")}
                                   {mode.label}
                                   {(if (= state.themeMode mode.value) (IconCheck "h-4 w-4 shrink-0") #html <span class="hidden"></span>)}
                                 </button>)}
                      </div>
                    </div>
                    <div>
                      <div class="mb-2 text-xs font-medium text-muted-foreground">Theme</div>
                      <div class="flex flex-wrap gap-2">
                        {(for [palette workspaceSettingsThemePalettes :key palette.value]
                           #html <button type="button"
                                         class={(workspaceSettingsChoiceClass (= state.themePalette palette.value))}
                                         on:click={{:kind :theme-palette-pick :palette palette.value}}>
                                   {palette.label}
                                   {(if (= state.themePalette palette.value) (IconCheck "h-4 w-4 shrink-0") #html <span class="hidden"></span>)}
                                 </button>)}
                      </div>
                    </div>
                    <div>
                      <div class="mb-2 text-xs font-medium text-muted-foreground">Tiling</div>
                      <label class="mb-3 flex cursor-pointer items-start gap-2 text-sm">
                        <input type="checkbox"
                               class="mt-0.5"
                               checked={state.workspaceSnapAssistEnabled}
                               on:change={{:kind :workspace-snap-assist-toggle
                                           :enabled event.currentTarget.checked}}></input>
                        <span>Show snap assist when dragging to the top-center strip (~300px wide)</span>
                      </label>
                    </div>
                  </div>
                </div>
              </div>
      )
      #html <span class="hidden"></span>))

(ann WorkspaceNamedLayoutPresetRow (Fn [WorkspaceLayoutPreset] Html))
(defn WorkspaceNamedLayoutPresetRow [preset]
  #html <div class="flex min-h-8 items-center gap-0.5 rounded-sm pr-1 hover:bg-accent/50"
             role="presentation">
          <button type="button"
                  role="menuitem"
                  class="min-w-0 flex-1 cursor-pointer truncate rounded-sm px-2 py-1.5 text-left text-sm outline-none hover:bg-accent hover:text-accent-foreground"
                  on:click={{:kind :workspace-layout-restore-preset :id preset.id}}>
            {preset.name}
          </button>
          <button type="button"
                  class="inline-flex h-7 shrink-0 items-center justify-center rounded-sm px-2 text-xs text-muted-foreground outline-none hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
                  title={(str "Update layout " preset.name " from current windows")}
                  aria-label={(str "Update layout " preset.name " from current windows")}
                  on:click={{:kind :workspace-layout-update-preset :id preset.id}}>
            Update
          </button>
          <button type="button"
                  class="inline-flex h-7 shrink-0 items-center justify-center rounded-sm px-2 text-xs text-muted-foreground outline-none hover:bg-destructive/10 hover:text-destructive focus-visible:ring-2 focus-visible:ring-ring"
                  aria-label={(str "Remove layout " preset.name)}
                  on:click={{:kind :workspace-layout-delete-preset :id preset.id}}>
            Remove
          </button>
        </div>)

(ann WorkspaceNamedLayoutMenuView (Fn [AppState] Html))
(defn WorkspaceNamedLayoutMenuView [state]
  (if state.workspaceLayoutMenuOpen
      #html <div class="contents">
              <div class="fixed inset-0 z-[999998]"
                   role="presentation"
                   on:click={{:kind :workspace-layout-menu-close}}></div>
              <div data-workspace-layout-menu
                   class="fixed bottom-[38px] right-5 z-[999999] min-w-52 rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
                   role="menu"
                   on:click={(Event.stop {:kind :noop})}>
                <button type="button"
                        role="menuitem"
                        class="flex w-full cursor-pointer items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground disabled:pointer-events-none disabled:opacity-40"
                        disabled={(not state.workspaceLayoutPresetsReady)}
                        on:click={{:kind :workspace-layout-save-open}}>
                  Save current layout…
                </button>
                <div class="my-1 h-px bg-border" role="separator"></div>
                <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">Restore</div>
                {(if (not state.workspaceLayoutPresetsReady)
                     #html <div class="px-2 py-1.5 text-sm text-muted-foreground">Loading...</div>
                     (if (= (count state.workspaceLayoutPresets) 0)
                         #html <div class="px-2 py-1.5 text-sm text-muted-foreground">No saved layouts</div>
                         #html <div class="space-y-0.5">
                                 {(for [preset state.workspaceLayoutPresets :key preset.id]
                                    #html <div class="contents">{(WorkspaceNamedLayoutPresetRow preset)}</div>)}
                               </div>))}
                {(if (workspaceLayoutDirty? state)
                     #html <div class="contents">
                             <div class="my-1 h-px bg-border" role="separator"></div>
                             <button type="button"
                                     role="menuitem"
                                     class="flex w-full cursor-pointer items-center rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground"
                                     on:click={{:kind :workspace-layout-revert-baseline}}>
                               Revert to baseline
                             </button>
                           </div>
                     #html <span class="hidden"></span>)}
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann WorkspaceLayoutSaveDialogView (Fn [AppState] Html))
(defn WorkspaceLayoutSaveDialogView [state]
  (if state.workspaceLayoutSaveOpen
      #html <div class="fixed inset-0 z-[1000000] flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :workspace-layout-save-close}}>
              <div role="dialog"
                   aria-modal="true"
                   aria-labelledby="workspace-save-layout-title"
                   class="w-full max-w-sm rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 id="workspace-save-layout-title" class="text-lg font-semibold">Save layout</h2>
                <p class="mt-1 text-sm text-muted-foreground">Choose a name for this window arrangement.</p>
                <input class="mt-4 flex h-9 w-full rounded-md border border-input bg-background px-3 py-1 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
                       placeholder="e.g. Review + browser"
                       value={state.workspaceLayoutSaveName}
                       on:input={{:kind :workspace-layout-save-name :value event.currentTarget.value}}></input>
                <div class="mt-6 flex justify-end gap-2">
                  <button type="button"
                          class="h-9 rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent"
                          on:click={{:kind :workspace-layout-save-close}}>Cancel</button>
                  <button type="button"
                          class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
                          disabled={(or (= (trim state.workspaceLayoutSaveName) "") (not state.workspaceLayoutPresetsReady))}
                          on:click={{:kind :workspace-layout-save-submit}}>Save</button>
                </div>
              </div>
            </div>
      #html <span class="hidden"></span>))
