(type AppMsgCast AppMsg)
(def jsURL (js-global URL))
(def jsJSON (js-global JSON))
(def jsGlobalThis (js-global globalThis))
(def jsWindow (js-global window))
(def jsDocument (js-global document))
(def jsCrypto (js-global crypto))
(def jsEvent (js-global Event))
(def jsObject (js-global Object))
(def jsArray (js-global Array))
(def jsNumber (js-global Number))
(def jsDate (js-global Date))
(def currentDragPathBox (unsafe-cast Js [""]))
(def workspaceFileDragMime "application/x-derp-file-drag")

(type WorkspaceFileDragPayload
  {:path String
   :isDirectory Bool
   :sourceKind String
   :sourceToken (Option String)})

(ann boxGet (Fn [Js] Js))
(defn boxGet [box]
  (nth box 0))

(ann boxSet (Fn [Js Js] Js))
(defn boxSet [box value]
  (box.splice 0 1 value))

(ann assignJs (Fn [Js Js] Js))
(defn assignJs [base updates]
  (jsObject.assign {} base updates))

(ann keyboardEditableActive? (Fn [] Bool))
(defn keyboardEditableActive? []
  (let [active jsDocument.activeElement
        tag (if (and (some? active) (string? active.tagName))
                (lower-case active.tagName)
                "")
        fileBrowser? (and (some? active)
                          (= (active.getAttribute "data-testid") "file-browser"))]
    (or (= tag "input")
        (= tag "textarea")
        (= tag "select")
        (and (= active.isContentEditable true) (not fileBrowser?)))))

(ann keyboardEditableTarget? (Fn [Js] Bool))
(defn keyboardEditableTarget? [target]
  (let [tag (if (and (some? target) (string? target.tagName))
                (lower-case target.tagName)
                "")
        fileBrowser? (and (some? target)
                          (= (target.getAttribute "data-testid") "file-browser"))]
    (or (= tag "input")
        (= tag "textarea")
        (= tag "select")
        (and (= target.isContentEditable true) (not fileBrowser?)))))

(ann keySearchShortcut? (Fn [String Bool Bool] Bool))
(defn keySearchShortcut? [key ctrlKey metaKey]
  (let [lower (lower-case key)]
    (or (= key "/")
        (and (= lower "k") (or ctrlKey metaKey)))))

(ann shareTokenFromPathname (Fn [String] (Option String)))
(defn shareTokenFromPathname [pathname]
  (if (not (starts-with? pathname "/share/"))
      nil
      (let [rest (string-slice pathname 7 (count pathname))
            token (first (split rest "/"))]
        (if (and (string? token) (not (= token ""))) token nil))))

(ann routeStateFromUrl (Fn [String] RouteState))
(defn routeStateFromUrl [href]
  (let [url (new jsURL href jsWindow.location.origin)
        dir (url.searchParams.get "dir")
        viewing (url.searchParams.get "viewing")
        playing (url.searchParams.get "playing")
        audioOnly (url.searchParams.get "audioOnly")
        passcode (url.searchParams.get "p")]
    {:currentUrl href
     :pathname url.pathname
     :search url.search
     :currentDir (if (string? dir) dir "")
     :viewingPath (if (string? viewing) viewing nil)
     :playingPath (if (string? playing) playing nil)
     :audioOnly (= audioOnly "true")
     :shareToken (shareTokenFromPathname url.pathname)
     :sharePasscodeParam (if (string? passcode) passcode nil)}))

(ann viewModeFromStoredValue (Fn [String] String))
(defn viewModeFromStoredValue [value]
  (if (= value "grid") "grid" "list"))

(ann workspaceSnapAssistFromStoredValue (Fn [String] Bool))
(defn workspaceSnapAssistFromStoredValue [value]
  (not (= value "false")))

(ann workspaceAssistGridShapeFromStoredValue (Fn [String] String))
(defn workspaceAssistGridShapeFromStoredValue [raw]
  (if (= raw "")
      "3x2"
      (try
       (let [stored (jsJSON.parse raw)
             storedState (get stored :state)
             shape (if (object? storedState)
                       (get storedState :assistGridShape)
                       (get stored :assistGridShape))]
         (if (and (string? shape) (isAssistGridShape shape)) shape "3x2"))
       (catch _error "3x2"))))

(ann workspaceSessionFromSearch (Fn [String] (Option String)))
(defn workspaceSessionFromSearch [search]
  (let [params (new jsURL (str "http://workspace.local/" search))
        value (params.searchParams.get "ws")]
    (if (and (string? value) (not (= value ""))) value nil)))

(ann workspaceSourceFromRoute (Fn [RouteState] WorkspaceTaskbarPinSource))
(defn workspaceSourceFromRoute [route]
  (match route.shareToken
    nil {:kind "local" :rootPath nil :token nil :sharePath nil}
    (some token) {:kind "share" :rootPath nil :token token :sharePath ""}))

(ann workspaceStorageKeyFromRoute (Fn [RouteState] String))
(defn workspaceStorageKeyFromRoute [route]
  (let [base (workspaceStorageBaseKey route.shareToken)]
    (match (workspaceSessionFromSearch route.search)
      nil base
      (some session) (workspaceStorageSessionKey base session))))

(ann initialWorkspaceFromRoute (Fn [RouteState] WorkspaceState))
(defn initialWorkspaceFromRoute [route]
  (let [source (workspaceSourceFromRoute route)
        dir route.currentDir]
    (if (not (= dir ""))
        (buildWorkspaceFromDirParam dir source)
        (defaultPersistedState source))))

