(ann loginErrorMessage (Fn [LoginResponse] String))
(defn loginErrorMessage [response]
  (if (string? response.body.error)
      response.body.error
      "Login failed"))

(ann responseErrorMessage (Fn [Number] String))
(defn responseErrorMessage [status]
  (str "Request failed (" status ")"))

(ann loginCommand (Fn [String] (Cmd AppMsg)))
(defn loginCommand [password]
  {:kind :http/request
   :request {:url "/api/auth/login"
             :method "POST"
             :headers {"Content-Type" "application/json"}
             :body (jsJSON.stringify {:password password})}
   :response :json
   :onSuccess :login-ok
   :onError :login-failed})

