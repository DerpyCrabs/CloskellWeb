(ann IconPause (Fn [String] Html))
(defn IconPause [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={(str "lucide lucide-pause " className)} aria-hidden="true">
          <rect x="14" y="3" width="5" height="18" rx="1"></rect>
          <rect x="5" y="3" width="5" height="18" rx="1"></rect>
        </svg>)

(ann IconX (Fn [String] Html))
(defn IconX [className]
  #html <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={(str "lucide lucide-x " className)} aria-hidden="true">
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>)

(ann browserFileIconClass (Fn [FileItem] String))
(defn browserFileIconClass [file]
  (if file.isDirectory
      "h-5 w-5 text-blue-500"
      (if (= file.type MediaType.IMAGE)
          "h-5 w-5 text-green-500"
          (if (= file.type MediaType.VIDEO)
              "h-5 w-5 text-red-500"
              (if (= file.type MediaType.AUDIO)
                  "h-5 w-5 text-purple-500"
                  (if (= file.type MediaType.TEXT)
                      "h-5 w-5 text-cyan-500"
                      (if (= file.type MediaType.PDF)
                          "h-5 w-5 text-orange-500"
                          "h-5 w-5 text-yellow-500")))))))

(ann currentMediaFile? (Fn [AppState FileItem] Bool))
(defn currentMediaFile? [state file]
  (match state.playingPath
    nil false
    (some path)
      (and (= file.path path)
           (or (= file.type MediaType.AUDIO)
               (= file.type MediaType.VIDEO)))))

(ann currentMediaIconClass (Fn [String] String))
(defn currentMediaIconClass [className]
  (str (if (includes? className "h-3.5")
           "h-3.5 w-3.5"
           (if (includes? className "h-4")
               "h-4 w-4"
               "h-5 w-5"))
       " text-primary"))

(ann BrowserFileIcon (Fn [AppState FileItem String] Html))
(defn BrowserFileIcon [state file className]
  (let [path file.path
        iconKind (if (currentMediaFile? state file)
                     "pause"
                     (if (= path virtualFolderFavorites)
                     "star"
                     (if (= path virtualFolderMostPlayed)
                         "eye"
                         (if (= path virtualFolderShares)
                             "link"
                             (if (and file.isDirectory (knowledgeBase? state path))
                                 "book-open"
                                 (if file.isDirectory
                                     "folder"
                                     (if (= file.type MediaType.IMAGE)
                                         "image"
                                         (if (= file.type MediaType.VIDEO)
                                             "video"
                                         (if (= file.type MediaType.AUDIO)
                                             "audio"
                                             (if (= file.type MediaType.TEXT)
                                                 "text"
                                                 (if (= file.type MediaType.PDF)
                                                     "pdf"
                                                         "unknown")))))))))))]
    #html <span class="contents">
            {(if (= iconKind "pause") (IconPause (currentMediaIconClass className)) #html <span class="hidden"></span>)}
            {(if (= iconKind "star") (IconStar className) #html <span class="hidden"></span>)}
            {(if (= iconKind "eye") (IconEye className) #html <span class="hidden"></span>)}
            {(if (= iconKind "link") (IconLink className) #html <span class="hidden"></span>)}
            {(if (= iconKind "book-open") (IconBookOpen className) #html <span class="hidden"></span>)}
            {(if (= iconKind "folder") (IconFolder className) #html <span class="hidden"></span>)}
            {(if (= iconKind "image") (IconImage className) #html <span class="hidden"></span>)}
            {(if (= iconKind "video") (IconVideo className) #html <span class="hidden"></span>)}
            {(if (= iconKind "audio") (IconMusic className) #html <span class="hidden"></span>)}
            {(if (= iconKind "text") (IconFileText className) #html <span class="hidden"></span>)}
            {(if (= iconKind "pdf") (IconBook className) #html <span class="hidden"></span>)}
            {(if (= iconKind "unknown") (IconFileQuestion className) #html <span class="hidden"></span>)}
          </span>))

(ann HeaderThemeButton (Fn [] Html))
(defn HeaderThemeButton []
  #html <button type="button"
                aria-label="Open theme settings"
                title="Theme settings"
                class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-background text-sm font-medium shadow-xs transition-colors hover:bg-muted hover:text-foreground dark:bg-input/30 dark:border-input dark:hover:bg-input/50"
                on:click={{:kind :theme-menu-toggle}}>
          {(IconSettings "h-4 w-4")}
        </button>)

(ann ShareHeaderSettingsButton (Fn [AppState] Html))
(defn ShareHeaderSettingsButton [state]
  #html <button type="button"
                aria-label="Open share settings"
                aria-expanded={state.themeMenuOpen}
                title="Share settings (theme, workspace view)"
                class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-background text-sm font-medium text-foreground shadow-xs transition-colors hover:bg-muted dark:bg-input/30 dark:border-input dark:hover:bg-input/50"
                on:click={{:kind :theme-menu-toggle}}>
          {(IconSettings "h-4 w-4")}
        </button>)

(ann FloatingThemeButton (Fn [] Html))
(defn FloatingThemeButton []
  #html <button type="button"
                aria-label="Open theme settings"
                title="Theme settings"
                class="fixed bottom-4 right-4 z-50 inline-flex size-8 items-center justify-center rounded-md border border-border bg-background text-sm font-medium text-foreground shadow-sm"
                on:click={{:kind :theme-menu-toggle}}>
          {(IconSettings "h-4 w-4")}
        </button>)

(ann fileMatchesPlayingPath? (Fn [AppState Bool FileItem String] Bool))
(defn fileMatchesPlayingPath? [state share? file path]
  (if share?
      (shareFileMatchesPath? state file path)
      (= file.path path)))

(ann playingFileIndex (Fn [AppState Bool (Vector FileItem) String] Number))
(defn playingFileIndex [state share? files path]
  (let [hit (find (map (range 0 (count files))
                       (fn [index] {:index index :file (nth files index)}))
                  (fn [entry] (fileMatchesPlayingPath? state share? entry.file path)))]
    (if (some? hit) hit.index -1)))

(ann showFloatingPlayingFileAction? (Fn [AppState Bool (Vector FileItem) (Option FileItem)] Bool))
(defn showFloatingPlayingFileAction? [state share? files current]
  (match state.playingPath
    nil false
    (some path)
      (match current
        nil false
        (some file)
          (and (not share?)
               (= file.type MediaType.VIDEO)
               (not state.audioOnly)
               (> (playingFileIndex state share? files path) 2)))))

(ann FloatingPlayingFileAction (Fn [AppState Bool (Vector FileItem) (Option FileItem)] Html))
(defn FloatingPlayingFileAction [state share? files current]
  (if (showFloatingPlayingFileAction? state share? files current)
      #html <div class="fixed right-3 top-1/2 z-30 flex -translate-y-1/2 flex-col gap-2 sm:right-5">
              <button type="button"
                      class="inline-flex size-10 items-center justify-center rounded-full border border-border bg-background/95 text-foreground shadow-lg backdrop-blur transition-colors hover:bg-muted"
                      title="Scroll to playing file"
                      aria-label="Scroll to playing file"
                      on:click={{:kind :scroll-playing-file}}>
                {(IconLocateFixed "h-4 w-4")}
              </button>
            </div>
      #html <span class="hidden"></span>))

(ann ThemeModeMenuItem (Fn [AppState String String] Html))
(defn ThemeModeMenuItem [state mode label]
  #html <button type="button"
                role="menuitem"
                class="flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground"
                on:click={{:kind :theme-pick :mode mode}}>
          {(if (= mode "light")
               (IconSun "h-4 w-4 shrink-0")
               (if (= mode "dark")
                   (IconMoon "h-4 w-4 shrink-0")
                   (IconMonitor "h-4 w-4 shrink-0")))}
          <span class="flex-1">{label}</span>
          {(if (= state.themeMode mode)
               (IconCheck "h-4 w-4 shrink-0")
               #html <span class="hidden"></span>)}
        </button>)

(ann ThemePaletteMenuItem (Fn [AppState String String] Html))
(defn ThemePaletteMenuItem [state palette label]
  #html <button type="button"
                role="menuitem"
                class="flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground"
                on:click={{:kind :theme-palette-pick :palette palette}}>
          <span class="flex-1">{label}</span>
          {(if (= state.themePalette palette)
               (IconCheck "h-4 w-4 shrink-0")
               #html <span class="hidden"></span>)}
        </button>)

(ann ThemeMenuContent (Fn [AppState] Html))
(defn ThemeMenuContent [state]
  #html <div class="contents">
          <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">Mode</div>
          {(ThemeModeMenuItem state "light" "Light")}
          {(ThemeModeMenuItem state "dark" "Dark")}
          {(ThemeModeMenuItem state "system" "System")}
          <div class="my-1 h-px bg-border"></div>
          <div class="px-2 py-1.5 text-xs font-medium text-muted-foreground">Theme</div>
          {(ThemePaletteMenuItem state "default" "Default")}
          {(ThemePaletteMenuItem state "caffeine" "Caffeine")}
          {(ThemePaletteMenuItem state "cosmic-night" "Cosmic Night")}
        </div>)

(ann ThemeMenuView (Fn [AppState] Html))
(defn ThemeMenuView [state]
  (let [shareSettings? (and (shareRoute? state) state.shareIsDirectory)]
    #html <div>
            {(if state.themeMenuOpen
                 (if shareSettings?
                     #html <div>
                             <div class="fixed inset-0 z-[100000]"
                                  role="presentation"
                                  on:click={{:kind :theme-menu-toggle}}></div>
                             <div role="menu"
                                  class="ring-foreground/10 fixed z-[100001] max-h-[min(85vh,28rem)] w-52 overflow-y-auto overflow-x-hidden rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-lg ring-1"
                                  style="top:62px;right:24px">
                               <button type="button"
                                       role="menuitem"
                                       class="flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground"
                                       on:click={{:kind :share-open-workspace}}>
                                 {(IconAppWindow "h-4 w-4 shrink-0")}
                                 <span>Workspace view</span>
                               </button>
                               <div class="my-1 h-px bg-border"></div>
                               {(ThemeMenuContent state)}
                             </div>
                           </div>
                     #html <div role="menu"
                                class="fixed right-4 top-14 z-50 min-w-44 rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md">
                             {(ThemeMenuContent state)}
                           </div>)
                 #html <span class="hidden"></span>)}
          </div>))

(ann breadcrumbPathMenuItemAt (Fn [AppState Bool Bool Number Number] Html))
(defn breadcrumbPathMenuItemAt [state compactMode? hiddenMode? hiddenLimit index]
  (let [parts (pathParts state.currentDir)
        total (count parts)]
    (if (>= index total)
        #html <span class="hidden"></span>
        (let [part (nth parts index)
              path (crumbPathAt state.currentDir index)
              entryIndex (+ index 1)]
          (if (or compactMode? (and hiddenMode? (< index hiddenLimit)))
              #html <button type="button"
                            role="menuitem"
                            data-breadcrumb-segment={(if (= entryIndex 0) "home" "crumb")}
                            data-breadcrumb-path={path}
                            class="flex w-full min-w-0 items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm hover:bg-accent hover:text-accent-foreground"
                            on:click={{:kind :breadcrumb-path-pick :path path}}
                            on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                            :path path
                                                            :x event.clientX
                                                            :y event.clientY})}>{part}</button>
              #html <span class="hidden"></span>)))))

(ann breadcrumbPathMenuItems (Fn [AppState Bool Bool Number] Html))
(defn breadcrumbPathMenuItems [state compactMode? hiddenMode? hiddenLimit]
  #html <div>
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 0)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 1)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 2)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 3)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 4)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 5)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 6)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 7)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 8)}
          {(breadcrumbPathMenuItemAt state compactMode? hiddenMode? hiddenLimit 9)}
        </div>)

(ann BreadcrumbPathMenu (Fn [AppState] Html))
(defn BreadcrumbPathMenu [state]
  (let [parts (pathParts state.currentDir)
        hiddenMode? (= state.menuKind "breadcrumb-path-hidden")
        compactMode? (= state.menuKind "breadcrumb-path-all")
        hiddenLimit (- (count parts) 2)]
    #html <div>
            {(if (and state.menuOpen (or hiddenMode? compactMode?))
                 #html <div>
                         <div class="fixed bottom-0 left-0 right-0 top-24 z-40 bg-transparent"
                              on:click={{:kind :breadcrumb-path-menu-close}}></div>
                         <div data-testid="breadcrumb-path-menu"
                              role="menu"
                              class="fixed left-4 top-14 z-50 max-h-64 min-w-48 overflow-y-auto rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10"
                              on:click={(Event.stop {:kind :noop})}>
                           {(if compactMode?
                                #html <button type="button"
                                              role="menuitem"
                                              data-breadcrumb-segment="home"
                                              data-breadcrumb-path=""
                                              class="flex w-full min-w-0 items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm hover:bg-accent hover:text-accent-foreground"
                                              on:click={{:kind :breadcrumb-path-pick :path ""}}
                                              on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                                              :path ""
                                                                              :x event.clientX
                                                                              :y event.clientY})}>Home</button>
                                #html <span class="hidden"></span>)}
                           {(breadcrumbPathMenuItems state compactMode? hiddenMode? hiddenLimit)}
                         </div>
                       </div>
                 #html <span class="hidden"></span>)}
          </div>))

(ann BreadcrumbsView (Fn [AppState] Html))
(defn BreadcrumbsView [state]
  (let [parts (pathParts state.currentDir)
        total (+ 1 (count parts))
        currentName (if (= state.currentDir "")
                        "Home"
                        (let [name (last parts)] (if (some? name) name state.currentDir)))]
    #html <div class="contents">
            <nav data-testid="breadcrumb-bar"
                 data-breadcrumb-layout="inline"
                 data-breadcrumb-count={total}
                 class="relative flex min-w-0 flex-1 flex-nowrap items-center gap-1 overflow-hidden lg:gap-2"
                 aria-label="Breadcrumb">
              <div class="pointer-events-none absolute left-0 top-0 flex items-center gap-1 lg:gap-2"
                   style="visibility:hidden">
                <span>Home</span>
                {(for [part parts :key (str "hidden-crumb-" part)]
                   #html <span>{part}</span>)}
              </div>
              <div data-breadcrumb-wrapper
                   data-breadcrumb-index="0"
                   class="flex shrink-0 items-center gap-2">
                <button type="button"
                        data-breadcrumb-segment="home"
                        data-breadcrumb-path=""
                        class={(str "inline-flex h-8 shrink-0 items-center justify-center gap-1.5 whitespace-nowrap rounded-md px-2.5 text-sm font-medium transition-colors "
                                    (if (= state.currentDir "") "bg-primary text-primary-foreground shadow-sm" "text-foreground hover:bg-accent hover:text-accent-foreground"))}
                        on:click={{:kind :navigate-dir :path ""}}
                        on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                        :path ""
                                                        :x event.clientX
                                                        :y event.clientY})}>
                  {(IconHome "h-4 w-4")}
                  <span>Home</span>
                </button>
              </div>
              {(for [part parts index :key (str index "-" part)]
                 #html <div data-breadcrumb-wrapper
                            data-breadcrumb-index={(+ index 1)}
                            class="flex min-w-0 shrink-0 items-center gap-2">
                         {(IconChevronRight "h-4 w-4 shrink-0 text-muted-foreground")}
                         <button type="button"
                                 data-breadcrumb-segment="crumb"
                                 data-breadcrumb-path={(crumbPathAt state.currentDir index)}
                                 class={(str "inline-flex h-8 min-w-0 shrink items-center justify-center gap-1.5 truncate whitespace-nowrap rounded-md px-2.5 text-sm font-medium transition-colors "
                                             (if (= (+ index 1) (count parts)) "bg-primary text-primary-foreground shadow-sm" "text-foreground hover:bg-accent hover:text-accent-foreground"))}
                                 on:click={{:kind :navigate-dir :path (crumbPathAt state.currentDir index)}}
                                 on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                                 :path (crumbPathAt state.currentDir index)
                                                                 :x event.clientX
                                                                 :y event.clientY})}>{part}</button>
                       </div>)}
              <button type="button"
                      data-testid="breadcrumb-ellipsis"
                      aria-haspopup="menu"
                      aria-label="Show hidden path segments"
                      class="hidden h-8 shrink-0 items-center justify-center rounded-md px-2.5 text-sm font-medium text-foreground hover:bg-accent hover:text-accent-foreground"
                      on:click={{:kind :breadcrumb-path-menu-toggle :mode "breadcrumb-path-hidden"}}>
                <span aria-hidden="true" class="before:content-['...']"></span>
              </button>
              <button type="button"
                      data-breadcrumb-segment="path-picker"
                      data-breadcrumb-path={state.currentDir}
                      class="hidden h-8 w-full max-w-full min-w-0 shrink items-center justify-between gap-2 rounded-md border border-border bg-muted/40 px-2.5 text-sm font-medium text-foreground shadow-none transition-colors hover:bg-muted hover:text-foreground"
                      title={currentName}
                      on:click={{:kind :breadcrumb-path-menu-toggle :mode "breadcrumb-path-all"}}>
                <span class="min-w-0 flex-1 truncate text-left">{currentName}</span>
                <span class="shrink-0 opacity-70">v</span>
              </button>
            </nav>
            {(BreadcrumbPathMenu state)}
          </div>))

(ann BrowserToolbar (Fn [AppState] Html))
(defn BrowserToolbar [state]
  #html <div class="shrink-0 border-b border-border bg-muted/30 p-1.5 lg:p-2">
          <div class="flex flex-wrap items-center justify-between w-full gap-1.5 lg:gap-2">
            <div data-breadcrumb-slot
                 data-testid="breadcrumb-slot"
                 class="flex min-h-0 min-w-0 flex-1 overflow-hidden">
              {(BreadcrumbsView state)}
            </div>
            <div class="flex items-center gap-1">
              {(if (currentKnowledgeBase? state)
                   #html <button type="button"
                                 aria-label="Open search"
                                 title="Open search"
                                 class="inline-flex h-8 shrink-0 items-center justify-center rounded-md border border-border bg-background px-2 text-xs font-medium shadow-xs transition-colors hover:bg-muted hover:text-foreground"
                                 on:click={{:kind :kb-search-open}}>
                           {(IconSearch "h-4 w-4")}
                         </button>
                   #html <span class="hidden"></span>)}
              {(if (currentPathEditable? state)
                   #html <div class="relative flex items-center gap-1">
                           <button type="button"
                                   title="Create new file"
                                   aria-label="New file"
                                   class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-background text-xs font-medium shadow-xs transition-colors hover:bg-muted hover:text-foreground"
                                   on:click={{:kind :admin-open-create :createKind "file"}}>
                             {(IconFilePlus "h-4 w-4")}
                           </button>
                           <button type="button"
                                   title="Create new folder"
                                   aria-label="New folder"
                                   class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-background text-xs font-medium shadow-xs transition-colors hover:bg-muted hover:text-foreground"
                                   on:click={{:kind :admin-open-create :createKind "folder"}}>
                             {(IconFolderPlus "h-4 w-4")}
                           </button>
                           <button type="button"
                                   title="Upload"
                                   aria-label="Upload"
                                   aria-expanded={state.adminUploadMenuOpen}
                                   class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border bg-background text-xs font-medium shadow-xs transition-colors hover:bg-muted hover:text-foreground"
                                   on:click={{:kind :admin-upload-menu-toggle}}>
                             {(IconUpload "h-4 w-4")}
                           </button>
                           {(if state.adminUploadMenuOpen
                                #html <div data-upload-menu
                                           class="absolute right-0 top-9 z-40 min-w-40 rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
                                           role="menu">
                                        <label role="menuitem"
                                               class="flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground">
                                          Upload files
                                          <input type="file"
                                                 multiple
                                                 class="sr-only"
                                                 data-testid="request-body-multipart-files"
                                                 on:change={{:kind :admin-upload-input-selected
                                                             :selected? (> event.currentTarget.files.length 0)
                                                             :testId "request-body-multipart-files"}}></input>
                                        </label>
                                        <label role="menuitem"
                                               class="flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground">
                                          Upload folder
                                          <input type="file"
                                                 multiple
                                                 webkitdirectory=""
                                                 class="sr-only"
                                                 data-testid="request-body-multipart-folder-files"
                                                 on:change={{:kind :admin-upload-input-selected
                                                             :selected? (> event.currentTarget.files.length 0)
                                                             :testId "request-body-multipart-folder-files"}}></input>
                                        </label>
                                      </div>
                                #html <span class="hidden"></span>)}
                         </div>
		                 #html <span class="hidden"></span>)}
	              <button type="button"
	                      aria-label="List view"
	                      aria-pressed={(= state.viewMode "list")}
                      class={(viewModeButtonClass (= state.viewMode "list"))}
                      on:click={{:kind :view-mode-picked :value "list"}}>
                {(IconList "h-4 w-4")}
              </button>
	              <button type="button"
	                      aria-label="Grid view"
	                      aria-pressed={(= state.viewMode "grid")}
                      class={(viewModeButtonClass (= state.viewMode "grid"))}
                      on:click={{:kind :view-mode-picked :value "grid"}}>
                {(IconLayoutGrid "h-4 w-4")}
              </button>
              {(HeaderThemeButton)}
            </div>
          </div>
        </div>)

(ann LoadingView (Fn [] Html))
(defn LoadingView []
  #html <div data-testid="directory-loading"
             class="flex min-h-52 items-center justify-center p-8 text-sm text-muted-foreground">
          Loading files...
        </div>)

(ann ErrorPanel (Fn [String] Html))
(defn ErrorPanel [message]
  #html <div data-testid="directory-list-error"
             class="m-4 rounded-md border border-destructive/40 bg-destructive/10 p-4 text-sm text-destructive">
          <p class="font-medium">Could not load this folder</p>
          <p class="mt-1">{message}</p>
          <button type="button"
                  class="mt-3 inline-flex h-8 items-center rounded-md border border-destructive/40 px-3 text-xs font-medium"
                  on:click={{:kind :refresh-files}}>Retry</button>
        </div>)

(ann EmptyFolderView (Fn [] Html))
(defn EmptyFolderView []
  #html <div data-testid="directory-empty"
             class="col-span-full flex flex-col items-center justify-center px-4 py-10 text-center">
          <div>
            <p class="text-sm font-medium text-foreground">This folder is empty</p>
            <p class="mt-1 max-w-sm text-xs text-muted-foreground">There are no files in this folder.</p>
          </div>
        </div>)

(ann kbTextFile? (Fn [FileItem] Bool))
(defn kbTextFile? [file]
  (let [ext (lower-case (if (string? file.extension) file.extension ""))]
    (and (not file.isDirectory)
         (or (= ext "md") (= ext "markdown") (= ext "txt")))))

(ann kbRecentFiles (Fn [AppState] (Vector FileItem)))
(defn kbRecentFiles [state]
  (slice (filter state.files kbTextFile?) 0 10))

(ann kbSearchFiles (Fn [AppState] (Vector FileItem)))
(defn kbSearchFiles [state]
  (let [query (lower-case (trim state.kbSearchQuery))]
    (if (= query "")
        []
        (filter state.files
                (fn [file]
                  (and (kbTextFile? file)
                       (includes? (lower-case file.name) query)))))))

(ann KnowledgeBaseRecentStrip (Fn [AppState] Html))
(defn KnowledgeBaseRecentStrip [state]
  (if (currentKnowledgeBase? state)
      #html <div data-testid="kb-recent-strip"
                 class="min-w-0 shrink-0 overflow-x-auto border-b border-border bg-muted/20 px-2 py-2">
              <div class="flex w-max min-w-full flex-nowrap gap-1.5">
                {(for [file (kbRecentFiles state) :key (str "kb-recent-" file.path)]
                   #html <button type="button"
                                 class="flex shrink-0 cursor-pointer items-center gap-1.5 rounded border border-border bg-background px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted/50"
                                 on:click={{:kind :open-file :file file}}>
                           <span class="text-xs text-muted-foreground">TXT</span>
                           <span class="max-w-[12rem] truncate font-medium">{file.name}</span>
                         </button>)}
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann KnowledgeBaseSearchOverlay (Fn [AppState] Html))
(defn KnowledgeBaseSearchOverlay [state]
  (if (and state.kbSearchOpen (currentKnowledgeBase? state))
      #html <div class="fixed inset-0 z-50 bg-black/30 p-4"
	                 role="presentation"
	                 on:click={{:kind :kb-search-close}}>
              <div class="mx-auto mt-16 w-full max-w-xl rounded-lg border border-border bg-popover p-3 text-popover-foreground shadow-xl"
                   role="dialog"
                   aria-modal="true"
                   on:click={(Event.stop {:kind :noop})}>
                <input type="search"
                       placeholder="Search notes..."
                       class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
                       value={state.kbSearchQuery}
                       autofocus
                       on:input={{:kind :kb-search-query :value event.currentTarget.value}}></input>
                <div class="mt-2 max-h-80 overflow-y-auto">
                  {(if (= (count (kbSearchFiles state)) 0)
                       #html <p class="px-2 py-6 text-center text-sm text-muted-foreground">No results</p>
                       #html <div class="space-y-1">
                               {(for [file (kbSearchFiles state) :key (str "kb-search-" file.path)]
                                  #html <button type="button"
                                                class="flex w-full flex-col rounded-md px-2 py-2 text-left text-sm hover:bg-muted"
                                                on:click={{:kind :open-file :file file}}>
                                          <span class="font-medium">{file.name}</span>
                                          <span class="truncate text-xs text-muted-foreground">{(parentDir file.path)}</span>
                                        </button>)}
                             </div>)}
                </div>
              </div>
	            </div>
      #html <span class="hidden"></span>))

(ann ParentRow (Fn [AppState] Html))
(defn ParentRow [state]
  #html <tr class="cursor-pointer select-none border-b border-border transition-colors hover:bg-muted/50"
            on:click={{:kind :navigate-dir :path (parentDir state.currentDir)}}>
          <td class="w-[40px] min-w-[40px] max-w-[40px] box-border p-2 align-middle">
            <div class="flex items-center justify-center">
              {(IconArrowUp "h-5 w-5 text-muted-foreground")}
            </div>
          </td>
          <td class="min-w-0 p-2 align-middle font-medium">..</td>
          <td class="min-w-0 p-2 align-middle text-right text-muted-foreground"></td>
        </tr>)

(ann ParentCard (Fn [AppState] Html))
(defn ParentCard [state]
  #html <button type="button"
                class="ring-foreground/10 bg-card text-card-foreground cursor-pointer py-0 transition-colors select-none hover:bg-muted/50 rounded-xl text-left shadow-xs ring-1 overflow-hidden flex flex-col"
                on:click={{:kind :navigate-dir :path (parentDir state.currentDir)}}>
          <div class="flex aspect-video flex-col items-center justify-center p-4 bg-muted/80">
            {(IconArrowUp "mb-2 h-12 w-12 text-muted-foreground")}
            <p class="text-center text-sm font-medium">..</p>
            <p class="text-center text-xs text-muted-foreground">Parent Folder</p>
          </div>
        </button>)

(ann FileRow (Fn [AppState FileItem] Html))
(defn FileRow [state file]
  (let [kbRoot (and file.isDirectory (knowledgeBase? state file.path))]
    #html <tr data-file-path={file.path}
              class={(rowClass state file)}
              tabindex="0"
              draggable="true"
              on:click={{:kind :open-file :file file}}
              on:dragstart={(fileDragStartMessage file.path event)}
              on:dragend={{:kind :drag-end}}
              on:dragover={(if (and file.isDirectory (currentPathEditable? state))
                               (Event.prevent {:kind :noop})
                               {:kind :noop})}
              on:drop={(if (and file.isDirectory (currentPathEditable? state))
                           (Event.prevent {:kind :drop-on-folder
                                           :sourcePath (dropSourcePathForState state event)
                                           :destPath file.path})
                           {:kind :noop})}
		                                                  on:contextmenu={(Event.prevent {:kind :file-context-menu
		                                                                                  :file file
		                                                                                  :x event.clientX
		                                                                                  :y event.clientY})}>
            <td class="w-[40px] min-w-[40px] max-w-[40px] box-border p-2 align-middle">
              {(if kbRoot
                   #html <div data-kb-root-icon="true" class="flex items-center justify-center">
                           {(BrowserFileIcon state file (browserFileIconClass file))}
                         </div>
                   #html <div class="flex items-center justify-center">
                           {(BrowserFileIcon state file (browserFileIconClass file))}
                         </div>)}
            </td>
            <td class="min-w-0 p-2 align-middle font-medium">
              <div class="flex min-w-0 items-center gap-2">
                {(if file.isDirectory
                     #html <span class="hidden"></span>
                     #html <button type="button"
                                   title={(if (favorite? state file.path) "Remove from favorites" "Add to favorites")}
                                   aria-label={(if (favorite? state file.path) "Remove from favorites" "Add to favorites")}
                                   class="shrink-0 opacity-50 transition-opacity hover:opacity-100 group-hover:opacity-100"
                                   on:click={(Event.stop {:kind :toggle-favorite :path file.path})}>
                             {(if (favorite? state file.path)
                                  (IconStarFilled "h-4 w-4 text-yellow-400")
                                  (IconStar "h-4 w-4 text-muted-foreground"))}
                           </button>)}
                <div class="min-w-0 flex-1">
                  <span class="block truncate font-medium">
                    {file.name}
                    {(if (pathShared? state file.path) (IconLink "ml-1.5 inline h-3 w-3 text-primary opacity-70") #html <span class="hidden"></span>)}
                  </span>
                  {(if (and (isVirtualFolderPath state.currentDir) (not file.isDirectory))
                       #html <span class="block truncate text-xs text-muted-foreground">{(parentDir file.path)}</span>
                       #html <span class="hidden"></span>)}
                </div>
              </div>
            </td>
            <td class="min-w-0 p-2 align-middle text-right text-muted-foreground">
              <div class="flex items-center justify-end gap-2">
	              {(if (and (not file.isDirectory) (> (adminViewCountNumber state file) 0))
	                   #html <span data-testid="file-view-count"
	                               class="inline-flex items-center gap-1 text-xs"
	                               title={(str (adminViewCountNumber state file) " views")}>
	                           {(IconEye "h-3.5 w-3.5 shrink-0")}
	                           <span>{(str (adminViewCountNumber state file))}</span>
	                         </span>
	                   #html <span class="hidden"></span>)}
	              {(if (and (not file.isDirectory) (> (adminShareViewCountNumber state file) 0))
	                   #html <span class="inline-flex items-center gap-1 text-xs text-primary/70"
	                               title={(str (adminShareViewCountNumber state file) " shared views")}>
	                           {(IconShare2 "h-3 w-3 shrink-0")}
	                           <span>{(str (adminShareViewCountNumber state file))}</span>
	                         </span>
	                   #html <span class="hidden"></span>)}
	              <span class="inline-block w-20 shrink-0 tabular-nums">{(if file.isDirectory "" (formatFileSize file.size))}</span>
              </div>
            </td>
          </tr>))

(ann FileCard (Fn [AppState FileItem] Html))
(defn FileCard [state file]
  #html <button type="button"
                role="button"
                data-file-path={file.path}
                class={(cardClass state file)}
                draggable="true"
                on:click={{:kind :open-file :file file}}
                on:dragstart={(fileDragStartMessage file.path event)}
                on:dragend={{:kind :drag-end}}
                on:dragover={(if (and file.isDirectory (currentPathEditable? state))
                                 (Event.prevent {:kind :noop})
                                 {:kind :noop})}
                on:drop={(if (and file.isDirectory (currentPathEditable? state))
                             (Event.prevent {:kind :drop-on-folder
                                             :sourcePath (dropSourcePathForState state event)
                                             :destPath file.path})
                             {:kind :noop})}
	                on:contextmenu={(Event.prevent {:kind :file-context-menu
	                                                                                :file file
	                                                                                :x event.clientX
	                                                                                :y event.clientY})}>
	          <div class="group relative flex aspect-video items-center justify-center overflow-hidden bg-muted">
		            {(if file.isDirectory
		                 #html <span class="hidden"></span>
		                 #html <button type="button"
		                               class={(if (favorite? state file.path)
		                                           "absolute left-1.5 top-1.5 z-10 rounded-full bg-background/90 p-1 shadow-sm transition-all hover:bg-background"
		                                           "absolute left-1.5 top-1.5 z-10 rounded-full bg-background/70 p-1 opacity-60 transition-all hover:bg-background/90 group-hover:opacity-100")}
		                               title={(if (favorite? state file.path) "Remove from favorites" "Add to favorites")}
		                               aria-label={(if (favorite? state file.path) "Remove from favorites" "Add to favorites")}
		                               on:click={(Event.stop {:kind :toggle-favorite :path file.path})}>
		                         {(if (favorite? state file.path)
		                              (IconStarFilled "h-3.5 w-3.5 text-yellow-400")
		                              (IconStar "h-3.5 w-3.5 text-muted-foreground"))}
		                       </button>)}
		            {(if (and (not file.isDirectory)
                              (or (> (adminViewCountNumber state file) 0)
                                  (> (adminShareViewCountNumber state file) 0)))
		                 #html <div data-testid="file-view-count"
		                            class="absolute right-1.5 top-1.5 z-10 flex items-center gap-1">
		                         {(if (> (adminViewCountNumber state file) 0)
		                              #html <div class="flex items-center gap-1 rounded-full bg-background/90 px-2 py-0.5 shadow-sm backdrop-blur-sm"
		                                         title={(str (adminViewCountNumber state file) " views")}>
		                                      {(IconEye "h-3 w-3 text-muted-foreground")}
		                                      <span class="text-xs font-medium text-muted-foreground">{(str (adminViewCountNumber state file))}</span>
		                                    </div>
		                              #html <span class="hidden"></span>)}
		                         {(if (> (adminShareViewCountNumber state file) 0)
		                              #html <div class="flex items-center gap-1 rounded-full bg-background/90 px-2 py-0.5 shadow-sm backdrop-blur-sm"
		                                         title={(str (adminShareViewCountNumber state file) " shared views")}>
		                                      {(IconShare2 "h-3 w-3 text-primary/70")}
		                                      <span class="text-xs font-medium text-primary/70">{(str (adminShareViewCountNumber state file))}</span>
		                                    </div>
		                              #html <span class="hidden"></span>)}
		                       </div>
		                 #html <span class="hidden"></span>)}
		            {(if (showThumbnail? file)
		                 #html <img src={(buildThumbnailUrl file.path nil)}
		                            data-testid={(fileThumbnailTestId file)}
	                            alt={file.name}
	                            class="h-full w-full object-cover"></img>
                 #html <div class="scale-[2.5] [&_svg]:h-6 [&_svg]:w-6">{(BrowserFileIcon state file (browserFileIconClass file))}</div>)}
          </div>
	          <div class="flex min-w-0 flex-col gap-1 p-3">
	            <p class="truncate text-sm font-medium"
	               title={file.name}>
	              {file.name}
	              {(if (pathShared? state file.path)
	                   (IconLink "ml-1 inline h-3 w-3 text-primary opacity-70")
	                   #html <span class="hidden"></span>)}
	            </p>
            {(if (and (isVirtualFolderPath state.currentDir) (not file.isDirectory))
                 #html <p class="truncate text-xs text-muted-foreground">{(parentDir file.path)}</p>
                 #html <div class="flex items-center justify-end text-xs text-muted-foreground">
                         <span>{(if file.isDirectory "" (formatFileSize file.size))}</span>
                       </div>)}
          </div>
        </button>)

(ann FilesListView (Fn [AppState] Html))
(defn FilesListView [state]
  #html <div class="px-4 py-2">
          <table class="directory-table w-full table-fixed caption-bottom text-sm">
            <colgroup>
              <col class="w-[40px]"></col>
              <col></col>
              <col class="w-24"></col>
            </colgroup>
            <tbody class="[&_tr:last-child]:border-0">
              {(if (not (= state.currentDir ""))
                   (ParentRow state)
                   #html <template></template>)}
              {(for [file (visibleBrowserFiles state) index :key file.path]
                 #html <tr data-file-path={file.path}
	                           class={(rowClass state file)}
	                           style={(if (= index (- (count (visibleBrowserFiles state)) 1)) "border-bottom-width:0" nil)}
	                           tabindex="0"
	                           draggable="true"
	                           on:click={{:kind :open-file :file file}}
	                           on:dragstart={(fileDragStartMessage file.path event)}
	                           on:dragend={{:kind :drag-end}}
	                           on:dragover={(if (and file.isDirectory (currentPathEditable? state))
	                                            (Event.prevent {:kind :noop})
	                                            {:kind :noop})}
	                           on:drop={(if (and file.isDirectory (currentPathEditable? state))
	                                        (Event.prevent {:kind :drop-on-folder
	                                                        :sourcePath (dropSourcePathForState state event)
	                                                        :destPath file.path})
	                                        {:kind :noop})}
	                           on:contextmenu={(Event.prevent {:kind :file-context-menu
	                                                           :file file
	                                                           :x event.clientX
	                                                           :y event.clientY})}>
	                         <td class="w-[40px] min-w-[40px] max-w-[40px] box-border p-2 align-middle">
	                           {(if (and file.isDirectory (knowledgeBase? state file.path))
	                                #html <div data-kb-root-icon="true" class="flex items-center justify-center">
	                                        {(BrowserFileIcon state file (browserFileIconClass file))}
	                                      </div>
	                                #html <div class="flex items-center justify-center">
	                                        {(BrowserFileIcon state file (browserFileIconClass file))}
	                                      </div>)}
	                         </td>
	                         <td class="min-w-0 p-2 align-middle font-medium">
	                           <div class="flex min-w-0 items-center gap-2">
	                             {(if file.isDirectory
	                                  #html <span class="hidden"></span>
	                                  #html <button type="button"
	                                                title={(if (favorite? state file.path) "Remove from favorites" "Add to favorites")}
	                                                aria-label={(if (favorite? state file.path) "Remove from favorites" "Add to favorites")}
	                                                class="shrink-0 opacity-50 transition-opacity hover:opacity-100 group-hover:opacity-100"
	                                                on:click={(Event.stop {:kind :toggle-favorite :path file.path})}>
	                                    {(if (favorite? state file.path)
	                                         (IconStarFilled "h-4 w-4 text-yellow-400")
	                                         (IconStar "h-4 w-4 text-muted-foreground"))}
	                                  </button>)}
	                             <div class="min-w-0 flex-1">
	                               <span class="block truncate font-medium">
	                                 {file.name}
	                                 {(if (pathShared? state file.path) (IconLink "ml-1.5 inline h-3 w-3 text-primary opacity-70") #html <span class="hidden"></span>)}
	                               </span>
	                               {(if (and (isVirtualFolderPath state.currentDir) (not file.isDirectory))
	                                    #html <span class="block truncate text-xs text-muted-foreground">{(parentDir file.path)}</span>
	                                    #html <span class="hidden"></span>)}
	                             </div>
	                           </div>
	                         </td>
		                         <td class="min-w-0 p-2 align-middle text-right text-muted-foreground">
		                           <div class="flex items-center justify-end gap-2">
		                             {(if (and (not file.isDirectory) (> (adminViewCountNumber state file) 0))
		                                  #html <span data-testid="file-view-count"
		                                              class="inline-flex items-center gap-1 text-xs"
		                                              title={(str (adminViewCountNumber state file) " views")}>
		                                          {(IconEye "h-3.5 w-3.5 shrink-0")}
		                                          <span>{(str (adminViewCountNumber state file))}</span>
		                                        </span>
		                                  #html <span class="hidden"></span>)}
		                             {(if (and (not file.isDirectory) (> (adminShareViewCountNumber state file) 0))
		                                  #html <span class="inline-flex items-center gap-1 text-xs text-primary/70"
		                                              title={(str (adminShareViewCountNumber state file) " shared views")}>
		                                          {(IconShare2 "h-3 w-3 shrink-0")}
		                                          <span>{(str (adminShareViewCountNumber state file))}</span>
		                                        </span>
		                                  #html <span class="hidden"></span>)}
		                             <span class="inline-block w-20 shrink-0 tabular-nums">{(if file.isDirectory "" (formatFileSize file.size))}</span>
		                           </div>
		                         </td>
	                       </tr>)}
              {(if (= (count state.files) 0)
                   #html <tr data-testid="directory-empty">
                           <td colspan="3" class="p-8 text-center">
                             <div>
                               <p class="text-sm font-medium text-foreground">This folder is empty</p>
                               <p class="mt-1 text-xs text-muted-foreground">There are no files in this folder.</p>
                             </div>
                           </td>
                         </tr>
                   #html <template></template>)}
            </tbody>
          </table>
        </div>)

(ann FilesGridView (Fn [AppState] Html))
(defn FilesGridView [state]
  #html <div class="file-browser-grid gap-4 py-4 px-4">
          {(if (not (= state.currentDir ""))
               (ParentCard state)
               #html <span class="hidden"></span>)}
          {(for [file (visibleBrowserFiles state) :key file.path]
             #html <div class="contents">{(FileCard state file)}</div>)}
        </div>)

(ann SelectedFileBanner (Fn [AppState] Html))
(defn SelectedFileBanner [state]
  #html <div>
          {(if (some? state.viewingPath)
               #html <div class="border-t border-border bg-muted/30 px-4 py-3 text-sm">
                       <span class="font-medium">Selected:</span>
                       <span class="ml-2 text-muted-foreground">{(selectedViewingName state)}</span>
                     </div>
               #html <div class="hidden"></div>)}
        </div>)

(ann DirectoryBody (Fn [AppState] Html))
(defn DirectoryBody [state]
  #html <div>
          {(if (some? state.filesError)
               (ErrorPanel state.filesError)
               (if state.filesPending
                   (LoadingView)
                   (if (and state.kbSearchOpen (currentKnowledgeBase? state))
                       #html <div class="hidden"></div>
                       #html <div>
                               {(KnowledgeBaseRecentStrip state)}
                               {(if (= (count state.files) 0)
                                    (FilesListView state)
                                    (if (= state.viewMode "grid")
                                        (FilesGridView state)
                                        (FilesListView state)))}
                             </div>)))}
        </div>)

(ann ContextMenuItemClass (Fn [] String))
(defn ContextMenuItemClass []
  "flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-left text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground")

(ann BreadcrumbContextMenuItems (Fn [AppState] Html))
(defn BreadcrumbContextMenuItems [state]
  #html <div>
          {(if (shareRoute? state)
               #html <a data-slot="context-menu-item"
                        data-testid="breadcrumb-menu-download-zip"
                        role="menuitem"
                        class={(ContextMenuItemClass)}
                        href={(str "/api/share/" (match state.shareToken nil "" (some token) token) "/download")}>Download ZIP</a>
               #html <span class="hidden"></span>)}
          <button type="button"
                  data-slot="context-menu-item"
                  data-testid="breadcrumb-menu-set-icon"
                  role="menuitem"
                  class={(ContextMenuItemClass)}
                  on:click={{:kind :close-context-menu}}>Set icon</button>
          <button type="button"
                  data-slot="context-menu-item"
                  data-testid="breadcrumb-menu-open-new-tab"
                  role="menuitem"
                  class={(ContextMenuItemClass)}
                  on:click={{:kind :close-context-menu}}>Open in new tab</button>
          <button type="button"
                  data-slot="context-menu-item"
                  data-testid="breadcrumb-menu-open-workspace"
                  role="menuitem"
                  class={(ContextMenuItemClass)}
                  on:click={{:kind :context-open-workspace}}>Open in Workspace</button>
        </div>)

(ann FileContextMenuItems (Fn [AppState] Html))
(defn FileContextMenuItems [state]
  #html <div>
          {(if state.menuIsDirectory
               #html <button type="button"
                             data-slot="context-menu-item"
                             role="menuitem"
                             class={(ContextMenuItemClass)}
                             on:click={{:kind :context-open-workspace}}>Open in Workspace</button>
	               #html <span class="hidden"></span>)}
          {(if (and state.menuIsDirectory (not (isVirtualFolderPath state.menuPath)))
               #html <button type="button"
                             data-slot="context-menu-item"
                             role="menuitem"
                             class={(ContextMenuItemClass)}
                             on:click={{:kind :admin-open-icon
                                        :path state.menuPath
                                        :name (fileNameFromPath state.menuPath)}}>Set icon</button>
               #html <span class="hidden"></span>)}
          {(if (and state.menuIsDirectory (not (isVirtualFolderPath state.menuPath)))
               #html <button type="button"
                             data-slot="context-menu-item"
                             role="menuitem"
                             class={(ContextMenuItemClass)}
                             on:click={{:kind :context-toggle-knowledge-base}}>
                       {(if (knowledgeBase? state state.menuPath) "Remove Knowledge Base" "Set as Knowledge Base")}
                     </button>
               #html <span class="hidden"></span>)}
	          {(if (= state.currentDir virtualFolderShares)
	               #html <button type="button"
	                             data-slot="context-menu-item"
	                             role="menuitem"
	                             class={(ContextMenuItemClass)}
	                             on:click={{:kind :admin-open-share
	                                        :path state.menuPath
	                                        :name (fileNameFromPath state.menuPath)
	                                        :isDirectory state.menuIsDirectory}}>Revoke Share</button>
	               #html <button type="button"
	                             data-slot="context-menu-item"
	                             role="menuitem"
	                             class={(ContextMenuItemClass)}
	                             on:click={{:kind :admin-open-share
	                                        :path state.menuPath
	                                        :name (fileNameFromPath state.menuPath)
	                                        :isDirectory state.menuIsDirectory}}>{(if (pathShared? state state.menuPath) "Manage Share" "Share")}</button>)}
	          <button type="button"
	                  data-slot="context-menu-item"
	                  role="menuitem"
                  class={(ContextMenuItemClass)}
                  on:click={{:kind :download-url
                             :url (fileDownloadHref state.menuPath nil)
                             :filename (if state.menuIsDirectory (str (fileNameFromPath state.menuPath) ".zip") (fileNameFromPath state.menuPath))}}>
            {(if state.menuIsDirectory "Download as ZIP" "Download")}
          </button>
          {(if (and (> (count state.editableFolders) 0)
                    (not (isVirtualFolderPath state.menuPath)))
               #html <button type="button"
                             data-slot="context-menu-item"
                             role="menuitem"
                             class={(ContextMenuItemClass)}
                             on:click={{:kind :admin-open-transfer
                                        :mode "copy"
                                        :path state.menuPath
                                        :name (fileNameFromPath state.menuPath)
                                        :isDirectory state.menuIsDirectory}}>Copy to...</button>
               #html <span class="hidden"></span>)}
          {(if (and (currentPathEditable? state)
                    (not (isVirtualFolderPath state.menuPath)))
               #html <div>
                       <div class="my-1 h-px bg-border" role="separator"></div>
                       <button type="button"
                               data-slot="context-menu-item"
                               role="menuitem"
                               class={(ContextMenuItemClass)}
                               on:click={{:kind :admin-open-transfer
                                          :mode "move"
                                          :path state.menuPath
                                          :name (fileNameFromPath state.menuPath)
                                          :isDirectory state.menuIsDirectory}}>Move to...</button>
                       <button type="button"
                               data-slot="context-menu-item"
                               role="menuitem"
                               class={(ContextMenuItemClass)}
                               on:click={{:kind :admin-open-rename
                                          :path state.menuPath
                                          :name (fileNameFromPath state.menuPath)
                                          :isDirectory state.menuIsDirectory}}>Rename</button>
                       <button type="button"
                               data-slot="context-menu-item"
                               role="menuitem"
                               class={(str "text-destructive " (ContextMenuItemClass))}
                               on:click={{:kind :admin-open-delete
                                          :path state.menuPath
                                          :name (fileNameFromPath state.menuPath)
                                          :isDirectory state.menuIsDirectory}}>Delete</button>
                     </div>
               #html <span class="hidden"></span>)}
          <button type="button"
                  data-slot="context-menu-item"
                  role="menuitem"
	                  class={(ContextMenuItemClass)}
	                  on:click={{:kind :context-favorite}}>{(if (favorite? state state.menuPath) "Unfavorite" "Favorite")}</button>
		        </div>)

(ann WorkspaceFileContextMenuItems (Fn [AppState] Html))
(defn WorkspaceFileContextMenuItems [state]
  (let [file (menuFileOrEmpty state)
        windowId state.workspaceContextMenuWindowId
        shareWorkspace (shareWorkspacePath? state.pathname)
        canAdminEdit (adminCurrentPathEditable? state)
        canEdit (if shareWorkspace state.shareAllowEdit canAdminEdit)
        canDelete (if shareWorkspace state.shareAllowDelete canAdminEdit)]
    #html <div>
            <button type="button"
                    data-slot="context-menu-item"
                    role="menuitem"
                    class={(ContextMenuItemClass)}
                    on:click={{:kind :workspace-open-in-new-tab
                               :windowId windowId
                               :file file}}>Open in new tab</button>
            <button type="button"
                    data-slot="context-menu-item"
                    role="menuitem"
                    data-testid="workspace-file-menu-open-split-view"
                    class={(ContextMenuItemClass)}
                    on:click={{:kind :workspace-open-in-split-view
                               :windowId windowId
                               :file file}}>Open in split view</button>
            <button type="button"
                    data-slot="context-menu-item"
                    role="menuitem"
                    class={(ContextMenuItemClass)}
                    on:click={(if shareWorkspace
                                  {:kind :noop}
                                  {:kind :admin-open-share
                                   :path file.path
                                   :name file.name
                                   :isDirectory file.isDirectory})}>{(if shareWorkspace "" "Share")}</button>
            <button type="button"
                    data-slot="context-menu-item"
                    role="menuitem"
                    class={(ContextMenuItemClass)}
                    on:click={(if shareWorkspace
                                  {:kind :noop}
                                  {:kind :admin-open-icon
                                   :path file.path
                                   :name file.name})}>{(if shareWorkspace "" "Set icon")}</button>
            <button type="button"
                    data-slot="context-menu-item"
                    role="menuitem"
                    class={(ContextMenuItemClass)}
                    on:click={{:kind :workspace-add-taskbar :file file}}>Add to taskbar</button>
            {(if canEdit
                 #html <button type="button"
                               data-slot="context-menu-item"
                               role="menuitem"
                               class={(ContextMenuItemClass)}
                               on:click={(if shareWorkspace
                                             {:kind :share-open-rename :file file}
                                             {:kind :admin-open-rename
                                              :path file.path
                                              :name file.name
                                              :isDirectory file.isDirectory})}>Rename</button>
                 #html <span class="hidden"></span>)}
            {(if canDelete
                 #html <button type="button"
                               data-slot="context-menu-item"
                               role="menuitem"
                               class={(str "text-destructive " (ContextMenuItemClass))}
                               on:click={(if shareWorkspace
                                             {:kind :share-open-delete :file file}
                                             {:kind :admin-open-delete
                                              :path file.path
                                              :name file.name
                                              :isDirectory file.isDirectory})}>Delete</button>
                 #html <span class="hidden"></span>)}
          </div>))

(ann ShareFileContextMenuItems (Fn [AppState] Html))
(defn ShareFileContextMenuItems [state]
  #html <div>
          {(if state.menuIsDirectory
               #html <button type="button"
                             data-slot="context-menu-item"
                             role="menuitem"
                             class={(ContextMenuItemClass)}
                             on:click={{:kind :context-open-workspace}}>Open in Workspace</button>
               #html <span class="hidden"></span>)}
          <button type="button"
                  data-slot="context-menu-item"
                  role="menuitem"
                  class={(ContextMenuItemClass)}
                  on:click={{:kind :share-open-rename :file (menuShareFileOrEmpty state)}}>Rename</button>
          {(if state.shareAllowDelete
               #html <button type="button"
                             data-slot="context-menu-item"
                             role="menuitem"
                             class={(ContextMenuItemClass)}
                             on:click={{:kind :share-open-delete :file (menuShareFileOrEmpty state)}}>Delete</button>
               #html <span class="hidden"></span>)}
        </div>)

(ann ContextMenuView (Fn [AppState] Html))
(defn ContextMenuView [state]
  #html <div>
          {(if (and state.menuOpen
                    (not (= state.menuKind "breadcrumb-path-all"))
                    (not (= state.menuKind "breadcrumb-path-hidden")))
               #html <div role="menu"
                          data-slot={(if (= state.menuKind "breadcrumb")
                                         "breadcrumb-context-menu"
                                         (if (= state.menuKind "workspace-file")
                                             "file-row-context-menu"
                                             "context-menu"))}
                          class="fixed z-[100000] min-w-48 rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
                          style={{:left (str (clampMenuLeft state.menuX) "px")
                                  :top (str (clampMenuTop state.menuY) "px")
                                  :max-height (str (max 160 (- jsWindow.innerHeight 16)) "px")
                                  :overflow-y "auto"}}>
			                       {(if (= state.menuKind "breadcrumb")
			                            (BreadcrumbContextMenuItems state)
			                            (if (= state.menuKind "workspace-pin")
			                                #html <button type="button"
			                                              data-slot="context-menu-item"
			                                              role="menuitem"
			                                              class={(ContextMenuItemClass)}
			                                              on:click={{:kind :workspace-remove-taskbar-pin
			                                                         :id state.menuPath}}>Unpin</button>
			                                (if (= state.menuKind "workspace-file")
			                                (WorkspaceFileContextMenuItems state)
			                                (if (or (shareRoute? state) (shareWorkspacePath? state.pathname))
			                                    (ShareFileContextMenuItems state)
			                                    (FileContextMenuItems state)))))}
			                     </div>
               #html <span class="hidden"></span>)}
        </div>)

(ann AdminCreateDialog (Fn [AppState] Html))
(defn AdminCreateDialog [state]
  (if (= state.adminCreateKind "none")
      #html <span class="hidden"></span>
      #html <div data-no-window-drag
                 class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :admin-close-dialog}}>
              <div role="dialog"
                   aria-modal="true"
                   class="w-full max-w-md rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 class="text-lg font-semibold">{(if (= state.adminCreateKind "folder") "Create New Folder" "Create New File")}</h2>
                <p class="mt-1 text-sm text-muted-foreground">
                  {(if (= state.adminCreateKind "folder")
                       "Enter a name for the new folder."
                       (str "Enter a name for the new file. " (adminDefaultExtension state) " extension will be added if no extension is provided."))}
                </p>
                <form class="mt-4 space-y-4"
                      on:submit={(Event.prevent {:kind :admin-create-submit})}>
                  <input type="text"
                         class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
                         placeholder={(if (= state.adminCreateKind "folder") "Folder name" (str "File name (e.g., notes" (adminDefaultExtension state) ")"))}
                         value={state.adminCreateName}
                         autofocus
                         disabled={state.adminCreatePending}
                         on:input={{:kind :admin-create-name :value event.currentTarget.value}}></input>
                  {(if (some? state.adminCreateError)
                       #html <p class="text-sm text-destructive">{state.adminCreateError}</p>
                       #html <p class="hidden"></p>)}
                  <div class="flex justify-end gap-2">
                    <button type="button"
                            class="h-9 rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent"
                            disabled={state.adminCreatePending}
                            on:click={{:kind :admin-close-dialog}}>Cancel</button>
                    <button type="submit"
                            class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
                            disabled={(or state.adminCreatePending (= (trim state.adminCreateName) ""))}>
                      {(if state.adminCreatePending "Creating..." "Create")}
                    </button>
                  </div>
                </form>
              </div>
            </div>))

(ann AdminRenameDialog (Fn [AppState] Html))
(defn AdminRenameDialog [state]
  (if state.adminRenameOpen
      #html <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :admin-close-dialog}}>
              <div role="dialog"
                   aria-modal="true"
                   class="w-full max-w-md rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 class="truncate text-lg font-semibold">{(str "Rename " state.adminRenameName)}</h2>
                <p class="mt-1 text-sm text-muted-foreground">{(str "Enter a new name for this " (if state.adminRenameIsDirectory "folder" "file") ".")}</p>
                <form class="mt-4 space-y-4"
                      on:submit={(Event.prevent {:kind :admin-rename-submit})}>
                  <input type="text"
                         class="w-full rounded-md border border-input bg-background px-3 py-2 text-sm outline-none focus-visible:ring-2 focus-visible:ring-ring"
                         placeholder="New name"
                         value={state.adminRenameName}
                         autofocus
                         disabled={state.adminRenamePending}
                         on:input={{:kind :admin-rename-name :value event.currentTarget.value}}></input>
                  {(if (some? state.adminRenameError)
                       #html <p class="text-sm text-destructive">{state.adminRenameError}</p>
                       #html <p class="hidden"></p>)}
                  <div class="flex justify-end gap-2">
                    <button type="button"
                            class="h-9 rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent"
                            disabled={state.adminRenamePending}
                            on:click={{:kind :admin-close-dialog}}>Cancel</button>
                    <button type="submit"
                            class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
                            disabled={(or state.adminRenamePending
                                          (= (trim state.adminRenameName) "")
                                          (= state.adminRenameName (fileNameFromPath state.adminRenameOldPath)))}>
                      {(if state.adminRenamePending "Renaming..." "Rename")}
                    </button>
                  </div>
                </form>
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann AdminDeleteDialog (Fn [AppState] Html))
(defn AdminDeleteDialog [state]
  (if state.adminDeleteOpen
      #html <div data-no-window-drag
                 class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :admin-close-dialog}}>
              <div role="alertdialog"
                   aria-modal="true"
                   class="w-full max-w-md rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 class="text-lg font-semibold">{(if state.adminDeleteIsDirectory "Delete Folder?" "Delete File?")}</h2>
                <p class="mt-2 text-sm text-muted-foreground">{(str "Are you sure you want to delete \"" state.adminDeleteName "\"?")}</p>
                <p class="mt-2 text-sm font-medium text-foreground">This action cannot be undone.</p>
                {(if (some? state.adminDeleteError)
                     #html <p class="mt-3 text-sm text-destructive">{state.adminDeleteError}</p>
                     #html <p class="hidden"></p>)}
                <div class="mt-6 flex justify-end gap-2">
                  <button type="button"
                          class="h-9 rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent"
                          on:click={{:kind :admin-close-dialog}}>Cancel</button>
                  <button type="button"
                          class="h-9 rounded-md bg-destructive px-4 text-sm font-medium text-destructive-foreground hover:bg-destructive/90 disabled:opacity-50"
                          disabled={state.adminDeletePending}
                          on:click={{:kind :admin-delete-submit}}>
                    {(if state.adminDeletePending "Deleting..." "Delete")}
                  </button>
                </div>
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann adminTransferButtonDisabled? (Fn [AppState] Bool))
(defn adminTransferButtonDisabled? [state]
  (or state.adminTransferPending
      (= state.adminTransferPath "")
      (and (= state.adminTransferMode "move")
           (or (= state.adminTransferBrowsePath (parentDir state.adminTransferPath))
               (not (pathCanMoveInto? state.adminTransferPath state.adminTransferBrowsePath))))))

(ann adminTransferFolders (Fn [AppState] (Vector FileItem)))
(defn adminTransferFolders [state]
  (filter state.files
          (fn [file]
            (and file.isDirectory
                 (pathCanMoveInto? state.adminTransferPath file.path)))))

(ann AdminTransferDialog (Fn [AppState] Html))
(defn AdminTransferDialog [state]
  (if (= state.adminTransferMode "none")
      #html <span class="hidden"></span>
      #html <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :admin-close-dialog}}>
              <div role="dialog"
                   aria-modal="true"
                   class="w-full max-w-md rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 class="truncate text-lg font-semibold">{(str (if (= state.adminTransferMode "copy") "Copy" "Move") " \"" state.adminTransferName "\"")}</h2>
                <p class="mt-1 text-sm text-muted-foreground">
                  {(if (= state.adminTransferMode "copy") "Choose an editable destination folder" "Choose a destination folder")}
                </p>
                <div class="mt-3 flex items-center gap-1.5 px-1 text-sm text-muted-foreground">
                  <span class="lucide-folder hidden"></span>
                  <span class="truncate font-mono text-xs">{(if (= state.adminTransferBrowsePath "") "/" state.adminTransferBrowsePath)}</span>
                </div>
                <div class="mt-2 max-h-64 overflow-y-auto rounded-md border border-border">
                  <div class="divide-y divide-border">
                    {(if (not (= state.adminTransferBrowsePath ""))
                         #html <button type="button"
                                       class="flex w-full items-center gap-2.5 px-3 py-2 text-left transition-colors hover:bg-muted/50"
                                       on:click={{:kind :admin-transfer-pick :path (parentDir state.adminTransferBrowsePath)}}>
                                 <span class="text-sm font-medium">..</span>
                               </button>
                         #html <span class="hidden"></span>)}
                    {(for [file (adminTransferFolders state) :key (str "transfer-" file.path)]
                       #html <button type="button"
                                     class={(str "flex w-full items-center gap-2.5 px-3 py-2 text-left transition-colors hover:bg-muted/50 "
                                                 (if (= state.adminTransferBrowsePath file.path) "bg-primary/10" ""))}
                                     on:click={{:kind :admin-transfer-pick :path file.path}}>
                               <span class="lucide-folder hidden"></span>
                               <span class="truncate text-sm">{file.name}</span>
                             </button>)}
                  </div>
                </div>
                {(if (some? state.adminTransferError)
                     #html <p class="mt-3 rounded-md border border-destructive/50 bg-destructive/10 px-3 py-2 text-sm text-destructive">{state.adminTransferError}</p>
                     #html <p class="hidden"></p>)}
                <div class="mt-6 flex justify-end gap-2">
                  <button type="button"
                          class="h-9 rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent"
                          disabled={state.adminTransferPending}
                          on:click={{:kind :admin-close-dialog}}>Cancel</button>
                  <button type="button"
                          class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
                          disabled={(adminTransferButtonDisabled? state)}
                          on:click={{:kind :admin-transfer-submit}}>
                    {(if state.adminTransferPending
                         (if (= state.adminTransferMode "copy") "Copying..." "Moving...")
                         (if (= state.adminTransferMode "copy") "Copy here" "Move here"))}
                  </button>
	                </div>
	              </div>
	            </div>))

(ann AdminShareLinkRow (Fn [AppState ShareLink] Html))
(defn AdminShareLinkRow [state share]
  #html <div class="rounded-md border border-border p-3">
          <div class="flex items-center gap-2">
            <input readonly
                   class="h-9 min-w-0 flex-1 rounded-md border border-input bg-muted/40 px-3 text-sm"
                   value={(adminShareUrl state share)}></input>
            <button type="button"
                    title="Copy link"
                    aria-label="Copy link"
                    class="inline-flex h-9 shrink-0 items-center rounded-md border border-border px-3 text-sm"
                    on:click={{:kind :noop}}>Copy</button>
          </div>
          <div class="mt-2 flex items-center justify-between gap-2 text-xs text-muted-foreground">
            <span>{(if share.editable "Editable share" "Read-only share")}</span>
            <button type="button"
                    class="inline-flex h-8 items-center rounded-md border border-destructive/50 px-3 text-xs font-medium text-destructive disabled:opacity-50"
                    disabled={(= state.adminShareDeletingToken share.token)}
                    on:click={{:kind :admin-share-delete :token share.token}}>
              {(if (= state.adminShareDeletingToken share.token) "Revoking..." "Revoke")}
            </button>
          </div>
        </div>)

(ann AdminShareDialog (Fn [AppState] Html))
(defn AdminShareDialog [state]
  (if state.adminShareOpen
      (let [links (adminSharesForPath state state.adminSharePath)]
        #html <div data-no-window-drag
                   class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                   role="presentation"
                   on:click={{:kind :admin-close-dialog}}>
                <div role="dialog"
                     aria-modal="true"
                     class="max-h-[90vh] w-full max-w-lg overflow-auto rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                     on:click={(Event.stop {:kind :noop})}>
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <h2 class="text-lg font-semibold">Share Links</h2>
                      <p class="mt-1 truncate text-sm text-muted-foreground">{state.adminShareName}</p>
                    </div>
                    <button type="button"
                            title="Close"
                            class="inline-flex h-8 shrink-0 items-center rounded-md border border-border px-3 text-sm"
                            on:click={{:kind :admin-close-dialog}}>Close</button>
                  </div>
                  <div class="mt-4 space-y-3">
	                    {(if (= (count links) 0)
	                         #html <p class="rounded-md border border-dashed border-border p-4 text-sm text-muted-foreground">No share links yet.</p>
	                         #html <div class="space-y-3">
	                                 {(for [share links :key share.token]
	                                    #html <div class="contents">{(AdminShareLinkRow state share)}</div>)}
	                               </div>)}
                  </div>
                  <div class="mt-5">
                    {(if state.adminShareCreateOpen
                         #html <form class="space-y-4"
                                     on:submit={(Event.prevent {:kind :admin-share-create})}>
                                 <label class="flex cursor-pointer items-center gap-2 text-sm">
                                   <input type="checkbox"
                                          checked={state.adminShareEditable}
                                          on:change={{:kind :admin-share-editable :editable event.currentTarget.checked}}></input>
                                   <span>Allow editing</span>
                                 </label>
                                 {(if state.adminShareEditable
                                      #html <div class="space-y-2 rounded-md border border-border p-3">
                                              <label class="flex cursor-pointer items-center gap-2 text-sm">
                                                <input type="checkbox"
                                                       checked={state.adminShareAllowUpload}
                                                       on:change={{:kind :admin-share-allow-upload :enabled event.currentTarget.checked}}></input>
                                                <span>Allow uploads</span>
                                              </label>
                                              <label class="flex cursor-pointer items-center gap-2 text-sm">
                                                <input type="checkbox"
                                                       checked={state.adminShareAllowEdit}
                                                       on:change={{:kind :admin-share-allow-edit :enabled event.currentTarget.checked}}></input>
                                                <span>Allow edits</span>
                                              </label>
                                              <label class="flex cursor-pointer items-center gap-2 text-sm">
                                                <input type="checkbox"
                                                       checked={state.adminShareAllowDelete}
                                                       on:change={{:kind :admin-share-allow-delete :enabled event.currentTarget.checked}}></input>
                                                <span>Allow delete</span>
                                              </label>
                                            </div>
                                      #html <span class="hidden"></span>)}
                                 {(if (some? state.adminShareError)
                                      #html <p class="text-sm text-destructive">{state.adminShareError}</p>
                                      #html <p class="hidden"></p>)}
                                 <div class="flex justify-end gap-2">
                                   <button type="button"
                                           class="h-9 rounded-md border border-border px-4 text-sm font-medium"
                                           disabled={state.adminSharePending}
                                           on:click={{:kind :admin-close-dialog}}>Cancel</button>
                                   <button type="submit"
                                           class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
                                           disabled={state.adminSharePending}>
                                     {(if state.adminSharePending "Creating..." "Create")}
                                   </button>
                                 </div>
                               </form>
                         #html <button type="button"
                                       class="inline-flex h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
                                       disabled={state.adminSharePending}
                                       on:click={{:kind :admin-share-show-create}}>Create New Share Link</button>)}
                  </div>
                </div>
              </div>)
      #html <span class="hidden"></span>))

(ann AdminPasteDialog (Fn [AppState] Html))
(defn AdminPasteDialog [state]
  (if state.adminPasteOpen
      #html <div data-no-window-drag
                 class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :admin-close-dialog}}>
              <div role="dialog"
                   aria-modal="true"
                   class="w-full max-w-lg rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 class="text-lg font-semibold">Paste Text</h2>
                <p class="mt-1 text-sm text-muted-foreground">Create a new text file from the clipboard.</p>
                <form class="mt-4 space-y-4"
                      on:submit={(Event.prevent {:kind :admin-paste-submit})}>
                  <input type="text"
                         class="h-9 w-full rounded-md border border-input bg-background px-3 text-sm"
                         value={state.adminPasteName}
                         on:input={{:kind :admin-paste-name :value event.currentTarget.value}}></input>
                  <pre class="max-h-56 overflow-auto whitespace-pre-wrap rounded-md border border-border bg-muted/30 p-3 text-sm">{state.adminPasteContent}</pre>
                  {(if (some? state.adminPasteError)
                       #html <p class="text-sm text-destructive">{state.adminPasteError}</p>
                       #html <p class="hidden"></p>)}
                  <div class="flex justify-end gap-2">
                    <button type="button"
                            class="h-9 rounded-md border border-border px-4 text-sm font-medium"
                            disabled={state.adminPastePending}
                            on:click={{:kind :admin-close-dialog}}>Cancel</button>
                    <button type="submit"
                            class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground disabled:opacity-50"
                            disabled={(or state.adminPastePending (= (trim state.adminPasteName) ""))}>
                      {(if state.adminPastePending "Pasting..." "Paste")}
                    </button>
                  </div>
                </form>
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann AdminIconDialog (Fn [AppState] Html))
(defn AdminIconDialog [state]
  (if state.adminIconDialogOpen
      #html <div data-no-window-drag
                 class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4"
                 role="presentation"
                 on:click={{:kind :admin-close-dialog}}>
              <div data-slot="dialog-content"
                   role="dialog"
                   aria-modal="true"
                   class="max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-lg border border-border bg-card p-6 text-card-foreground shadow-lg"
                   on:click={(Event.stop {:kind :noop})}>
                <h2 class="text-lg font-semibold">Set Custom Icon</h2>
                <p class="mt-1 text-sm text-muted-foreground">{(str "Choose an icon for " (fileNameFromPath state.adminIconPath))}</p>
                <div class="mt-4 grid grid-cols-4 gap-2 sm:grid-cols-6">
                  <button type="button"
                          title="folder"
                          class={(str "rounded-lg border-2 p-3 text-sm hover:bg-muted "
                                      (if (= state.adminIconName "folder") "border-primary bg-primary/10" "border-border"))}
                          on:click={{:kind :admin-icon-pick :name "folder"}}>Folder</button>
                  <button type="button"
                          title="book-open"
                          class={(str "rounded-lg border-2 p-3 text-sm hover:bg-muted "
                                      (if (= state.adminIconName "book-open") "border-primary bg-primary/10" "border-border"))}
                          on:click={{:kind :admin-icon-pick :name "book-open"}}>Book</button>
                  <button type="button"
                          title="file-text"
                          class={(str "rounded-lg border-2 p-3 text-sm hover:bg-muted "
                                      (if (= state.adminIconName "file-text") "border-primary bg-primary/10" "border-border"))}
                          on:click={{:kind :admin-icon-pick :name "file-text"}}>Text</button>
                  <button type="button"
                          title="star"
                          class={(str "rounded-lg border-2 p-3 text-sm hover:bg-muted "
                                      (if (= state.adminIconName "star") "border-primary bg-primary/10" "border-border"))}
                          on:click={{:kind :admin-icon-pick :name "star"}}>Star</button>
                </div>
                {(if (some? state.adminIconError)
                     #html <p class="mt-3 text-sm text-destructive">{state.adminIconError}</p>
                     #html <p class="hidden"></p>)}
                <div class="mt-6 flex justify-end gap-2">
                  <button type="button"
                          class="h-9 rounded-md border border-input bg-background px-4 text-sm font-medium hover:bg-accent"
                          disabled={state.adminIconPending}
                          on:click={{:kind :admin-close-dialog}}>Cancel</button>
                  <button type="button"
                          class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
                          disabled={(or state.adminIconPending (= state.adminIconName ""))}
                          on:click={{:kind :admin-icon-save}}>
                    {(if state.adminIconPending "Saving..." "Save")}
                  </button>
                </div>
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann AdminDialogLayer (Fn [AppState] Html))
(defn AdminDialogLayer [state]
  #html <div>
          {(AdminCreateDialog state)}
          {(AdminRenameDialog state)}
          {(AdminDeleteDialog state)}
          {(AdminTransferDialog state)}
          {(AdminShareDialog state)}
          {(AdminPasteDialog state)}
          {(AdminIconDialog state)}
        </div>)

(ann AdminUploadToast (Fn [AppState] Html))
(defn AdminUploadToast [state]
  #html <div>
          {(if (some? state.adminUploadStatus)
               #html <div class="fixed bottom-4 right-4 z-50 rounded-md border border-border bg-popover px-4 py-3 text-sm text-popover-foreground shadow-lg">
                       {state.adminUploadStatus}
                     </div>
               #html <span class="hidden"></span>)}
        </div>)

(ann LoginView (Fn [AppState] Html))
(defn LoginView [state]
  #html <div class="relative min-h-screen flex items-center justify-center p-4">
          {(FloatingThemeButton)}
          <div class="w-full max-w-sm rounded-xl border border-border bg-card text-card-foreground shadow-sm">
            <div class="p-6 space-y-1">
              <h1 class="text-xl font-semibold">Media Server</h1>
              <p class="text-sm text-muted-foreground">Enter password to continue</p>
            </div>
            <div class="p-6 pt-0">
              <form class="space-y-4"
                    on:submit={(Event.prevent {:kind :login-submit})}>
                <input class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:opacity-50"
                       type="password"
                       placeholder="Password"
                       autocomplete="current-password"
                       autofocus
                       value={state.loginPassword}
                       disabled={state.loginPending}
                       on:input={{:kind :login-password :value event.currentTarget.value}}></input>
                {(if (some? state.loginError)
                    #html <p class="text-sm text-destructive">{state.loginError}</p>
                    #html <p class="hidden"></p>)}
                <button type="submit"
                        class="w-full h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow-sm hover:bg-primary/90 disabled:opacity-50"
                        disabled={state.loginPending}>{(if state.loginPending "Signing in..." "Sign in")}</button>
              </form>
            </div>
          </div>
        </div>)

(ann PlaceholderRouteView (Fn [AppState] Html))
(defn PlaceholderRouteView [state]
  #html <main class="min-h-screen bg-background text-foreground"
              data-route={(routeLabel state)}>
          {(FloatingThemeButton)}
          <section class="mx-auto flex min-h-screen max-w-4xl flex-col justify-center px-6 py-12">
            <p class="text-sm font-medium uppercase tracking-wide text-muted-foreground">{(routeLabel state)}</p>
            <h1 class="mt-3 text-3xl font-semibold">{(routeTitle state)}</h1>
            <p class="mt-3 max-w-2xl text-sm text-muted-foreground">{(routeDescription state)}</p>
            <dl class="mt-8 grid gap-3 text-sm sm:grid-cols-2">
              <div class="rounded-lg border border-border bg-card p-4">
                <dt class="font-medium text-card-foreground">Path</dt>
                <dd class="mt-1 break-all text-muted-foreground">{state.pathname}</dd>
              </div>
              <div class="rounded-lg border border-border bg-card p-4">
                <dt class="font-medium text-card-foreground">Search</dt>
                <dd class="mt-1 break-all text-muted-foreground">{(if (= state.search "") "None" state.search)}</dd>
              </div>
            </dl>
	          </section>
	        </main>)

(ann workspaceFiles (Fn [AppState] (Vector FileItem)))
(defn workspaceFiles [state]
  (if (shareWorkspacePath? state.pathname)
      state.shareFiles
      (visibleBrowserFiles state)))

(ann workspaceFilesPending? (Fn [AppState] Bool))
(defn workspaceFilesPending? [state]
  (if (shareWorkspacePath? state.pathname)
      state.shareFilesPending
      state.filesPending))

(ann workspaceFilesError (Fn [AppState] (Option String)))
(defn workspaceFilesError [state]
  (if (shareWorkspacePath? state.pathname)
      state.shareFilesError
      state.filesError))

(ann workspaceFilesErrorText (Fn [AppState] String))
(defn workspaceFilesErrorText [state]
  (let [error (workspaceFilesError state)]
    (if (string? error) error "")))

(ann workspaceFileSubtitle (Fn [FileItem] String))
(defn workspaceFileSubtitle [file]
  (if file.isDirectory "" (formatFileSize file.size)))

(ann workspaceCurrentKnowledgeBase? (Fn [AppState String] Bool))
(defn workspaceCurrentKnowledgeBase? [state dir]
  (some? (getKnowledgeBaseRoot dir state.knowledgeBases)))

(ann workspaceKbRecentFiles (Fn [AppState] (Vector FileItem)))
(defn workspaceKbRecentFiles [state]
  (slice (filter (workspaceFiles state) kbTextFile?) 0 10))

(ann WorkspaceKbRecentStrip (Fn [AppState String String] Html))
(defn WorkspaceKbRecentStrip [state windowId dir]
  (if (workspaceCurrentKnowledgeBase? state dir)
      #html <div data-testid="kb-recent-strip"
                 class="min-w-0 shrink-0 overflow-x-auto border-b border-border bg-muted/20 px-2 py-2">
              <div class="flex w-max min-w-full flex-nowrap gap-1.5">
                {(for [file (workspaceKbRecentFiles state) :key (str windowId "-kb-recent-" file.path)]
                   #html <button type="button"
                                 class="flex shrink-0 cursor-pointer items-center gap-1.5 rounded border border-border bg-background px-2 py-1.5 text-left text-sm transition-colors hover:bg-muted/50"
                                 on:click={{:kind :workspace-open-file-for-window
                                            :windowId windowId
                                            :file file}}>
                           <span class="text-xs text-muted-foreground">TXT</span>
                           <span class="max-w-[12rem] truncate font-medium">{file.name}</span>
                         </button>)}
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann WorkspaceKbCreateActions (Fn [AppState String] Html))
(defn WorkspaceKbCreateActions [state dir]
  (let [shareWorkspace (shareWorkspacePath? state.pathname)
        canCreate (if shareWorkspace state.shareAllowEdit (adminCurrentPathEditable? state))]
    (if (and canCreate (workspaceCurrentKnowledgeBase? state dir))
        #html <div class="flex flex-wrap gap-2 border-b border-border bg-background p-2">
                <button type="button"
                        class="border-dashed inline-flex h-8 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-medium hover:bg-muted"
                        on:click={(if shareWorkspace
                                      {:kind :share-open-create :createKind "file"}
                                      {:kind :admin-open-create :createKind "file"})}>New file</button>
                <button type="button"
                        class="border-dashed inline-flex h-8 items-center justify-center rounded-md border border-border bg-background px-3 text-xs font-medium hover:bg-muted"
                        on:click={(if shareWorkspace
                                      {:kind :share-open-create :createKind "folder"}
                                      {:kind :admin-open-create :createKind "folder"})}>New folder</button>
              </div>
        #html <span class="hidden"></span>)))

(ann WorkspaceInlineBreadcrumbs (Fn [AppState String String] Html))
(defn WorkspaceInlineBreadcrumbs [state windowId dir]
  (let [parts (pathParts dir)
        lastIndex (- (count parts) 1)
        shareWorkspace (shareWorkspacePath? state.pathname)
        shareRootName (if (not (= (trim state.shareName) ""))
                          state.shareName
                          (if (not (= state.sharePath ""))
                              (fileNameFromPath state.sharePath)
                              "Shared media"))
        rootName (if shareWorkspace shareRootName "Home")
        currentName (if (= dir "")
                        rootName
                        (let [name (last parts)] (if (some? name) name dir)))]
    #html <div data-breadcrumb-slot
               data-testid="breadcrumb-slot"
               class="flex min-w-0 flex-1 items-center gap-1 overflow-hidden text-xs text-muted-foreground lg:gap-2">
            {(if (= dir "")
                 #html <button type="button"
                               data-breadcrumb-segment="home"
                               data-breadcrumb-path=""
                               class="inline-flex h-7 shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-md bg-primary px-2 text-xs font-medium text-primary-foreground shadow-sm transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                               on:click={{:kind :workspace-navigate-dir-for-window
                                          :windowId windowId
                                          :path ""}}
                               on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                               :path ""
                                                               :x event.clientX
                                                               :y event.clientY})}>
                         {(if shareWorkspace
                              (IconFolder "h-4 w-4")
                              (IconHome "h-4 w-4"))}
	                         <span>{rootName}</span>
                       </button>
                 #html <div class="flex min-w-0 items-center gap-1 overflow-hidden">
                         <button type="button"
                                 data-breadcrumb-segment="path-picker"
                                 aria-label={currentName}
                                 class="hidden"
                                 on:click={{:kind :breadcrumb-path-menu-toggle :mode "Workspace"}}>{currentName}</button>
                         {(if shareWorkspace
                              #html <button type="button"
                                            data-breadcrumb-segment="home"
                                            data-breadcrumb-path=""
                                            class="inline-flex h-7 shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-md px-2 text-xs font-medium text-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                            on:click={{:kind :workspace-navigate-dir-for-window
                                                       :windowId windowId
                                                       :path ""}}
                                            on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                                            :path ""
                                                                            :x event.clientX
                                                                            :y event.clientY})}>
                                      {(IconFolder "h-4 w-4")}
                                      <span>{rootName}</span>
                                    </button>
                              #html <span class="hidden"></span>)}
                         {(for [part parts index :key (str windowId "-crumb-" index)]
                            #html <div data-breadcrumb-wrapper
                                       class="flex shrink-0 items-center gap-2">
                                    {(IconChevronRight "h-4 w-4 shrink-0 text-muted-foreground")}
                                    <button type="button"
                                            data-breadcrumb-path={(crumbPathAt dir index)}
                                            class={(str "inline-flex h-7 shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-md px-2 text-xs font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring "
                                                        (if (= index lastIndex)
                                                            "bg-primary text-primary-foreground shadow-sm hover:bg-primary/90"
                                                            "text-foreground hover:bg-muted hover:text-foreground"))}
                                            on:click={{:kind :workspace-navigate-dir-for-window
                                                       :windowId windowId
                                                       :path (crumbPathAt dir index)}}
                                            on:contextmenu={(Event.prevent {:kind :breadcrumb-context-menu
                                                                            :path (crumbPathAt dir index)
                                                                            :x event.clientX
                                                                            :y event.clientY})}>{part}</button>
                                  </div>)}
                       </div>)}
          </div>))

(ann WorkspaceHiddenBreadcrumbMeasure (Fn [String] Html))
(defn WorkspaceHiddenBreadcrumbMeasure [dir]
  #html <div class="pointer-events-none absolute left-0 top-0 flex items-center gap-1 lg:gap-2"
             style="visibility:hidden">
          <span>Home</span>
          {(for [part (pathParts dir) :key (str "workspace-hidden-crumb-" part)]
             #html <span>{part}</span>)}
        </div>)

(ann workspaceViewModeButtonClass (Fn [Bool] String))
(defn workspaceViewModeButtonClass [active]
  (str "h-7 w-7 inline-flex items-center justify-center rounded-md border border-transparent p-0 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring "
       (if active
           "bg-primary text-primary-foreground shadow-sm hover:bg-primary/90"
           "text-foreground hover:bg-muted hover:text-foreground dark:hover:bg-muted/50")))

(ann showWorkspaceSharedContentShortcut? (Fn [AppState String] Bool))
(defn showWorkspaceSharedContentShortcut? [state dir]
  (and (not (shareWorkspacePath? state.pathname))
       (not (some? (find (workspaceFiles state) (fn [file] (= file.name "SharedContent")))))
       (or (= dir "")
           (= dir "SharedContent")
           (starts-with? dir "SharedContent/"))))

(ann WorkspaceBrowserPane (Fn [AppState WorkspaceTabWindow] Html))
(defn WorkspaceBrowserPane [state win]
  (let [dir (workspaceWindowDir win)
        windowId (workspaceWindowId win)
        shareWorkspace (shareWorkspacePath? state.pathname)
        canCreate (if shareWorkspace
                      state.shareAllowEdit
                      (isPathEditable dir state.editableFolders state.mediaRoots))]
    #html <div class="flex h-full min-h-0 flex-col bg-background text-muted-foreground">
            <div class="relative flex h-9 shrink-0 items-center gap-1 border-b border-border bg-muted/50 px-2 py-0 lg:gap-2">
              {(WorkspaceHiddenBreadcrumbMeasure dir)}
              {(if (not (= dir ""))
                   #html <button type="button"
                                 class="inline-flex h-7 shrink-0 items-center justify-center gap-1 whitespace-nowrap rounded-md px-2 text-xs font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                                 on:click={{:kind :workspace-navigate-dir-for-window
                                            :windowId windowId
                                            :path ""}}>
                           {(IconHome "h-4 w-4")}
                           <span>Home</span>
                         </button>
                   #html <span class="hidden"></span>)}
              {(WorkspaceInlineBreadcrumbs state windowId dir)}
              {(if canCreate
                   (if shareWorkspace
                       #html <button type="button"
                                     title="Create new file"
                                     aria-label="New file"
                                     class="inline-flex h-7 items-center justify-center rounded-md border border-border bg-background px-2 text-xs font-medium hover:bg-muted"
                                     on:click={{:kind :share-open-create :createKind "file"}}>
                               {(IconFilePlus "h-4 w-4")}
                             </button>
                       #html <button type="button"
                                     title="Create new file"
                                     aria-label="New file"
                                     class="inline-flex h-7 items-center justify-center rounded-md border border-border bg-background px-2 text-xs font-medium hover:bg-muted"
                                     on:click={{:kind :admin-open-create :createKind "file"}}>
                               {(IconFilePlus "h-4 w-4")}
                             </button>)
                   #html <span class="hidden"></span>)}
              {(if canCreate
                   (if shareWorkspace
                       #html <button type="button"
                                     title="Create new folder"
                                     aria-label="New folder"
                                     class="inline-flex h-7 items-center justify-center rounded-md border border-border bg-background px-2 text-xs font-medium hover:bg-muted"
                                     on:click={{:kind :share-open-create :createKind "folder"}}>
                               {(IconFolderPlus "h-4 w-4")}
                             </button>
                       #html <button type="button"
                                     title="Create new folder"
                                     aria-label="New folder"
                                     class="inline-flex h-7 items-center justify-center rounded-md border border-border bg-background px-2 text-xs font-medium hover:bg-muted"
                                     on:click={{:kind :admin-open-create :createKind "folder"}}>
                               {(IconFolderPlus "h-4 w-4")}
                             </button>)
                   #html <span class="hidden"></span>)}
              {(if (workspaceCurrentKnowledgeBase? state dir)
                   #html <button type="button"
                                 aria-label="Open search"
                                 title="Search notes (Ctrl+K)"
                                 class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-transparent text-muted-foreground hover:bg-muted hover:text-foreground"
                                 on:click={{:kind :kb-search-open}}>
                           {(IconSearch "h-4 w-4")}
                         </button>
	                  #html <span class="hidden"></span>)}
              <div class="flex items-center gap-1">
	              <button type="button"
	                      aria-label="List view"
	                      aria-pressed={(= state.viewMode "list")}
                        class={(workspaceViewModeButtonClass (= state.viewMode "list"))}
                        on:click={(if shareWorkspace
                                      {:kind :share-view-mode-picked :value "list"}
                                      {:kind :view-mode-picked :value "list"})}>
                  {(IconList "h-3.5 w-3.5")}
                </button>
	                <button type="button"
	                        aria-label="Grid view"
	                        aria-pressed={(= state.viewMode "grid")}
                        class={(workspaceViewModeButtonClass (= state.viewMode "grid"))}
                        on:click={(if shareWorkspace
                                      {:kind :share-view-mode-picked :value "grid"}
                                      {:kind :view-mode-picked :value "grid"})}>
                  {(IconLayoutGrid "h-3.5 w-3.5")}
                </button>
              </div>
            </div>
	            <div data-testid="workspace-upload-drop-zone"
	                 class="relative flex min-h-0 flex-1 flex-col overflow-hidden outline-none"
	                 tabindex="0"
	                 on:paste={(Event.prevent {:kind :admin-paste
	                                            :text (if (some? event.clipboardData)
	                                                      (event.clipboardData.getData "text/plain")
	                                                      "")})}>
	              {(WorkspaceKbRecentStrip state windowId dir)}
	              {(WorkspaceKbCreateActions state dir)}
	              <div class="min-h-0 flex-1 overflow-auto">
	              {(if (some? (workspaceFilesError state))
	                   #html <div class="p-4 text-sm text-destructive">{(workspaceFilesErrorText state)}</div>
	                   (if (workspaceFilesPending? state)
	                         #html <div class="p-4 text-sm text-muted-foreground">Loading...</div>
                         (if (= state.viewMode "grid")
	                             #html <div class="file-browser-grid gap-4 p-2">
	                                     {(if (not (= dir ""))
	                                          #html <div class="ring-foreground/10 flex cursor-pointer flex-col overflow-hidden rounded-xl bg-card py-0 text-left text-card-foreground shadow-xs ring-1 transition-colors select-none hover:bg-muted/50"
	                                                     on:click={{:kind :workspace-navigate-dir-for-window
	                                                                :windowId windowId
	                                                                :path (parentDir dir)}}>
	                                                  <div class="bg-muted/80 flex aspect-video flex-col items-center justify-center p-4">
	                                                    {(IconArrowUp "mb-2 h-12 w-12 text-muted-foreground")}
	                                                    <p class="text-center text-sm font-medium">..</p>
	                                                  </div>
	                                                </div>
	                                          #html <span class="hidden"></span>)}
                                     {(if (showWorkspaceSharedContentShortcut? state dir)
                                          #html <div class="ring-foreground/10 flex cursor-pointer flex-col overflow-hidden rounded-xl bg-card py-0 text-left text-card-foreground shadow-xs ring-1 transition-colors select-none hover:bg-muted/50"
                                                     on:click={{:kind :workspace-navigate-dir-for-window
                                                                :windowId windowId
                                                                :path "SharedContent"}}>
                                                  <div class="group relative flex aspect-video items-center justify-center overflow-hidden bg-muted">
                                                    {(IconFolder "h-8 w-8 text-blue-500")}
                                                  </div>
                                                  <div class="flex flex-col gap-1 p-3">
                                                    <p class="truncate text-sm font-medium">SharedContent</p>
                                                    <div class="flex items-center justify-end text-xs text-muted-foreground"><span></span></div>
                                                  </div>
                                                </div>
                                          #html <span class="hidden"></span>)}
                                     {(for [file (workspaceFiles state) :key (str windowId "-workspace-grid-" file.path)]
                                        #html <div data-file-path={file.path}
                                                  class="ring-foreground/10 flex cursor-pointer flex-col overflow-hidden rounded-xl bg-card py-0 text-left text-card-foreground shadow-xs ring-1 transition-colors select-none hover:bg-muted/50"
                                                  draggable="true"
                                                  on:dragstart={(workspaceFileDragStartMessage state file event)}
                                                  on:dragover={(if (and file.isDirectory (adminCurrentPathEditable? state))
                                                                (Event.prevent {:kind :noop})
                                                                {:kind :noop})}
                                                  on:drop={(if (and file.isDirectory (adminCurrentPathEditable? state))
                                                            (Event.prevent {:kind :drop-on-folder
                                                                            :sourcePath (dropSourcePathForState state event)
                                                                            :destPath file.path})
                                                            {:kind :noop})}
	                                                  on:click={{:kind :workspace-open-file-for-window
	                                                            :windowId windowId
	                                                            :file file}}
	                                                  on:contextmenu={(Event.prevent {:kind :workspace-file-context-menu
	                                                                                  :windowId windowId
	                                                                                  :file file
	                                                                                  :x event.clientX
	                                                                                  :y event.clientY})}>
                                                <div class="group relative flex aspect-video items-center justify-center overflow-hidden bg-muted">
                                                  <div class="scale-[2.5] [&_svg]:h-6 [&_svg]:w-6">{(BrowserFileIcon state file (browserFileIconClass file))}</div>
                                                </div>
                                                <div class="flex min-w-0 flex-col gap-1 p-3">
                                                  <p class="truncate text-sm font-medium">{file.name}</p>
                                                  <div class="flex items-center justify-end text-xs text-muted-foreground">
                                                    <span>{(if file.isDirectory "" (formatFileSize file.size))}</span>
                                                  </div>
                                                </div>
                                              </div>)}
                                   </div>
                             #html <table class="directory-table w-full table-fixed caption-bottom text-sm">
                                 <tbody>
                                   {(if (not (= dir ""))
                                        #html <tr class="cursor-pointer select-none border-b border-border transition-colors hover:bg-muted/50"
                                                  on:click={{:kind :workspace-navigate-dir-for-window
                                                             :windowId windowId
                                                             :path (parentDir dir)}}>
                                                <td class="w-[40px] min-w-[40px] max-w-[40px] box-border p-2 align-middle">
                                                  <div class="flex items-center justify-center">
                                                    {(IconArrowUp "h-4 w-4 text-muted-foreground")}
                                                  </div>
                                                </td>
                                                <td class="min-w-0 p-2 align-middle font-medium">..</td>
                                                <td class="min-w-0 p-2 align-middle text-right text-muted-foreground"></td>
                                              </tr>
                                        #html <template></template>)}
                                   {(if (showWorkspaceSharedContentShortcut? state dir)
                                        #html <tr class="cursor-pointer select-none border-b border-border transition-colors hover:bg-muted/50"
                                                  on:click={{:kind :workspace-navigate-dir-for-window
                                                             :windowId windowId
                                                             :path "SharedContent"}}>
                                                <td class="w-[40px] min-w-[40px] max-w-[40px] box-border p-2 align-middle">
                                                  <div class="flex items-center justify-center">
                                                    {(IconFolder "h-4 w-4 text-blue-500")}
                                                  </div>
                                                </td>
                                                <td class="min-w-0 p-2 align-middle font-medium">SharedContent</td>
                                                <td class="min-w-0 p-2 align-middle text-right text-muted-foreground"></td>
                                              </tr>
                                        #html <template></template>)}
                                   {(for [file (workspaceFiles state) index :key (str windowId "-workspace-file-" file.path)]
                                      #html <tr data-file-path={file.path}
                                                class="group cursor-pointer select-none border-b border-border transition-colors hover:bg-muted/50"
                                                style={(if (= index (- (count (workspaceFiles state)) 1)) "border-bottom-width:0" nil)}
                                                draggable="true"
                                                on:dragstart={(workspaceFileDragStartMessage state file event)}
                                                on:dragover={(if (and file.isDirectory (adminCurrentPathEditable? state))
                                                              (Event.prevent {:kind :noop})
                                                              {:kind :noop})}
                                                on:drop={(if (and file.isDirectory (adminCurrentPathEditable? state))
                                                          (Event.prevent {:kind :drop-on-folder
                                                                          :sourcePath (dropSourcePathForState state event)
                                                                          :destPath file.path})
                                                          {:kind :noop})}
	                                                on:click={{:kind :workspace-open-file-for-window
	                                                          :windowId windowId
	                                                          :file file}}
	                                                on:contextmenu={(Event.prevent {:kind :workspace-file-context-menu
	                                                                                :windowId windowId
	                                                                                :file file
	                                                                                :x event.clientX
	                                                                                :y event.clientY})}>
                                              <td class="w-[40px] min-w-[40px] max-w-[40px] box-border p-2 align-middle">
                                                <div class="flex items-center justify-center">
                                                  {(BrowserFileIcon state file (browserFileIconClass file))}
                                                </div>
                                              </td>
                                              <td class="min-w-0 p-2 align-middle font-medium">
                                                <span class="truncate">{file.name}</span>
                                              </td>
                                              <td class="min-w-0 p-2 align-middle text-right text-muted-foreground">
                                                <span class="inline-block w-20 tabular-nums">{(workspaceFileSubtitle file)}</span>
                                              </td>
                                            </tr>)}
                                   {(if (= (count (workspaceFiles state)) 0)
                                        #html <tr data-testid="directory-empty">
                                                <td colspan="3" class="p-8 text-center">
                                                  <div>
                                                    <p class="text-sm font-medium text-foreground">This folder is empty</p>
                                                    <p class="mt-1 text-xs text-muted-foreground">There are no files in this folder.</p>
                                                 </div>
                                                </td>
                                              </tr>
	                                        #html <template></template>)}
	                                 </tbody>
	                               </table>)))}
	              </div>
	            </div>
	          </div>))

(ann workspaceImageCounter (Fn [AppState WorkspaceTabWindow FileItem] String))
(defn workspaceImageCounter [state win file]
  (let [images (workspaceWindowImageFilesForUpdate state win)
        total (count images)
        index (adminImageIndexForUpdate images file.path)]
    (if (= total 0)
        "1 of 1"
        (str (+ (if (< index 0) 0 index) 1) " of " total))))

(ann workspaceTextExtensionLabel (Fn [FileItem] String))
(defn workspaceTextExtensionLabel [file]
  (if (= file.extension "")
      "TXT"
      (if (= file.extension "txt")
          "TXT"
          (if (= file.extension "md")
              "MD"
              (if (= file.extension "json") "JSON" file.extension)))))

(ann WorkspaceImageViewerPane (Fn [AppState WorkspaceTabWindow FileItem String] Html))
(defn WorkspaceImageViewerPane [state win file url]
  #html <div class="flex h-full min-h-0 flex-col bg-black">
          <div class="flex h-8 shrink-0 items-center justify-between border-b border-white/10 bg-black/50 px-2">
            <span class="text-xs text-white/90">{(workspaceImageCounter state win file)}</span>
            <div class="flex flex-1 items-center justify-end gap-1">
              <button type="button"
                      title="Zoom out"
                      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white hover:bg-white/10"
                      on:click={{:kind :admin-image-zoom-out}}>
                {(IconZoomOut "h-3.5 w-3.5")}
              </button>
              <span class="min-w-12 text-center text-xs text-white/80">{(imageZoomLabel state.adminImageZoom)}</span>
              <button type="button"
                      title="Zoom in"
                      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white hover:bg-white/10"
                      on:click={{:kind :admin-image-zoom-in}}>
                {(IconZoomIn "h-3.5 w-3.5")}
              </button>
              <button type="button"
                      title="Fit to screen"
                      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white hover:bg-white/10"
                      on:click={{:kind :admin-image-fit}}>
                {(IconMaximize2 "h-3.5 w-3.5")}
              </button>
              <button type="button"
                      title="Rotate"
                      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white hover:bg-white/10"
                      on:click={{:kind :admin-image-rotate}}>
                {(IconRotateCw "h-3.5 w-3.5")}
              </button>
              <button type="button"
                      title="Download"
                      class="inline-flex h-7 w-7 items-center justify-center rounded-md text-white hover:bg-white/10"
                      on:click={{:kind :download-url
                                 :url (fileDownloadHref file.path (workspaceWindowSourceMediaContext win))
                                 :filename file.name}}>
                {(IconDownload "h-3.5 w-3.5")}
              </button>
            </div>
          </div>
          <div class="relative flex min-h-0 flex-1 items-center justify-center overflow-auto p-2">
            <button type="button"
                    aria-label="Previous image"
                    class="absolute bottom-0 left-0 top-0 z-10 w-[30%] cursor-pointer"
                    on:click={{:kind :admin-image-previous}}></button>
            <button type="button"
                    aria-label="Next image"
                    class="absolute bottom-0 right-0 top-0 z-10 w-[30%] cursor-pointer"
                    on:click={{:kind :admin-image-next}}></button>
            <img src={url}
                 alt={file.name}
                 style={(str "transform: rotate(" state.adminImageRotation "deg) scale(" (imageZoomScale state.adminImageZoom) ");")}
                 class="pointer-events-none h-full w-full object-contain transition-transform duration-200"></img>
          </div>
          {(AdminMarkdownImageOverlay state)}
        </div>)

(ann WorkspacePdfControls (Fn [WorkspaceTabWindow FileItem String] Html))
(defn WorkspacePdfControls [win file url]
  #html <div class="flex items-center gap-1">
          <button type="button"
                  title="Open in new tab"
                  aria-label="Open in new tab"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted"
                  on:click={{:kind :open-url-new-tab :url url}}>
            {(IconExternalLink "h-3.5 w-3.5")}
          </button>
          <button type="button"
                  title="Download"
                  aria-label="Download"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-md text-muted-foreground hover:bg-muted"
                  on:click={{:kind :download-url
                             :url (fileDownloadHref file.path (workspaceWindowSourceMediaContext win))
                             :filename file.name}}>
            {(IconDownload "h-3.5 w-3.5")}
          </button>
        </div>)

(ann WorkspaceTextControls (Fn [AppState WorkspaceTabWindow FileItem Bool Bool Number] Html))
(defn WorkspaceTextControls [state win file editable readOnly lineCount]
  #html <div class="flex items-center gap-1">
          <button type="button"
                  title="Copy to clipboard"
                  aria-label="Copy to clipboard"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-md text-sm hover:bg-muted"
                  on:click={{:kind :noop}}>⎘</button>
          <button type="button"
                  title="Download"
                  aria-label="Download"
                  class="inline-flex h-7 w-7 items-center justify-center rounded-md hover:bg-muted"
                  on:click={{:kind :download-url
                             :url (fileDownloadHref file.path (workspaceWindowSourceMediaContext win))
                             :filename file.name}}>
            {(IconDownload "h-3.5 w-3.5")}
          </button>
          {(if editable
               (if readOnly
                   #html <button type="button"
                                 class="inline-flex h-7 items-center rounded-md border border-border px-2 text-xs"
                                 on:click={{:kind :admin-text-read-only :readOnly false}}>Edit</button>
                   #html <button type="button"
                                 class="inline-flex h-7 items-center rounded-md border border-border px-2 text-xs"
                                 on:click={{:kind :admin-text-read-only :readOnly true}}>Read only</button>)
               #html <span class="hidden"></span>)}
        </div>)

(ann WorkspaceFramedControls (Fn [AppState WorkspaceTabWindow FileItem String Bool Bool Number] Html))
(defn WorkspaceFramedControls [state win file url editable readOnly lineCount]
  #html <div class="flex w-full min-w-0 shrink-0 items-center justify-between gap-2">
          <div class="min-w-0 truncate">
            {(if (= file.type MediaType.TEXT)
                 #html <span class="text-xs text-muted-foreground">{(str (workspaceTextExtensionLabel file) " · " lineCount " lines")}</span>
                 #html <span class="hidden"></span>)}
          </div>
          <div class="flex shrink-0 items-center gap-1">
            {(if (= file.type MediaType.PDF)
                 (WorkspacePdfControls win file url)
                 #html <span class="hidden"></span>)}
            {(if (= file.type MediaType.TEXT)
                 (WorkspaceTextControls state win file editable readOnly lineCount)
                 #html <span class="hidden"></span>)}
          </div>
        </div>)

(ann WorkspaceVideoViewerBody (Fn [AppState FileItem String String] Html))
(defn WorkspaceVideoViewerBody [state file url windowId]
  #html <div class="contents">
          {(if (and state.workspaceAudioVideoHidden
                    (= state.workspaceAudioVideoWindowId windowId))
	               #html <div class="rounded-md border border-border bg-muted/30 p-6 text-center text-foreground">
	                       <p class="text-sm">Playing audio in the taskbar.</p>
	                     </div>
	               #html <div class="flex h-full min-h-0 flex-1 flex-col overflow-hidden bg-black">
	                       <div class="group relative flex min-h-0 min-w-0 flex-1 flex-col bg-black">
	                         <div class="absolute right-2 top-2 z-10 opacity-0 transition-opacity group-hover:opacity-100">
	                           <button type="button"
	                                   title="Listen only"
	                                   aria-label="Listen only"
	                                   class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-secondary text-secondary-foreground"
	                                   on:click={{:kind :workspace-listen-only
	                                              :windowId windowId
	                                              :path file.path
	                                              :name file.name
	                                              :dir (workspaceWindowFileDir file state.currentDir)}}>
	                             {(IconHeadphones "h-4 w-4")}
	                           </button>
	                         </div>
		                         <video src={url}
		                                controls
		                                autoplay
		                                playsinline
		                                data-media-type={MediaType.VIDEO}
		                                title={file.name}
		                                on:loadedmetadata={{:kind :workspace-video-metadata-loaded
		                                                    :windowId windowId
		                                                    :path file.path
		                                                    :width event.currentTarget.videoWidth
		                                                    :height event.currentTarget.videoHeight}}
		                                class="min-h-0 w-full flex-1 bg-black object-contain"></video>
	                       </div>
	                     </div>)}
	        </div>)

(ann WorkspaceTextViewerBody (Fn [AppState FileItem String Bool (Option String) Bool Bool] Html))
(defn WorkspaceTextViewerBody [state file textContent textPending textError editable readOnly]
	      #html <div class="contents">
	          {(if textPending
	               #html <p class="p-3 text-sm text-muted-foreground">Loading...</p>
	               (if (some? textError)
	                   #html <p class="p-3 text-sm text-destructive">{textError}</p>
	                   (if (and editable (not readOnly))
	                       #html <textarea class="scrollbar-thin h-full w-full resize-none bg-transparent px-3 py-2 font-sans text-base leading-[1.75] text-foreground wrap-break-word whitespace-pre-wrap focus:outline-none"
	                                       value={textContent}
	                                       spellcheck="false"
	                                       on:input={{:kind :admin-text-input :value event.currentTarget.value}}
	                                       on:paste={(Event.prevent (adminTextPasteMessage state file event))}
	                                       on:blur={{:kind :admin-text-save-if-needed}}></textarea>
	                       #html <div class="scrollbar-thin h-full overflow-auto px-3 py-2 text-left">
	                               {(if (= file.extension "md")
	                                    (AdminTextReadOnlyView state file textContent)
	                                    #html <pre class="text-foreground wrap-break-word whitespace-pre-wrap px-3 py-2 font-sans text-base leading-[1.75]">{textContent}</pre>)}
	                             </div>)))}
	        </div>)

(ann WorkspaceUnsupportedViewerBody (Fn [WorkspaceTabWindow FileItem] Html))
(defn WorkspaceUnsupportedViewerBody [win file]
  #html <div class="rounded-md border border-border bg-muted/30 p-6 text-center text-foreground">
          <p class="text-sm">This file type cannot be previewed.</p>
          <a href={(fileDownloadHref file.path (workspaceWindowSourceMediaContext win))}
             download={file.name}
             class="mt-4 inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground">Download File</a>
        </div>)

(ann WorkspaceFramedViewerBody (Fn [AppState WorkspaceTabWindow FileItem String String String Bool (Option String) Bool Bool] Html))
(defn WorkspaceFramedViewerBody [state win file url windowId textContent textPending textError editable readOnly]
  #html <div class={(if (= file.type MediaType.TEXT)
                       "min-h-0 flex-1 overflow-hidden text-sm text-muted-foreground"
                       (if (= file.type MediaType.PDF)
                           "flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-neutral-800 text-sm text-muted-foreground"
                           "flex min-h-0 flex-1 items-center justify-center overflow-auto p-4 text-sm text-muted-foreground"))}>
          {(if (= file.path "")
               #html <div>No file selected</div>
               (if (= file.type MediaType.PDF)
                   #html <embed src={url}
                                type="application/pdf"
                                class="h-full w-full"></embed>
                   (if (= file.type MediaType.VIDEO)
                       (WorkspaceVideoViewerBody state file url windowId)
                       (if (= file.type MediaType.AUDIO)
                           #html <audio src={url}
                                        controls
                                        autoplay
                                        class="w-full max-w-md"></audio>
                           (if (= file.type MediaType.TEXT)
                               (WorkspaceTextViewerBody state file textContent textPending textError editable readOnly)
                               (WorkspaceUnsupportedViewerBody win file))))))}
        </div>)

(ann WorkspaceFramedViewerPane (Fn [AppState WorkspaceTabWindow FileItem String String String String Bool (Option String) Bool Bool Number] Html))
(defn WorkspaceFramedViewerPane [state win file url title windowId textContent textPending textError editable readOnly lineCount]
  #html <div class="flex h-full min-h-0 flex-col bg-background text-foreground">
          <div class={(if (= file.type MediaType.TEXT)
                         "flex h-9 shrink-0 flex-wrap items-center gap-1 border-b border-border bg-muted/50 px-2"
                         "flex h-8 shrink-0 items-center justify-between gap-2 border-b border-border px-3 text-sm font-medium")}>
            {(WorkspaceFramedControls state win file url editable readOnly lineCount)}
          </div>
          {(WorkspaceFramedViewerBody state win file url windowId textContent textPending textError editable readOnly)}
          {(AdminMarkdownImageOverlay state)}
        </div>)

(ann WorkspaceViewerPane (Fn [AppState WorkspaceTabWindow] Html))
(defn WorkspaceViewerPane [state win]
  (let [file (workspaceWindowFileItem win)
        url (workspaceWindowMediaUrl state win file)
        title (workspaceWindowTitle win)
        windowId (workspaceWindowId win)
        localText (if (= state.adminTextPath file.path) state.adminTextDraft state.adminTextContent)
        textContent (if (shareWorkspacePath? state.pathname)
                        state.shareTextContent
                        (if (string? localText) localText ""))
        textPending (if (shareWorkspacePath? state.pathname) state.shareTextPending state.adminTextPending)
        textError (if (shareWorkspacePath? state.pathname) state.shareTextError state.adminTextError)
        editable (and (not (shareWorkspacePath? state.pathname)) (fileEditable? state file))
        readOnly (or (not editable) state.adminTextReadOnly)
        lineCount (count (split textContent "\n"))]
	    #html <div class="contents">
	            {(if (= file.type MediaType.IMAGE)
	                 (WorkspaceImageViewerPane state win file url)
	                 (if (= file.type MediaType.VIDEO)
	                     (WorkspaceVideoViewerBody state file url windowId)
	                     (WorkspaceFramedViewerPane state win file url title windowId textContent textPending textError editable readOnly lineCount)))}
	          </div>))

(ann WorkspacePaneForWindow (Fn [AppState WorkspaceTabWindow] Html))
(defn WorkspacePaneForWindow [state win]
  #html <div class="contents">
          {(if (or (= win.type "viewer") (some? (workspaceWindowViewingPath win)))
               (WorkspaceViewerPane state win)
               (WorkspaceBrowserPane state win))}
        </div>)

(ann workspaceActiveGroupId (Fn [AppState] (Option String)))
(defn workspaceActiveGroupId [state]
  (let [activeId state.workspace.activeWindowId
        win (if (string? activeId) (findWorkspaceWindow state.workspace activeId) nil)]
    (if (some? win) (groupIdForWindow win) nil)))

(ann workspaceGroupVisibleWindow (Fn [AppState String] (Option WorkspaceTabWindow)))
(defn workspaceGroupVisibleWindow [state groupId]
  (let [visibleId (resolveGroupVisibleTabId state.workspace groupId)
        tabs (tabsInGroup (workspaceWindows state) groupId)]
    (if (not (= visibleId ""))
        (let [win (find tabs (fn [tab] (= tab.id visibleId)))]
          (if (some? win) win (if (> (count tabs) 0) (nth tabs 0) nil)))
        (if (> (count tabs) 0) (nth tabs 0) nil))))

(ann workspaceGroupTabs (Fn [AppState String] (Vector WorkspaceTabWindow)))
(defn workspaceGroupTabs [state groupId]
  (tabsInGroup (workspaceWindows state) groupId))

(ann workspaceWindowStyle (Fn [WorkspaceTabWindow] String))
(defn workspaceWindowStyle [win]
  (let [bounds (boundsForWindow win)
        layout (layoutForWindow win)
        z (if (number? layout.zIndex) layout.zIndex 1)]
    (str "left:" bounds.x "px;top:" bounds.y "px;width:" bounds.width "px;height:" bounds.height "px;z-index:" z)))

(ann workspaceWindowMinimized? (Fn [WorkspaceTabWindow] Bool))
(defn workspaceWindowMinimized? [win]
  (= (get (layoutForWindow win) :minimized) true))

(ann workspaceWindowFullscreen? (Fn [WorkspaceTabWindow] Bool))
(defn workspaceWindowFullscreen? [win]
  (= (get (layoutForWindow win) :fullscreen) true))

(ann WorkspaceTabButton (Fn [AppState String String WorkspaceTabWindow] Html))
(defn WorkspaceTabButton [state groupId activeTabId tab]
  (let [tabId tab.id
        active (= tabId activeTabId)
        split (if (object? state.workspace.tabGroupSplits)
                  (object-get state.workspace.tabGroupSplits groupId)
                  nil)
        splitLeftId (if (object? split) (object-get split "leftTabId") nil)
        splitLeft (= splitLeftId tabId)
        pullable (and (> (workspaceGroupTabCount state groupId) 1) (not splitLeft))
        tabFile (workspaceWindowFileItem tab)
        tabJs (unsafe-cast Js tab)]
    #html <div data-workspace-tab-id={tabId}
               data-workspace-split-left-tab={(if splitLeft "" nil)}
               data-no-window-drag={(if pullable "" nil)}
               data-tab-pinned={(if (= tab.tabPinned true) "true" nil)}
               class={(str "flex h-8 min-w-0 max-w-[180px] shrink-0 cursor-pointer items-center gap-1 border-r border-border px-2 "
                           (if active "bg-background" "bg-muted/50 hover:bg-muted"))}
               on:contextmenu={(Event.prevent {:kind :workspace-tab-menu-open
                                               :id tabId
                                               :x event.clientX
                                               :y event.clientY})}
               on:pointerdown={(if pullable
                                  (startWorkspaceTabDrag state groupId tabId event)
                                  (startWorkspaceWindowDrag state groupId tabJs event))}
               on:click={(workspaceTabClickMessage groupId tabId)}>
            <div class="flex h-4 w-4 shrink-0 items-center justify-center">
              {(if (= tab.type "browser")
                   (IconFolder "h-3.5 w-3.5 text-blue-500")
                   (BrowserFileIcon state tabFile (browserFileIconClass tabFile)))}
            </div>
            <span class="min-w-0 flex-1 truncate text-[11px] font-medium">{(workspaceWindowTitle tab)}</span>
            {(if (= tab.tabPinned true)
                 #html <span class="hidden"></span>
                 #html <button type="button"
                               data-no-window-drag={(if pullable "" nil)}
                               data-testid="workspace-tab-close"
                               class="ml-auto shrink-0 rounded-sm p-0.5 text-muted-foreground hover:bg-muted hover:text-foreground"
                               on:pointerdown={(if pullable
                                                 (Event.stop {:kind :noop})
                                                 (Event.stop {:kind :noop}))}
                               on:mousedown={(if pullable
                                               (Event.stop {:kind :noop})
                                               (Event.stop {:kind :noop}))}
                               on:click={(Event.stop {:kind :workspace-close-tab :id tabId})}>
                         {(IconX "h-3 w-3")}
                       </button>)}
          </div>))

(ann WorkspaceTabButtonAt (Fn [AppState String String (Vector WorkspaceTabWindow) Number] Html))
(defn WorkspaceTabButtonAt [state groupId activeTabId tabs index]
  #html <div class="contents">
          {(if (< index (count tabs))
               (WorkspaceTabButton state groupId activeTabId (nth tabs index))
               #html <span class="hidden"></span>)}
        </div>)

(ann WorkspaceTabButtonsView (Fn [AppState String String (Vector WorkspaceTabWindow)] Html))
(defn WorkspaceTabButtonsView [state groupId activeTabId tabs]
    #html <div class="contents">
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 0)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 1)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 2)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 3)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 4)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 5)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 6)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 7)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 8)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 9)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 10)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 11)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 12)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 13)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 14)}
          {(WorkspaceTabButtonAt state groupId activeTabId tabs 15)}
        </div>)

(ann WorkspaceTabMenuView (Fn [AppState] Html))
(defn WorkspaceTabMenuView [state]
  (let [tab (findWorkspaceWindow state.workspace state.workspaceTabMenuTabId)
        hasTab (some? tab)
        tabJs (unsafe-cast Js tab)
        pinned (if hasTab (= tabJs.tabPinned true) false)
        groupId (if hasTab (groupIdForWindow tabJs) "")
        split (if (and hasTab (object? state.workspace.tabGroupSplits))
                  (object-get state.workspace.tabGroupSplits groupId)
                  nil)
        splitLeftId (if (object? split) (object-get split "leftTabId") nil)
        isSplitLeft (and (string? splitLeftId) (= splitLeftId state.workspaceTabMenuTabId))
        tabCount (if hasTab (workspaceGroupTabCount state groupId) 0)]
    (if (and state.workspaceTabMenuOpen hasTab)
        #html <div class="fixed inset-0 z-[9998]"
                   on:mousedown={{:kind :workspace-tab-menu-close}}>
                <div role="menu"
                     data-slot="workspace-tab-context-menu"
                     data-testid="workspace-tab-context-menu"
                     class="fixed z-[9999] min-w-40 rounded-md border border-border bg-popover p-1 text-popover-foreground shadow-md"
                     style={(str "left:" (clampMenuLeft state.workspaceTabMenuX) "px;top:" (clampMenuTop state.workspaceTabMenuY) "px")}
                     on:mousedown={(Event.stop {:kind :noop})}>
                  {(if isSplitLeft
                       #html <button type="button"
                                     data-slot="context-menu-item"
                                     data-testid="workspace-tab-menu-exit-split"
                                     role="menuitem"
                                     class={(ContextMenuItemClass)}
                                     on:click={{:kind :workspace-tab-exit-split :groupId groupId}}>
                               Exit split view
                             </button>
                       #html <span class="hidden"></span>)}
                  {(if (and (not (object? split)) (>= tabCount 2))
                       #html <button type="button"
                                     data-slot="context-menu-item"
                                     data-testid="workspace-tab-menu-use-split-left"
                                     role="menuitem"
                                     class={(ContextMenuItemClass)}
                                     on:click={{:kind :workspace-tab-use-split-left
                                                :id state.workspaceTabMenuTabId}}>
                               Use as split left tab
                             </button>
                       #html <span class="hidden"></span>)}
                  <button type="button"
                          data-slot="context-menu-item"
                          data-testid={(if pinned "workspace-tab-menu-unpin" "workspace-tab-menu-pin")}
                          role="menuitem"
                          class={(ContextMenuItemClass)}
                          on:click={{:kind :workspace-toggle-tab-pinned
                                     :id state.workspaceTabMenuTabId}}>
                    {(if pinned "Unpin tab" "Pin tab")}
                  </button>
                </div>
              </div>
        #html <span class="hidden"></span>)))

(ann WorkspaceTabStripView (Fn [AppState String] Html))
(defn WorkspaceTabStripView [state groupId]
  (let [tabs (workspaceGroupTabs state groupId)
        activeTabId (resolveGroupVisibleTabId state.workspace groupId)
        tabCount (count tabs)]
    #html <div class="workspace-tab-strip flex min-w-0 flex-1 items-center">
            <div data-tab-drop-slot
                 data-no-window-drag
                 class="flex h-8 min-w-[12px] w-[12px] shrink-0 items-stretch border-0 p-0"
                 on:dragover={(Event.prevent {:kind :noop})}
                 on:drop={(Event.prevent (workspaceTabDropMessage activeTabId 0 event))}></div>
            {(WorkspaceTabButtonsView state groupId activeTabId tabs)}
            <div data-tab-drop-slot
                 data-no-window-drag
                 class="flex h-8 min-w-[12px] w-[12px] shrink-0 items-stretch border-0 p-0"
                 on:dragover={(Event.prevent {:kind :noop})}
                 on:drop={(Event.prevent (workspaceTabDropMessage activeTabId tabCount event))}></div>
          </div>))

(ann WorkspaceSplitPaneContent (Fn [AppState String WorkspaceTabWindow WorkspaceTabWindow] Html))
(defn WorkspaceSplitPaneContent [state groupId leftWin rightWin]
  (let [split (object-get state.workspace.tabGroupSplits groupId)
        fraction (if (and (object? split) (number? split.leftPaneFraction)) split.leftPaneFraction 0.5)
        leftPct (* fraction 100)]
    #html <div class="flex h-full min-h-0 w-full">
            <div data-testid="workspace-split-left-pane"
                 class="min-h-0 overflow-hidden border-r border-border"
                 style={(str "width:" leftPct "%")}>
              {(WorkspacePaneForWindow state leftWin)}
            </div>
            <div data-workspace-split-resize-handle
                 data-testid="workspace-split-divider"
                 class="w-1 shrink-0 cursor-col-resize bg-border"
                 on:pointerdown={(startWorkspaceSplitResize groupId event)}></div>
            <div data-testid="workspace-split-right-pane"
                 class="min-h-0 flex-1 overflow-hidden">
              {(WorkspacePaneForWindow state rightWin)}
            </div>
          </div>))

(ann WorkspaceGroupContent (Fn [AppState String WorkspaceTabWindow] Html))
(defn WorkspaceGroupContent [state groupId visibleWin]
  (let [split (object-get state.workspace.tabGroupSplits groupId)
        tabs (workspaceGroupTabs state groupId)
        leftId (if (object? split) split.leftTabId nil)
        leftWin (if (string? leftId) (find tabs (fn [tab] (= tab.id leftId))) nil)
        rightWin (find tabs (fn [tab] (not (= tab.id leftId))))]
    #html <div class="contents">
            {(if (and (some? leftWin) (some? rightWin))
                 (WorkspaceSplitPaneContent state groupId leftWin rightWin)
                 (WorkspacePaneForWindow state visibleWin))}
          </div>))

(ann WorkspaceGroupWindowChrome (Fn [AppState String Js Bool Bool Bool String] Html))
(defn WorkspaceGroupWindowChrome [state groupId win active minimized fullscreen windowId]
  #html <div class={(str "absolute flex flex-col " (if minimized "hidden" ""))}
	             style={(workspaceWindowStyle win)}>
          <div data-window-group={groupId}
               data-workspace-window-minimized={(if minimized "" nil)}
               data-workspace-active={(if active "" nil)}
               on:mousedown={{:kind :workspace-focus-window-id :id windowId}}
               class={(str "relative flex h-full min-h-0 min-w-0 flex-col overflow-hidden border border-border bg-background shadow-2xl "
                           (if active "shadow-black/20" ""))}>
            <div class={(str "relative z-10 flex h-8 shrink-0 items-stretch border-b border-border "
                             (if active "bg-muted text-foreground" "bg-muted/50 text-muted-foreground"))}>
	              <div data-testid="window-drag-handle"
	                   class="workspace-window-drag-handle flex min-w-0 flex-1 cursor-grab items-center text-xs font-medium select-none active:cursor-grabbing"
	                   on:pointerdown={(startWorkspaceWindowDrag state groupId win event)}
	                   on:pointerup={{:kind :admin-text-save-if-needed}}
	                   on:mousedown={(workspaceDragHandleMouseDownMessage windowId)}
	                   on:click={{:kind :admin-text-save-if-needed}}>
	                {(WorkspaceTabStripView state groupId)}
	              </div>
              <div class="workspace-window-drag-handle min-w-[48px] shrink-0 cursor-grab active:cursor-grabbing"
                   aria-hidden="true"
                   on:pointerdown={(startWorkspaceWindowDrag state groupId win event)}
                   on:pointerup={{:kind :admin-text-save-if-needed}}
                   on:mousedown={(workspaceDragHandleMouseDownMessage windowId)}
                   on:click={{:kind :admin-text-save-if-needed}}></div>
	              <div data-no-window-drag
	                   class="workspace-window-buttons flex shrink-0 items-stretch">
                <button type="button"
                        title="Minimize"
                        aria-label="Minimize"
                        class="inline-flex h-full w-8 items-center justify-center text-muted-foreground hover:bg-muted hover:text-foreground"
                        on:click={(Event.stop {:kind :workspace-minimize-window
                                               :id windowId
                                               :minimized true})}>
                  {(IconMinus "h-3.5 w-3.5")}
                </button>
                <button type="button"
	                        title="Maximize"
	                        aria-label="Maximize"
	                        class="inline-flex h-full w-8 items-center justify-center text-muted-foreground hover:bg-muted hover:text-foreground"
	                        on:click={(Event.stop {:kind :workspace-toggle-fullscreen :id windowId})}
	                        on:contextmenu={(Event.prevent {:kind :workspace-open-layout-picker
	                                                       :id windowId
	                                                       :x event.clientX
	                                                       :y event.clientY})}>
	                  {(if fullscreen
	                       (IconMinimize2 "h-3.5 w-3.5")
	                       (IconMaximize2 "h-3.5 w-3.5"))}
	                </button>
                <button type="button"
                        title="Close"
                        aria-label={(str "Close " (workspaceWindowTitle win))}
                        class="inline-flex h-full w-8 items-center justify-center text-muted-foreground hover:bg-muted hover:text-foreground"
                        on:click={(Event.stop {:kind :workspace-close-window-id :id windowId})}>
                  {(IconX "h-3.5 w-3.5")}
                </button>
              </div>
            </div>
            <div data-testid="workspace-chrome-content"
                 data-no-window-drag
                 class="relative flex h-full min-h-0 min-w-0 flex-1 flex-col overflow-hidden text-sm text-muted-foreground">
              <div data-testid="workspace-window-visible-content"
                   class="workspace-window-content relative h-full min-h-0 flex-1 overflow-hidden text-sm text-muted-foreground">
                {(WorkspaceGroupContent state groupId win)}
              </div>
            </div>
          </div>
          {(WorkspaceResizeHandlesView state windowId win minimized fullscreen)}
        </div>)

(ann WorkspaceGroupWindowView (Fn [AppState String] Html))
(defn WorkspaceGroupWindowView [state groupId]
  (let [visibleWin (workspaceGroupVisibleWindow state groupId)
        hasVisibleWin (some? visibleWin)
        win (unsafe-cast Js visibleWin)
	        active (= (workspaceActiveGroupId state) groupId)
	        minimized (if hasVisibleWin (workspaceWindowMinimized? win) true)
	        fullscreen (if hasVisibleWin (workspaceWindowFullscreen? win) false)
	        windowId (if hasVisibleWin (workspaceWindowId win) "")]
	  #html <div class="contents">
	          {(if hasVisibleWin
	               (WorkspaceGroupWindowChrome state groupId win active minimized fullscreen windowId)
	               #html <span class="hidden"></span>)}
	        </div>))

(ann workspacePinIsDirectory? (Fn [WorkspaceTaskbarPin] Bool))
(defn workspacePinIsDirectory? [pin]
  (= pin.isDirectory true))

(ann workspacePinPath (Fn [WorkspaceTaskbarPin] String))
(defn workspacePinPath [pin]
  pin.path)

(ann workspacePinName (Fn [WorkspaceTaskbarPin] String))
(defn workspacePinName [pin]
  (if (not (= pin.title ""))
      pin.title
      (workspacePathNameFromPath (workspacePinPath pin))))

(ann workspacePinTitle (Fn [WorkspaceTaskbarPin] String))
(defn workspacePinTitle [pin]
  (str (if (workspacePinIsDirectory? pin) "Folder: " "File: ") (workspacePinPath pin)))

(ann workspacePinFileItem (Fn [WorkspaceTaskbarPin] FileItem))
(defn workspacePinFileItem [pin]
  (workspaceFileItemFromDrag (workspacePinPath pin) (workspacePinIsDirectory? pin)))

(ann workspaceTaskbarAudioUrl (Fn [AppState] String))
(defn workspaceTaskbarAudioUrl [state]
  (workspaceAudioUrlForPath state state.workspaceAudioPath))

(ann workspaceTaskbarAudioActive? (Fn [AppState] Bool))
(defn workspaceTaskbarAudioActive? [state]
  (not (= state.workspaceAudioPath "")))

(ann WorkspaceTaskbarPinIcon (Fn [WorkspaceTaskbarPin] Html))
(defn WorkspaceTaskbarPinIcon [pin]
  (if (workspacePinIsDirectory? pin)
      #html <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="h-4 w-4 text-blue-500"
                 aria-hidden="true">
              <path d="M3 6h6l2 2h10v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
      #html <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 class="h-4 w-4 text-muted-foreground"
                 aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <path d="M14 2v6h6"></path>
            </svg>))

(ann WorkspaceTaskbarPinView (Fn [AppState WorkspaceTaskbarPin] Html))
(defn WorkspaceTaskbarPinView [state pin]
  (let [path (workspacePinPath pin)
        isDirectory (workspacePinIsDirectory? pin)
        title (workspacePinTitle pin)
        name (workspacePinName pin)
        id pin.id]
    #html <div data-taskbar-pin
               class="flex shrink-0 items-center justify-center py-1 px-0.5"
               draggable="true"
               on:dragstart={(workspaceFileDragStartMessage state (workspacePinFileItem pin) event)}
               on:dragend={{:kind :drag-end}}>
            <div role="button"
                 tabindex="0"
                 title={title}
                 aria-label={title}
                 class="flex h-7 w-7 shrink-0 cursor-default items-center justify-center rounded-none text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
                 on:click={{:kind :workspace-open-taskbar-pin
                            :path path
                            :isDirectory isDirectory
                            :title name}}
                 on:contextmenu={(Event.prevent {:kind :workspace-pin-context-menu
                                                 :id id
                                                 :x event.clientX
                                                 :y event.clientY})}>
              {(WorkspaceTaskbarPinIcon pin)}
            </div>
          </div>))

(ann WorkspaceTaskbarPinsView (Fn [AppState] Html))
(defn WorkspaceTaskbarPinsView [state]
  #html <div class="flex shrink-0 items-center gap-1">
          {(for [pin (workspaceTaskbarPins state) :key (str "workspace-pin-" pin.id)]
             #html <div class="contents">{(WorkspaceTaskbarPinView state pin)}</div>)}
        </div>)

(ann WorkspaceTaskbarAudioView (Fn [AppState] Html))
(defn WorkspaceTaskbarAudioView [state]
  (let [active (workspaceTaskbarAudioActive? state)
        url (if active (workspaceTaskbarAudioUrl state) "")]
      #html <div data-workspace-taskbar-audio-root
                 class={(if active "relative flex shrink-0 items-center" "hidden")}>
              <audio data-workspace-taskbar-media-audio
                     src={url}
                     preload="auto"
                     loop={(and active state.workspaceAudioRepeat)}
                     on:pause={(if (and active state.workspaceAudioRepeat) {:kind :workspace-audio-loop-resume} {:kind :noop})}
                     on:ended={(if (and active state.workspaceAudioRepeat) {:kind :workspace-audio-loop-resume} {:kind :noop})}
                     on:timeupdate={(if (and active state.workspaceAudioRepeat)
                                        {:kind :workspace-audio-loop-check
                                         :currentTime event.currentTarget.currentTime
                                         :duration event.currentTarget.duration}
                                        {:kind :noop})}
                     class="hidden"></audio>
              {(if active
                   #html <button type="button"
                                 aria-label="Open audio controls"
                                 title="Open audio controls"
                                 class="inline-flex h-7 max-w-[220px] items-center gap-1 truncate rounded-md border border-border bg-background px-2 text-xs font-medium hover:bg-muted"
                                 on:click={{:kind :workspace-audio-open-toggle}}>
                           <span class="lucide-volume-2 hidden"></span>
                           <span class="truncate">{state.workspaceAudioName}</span>
                         </button>
                   #html <span class="hidden"></span>)}
              {(if (and active state.workspaceAudioOpen)
                   #html <div class="bg-popover absolute bottom-full right-0 z-[60] mb-2 w-64 rounded-md border border-border p-2 text-popover-foreground shadow-lg">
                           <div class="truncate px-1 pb-2 text-xs font-medium">{state.workspaceAudioName}</div>
                           <div class="flex items-center gap-1">
                             <button type="button"
                                     title="Play"
                                     aria-label="Play"
                                     class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-border hover:bg-muted"
                                     on:click={{:kind :workspace-audio-play
                                                :path state.workspaceAudioPath
                                                :name state.workspaceAudioName
                                                :dir state.workspaceAudioDir}}>
                               <span class="lucide-play hidden"></span>
                               Play
                             </button>
                             <button type="button"
                                     title="Repeat"
                                     aria-label="Repeat"
                                     class={(str "inline-flex h-8 w-8 items-center justify-center rounded-md border border-border hover:bg-muted "
                                                 (if state.workspaceAudioRepeat "bg-muted text-foreground" ""))}
                                     on:click={{:kind :workspace-audio-repeat-set :enabled (not state.workspaceAudioRepeat)}}>
                               <span class="lucide-repeat hidden"></span>
                               Rep
                             </button>
                             <button type="button"
                                     class="inline-flex h-8 items-center rounded-md border border-border px-2 text-xs hover:bg-muted"
                                     on:click={{:kind :workspace-audio-stop}}>Stop playback</button>
                           </div>
                           {(if state.workspaceAudioVideoHidden
                                #html <button type="button"
                                              class="mt-2 inline-flex h-8 items-center rounded-md border border-border px-2 text-xs hover:bg-muted"
                                              on:click={{:kind :workspace-show-video}}>Show video</button>
                                #html <span class="hidden"></span>)}
                         </div>
                   #html <span class="hidden"></span>)}
            </div>))

(ann workspaceOptionalString (Fn [(Option String)] String))
(defn workspaceOptionalString [value]
  (match value
    nil ""
    (some text) text))

(ann workspaceTaskbarGroupTooltip (Fn [AppState WorkspaceTabWindow] String))
(defn workspaceTaskbarGroupTooltip [state win]
  (let [iconPath (workspaceOptionalString win.iconPath)
        dir (workspaceOptionalString win.initialState.dir)
        viewing (workspaceOptionalString win.initialState.viewing)
        playing (workspaceOptionalString win.initialState.playing)
        fallbackPlaying (workspaceOptionalString state.playingPath)
        path (if (not (= iconPath ""))
                 iconPath
                 (if (= win.type "browser")
                     dir
                     (if (not (= viewing ""))
                         viewing
                         (if (not (= playing ""))
                             playing
                             fallbackPlaying))))]
    (if (= path "")
        (workspaceWindowTitle win)
        (str (if (= win.type "browser") "Folder: " "File: ") path))))

(ann WorkspaceTaskbarRowContent (Fn [AppState (Option String) String WorkspaceTabWindow String Bool] Html))
(defn WorkspaceTaskbarRowContent [state activeGroup groupId win windowId minimized]
  (let [taskbarFile (workspaceWindowFileItem win)]
    #html <div data-taskbar-window-row
	             data-taskbar-active={(if (= activeGroup groupId) "" nil)}
	             class={(str "flex h-8 min-w-[120px] flex-[0_1_220px] items-center gap-1 overflow-hidden border-r border-border px-2 text-xs "
	                         (if (= activeGroup groupId)
	                             "border-b-2 border-b-primary bg-muted text-foreground"
	                             "border-b-2 border-b-transparent bg-muted/50 text-muted-foreground"))}>
	          <button type="button"
	                  title={(workspaceTaskbarGroupTooltip state win)}
	                  aria-current={(if (= activeGroup groupId) "true" nil)}
	                  class="flex min-w-0 flex-1 items-center gap-1.5 overflow-hidden text-left text-xs touch-manipulation"
	                  on:click={(if minimized
	                              {:kind :workspace-focus-window-id :id windowId}
	                              (if (= activeGroup groupId)
	                                  {:kind :workspace-minimize-window :id windowId :minimized true}
	                                  {:kind :workspace-focus-window-id :id windowId}))}>
	            <span class="inline-flex shrink-0">
	              {(if (= win.type "browser")
	                   (IconFolder "h-3.5 w-3.5 text-blue-500")
	                   (BrowserFileIcon state taskbarFile (browserFileIconClass taskbarFile)))}
	            </span>
	            <span class="min-w-0 truncate">{(workspaceTaskbarGroupLabel state groupId win)}</span>
	          </button>
	          <button type="button"
	                  aria-label={(str "Close " (workspaceTaskbarGroupLabel state groupId win))}
	                  class="flex h-7 w-7 shrink-0 items-center justify-center rounded text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
	                  on:click={{:kind :workspace-close-window-id :id windowId}}>
	            {(IconX "h-4 w-4")}
	          </button>
	        </div>))

(ann WorkspaceTaskbarRowForGroup (Fn [AppState (Option String) String] Html))
(defn WorkspaceTaskbarRowForGroup [state activeGroup groupId]
  (let [visibleWin (workspaceGroupVisibleWindow state groupId)
        hasVisibleWin (some? visibleWin)
        win (unsafe-cast Js visibleWin)
        windowId (if hasVisibleWin (workspaceWindowId win) "")
        minimized (if hasVisibleWin (workspaceWindowMinimized? win) true)]
    #html <div class="contents">
            {(if hasVisibleWin
                 (WorkspaceTaskbarRowContent state activeGroup groupId win windowId minimized)
                 #html <span class="hidden"></span>)}
          </div>))

(ann WorkspaceTaskbarRowAt (Fn [AppState (Option String) (Vector String) Number] Html))
(defn WorkspaceTaskbarRowAt [state activeGroup groups index]
  #html <div class="contents">
          {(if (< index (count groups))
               (WorkspaceTaskbarRowForGroup state activeGroup (nth groups index))
               #html <span class="hidden"></span>)}
        </div>)

(ann WorkspaceTaskbarRowsView (Fn [AppState (Option String) (Vector String)] Html))
(defn WorkspaceTaskbarRowsView [state activeGroup groups]
  #html <div class="contents">
          {(WorkspaceTaskbarRowAt state activeGroup groups 0)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 1)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 2)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 3)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 4)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 5)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 6)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 7)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 8)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 9)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 10)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 11)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 12)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 13)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 14)}
          {(WorkspaceTaskbarRowAt state activeGroup groups 15)}
        </div>)

(ann WorkspaceTaskbarView (Fn [AppState] Html))
(defn WorkspaceTaskbarView [state]
  (let [activeGroup (workspaceActiveGroupId state)
        groups (workspaceGroupIds state)]
    #html <div class="contents">
            <div class="fixed inset-x-0 bottom-0 z-50 flex h-8 items-center gap-2 bg-background px-3 text-foreground">
              <button type="button"
                      title="Open browser window"
                      aria-label="Open browser window"
                      class="flex h-7 w-7 shrink-0 items-center justify-center rounded-none text-amber-500 hover:bg-amber-500/15 hover:text-amber-400"
                      on:click={{:kind :workspace-open-browser}}>
                {(IconFolderOpen "h-5 w-5")}
              </button>
              <div class="flex min-w-0 flex-1 items-center overflow-hidden">
                {(WorkspaceTaskbarPinsView state)}
                {(WorkspaceTaskbarRowsView state activeGroup groups)}
              </div>
              {(WorkspaceTaskbarAudioView state)}
	              <div class="flex shrink-0 items-center gap-1 border-l border-border pl-2">
	                {(if (shareWorkspacePath? state.pathname)
	                     #html <button type="button"
	                                   data-testid="workspace-exit-to-share"
	                                   title="Standard share page — exit workspace layout"
	                                   aria-label="Exit workspace: open standard share page"
	                                   class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-none text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
	                                   on:click={{:kind :workspace-exit-to-share}}>
	                             {(IconArrowLeftFromLine "h-4 w-4")}
	                           </button>
	                     #html <span class="hidden"></span>)}
	                <button type="button"
	                        data-testid="workspace-named-layout-trigger"
                        title="Layouts — save or restore"
                        class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-none text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-40"
                        disabled={(not state.workspaceLayoutPresetsReady)}
                        on:pointerup={{:kind :workspace-layout-menu-toggle
                                       :x 0
                                       :y 0}}
                        on:click={{:kind :workspace-layout-menu-toggle
                                   :x 0
                                   :y 0}}>
                  {(IconLayoutGrid "h-4 w-4")}
                </button>
                <button type="button"
                        title="Settings"
                        aria-label="Open settings"
                        class="h-8 w-8 shrink-0 inline-flex cursor-pointer items-center justify-center rounded-none border-0 bg-transparent text-muted-foreground outline-none transition-colors hover:bg-muted hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring"
                        on:click={{:kind :workspace-settings-open}}>
                  {(IconSettings "h-4 w-4")}
                </button>
              </div>
            </div>
            {(WorkspaceNamedLayoutMenuView state)}
            {(WorkspaceLayoutSaveDialogView state)}
          </div>))

(ann assistGridCols (Fn [String] Number))
(defn assistGridCols [shape]
  (if (or (= shape "3x2") (= shape "3x3")) 3 2))

(ann assistGridRows (Fn [String] Number))
(defn assistGridRows [shape]
  (if (= shape "3x3")
      3
      (if (= shape "2x3") 3 2)))

(ann assistGridLabel (Fn [String] String))
(defn assistGridLabel [shape]
  (if (= shape "3x2")
      "3×2"
      (if (= shape "3x3")
          "3×3"
          (if (= shape "2x2") "2×2" "2×3"))))

(ann assistSpanTestId (Fn [String Number Number Number Number] (Option String)))
(defn assistSpanTestId [kind gc0 gc1 gr0 gr1]
  (if (and (= kind "cell") (= gc0 0) (= gc1 0) (= gr0 0) (= gr1 0))
      "snap-assist-master-cell"
      (if (and (= kind "hgutter") (= gc0 0) (= gc1 0) (= gr0 0) (= gr1 1))
          "snap-assist-hgutter-col0"
          (if (and (= kind "vgutter") (= gc0 0) (= gc1 1) (= gr0 0) (= gr1 0))
              "snap-assist-vgutter-two-cols-top"
              nil))))

(ann assistSpanButtonStyle (Fn [String Number Number] String))
(defn assistSpanButtonStyle [kind gc0 gr0]
  (let [gridColumn (if (= kind "cell")
                       (+ (* gc0 2) 1)
                       (if (= kind "hgutter") (+ (* gc0 2) 1) (* (+ gc0 1) 2)))
        gridRow (if (= kind "cell")
                    (+ (* gr0 2) 1)
                    (if (= kind "vgutter") (+ (* gr0 2) 1) (* (+ gr0 1) 2)))]
    (str "grid-column:" gridColumn ";grid-row:" gridRow)))

(type AssistGridPlacement
  {:kind String
   :gc0 Number
   :gc1 Number
   :gr0 Number
   :gr1 Number})

(ann addCellPlacements (Fn [(Vector AssistGridPlacement) Number Number] (Vector AssistGridPlacement)))
(defn addCellPlacements [out cols rows]
  (reduce (range 0 rows)
          out
          (fn [rowOut r]
            (reduce (range 0 cols)
                    rowOut
                    (fn [acc c]
                      (conj acc {:kind "cell" :gc0 c :gc1 c :gr0 r :gr1 r}))))))

(ann addVerticalGutterPlacements (Fn [(Vector AssistGridPlacement) Number Number] (Vector AssistGridPlacement)))
(defn addVerticalGutterPlacements [out cols rows]
  (reduce (range 0 (- cols 1))
          out
          (fn [colOut c]
            (reduce (range 0 rows)
                    colOut
                    (fn [acc r]
                      (conj acc {:kind "vgutter" :gc0 c :gc1 (+ c 1) :gr0 r :gr1 r}))))))

(ann addHorizontalGutterPlacements (Fn [(Vector AssistGridPlacement) Number Number] (Vector AssistGridPlacement)))
(defn addHorizontalGutterPlacements [out cols rows]
  (reduce (range 0 (- rows 1))
          out
          (fn [rowOut r]
            (reduce (range 0 cols)
                    rowOut
                    (fn [acc c]
                      (conj acc {:kind "hgutter" :gc0 c :gc1 c :gr0 r :gr1 (+ r 1)}))))))

(ann addJunctionPlacements (Fn [(Vector AssistGridPlacement) Number Number] (Vector AssistGridPlacement)))
(defn addJunctionPlacements [out cols rows]
  (reduce (range 0 (- cols 1))
          out
          (fn [colOut c]
            (reduce (range 0 (- rows 1))
                    colOut
                    (fn [acc r]
                      (conj acc {:kind "junction" :gc0 c :gc1 (+ c 1) :gr0 r :gr1 (+ r 1)}))))))

(ann assistGridPlacements (Fn [Number Number] (Vector AssistGridPlacement)))
(defn assistGridPlacements [cols rows]
  (addJunctionPlacements
   (addHorizontalGutterPlacements
    (addVerticalGutterPlacements
     (addCellPlacements [] cols rows)
     cols
     rows)
    cols
    rows)
   cols
   rows))

(ann clearAssistHoverActive (Fn [Js] Nil))
(defn clearAssistHoverActive [root]
  (do
    (let [items (jsArray.from (root.querySelectorAll "[data-assist-grid-span]"))]
      (items.forEach (fn [item] (item.removeAttribute "data-snap-assist-hover-active"))))
    nil))

(defn setAssistHoverActive [event]
  (let [el event.currentTarget
        root (if (some? el) (el.closest "[data-assist-master-grid]") nil)
        span (parseAssistSpanElement el)]
    (do
      (if (some? root) (clearAssistHoverActive root) nil)
      (if (some? el) (el.setAttribute "data-snap-assist-hover-active" "") nil)
      (if (some? span) (showWorkspaceSnapPreview span) nil)
      (match span
        nil {:kind :noop}
        (some current) {:kind :workspace-assist-hover
                        :gridCols current.gridCols
                        :gridRows current.gridRows
                        :gc0 current.gc0
                        :gc1 current.gc1
                        :gr0 current.gr0
                        :gr1 current.gr1}))))

(ann assistSpanMatches? (Fn [(Option AssistGridSpan) Number Number Number Number Number Number] Bool))
(defn assistSpanMatches? [activeSpan cols rows gc0 gc1 gr0 gr1]
  (match activeSpan
    nil false
    (some span)
      (and (= span.gridCols cols)
           (= span.gridRows rows)
           (= span.gc0 gc0)
           (= span.gc1 gc1)
           (= span.gr0 gr0)
           (= span.gr1 gr1))))

(ann WorkspaceAssistSpanButton (Fn [String String Bool (Option AssistGridSpan) Number Number String Number Number Number Number] Html))
(defn WorkspaceAssistSpanButton [windowId shape pickMode activeSpan cols rows kind gc0 gc1 gr0 gr1]
  #html <button type="button"
                tabindex="-1"
                data-assist-grid-span
                data-snap-assist-hover-active={(if (assistSpanMatches? activeSpan cols rows gc0 gc1 gr0 gr1) "" nil)}
                data-gc0={gc0}
                data-gc1={gc1}
                data-gr0={gr0}
                data-gr1={gr1}
                data-grid-cols={cols}
                data-grid-rows={rows}
                data-testid={(assistSpanTestId kind gc0 gc1 gr0 gr1)}
                class={(if (= kind "cell")
                           "rounded-sm border border-border bg-muted p-0 transition-colors"
                           "border-0 bg-background p-0 transition-colors")}
                style={(assistSpanButtonStyle kind gc0 gr0)}
                on:mouseenter={(setAssistHoverActive event)}
                on:click={(if pickMode
                            {:kind :workspace-tiling-pick
                             :id windowId
                             :gridCols cols
                             :gridRows rows
                             :gc0 gc0
                             :gc1 gc1
                             :gr0 gr0
                             :gr1 gr1}
                            {:kind :noop})}></button>)

(ann WorkspaceAssistMiniGrid (Fn [String String Bool (Option AssistGridSpan)] Html))
(defn WorkspaceAssistMiniGrid [windowId shape pickMode activeSpan]
  (let [cols (assistGridCols shape)
        rows (assistGridRows shape)
        placements (assistGridPlacements cols rows)
        colTemplate (if (= cols 3) "minmax(0,1fr) 6px minmax(0,1fr) 6px minmax(0,1fr)" "minmax(0,1fr) 6px minmax(0,1fr)")
        rowTemplate (if (= rows 3) "minmax(0,1fr) 6px minmax(0,1fr) 6px minmax(0,1fr)" "minmax(0,1fr) 6px minmax(0,1fr)")]
    #html <div class="flex min-w-0 flex-col" data-assist-mini-grid={shape}>
            <div data-assist-label={(assistGridLabel shape)}
                 class="mb-0.5 text-center text-[10px] font-medium tracking-wider text-muted-foreground"></div>
            <div data-assist-master-grid
                 class="relative grid w-[84px] shrink-0 rounded-md border border-border bg-background p-1 shadow-sm sm:w-24"
                 style={(str "aspect-ratio:1.6;grid-template-columns:" colTemplate ";grid-template-rows:" rowTemplate)}>
              {(for [placement placements :key (str shape "-" placement.kind "-" placement.gc0 "-" placement.gc1 "-" placement.gr0 "-" placement.gr1)]
                 #html <button type="button"
                               tabindex="-1"
                               data-assist-grid-span
                               data-gc0={placement.gc0}
                               data-gc1={placement.gc1}
                               data-gr0={placement.gr0}
                               data-gr1={placement.gr1}
                               data-snap-assist-hover-active={(if (assistSpanMatches? activeSpan cols rows placement.gc0 placement.gc1 placement.gr0 placement.gr1) "" nil)}
                               data-grid-cols={cols}
                               data-grid-rows={rows}
                               data-testid={(assistSpanTestId placement.kind placement.gc0 placement.gc1 placement.gr0 placement.gr1)}
                               class={(if (= placement.kind "cell")
                                          "rounded-sm border border-border bg-muted p-0 transition-colors"
                                          "border-0 bg-background p-0 transition-colors")}
                               style={(assistSpanButtonStyle placement.kind placement.gc0 placement.gr0)}
                               on:mouseenter={(setAssistHoverActive event)}
                               on:click={(if pickMode
                                           {:kind :workspace-tiling-pick
                                            :id windowId
                                            :gridCols cols
                                            :gridRows rows
                                            :gc0 placement.gc0
                                            :gc1 placement.gc1
                                            :gr0 placement.gr0
                                            :gr1 placement.gr1}
                                           {:kind :noop})}></button>)}
            </div>
          </div>))

(ann WorkspaceAssistGridSet (Fn [String Bool (Option AssistGridSpan)] Html))
(defn WorkspaceAssistGridSet [windowId pickMode activeSpan]
  #html <div class="flex max-w-[min(100vw-1rem,32rem)] justify-center gap-2 overflow-x-auto">
          {(WorkspaceAssistMiniGrid windowId "3x2" pickMode activeSpan)}
          {(WorkspaceAssistMiniGrid windowId "3x3" pickMode activeSpan)}
          {(WorkspaceAssistMiniGrid windowId "2x2" pickMode activeSpan)}
          {(WorkspaceAssistMiniGrid windowId "2x3" pickMode activeSpan)}
        </div>)

(ann workspaceActiveDragSnapSpan (Fn [AppState] (Option AssistGridSpan)))
(defn workspaceActiveDragSnapSpan [state]
  (match state.workspaceWindowDrag
    nil nil
    (some drag) drag.snapSpan))

(ann workspaceSnapPreviewStyle (Fn [AppState] String))
(defn workspaceSnapPreviewStyle [state]
  (match state.workspaceWindowDrag
    nil "display:none;z-index:99999"
    (some drag)
      (match drag.snapSpan
        nil "display:none;z-index:99999"
        (some span)
          (let [bounds (assistGridSpanToBounds (getViewportSize) span)]
            (str "display:block;z-index:99999;left:" bounds.x "px;top:" bounds.y "px;width:" bounds.width "px;height:" bounds.height "px")))))

(ann workspaceSnapAssistStyle (Fn [AppState] String))
(defn workspaceSnapAssistStyle [state]
  (match state.workspaceWindowDrag
    nil "display:none"
    (some drag)
      (if (workspaceWindowDragKeepsAssistVisible? state drag drag.clientX drag.clientY)
          "display:block"
          "display:none")))

(def workspaceTilingPickerApproxWidth 360)
(def workspaceTilingPickerApproxHeight 520)

(ann workspaceTilingPickerLeft (Fn [Number] Number))
(defn workspaceTilingPickerLeft [anchorLeft]
  (let [maxLeft (- jsWindow.innerWidth workspaceTilingPickerApproxWidth)]
    (max 0 (min anchorLeft maxLeft))))

(ann workspaceTilingPickerTop (Fn [Number] Number))
(defn workspaceTilingPickerTop [anchorTop]
  (let [below (+ anchorTop 4)
        above (- anchorTop workspaceTilingPickerApproxHeight 4)
        bottomLimit (- jsWindow.innerHeight workspaceTilingPickerApproxHeight)
        initial (if (> (+ below workspaceTilingPickerApproxHeight) jsWindow.innerHeight)
                    above
                    below)
        next (if (> (+ initial workspaceTilingPickerApproxHeight) jsWindow.innerHeight)
                 bottomLimit
                 initial)]
    (max 0 (min next bottomLimit))))

(ann workspaceTilingPickerStyle (Fn [AppState] String))
(defn workspaceTilingPickerStyle [state]
  (str "left:" (workspaceTilingPickerLeft state.workspaceLayoutPickerX)
       "px;top:" (workspaceTilingPickerTop state.workspaceLayoutPickerY)
       "px"))

(ann WorkspaceTilingPickerView (Fn [AppState] Html))
(defn WorkspaceTilingPickerView [state]
  (if state.workspaceLayoutPickerOpen
      #html <div class="contents">
              <div class="pointer-events-none fixed inset-0 z-[9998]"></div>
              <div data-tiling-picker
                   class="fixed z-[9999] max-h-[min(85vh,520px)] overflow-y-auto rounded-lg border border-border bg-popover/95 p-3 shadow-2xl backdrop-blur"
                   style={(workspaceTilingPickerStyle state)}
                   on:mousedown={(Event.stop {:kind :noop})}
                   on:pointerdown={(Event.stop {:kind :noop})}>
                <div class="flex flex-col gap-3">
                  {(WorkspaceAssistGridSet state.workspaceLayoutPickerWindowId true nil)}
                </div>
              </div>
            </div>
      #html <span class="hidden"></span>))

(ann WorkspaceEmptyState (Fn [] Html))
(defn WorkspaceEmptyState []
  #html <div class="flex h-full items-center justify-center p-6">
          <div class="w-full max-w-md rounded-xl border border-border bg-card/95 p-8 text-center shadow-2xl">
            <div class="space-y-3">
              <div class="text-lg font-medium">No windows are open</div>
              <div class="text-sm text-muted-foreground">Start a browser window to build your workspace.</div>
              <button type="button"
                      class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground shadow hover:bg-primary/90"
                      on:click={{:kind :workspace-open-browser}}>Open Browser</button>
            </div>
          </div>
        </div>)

(ann WorkspaceGroupWindowAt (Fn [AppState (Vector String) Number] Html))
(defn WorkspaceGroupWindowAt [state groups index]
  #html <div class="contents">
          {(if (< index (count groups))
               (WorkspaceGroupWindowView state (nth groups index))
               #html <span class="hidden"></span>)}
        </div>)

(ann WorkspaceGroupWindowsView (Fn [AppState (Vector String)] Html))
(defn WorkspaceGroupWindowsView [state groups]
  #html <div class="contents">
          {(WorkspaceGroupWindowAt state groups 0)}
          {(WorkspaceGroupWindowAt state groups 1)}
          {(WorkspaceGroupWindowAt state groups 2)}
          {(WorkspaceGroupWindowAt state groups 3)}
          {(WorkspaceGroupWindowAt state groups 4)}
          {(WorkspaceGroupWindowAt state groups 5)}
          {(WorkspaceGroupWindowAt state groups 6)}
          {(WorkspaceGroupWindowAt state groups 7)}
          {(WorkspaceGroupWindowAt state groups 8)}
          {(WorkspaceGroupWindowAt state groups 9)}
          {(WorkspaceGroupWindowAt state groups 10)}
          {(WorkspaceGroupWindowAt state groups 11)}
          {(WorkspaceGroupWindowAt state groups 12)}
          {(WorkspaceGroupWindowAt state groups 13)}
          {(WorkspaceGroupWindowAt state groups 14)}
          {(WorkspaceGroupWindowAt state groups 15)}
        </div>)

(ann WorkspaceWindowsContent (Fn [AppState] Html))
(defn WorkspaceWindowsContent [state]
  (let [groups (workspaceGroupIds state)]
    #html <div data-workspace-canvas
               class="relative h-full">
            <div data-snap-preview
                 class="pointer-events-none absolute rounded-sm border-2 border-blue-400/50 bg-blue-500/15 transition-all duration-150"
                 style={(workspaceSnapPreviewStyle state)}></div>
            {(if state.workspaceLayoutPickerOpen
                 #html <span class="hidden"></span>
                 #html <div data-workspace-snap-assist
                            class="pointer-events-auto absolute left-1/2 top-2 z-[100000] hidden max-w-[calc(100%-1rem)] -translate-x-1/2 rounded-lg border border-border bg-popover/95 p-2 shadow-2xl"
                            style={(workspaceSnapAssistStyle state)}>
                         <div data-assist-label="Snap layouts"
                              class="mb-1 text-center text-[10px] font-medium uppercase tracking-wider text-muted-foreground"></div>
                         {(WorkspaceAssistGridSet "" false (workspaceActiveDragSnapSpan state))}
                       </div>)}
	            {(WorkspaceGroupWindowsView state groups)}
	            {(WorkspaceTabMenuView state)}
	            {(WorkspaceTilingPickerView state)}
	          </div>))

(ann WorkspaceCanvasContent (Fn [AppState] Html))
(defn WorkspaceCanvasContent [state]
  #html <div class="contents">
          {(if (= (count (workspaceWindows state)) 0)
               (WorkspaceEmptyState)
               (WorkspaceWindowsContent state))}
        </div>)

(ann BrowserView (Fn [AppState] Html))
(defn BrowserView [state]
	  #html <div class="min-h-screen bg-background"
		             data-testid="upload-drop-zone"
		             on:dragenter={(Event.prevent {:kind :admin-drag-enter-upload})}
		             on:dragover={(Event.prevent {:kind :admin-drag-enter-upload})}
		             on:dragleave={{:kind :admin-drag-leave-upload}}>
		          {(AdminMediaPlayerLayer state)}
		          {(FloatingPlayingFileAction state false (visibleBrowserFiles state) (selectedPlayingFile state))}
		          {(AdminViewerLayer state)}
		          <div data-testid="media-chrome-pad-root"
		               class={(if (showAdminAudioChrome? state) "max-[649px]:pb-[calc(2.875rem+env(safe-area-inset-bottom,0px))] min-[650px]:pb-12" "")}>
		            <div data-testid="file-browser"
			                 class="flex min-h-0 flex-1 flex-col outline-none"
		                 tabindex="0"
	                 contenteditable="plaintext-only"
	                 on:keydown={(browserKeydownMessage event)}
	                 on:paste={(Event.prevent {:kind :admin-paste
	                                            :text (if (some? event.clipboardData)
	                                                      (event.clipboardData.getData "text/plain")
	                                                      "")})}>
              <div class="container mx-auto lg:p-4">
                <div class="ring-foreground/10 bg-card text-card-foreground flex flex-col gap-0 overflow-hidden rounded-none py-0 text-sm shadow-xs ring-1 lg:rounded-xl">
                  {(BrowserToolbar state)}
		                  <div class="relative flex flex-col">
	                    {(if (some? state.authError)
	                         #html <div class="border-b border-destructive/30 bg-destructive/10 px-4 py-2 text-xs text-destructive">{state.authError}</div>
	                         #html <span class="hidden"></span>)}
                    {(if (some? state.settingsError)
                         #html <div class="border-b border-destructive/30 bg-destructive/10 px-4 py-2 text-xs text-destructive">{state.settingsError}</div>
                         #html <span class="hidden"></span>)}
                    {(if (some? state.sharesError)
                         #html <div class="border-b border-destructive/30 bg-destructive/10 px-4 py-2 text-xs text-destructive">{state.sharesError}</div>
                         #html <span class="hidden"></span>)}
		                    {(DirectoryBody state)}
		                    {(if state.adminExternalDragOver
	                         #html <div class="pointer-events-none absolute inset-0 z-30 flex items-center justify-center border-2 border-dashed border-primary bg-background/80 text-sm font-medium text-foreground">
	                                 Drop files to upload
	                               </div>
	                         #html <span class="hidden"></span>)}
	                  </div>
	                </div>
	              </div>
	              {(ContextMenuView state)}
	              {(KnowledgeBaseSearchOverlay state)}
		              {(ThemeMenuView state)}
		              {(AdminDialogLayer state)}
	              {(UnsupportedFileDialog state)}
		            </div>
		          </div>
	          {(AdminUploadToast state)}
	        </div>)

(ann ShareFolderView (Fn [AppState] Html))
(defn ShareFolderView [state]
	  #html <div class="min-h-screen bg-background">
	          {(ShareMediaPlayerLayer state)}
	          {(ShareViewerLayer state)}
	          {(FloatingPlayingFileAction state true state.shareFiles (selectedSharePlayingFile state))}
		          <div data-testid="share-file-browser"
		               class="flex min-h-0 flex-1 flex-col outline-none"
	               tabindex="0">
            <div class="container mx-auto lg:p-4">
              <div class="ring-foreground/10 bg-card text-card-foreground flex flex-col gap-0 overflow-hidden rounded-none py-0 text-sm shadow-xs ring-1 lg:rounded-xl">
                <div class="shrink-0 border-b border-border bg-muted/30 p-1.5 lg:p-2">
                  <div class="flex flex-wrap items-center justify-between w-full gap-1.5 lg:gap-2">
                    <div data-breadcrumb-slot
                         data-testid="breadcrumb-slot"
                         class="flex min-h-0 min-w-0 flex-1 overflow-hidden">
	                      {(ShareBreadcrumbsView state)}
	                    </div>
		                    <div class="flex items-center gap-1">
		                      {(if state.shareAllowUpload
		                           (ShareUploadControls state)
		                           #html <span class="hidden"></span>)}
		                      {(ShareViewModeToggle state)}
		                      {(ShareHeaderSettingsButton state)}
	                    </div>
	                  </div>
	                </div>
	                {(ThemeMenuView state)}
	                <div class="relative flex flex-col" data-testid="upload-drop-zone">
	                  {(ShareFolderBody state)}
	                </div>
	              </div>
	            </div>
	            {(ContextMenuView state)}
		            {(ShareDialogLayer state)}
		            {(ShareUploadToast state)}
		          </div>
		        </div>)

(ann ShareRouteView (Fn [AppState] Html))
(defn ShareRouteView [state]
  #html <div>
          {(if state.shareInfoPending
               (ShareLoadingView)
               (if (some? state.shareInfoError)
                   (ShareNotFoundView)
		                   (if (and state.shareNeedsPasscode (not state.shareAuthorized))
		                       (SharePasscodeView state)
		                       (if state.shareIsDirectory
		                           (ShareFolderView state)
		                           #html <div class="min-h-screen bg-background">
		                                   {(ShareMediaPlayerLayer state)}
		                                   {(ShareFilePageView state)}
		                                   {(ShareViewerLayer state)}
		                                 </div>))))}
	          {(if (and (not state.shareInfoPending) (not state.shareIsDirectory))
	               (ThemeMenuView state)
	               #html <span class="hidden"></span>)}
	        </div>)

(ann WorkspaceRouteView (Fn [AppState] Html))
(defn WorkspaceRouteView [state]
  #html <div class="contents">
          {(if (shareWorkspacePath? state.pathname)
               (if state.shareInfoPending
                   (ShareLoadingView)
                   (if (some? state.shareInfoError)
                       (ShareNotFoundView)
                       (if (and state.shareNeedsPasscode (not state.shareAuthorized))
                           (SharePasscodeView state)
                           (if (not state.shareIsDirectory)
                               #html <main class="relative flex min-h-screen items-center justify-center bg-background text-foreground">
                                       {(FloatingThemeButton)}
                                       <p class="text-sm text-muted-foreground">Loading...</p>
                                     </main>
                               #html <main class="relative h-screen overflow-hidden bg-background text-foreground"
                                           on:pointerdown={(if state.workspaceLayoutPickerOpen
                                                              {:kind :workspace-close-layout-picker}
                                                              {:kind :noop})}>
                                       <div class="absolute inset-x-0 top-0 bottom-8 overflow-hidden">
                                         {(WorkspaceCanvasContent state)}
                                       </div>
                                       {(WorkspaceTaskbarView state)}
                                       {(WorkspaceSettingsDialog state)}
                                       {(ContextMenuView state)}
                                       {(KnowledgeBaseSearchOverlay state)}
                                       {(ShareDialogLayer state)}
                                       {(ShareMediaPlayerLayer state)}
                                     </main>))))
               #html <main class="relative h-screen overflow-hidden bg-background text-foreground"
                           on:pointerdown={(if state.workspaceLayoutPickerOpen
                                              {:kind :workspace-close-layout-picker}
                                              {:kind :noop})}>
                       <div class="absolute inset-x-0 top-0 bottom-8 overflow-hidden">
                         {(WorkspaceCanvasContent state)}
                       </div>
                       {(WorkspaceTaskbarView state)}
                       {(WorkspaceSettingsDialog state)}
                       {(ContextMenuView state)}
                       {(KnowledgeBaseSearchOverlay state)}
                       {(AdminDialogLayer state)}
                       {(AdminViewerLayer state)}
                       {(AdminMediaPlayerLayer state)}
                     </main>)}
        </div>)

(ann view (Fn [AppState] Html))
(defn view [state]
  (if (= state.pathname "/login")
      (LoginView state)
      (if (workspaceRoute? state)
          (WorkspaceRouteView state)
          (if (shareRoute? state)
              (ShareRouteView state)
              (if (browserRoute? state)
                  (BrowserView state)
                  (PlaceholderRouteView state))))))
