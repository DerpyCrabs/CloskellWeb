(ann shareWorkspacePath? (Fn [String] Bool))
(defn shareWorkspacePath? [pathname]
  (regex-test? pathname "^/share/[^/]+/workspace/?$" ""))

(ann workspaceRoute? (Fn [AppState] Bool))
(defn workspaceRoute? [state]
  (or (= state.pathname "/workspace")
      (shareWorkspacePath? state.pathname)))

(ann workspacePathname? (Fn [String] Bool))
(defn workspacePathname? [pathname]
  (or (= pathname "/workspace")
      (shareWorkspacePath? pathname)))

(ann hrefWithWorkspaceSession (Fn [String] String))
(defn hrefWithWorkspaceSession [href]
  (let [url (new jsURL href jsWindow.location.origin)
        sid (url.searchParams.get "ws")]
    (if (and (workspacePathname? url.pathname)
             (not (and (string? sid) (not (= sid "")))))
        (do
          (url.searchParams.set "ws" (jsCrypto.randomUUID))
          (str url.pathname url.search url.hash))
        href)))

(ann shareIndexRoute? (Fn [AppState] Bool))
(defn shareIndexRoute? [state]
  (or (= state.pathname "/share") (= state.pathname "/share/")))

(ann loginSubpathRoute? (Fn [AppState] Bool))
(defn loginSubpathRoute? [state]
  (starts-with? state.pathname "/login/"))

(ann publicBrowserShellRoute? (Fn [AppState] Bool))
(defn publicBrowserShellRoute? [state]
  (or (shareIndexRoute? state) (loginSubpathRoute? state)))

(ann shareRoute? (Fn [AppState] Bool))
(defn shareRoute? [state]
  (and (some? state.shareToken)
       (not (shareWorkspacePath? state.pathname))))

(ann browserRoute? (Fn [AppState] Bool))
(defn browserRoute? [state]
  (and (not (= state.pathname "/login"))
       (not (workspaceRoute? state))
       (not (shareRoute? state))))

(ann routeLabel (Fn [AppState] String))
(defn routeLabel [state]
  (if (= state.pathname "/login")
      "login"
      (if (= state.pathname "/workspace")
          "workspace"
          (if (starts-with? state.pathname "/share/")
              "share"
              "browser"))))

(ann routeTitle (Fn [AppState] String))
(defn routeTitle [state]
  (if (= state.pathname "/workspace")
      "Workspace"
      (if (starts-with? state.pathname "/share/")
          "Shared media"
          "Media browser")))

(ann routeDescription (Fn [AppState] String))
(defn routeDescription [state]
  (if (= state.pathname "/workspace")
      "Workspace routing still needs its native Closkell view port."
      (if (starts-with? state.pathname "/share/")
          "Share routing still needs its native Closkell view port."
          "Browse media through the Closkell app shell.")))

(ann markBrowserLoading (Fn [AppState] AppState))
(defn markBrowserLoading [state]
  (merge state {:authPending true
                :authError nil
                :settingsPending true
                :settingsError nil
                :sharesPending true
                :sharesError nil
                :filesPending true
                :filesError nil
                :adminUploadMenuOpen false
                :adminExternalDragOver false
                :adminCreateKind "none"
                :adminCreateName ""
                :adminCreatePending false
                :adminCreateError nil
                :adminRenameOpen false
                :adminRenameOldPath ""
                :adminRenameName ""
                :adminRenamePending false
                :adminRenameError nil
                :adminDeleteOpen false
                :adminDeletePath ""
                :adminDeleteName ""
                :adminDeletePending false
                :adminDeleteError nil
                :adminTransferMode "none"
                :adminTransferPath ""
                :adminTransferName ""
                :adminTransferBrowsePath ""
                :adminTransferPending false
	                :adminTransferError nil
	                :adminShareOpen false
	                :adminSharePath ""
	                :adminShareName ""
	                :adminShareIsDirectory false
	                :adminShareCreateOpen false
	                :adminShareEditable false
	                :adminShareAllowUpload true
	                :adminShareAllowEdit true
	                :adminShareAllowDelete true
	                :adminSharePending false
	                :adminShareError nil
	                :adminShareDeletingToken ""
	                :adminPasteOpen false
	                :adminPastePending false
	                :adminPasteError nil
	                :adminMarkdownImageOpen false
	                :themeMenuOpen false
	                :themeMode state.themeMode
	                :themePalette state.themePalette
	                :scrollY 0
	                :draggedPath nil}))

(ann markShareLoading (Fn [AppState] AppState))
(defn markShareLoading [state]
  (merge state {:shareInfoPending true
                :shareInfoError nil
                :shareInfoStatus 0
                :shareFilesPending false
                :shareFilesError nil
	                :shareFiles []
	                :sharePasscodeError nil
	                :sharePasscodePending false
	                :sharePasscodeAutoTried false
	                :shareUploadMenuOpen false
	                :shareUploadSelected false
	                :shareUploadPending false
	                :shareUploadStatus nil
	                :shareCreateKind "none"
	                :shareCreateName ""
	                :shareCreatePending false
	                :shareCreateError nil
	                :shareRenameOpen false
	                :shareRenameOldPath ""
	                :shareRenameName ""
	                :shareRenamePending false
	                :shareRenameError nil
	                :shareDeleteOpen false
	                :shareDeletePath ""
	                :shareDeleteName ""
	                :shareDeletePending false
	                :shareDeleteError nil
	                :shareTextPath ""
	                :shareTextContent ""
	                :shareTextPending false
	                :shareTextError nil
	                :shareTextSaving false
	                :shareImageZoom 0
	                :shareImageRotation 0
	                :shareAudioRepeat false
	                :shareVideoCompact false}))

