(ann keydownSubscription (Fn [] (Sub AppMsg)))
(defn keydownSubscription []
  {:kind :sub/window/event
   :id "global-keydown"
   :type "keydown"
   :onEvent (fn [payload]
              (let [key (if (string? payload.key) payload.key "")
                    ctrlKey (= payload.ctrlKey true)
                    metaKey (= payload.metaKey true)
                    targetEditable (keyboardEditableActive?)]
                (if (and (not targetEditable) (keySearchShortcut? key ctrlKey metaKey))
                    {:kind :kb-search-open}
                    {:kind :global-keydown
                     :key key
                     :ctrlKey ctrlKey
                     :metaKey metaKey
                     :targetEditable targetEditable})))})

(ann browserKeydownMessage (Fn [Js] Js))
(defn browserKeydownMessage [event]
  (let [key (if (string? event.key) event.key "")
        ctrlKey (= event.ctrlKey true)
        metaKey (= event.metaKey true)
        targetEditable (keyboardEditableTarget? event.target)]
    (if (and (not targetEditable) (keySearchShortcut? key ctrlKey metaKey))
        {:kind :kb-search-open}
        {:kind :global-keydown
         :key key
         :ctrlKey ctrlKey
         :metaKey metaKey
         :targetEditable targetEditable})))

(ann windowScrollSubscription (Fn [] (Sub AppMsg)))
(defn windowScrollSubscription []
  {:kind :sub/window/event
   :id "window-scroll"
   :type "scroll"
   :onEvent (fn [_payload] {:kind :window-scroll :y jsWindow.scrollY})})

(ann pasteSubscription (Fn [] (Sub AppMsg)))
(defn pasteSubscription []
  {:kind :sub/window/event
   :id "admin-paste"
   :type "paste"
   :onEvent (fn [payload]
              (let [data payload.clipboardData
                    text (if (some? data) (data.getData "text/plain") "")]
                {:kind :admin-paste :text text}))})

(ann subscriptions (Fn [AppState] (Sub AppMsg)))
(defn subscriptions [state]
  (Sub.batch [(routePopstateSubscription)
              (sseRefreshSubscription)
              (workspaceWindowDragMoveSubscription state)
              (workspaceWindowDragEndSubscription state "workspace-window-drag-up" "pointerup")
              (workspaceWindowDragEndSubscription state "workspace-window-drag-cancel" "pointercancel")
              (workspaceResizeMoveSubscription state)
              (workspaceResizeEndSubscription state)
              (workspaceTabDragEndSubscription state "workspace-tab-drag-up" "pointerup")
              (workspaceTabDragEndSubscription state "workspace-tab-drag-cancel" "pointercancel")
              (workspaceSplitResizeMoveSubscription state)
              (workspaceSplitResizeEndSubscription state "workspace-split-resize-up" "pointerup")
              (workspaceSplitResizeEndSubscription state "workspace-split-resize-cancel" "pointercancel")
              (keydownSubscription)
              (windowScrollSubscription)
              (pasteSubscription)]))

(ann mediaRootsFromAuth (Fn [AuthResponse] (Vector MediaRootSummary)))
(defn mediaRootsFromAuth [response]
  (if (vector? response.body.mediaRoots) response.body.mediaRoots []))

(ann viewModeFromSettings (Fn [GlobalSettings String] String))
(defn viewModeFromSettings [settings dir]
  (let [value (object-get settings.viewModes dir)]
    (if (= value "grid") "grid" "list")))

(ann viewModeFromViewModes (Fn [(Map String String) String] String))
(defn viewModeFromViewModes [viewModes dir]
  (let [value (object-get viewModes dir)]
    (if (= value "grid") "grid" "list")))

(ann unauthorized? (Fn [Number] Bool))
(defn unauthorized? [status]
  (= status 401))

(ann maybeRedirectUnauthorized (Fn [Number] (Cmd AppMsg)))
(defn maybeRedirectUnauthorized [status]
  (if (unauthorized? status)
      {:kind :browser/location-assign :url "/login"}
      Cmd.none))

(ann browserHref (Fn [String (Option String)] String))
(defn browserHref [dir viewing]
  (let [dirPart (if (= dir "") "" (str "dir=" (encode-uri-component dir)))
        viewingPart (if (some? viewing) (str "viewing=" (encode-uri-component viewing)) "")]
    (if (= dirPart "")
        (if (= viewingPart "") "/" (str "/?" viewingPart))
        (if (= viewingPart "") (str "/?" dirPart) (str "/?" dirPart "&" viewingPart)))))

(ann browserMediaHref (Fn [String (Option String) (Option String) Bool] String))
(defn browserMediaHref [dir viewing playing audioOnly]
  (let [parts (filter [(if (= dir "") "" (str "dir=" (encode-uri-component dir)))
                       (match viewing nil "" (some value) (str "viewing=" (encode-uri-component value)))
                       (match playing nil "" (some value) (str "playing=" (encode-uri-component value)))
                       (if audioOnly "audioOnly=true" "")]
                      (fn [part] (not (= part ""))))
        query (join parts "&")]
    (if (= query "") "/" (str "/?" query))))

(ann shareHref (Fn [String String (Option String)] String))
(defn shareHref [token dir viewing]
  (let [dirPart (if (= dir "") "" (str "dir=" (encode-uri-component dir)))
        viewingPart (if (some? viewing) (str "viewing=" (encode-uri-component viewing)) "")
        base (str "/share/" token)]
    (if (= dirPart "")
        (if (= viewingPart "") base (str base "?" viewingPart))
        (if (= viewingPart "") (str base "?" dirPart) (str base "?" dirPart "&" viewingPart)))))

(ann shareMediaHref (Fn [String String (Option String) (Option String) Bool] String))
(defn shareMediaHref [token dir viewing playing audioOnly]
  (let [parts (filter [(if (= dir "") "" (str "dir=" (encode-uri-component dir)))
                       (match viewing nil "" (some value) (str "viewing=" (encode-uri-component value)))
                       (match playing nil "" (some value) (str "playing=" (encode-uri-component value)))
                       (if audioOnly "audioOnly=true" "")]
                      (fn [part] (not (= part ""))))
        query (join parts "&")
        base (str "/share/" token)]
    (if (= query "") base (str base "?" query))))

(ann shareClassicHrefForState (Fn [AppState String] String))
(defn shareClassicHrefForState [state token]
  (let [url (new jsURL state.currentUrl jsWindow.location.origin)]
    (do
      (url.searchParams.delete "ws")
      (url.searchParams.delete "preset")
      (str "/share/" token url.search url.hash))))

(ann workspaceHref (Fn [String] String))
(defn workspaceHref [path]
  (if (= path "")
      "/workspace"
      (str "/workspace?dir=" (encode-uri-component path))))

(ann workspaceHrefForState (Fn [AppState String] String))
(defn workspaceHrefForState [state path]
  (let [dirPart (if (= path "") "" (str "dir=" (encode-uri-component path)))
        wsPart (match (workspaceSessionFromSearch state.search)
                 nil ""
                 (some session) (str "ws=" (encode-uri-component session)))
        parts (filter [dirPart wsPart] (fn [part] (not (= part ""))))
        query (join parts "&")]
    (if (= query "") "/workspace" (str "/workspace?" query))))

(ann shareWorkspaceHref (Fn [String String] String))
(defn shareWorkspaceHref [token path]
  (if (= path "")
      (str "/share/" token "/workspace")
      (str "/share/" token "/workspace?dir=" (encode-uri-component path))))

(ann shareWorkspaceHrefForState (Fn [AppState String String] String))
(defn shareWorkspaceHrefForState [state token path]
  (let [dirPart (if (= path "") "" (str "dir=" (encode-uri-component path)))
        wsPart (match (workspaceSessionFromSearch state.search)
                 nil ""
                 (some session) (str "ws=" (encode-uri-component session)))
        parts (filter [dirPart wsPart] (fn [part] (not (= part ""))))
        query (join parts "&")
        base (str "/share/" token "/workspace")]
    (if (= query "") base (str base "?" query))))

(ann routeMerge (Fn [AppState String] AppState))
(defn routeMerge [state href]
  (merge state (routeStateFromUrl href)))

(ann workspacePersistCommand (Fn [AppState] (Cmd AppMsg)))
(defn workspacePersistCommand [state]
  (if (workspaceRoute? state)
      (storageSetCommand (workspaceStorageKeyForState state)
                         (workspaceStateStorageValue state.workspace))
      Cmd.none))

(ann persistWorkspaceIfChangedCommand (Fn [AppState AppState] (Cmd AppMsg)))
(defn persistWorkspaceIfChangedCommand [before after]
  (if (and (workspaceRoute? after)
           after.workspaceStorageLoaded
           (or (not (= before.workspaceRevision after.workspaceRevision))
               (not (= (workspaceStateStorageValue before.workspace)
                       (workspaceStateStorageValue after.workspace)))))
      (workspacePersistCommand after)
      Cmd.none))

(ann withPersistWorkspaceCommand (Fn [(Cmd AppMsg) AppState AppState] (Cmd AppMsg)))
(defn withPersistWorkspaceCommand [cmd before after]
  (Cmd.batch [cmd (persistWorkspaceIfChangedCommand before after)]))

(ann documentTitleIfChangedCommand (Fn [AppState AppState] (Cmd AppMsg)))
(defn documentTitleIfChangedCommand [before after]
  (if (= (appDocumentTitle before) (appDocumentTitle after))
      Cmd.none
      (documentTitleForStateCommand after)))

(ann withAppEffectCommands (Fn [(Cmd AppMsg) AppState AppState] (Cmd AppMsg)))
(defn withAppEffectCommands [cmd before after]
  (Cmd.batch [cmd
              (persistWorkspaceIfChangedCommand before after)
              (documentTitleIfChangedCommand before after)]))

(ann workspaceLayoutScopeForState (Fn [AppState] String))
(defn workspaceLayoutScopeForState [state]
  (workspaceLayoutScopeFromShareToken state.shareToken))

(ann workspacePresetParam (Fn [AppState] (Option String)))
(defn workspacePresetParam [state]
  (let [url (new jsURL state.currentUrl jsWindow.location.origin)
        value (url.searchParams.get "preset")]
    (if (and (string? value) (not (= value ""))) value nil)))

(ann workspaceHrefWithoutPreset (Fn [AppState] String))
(defn workspaceHrefWithoutPreset [state]
  (let [url (new jsURL state.currentUrl jsWindow.location.origin)]
    (do
      (url.searchParams.delete "preset")
      (str url.pathname url.search url.hash))))

(ann clearWorkspacePresetParamState (Fn [AppState] AppState))
(defn clearWorkspacePresetParamState [state]
  (let [href (workspaceHrefWithoutPreset state)]
    (routeMerge state href)))

(ann replaceWorkspaceUrlIfChangedCommand (Fn [AppState AppState] (Cmd AppMsg)))
(defn replaceWorkspaceUrlIfChangedCommand [before after]
  (if (= before.currentUrl after.currentUrl)
      Cmd.none
      (replaceBrowserHref after.currentUrl)))

(ann workspaceLayoutSnapshot (Fn [AppState] WorkspaceState))
(defn workspaceLayoutSnapshot [state]
  (workspaceLayoutSnapshotState state.workspace))

(ann workspaceLayoutPresetsFromBody (Fn [Js (Vector WorkspaceLayoutPreset)] (Vector WorkspaceLayoutPreset)))
(defn workspaceLayoutPresetsFromBody [body fallback]
  (if (vector? body.workspaceLayoutPresets) body.workspaceLayoutPresets fallback))

(ann workspaceStateFromPresetOutcome (Fn [AppState WorkspaceHydrationOutcome] AppState))
(defn workspaceStateFromPresetOutcome [state outcome]
  (let [base (if (= outcome.kind "apply")
                 (match outcome.workspace
                   nil state
                   (some workspace)
                     (merge (setWorkspaceState state workspace)
                            {:workspaceLayoutBaselineSnapshot outcome.baselineSnapshot
                             :workspaceLayoutBaselinePresetId outcome.baselinePresetId}))
                 state)]
    (if (= outcome.stripPresetFromUrl true)
        (clearWorkspacePresetParamState base)
        base)))

(ann workspaceInitialStateFromLoaded (Fn [AppState (Option WorkspaceState)] WorkspaceState))
(defn workspaceInitialStateFromLoaded [state loaded]
  (match loaded
    (some snapshot) snapshot
    nil
      (let [source (workspaceSourceForState state)]
        (if (not (= state.currentDir ""))
            (buildWorkspaceFromDirParam state.currentDir source)
            (defaultPersistedState source)))))

(ann workspaceApplyPresetFromReadyPresets (Fn [AppState (Vector WorkspaceLayoutPreset)] AppState))
(defn workspaceApplyPresetFromReadyPresets [state presets]
  (match (workspacePresetParam state)
    nil state
    (some _presetId)
      (if (or (not state.workspaceStorageLoaded)
              (not state.workspaceLayoutPresetsReady))
          state
          (if state.workspaceHasPersistedDraft
              (clearWorkspacePresetParamState state)
              (match (resolveWorkspaceDeferredPresetApply
                      {:presetParam (workspacePresetParam state)
                       :presetsReadyNow true
                       :hasPersistedDraft false
                       :presetsList presets
	                       :layoutScope (workspaceLayoutScopeForState state)})
	                nil state
	                (some outcome) (workspaceStateFromPresetOutcome state outcome))))))

(ann workspaceApplyStorageHydrationState (Fn [AppState (Option WorkspaceState)] AppState))
(defn workspaceApplyStorageHydrationState [state loaded]
  (let [hasDraft (some? loaded)
        hydrated (merge (setWorkspaceState state (workspaceInitialStateFromLoaded state loaded))
                        {:workspaceStorageLoaded true
                         :workspaceHasPersistedDraft hasDraft})]
    (workspaceApplyPresetFromReadyPresets hydrated hydrated.workspaceLayoutPresets)))

(ann workspaceLayoutPresetWithCurrentSnapshot (Fn [AppState String] WorkspaceLayoutPreset))
(defn workspaceLayoutPresetWithCurrentSnapshot [state name]
  (let [date (new jsDate)
        now (date.toISOString)]
    {:id (makeWorkspaceLayoutPresetId)
     :name name
     :scope (workspaceLayoutScopeForState state)
     :snapshot (workspaceLayoutSnapshot state)
     :createdAt now
     :updatedAt now}))

(ann workspaceUpdatedPresetFromCurrent (Fn [AppState WorkspaceLayoutPreset] WorkspaceLayoutPreset))
(defn workspaceUpdatedPresetFromCurrent [state preset]
  (let [date (new jsDate)]
    (merge preset {:snapshot (workspaceLayoutSnapshot state)
                   :updatedAt (date.toISOString)})))

(ann closeContextMenu (Fn [AppState] AppState))
(defn closeContextMenu [state]
  (merge state {:menuOpen false
                :menuKind "none"
                :menuPath ""
                :menuFile nil
                :workspaceContextMenuWindowId ""
                :workspaceLayoutMenuOpen false
                :workspaceTabMenuOpen false
                :workspaceTabMenuTabId ""
                :workspaceTabMenuX 0
                :workspaceTabMenuY 0
                :menuIsDirectory false}))

(ann closeTransientUi (Fn [AppState] AppState))
(defn closeTransientUi [state]
  (merge (closeContextMenu state)
         {:kbSearchOpen false
          :adminUploadMenuOpen false
          :adminCreateKind "none"
          :adminCreateName ""
          :adminCreateError nil
          :adminRenameOpen false
          :adminRenameError nil
          :adminDeleteOpen false
          :adminDeleteError nil
          :adminTransferMode "none"
          :adminTransferError nil
          :adminShareOpen false
          :adminShareCreateOpen false
          :adminShareError nil
          :adminPasteOpen false
          :adminPasteError nil
          :adminMarkdownImageOpen false
          :adminIconDialogOpen false
          :adminIconError nil
		          :themeMenuOpen false
		          :workspaceSettingsOpen false
		          :adminImageZoom 0
          :adminImageRotation 0
          :shareUploadMenuOpen false
          :shareCreateKind "none"
          :shareCreateName ""
          :shareCreateError nil
          :shareRenameOpen false
          :shareRenameError nil
          :shareDeleteOpen false
          :shareDeleteError nil
	          :shareImageZoom 0
	          :shareImageRotation 0
	          :workspaceSettingsOpen false
	          :workspaceLayoutPickerOpen false
	          :workspaceLayoutPickerWindowId ""
	          :workspaceLayoutPickerX 0
	          :workspaceLayoutPickerY 0
	          :workspaceLayoutMenuOpen false
	          :workspaceLayoutSaveOpen false
	          :workspaceLayoutSaveName ""
	          :workspaceContextMenuWindowId ""
	          :workspaceWindowDrag nil
	          :workspaceWindowResize nil
	          :workspaceTabDrag nil
	          :workspaceSplitResize nil
	          :workspaceTabMenuOpen false
	          :workspaceTabMenuTabId ""
	          :workspaceTabMenuX 0
	          :workspaceTabMenuY 0}))

(ann workspaceWindowDragNextBounds (Fn [WorkspaceWindowDragSession Number Number] WorkspaceBounds))
(defn workspaceWindowDragNextBounds [drag clientX clientY]
  (let [cur drag.liveBounds
        nx (- (- clientX drag.canvasLeft) drag.grabDx)
        ny (- (- clientY drag.canvasTop) drag.grabDy)
        minX (- workspaceWindowMinVisiblePx cur.width)
        maxX (- drag.canvasWidth workspaceWindowMinVisiblePx)
        minY (- workspaceWindowMinVisiblePx cur.height)
        maxY (- drag.canvasHeight workspaceWindowMinVisiblePx)]
    {:x (max minX (min nx maxX))
     :y (max minY (min ny maxY))
     :width cur.width
     :height cur.height}))

(def workspaceResizeMinWidth 360)
(def workspaceResizeMinHeight 260)

(ann workspaceResizeNextBounds (Fn [WorkspaceWindowResizeSession Number Number] WorkspaceBounds))
(defn workspaceResizeNextBounds [resize clientX clientY]
  (let [start resize.startBounds
        dx (- clientX resize.startX)
        dy (- clientY resize.startY)
        withRight (if (includes? resize.direction "right")
                      (merge start {:width (+ start.width dx)})
                      start)
        withLeft (if (includes? resize.direction "left")
                     (merge withRight {:x (+ start.x dx)
                                       :width (- start.width dx)})
                     withRight)
        withBottom (if (includes? resize.direction "bottom")
                       (merge withLeft {:height (+ start.height dy)})
                       withLeft)
        withTop (if (includes? resize.direction "top")
                    (merge withBottom {:y (+ start.y dy)
                                       :height (- start.height dy)})
                    withBottom)]
    withTop))

(ann workspaceClampResizeBounds (Fn [WorkspaceBounds WorkspaceWindowResizeSession] WorkspaceBounds))
(defn workspaceClampResizeBounds [bounds resize]
  (let [width0 (max bounds.width workspaceResizeMinWidth)
        height0 (max bounds.height workspaceResizeMinHeight)
        x0 bounds.x
        y0 bounds.y
        width1 (if (< x0 0) (+ width0 x0) width0)
        x1 (if (< x0 0) 0 x0)
        height1 (if (< y0 0) (+ height0 y0) height0)
        y1 (if (< y0 0) 0 y0)
        width2 (max width1 workspaceResizeMinWidth)
        height2 (max height1 workspaceResizeMinHeight)
        x2 (if (> width2 resize.canvasWidth)
               0
               (max 0 (min x1 (- resize.canvasWidth width2))))
        vis workspaceWindowMinVisiblePx
        y2 (max (- vis height2) (min y1 (- resize.canvasHeight vis)))]
    {:x x2 :y y2 :width width2 :height height2}))

(ann workspaceWindowDragEdgeSpan (Fn [AppState WorkspaceWindowDragSession Number Number] (Option AssistGridSpan)))
(defn workspaceWindowDragEdgeSpan [state drag clientX clientY]
  (let [lx (- clientX drag.canvasLeft)
        ly (- clientY drag.canvasTop)]
    (detectEdgeAssistGridSpan lx
                              ly
                              drag.canvasWidth
                              drag.canvasHeight
                              state.workspaceAssistGridShape
                              {:suppressTopEdgeSpans false})))

(ann workspaceWindowDragTriggersAssist? (Fn [AppState WorkspaceWindowDragSession Number Number] Bool))
(defn workspaceWindowDragTriggersAssist? [state drag clientX clientY]
  (let [lx (- clientX drag.canvasLeft)
        ly (- clientY drag.canvasTop)
        center (/ drag.canvasWidth 2)]
    (and state.workspaceSnapAssistEnabled
         (<= ly 36)
         (<= (abs (- lx center)) topSnapAssistCenterHalfWidthPx))))

(ann workspaceWindowDragKeepsAssistVisible? (Fn [AppState WorkspaceWindowDragSession Number Number] Bool))
(defn workspaceWindowDragKeepsAssistVisible? [state drag _clientX clientY]
  (let [ly (- clientY drag.canvasTop)]
    (and state.workspaceSnapAssistEnabled
         (= drag.assistActive true)
         (<= ly topSnapAssistKeepalivePx))))

(ann workspaceAssistPickSpanFromPoint (Fn [Number Number] (Option AssistGridSpan)))
(defn workspaceAssistPickSpanFromPoint [clientX clientY]
  (let [root (jsDocument.querySelector "[data-workspace-snap-assist]")]
    (match (pickAssistSlotFromPoint clientX clientY root)
      nil nil
      (some pick) pick.span)))

(ann workspaceWindowDragNextSnapSpan (Fn [AppState WorkspaceWindowDragSession Number Number] (Option AssistGridSpan)))
(defn workspaceWindowDragNextSnapSpan [state drag clientX clientY]
  (let [assistActive (workspaceWindowDragKeepsAssistVisible? state drag clientX clientY)]
    (match (if assistActive (workspaceAssistPickSpanFromPoint clientX clientY) nil)
      (some span) span
      nil (match (workspaceWindowDragEdgeSpan state drag clientX clientY)
            (some span) span
            nil (if assistActive drag.snapSpan nil)))))

(type WorkspaceWindowDragTarget
  {:groupId String
   :targetId String
   :insertIndex Number})

(ann workspaceWindowDragTargetForWindow (Fn [AppState WorkspaceWindowDragSession Number Number WorkspaceTabWindow] (Option WorkspaceWindowDragTarget)))
(defn workspaceWindowDragTargetForWindow [state drag localX localY win]
  (let [targetGroupId (groupIdForWindow win)
        bounds (boundsForWindow win)]
    (if (or (= targetGroupId drag.groupId)
            (< localX bounds.x)
            (> localX (+ bounds.x bounds.width))
            (< localY bounds.y)
            (> localY (+ bounds.y 32)))
        nil
        {:groupId targetGroupId
         :targetId (workspaceWindowId win)
         :insertIndex (count (tabsInGroup state.workspace.windows targetGroupId))})))

(ann workspaceWindowDragMergeTargetAt (Fn [AppState WorkspaceWindowDragSession Number Number (Vector WorkspaceTabWindow) Number] (Option WorkspaceWindowDragTarget)))
(defn workspaceWindowDragMergeTargetAt [state drag localX localY windows index]
  (if (>= index (count windows))
      nil
      (match (workspaceWindowDragTargetForWindow state drag localX localY (nth windows index))
        nil (workspaceWindowDragMergeTargetAt state drag localX localY windows (+ index 1))
        (some target) target)))

(ann workspaceWindowDragMergeTarget (Fn [AppState WorkspaceWindowDragSession Number Number] (Option WorkspaceWindowDragTarget)))
(defn workspaceWindowDragMergeTarget [state drag clientX clientY]
  (workspaceWindowDragMergeTargetAt state
                                    drag
                                    (- clientX drag.canvasLeft)
                                    (- clientY drag.canvasTop)
                                    (workspaceWindows state)
                                    0))

(ann workspaceTabDragTargetForWindow (Fn [AppState WorkspaceTabDragSession Number Number WorkspaceTabWindow] (Option WorkspaceWindowDragTarget)))
(defn workspaceTabDragTargetForWindow [state drag localX localY win]
  (let [targetGroupId (groupIdForWindow win)
        bounds (boundsForWindow win)]
    (if (or (= targetGroupId drag.groupId)
            (< localX bounds.x)
            (> localX (+ bounds.x bounds.width))
            (< localY bounds.y)
            (> localY (+ bounds.y 32)))
        nil
        {:groupId targetGroupId
         :targetId (workspaceWindowId win)
         :insertIndex (count (tabsInGroup state.workspace.windows targetGroupId))})))

(ann workspaceTabDragMergeTargetAt (Fn [AppState WorkspaceTabDragSession Number Number (Vector WorkspaceTabWindow) Number] (Option WorkspaceWindowDragTarget)))
(defn workspaceTabDragMergeTargetAt [state drag localX localY windows index]
  (if (>= index (count windows))
      nil
      (match (workspaceTabDragTargetForWindow state drag localX localY (nth windows index))
        nil (workspaceTabDragMergeTargetAt state drag localX localY windows (+ index 1))
        (some target) target)))

(ann workspaceTabDragMergeTarget (Fn [AppState WorkspaceTabDragSession Number Number] (Option WorkspaceWindowDragTarget)))
(defn workspaceTabDragMergeTarget [state drag clientX clientY]
  (workspaceTabDragMergeTargetAt state
                                 drag
                                 (- clientX drag.canvasLeft)
                                 (- clientY drag.canvasTop)
                                 (workspaceWindows state)
                                 0))

(ann workspaceTabDragOwnHeader? (Fn [AppState WorkspaceTabDragSession Number Number] Bool))
(defn workspaceTabDragOwnHeader? [state drag clientX clientY]
  (match (findWorkspaceWindow state.workspace drag.tabId)
    nil false
    (some win)
      (let [bounds (boundsForWindow win)
            localX (- clientX drag.canvasLeft)
            localY (- clientY drag.canvasTop)]
        (and (>= localX bounds.x)
             (<= localX (+ bounds.x bounds.width))
             (>= localY bounds.y)
             (<= localY (+ bounds.y 32))))))

(ann workspaceTabDragDropState (Fn [AppState WorkspaceTabDragSession Number Number] AppState))
(defn workspaceTabDragDropState [state drag clientX clientY]
  (let [dx (abs (- clientX drag.startX))
        dy (abs (- clientY drag.startY))
        moved (> (+ dx dy) 8)]
    (if (not moved)
        state
        (match (workspaceTabDragMergeTarget state drag clientX clientY)
          (some target)
            (setWorkspaceState state
                               (mergeWindowIntoGroupState state.workspace
                                                          drag.tabId
                                                          target.targetId
                                                          target.insertIndex))
          nil
            (if (workspaceTabDragOwnHeader? state drag clientX clientY)
                state
                (setWorkspaceState state (splitWindowFromGroupState state.workspace drag.tabId nil)))))))

(ann workspaceSplitResizeFraction (Fn [WorkspaceSplitResizeSession Number] Number))
(defn workspaceSplitResizeFraction [resize clientX]
  (if (<= resize.groupWidth 0)
      0.5
      (let [raw (/ (- clientX resize.groupLeft) resize.groupWidth)]
        (min 0.7 (max 0.3 raw)))))

(ann workspaceWindowDragDropState (Fn [AppState WorkspaceWindowDragSession Number Number] AppState))
(defn workspaceWindowDragDropState [state drag clientX clientY]
  (let [bounds drag.liveBounds
        mergeTarget (workspaceWindowDragMergeTarget state drag clientX clientY)]
    (match mergeTarget
      (some target)
        (setWorkspaceState state
                           (mergeWindowIntoGroupState state.workspace
                                                      drag.windowId
                                                      target.targetId
                                                      target.insertIndex))
      nil
        (match (workspaceWindowDragNextSnapSpan state drag clientX clientY)
          nil (setWorkspaceState state
                                 (updateWorkspaceWindowBoundsState state.workspace
                                                                   drag.windowId
                                                                   bounds))
	          (some span)
	            (setWorkspaceState state
	                               (tilingPickWorkspaceState state.workspace drag.windowId span))))))

(ann clampMenuLeft (Fn [Number] Number))
(defn clampMenuLeft [x]
  (max 8 (min x (- jsWindow.innerWidth 248))))

(ann clampMenuTop (Fn [Number] Number))
(defn clampMenuTop [y]
  (max 8 (min y (- jsWindow.innerHeight 320))))

(ann favoritesFromResponse (Fn [BasicResponse (Vector String)] (Vector String)))
(defn favoritesFromResponse [response fallback]
  (if (vector? response.body.favorites) response.body.favorites fallback))

(ann knowledgeBasesFromResponse (Fn [BasicResponse (Vector String)] (Vector String)))
(defn knowledgeBasesFromResponse [response fallback]
  (if (vector? response.body.knowledgeBases) response.body.knowledgeBases fallback))

(ann currentKnowledgeBaseRoot (Fn [AppState] (Option String)))
(defn currentKnowledgeBaseRoot [state]
  (getKnowledgeBaseRoot state.currentDir state.knowledgeBases))

(ann currentKnowledgeBase? (Fn [AppState] Bool))
(defn currentKnowledgeBase? [state]
  (some? (currentKnowledgeBaseRoot state)))

(ann responseViewCount (Fn [BasicResponse] Number))
(defn responseViewCount [response]
  (if (number? response.body.viewCount) response.body.viewCount 0))

(ann fileViewCountNumber (Fn [FileItem] Number))
(defn fileViewCountNumber [file]
  (if (number? file.viewCount) file.viewCount 0))

(ann viewStatsViewsFromResponse (Fn [ViewStatsResponse] (Map String Number)))
(defn viewStatsViewsFromResponse [response]
  (if (object? response.body.views) response.body.views (hash-map)))

(ann viewStatsShareViewsFromResponse (Fn [ViewStatsResponse] (Map String Number)))
(defn viewStatsShareViewsFromResponse [response]
  (if (object? response.body.shareViews) response.body.shareViews (hash-map)))

(ann viewCountFromMap (Fn [(Map String Number) String] Number))
(defn viewCountFromMap [counts path]
  (let [value (object-get counts path)]
    (if (number? value) value 0)))

(ann adminViewCountNumber (Fn [AppState FileItem] Number))
(defn adminViewCountNumber [state file]
  (let [statsCount (viewCountFromMap state.viewCounts file.path)
        fileCount (fileViewCountNumber file)]
    (if (> statsCount 0) statsCount fileCount)))

(ann adminShareViewCountNumber (Fn [AppState FileItem] Number))
(defn adminShareViewCountNumber [state file]
  (viewCountFromMap state.shareViewCounts file.path))

(ann updateFileViewCount (Fn [FileItem String Number] FileItem))
(defn updateFileViewCount [file path count]
  (if (= file.path path)
      (merge file {:viewCount count})
      file))

(ann updateFilesViewCount (Fn [(Vector FileItem) String Number] (Vector FileItem)))
(defn updateFilesViewCount [files path count]
  (map files (fn [file] (updateFileViewCount file path count))))

(ann shareRelativePath (Fn [AppState String] String))
(defn shareRelativePath [state path]
  (if (= state.sharePath "")
      path
      (if (= path state.sharePath)
          ""
          (if (starts-with? path (str state.sharePath "/"))
              (string-slice path (+ (count state.sharePath) 1) (count path))
              path))))

(ann shareChildPath (Fn [String String] String))
(defn shareChildPath [dir name]
  (if (= dir "") name (str dir "/" name)))

(ann shareCreateNameWithDefault (Fn [String String] String))
(defn shareCreateNameWithDefault [kind name]
  (if (= kind "file")
      (if (includes? name ".") name (str name ".txt"))
      name))

(ann adminDefaultExtension (Fn [AppState] String))
(defn adminDefaultExtension [state]
  (if (some? (getKnowledgeBaseRoot state.currentDir state.knowledgeBases)) ".md" ".txt"))

(ann adminCreateNameWithDefault (Fn [AppState String String] String))
(defn adminCreateNameWithDefault [state kind name]
  (if (= kind "file")
      (if (includes? name ".") name (str name (adminDefaultExtension state)))
      name))

(ann shareSiblingPath (Fn [String String] String))
(defn shareSiblingPath [oldPath newName]
  (let [safePath (if (string? oldPath) oldPath "")
        parts (filter (split safePath "/") (fn [part] (not (= part ""))))]
    (if (<= (count parts) 1)
        newName
        (str (join (slice parts 0 (- (count parts) 1)) "/") "/" newName))))

(ann pathCanMoveInto? (Fn [String String] Bool))
(defn pathCanMoveInto? [sourcePath destinationDir]
  (and (not (= sourcePath ""))
       (not (= sourcePath destinationDir))
       (not (starts-with? destinationDir (str sourcePath "/")))))

(ann destinationChildPath (Fn [String String] String))
(defn destinationChildPath [destinationDir name]
  (if (= destinationDir "") name (str destinationDir "/" name)))

(ann adminCurrentPathEditable? (Fn [AppState] Bool))
(defn adminCurrentPathEditable? [state]
  (and (not (= state.currentDir virtualFolderMostPlayed))
       (not (= state.currentDir virtualFolderFavorites))
       (not (= state.currentDir virtualFolderShares))
       (not (isVirtualFolderPath state.currentDir))
       (isPathEditable state.currentDir state.editableFolders state.mediaRoots)))

(ann adminFileNameFromPath (Fn [String] String))
(defn adminFileNameFromPath [path]
  (let [safePath (if (string? path) path "")
        parts (filter (split safePath "/") (fn [part] (not (= part ""))))
        name (last parts)]
    (if (some? name) name safePath)))

(ann shareAllowUploadFromInfo (Fn [ShareInfoResponse] Bool))
(defn shareAllowUploadFromInfo [response]
  (and response.body.editable
       (match response.body.restrictions
         nil true
         (some restrictions) (not (= restrictions.allowUpload false)))))

(ann shareAllowEditFromInfo (Fn [ShareInfoResponse] Bool))
(defn shareAllowEditFromInfo [response]
  (and response.body.editable
       (match response.body.restrictions
         nil true
         (some restrictions) (not (= restrictions.allowEdit false)))))

(ann shareAllowDeleteFromInfo (Fn [ShareInfoResponse] Bool))
(defn shareAllowDeleteFromInfo [response]
  (and response.body.editable
       (match response.body.restrictions
         nil true
         (some restrictions) (not (= restrictions.allowDelete false)))))

(ann shareAdminViewMode (Fn [ShareInfoResponse String] String))
(defn shareAdminViewMode [response fallback]
  (match response.body.adminViewMode
    nil fallback
    (some mode) (if (= mode "grid") "grid" "list")))

(ann shareInfoPath (Fn [ShareInfoResponse] String))
(defn shareInfoPath [response]
  (match response.body.path
    nil ""
    (some value) value))

(ann shareWorkspaceDefaultSourceNeedsInfo? (Fn [WorkspaceTabWindow] Bool))
(defn shareWorkspaceDefaultSourceNeedsInfo? [win]
  (let [source win.source
        sharePath source.sharePath]
    (and (= win.type "browser")
         (= (workspaceWindowDir win) "")
         (= source.kind "share")
         (or (not (string? sharePath)) (= sharePath "")))))

(ann stateWithShareWorkspaceInfo (Fn [AppState] AppState))
(defn stateWithShareWorkspaceInfo [state]
  (if (and (shareWorkspacePath? state.pathname)
           state.shareIsDirectory
           (not (= state.sharePath "")))
      (let [source (workspaceSourceForState state)
            title (workspaceBrowserDirTitle state.sharePath)
            windows (map state.workspace.windows
                         (fn [win]
                           (if (shareWorkspaceDefaultSourceNeedsInfo? win)
                               (merge win {:source source
                                           :title title})
                               win)))]
        (setWorkspaceState state (merge state.workspace {:windows windows})))
      state))

(ann shareInfoState (Fn [AppState ShareInfoResponse] AppState))
(defn shareInfoState [state response]
  (stateWithShareWorkspaceInfo
   (merge state {:shareInfoPending false
                 :shareInfoError nil
                 :shareInfoStatus response.status
		                 :shareName response.body.name
		                 :sharePath (shareInfoPath response)
		                 :shareIsDirectory response.body.isDirectory
		                 :shareMediaType response.body.mediaType
		                 :shareExtension response.body.extension
		                 :shareEditable response.body.editable
		                 :shareAllowUpload (shareAllowUploadFromInfo response)
		                 :shareAllowEdit (shareAllowEditFromInfo response)
		                 :shareAllowDelete (shareAllowDeleteFromInfo response)
		                 :shareNeedsPasscode response.body.needsPasscode
		                 :shareAuthorized response.body.authorized
		                 :viewMode (if state.viewModeTouched
		                             state.viewMode
		                             (if (shareWorkspacePath? state.pathname)
		                                 state.viewMode
		                                 (shareAdminViewMode response state.viewMode)))})))

(ann shareInfoFollowupCommand (Fn [AppState ShareInfoResponse] (Cmd AppMsg)))
(defn shareInfoFollowupCommand [state response]
  (match state.shareToken
    nil Cmd.none
    (some token)
      (if (and response.body.needsPasscode (not response.body.authorized))
          (match state.sharePasscodeParam
            nil Cmd.none
            (some passcode)
              (if (or (= passcode "") state.sharePasscodeAutoTried)
                  Cmd.none
                  (verifySharePasscodeCommand token passcode)))
		          (if response.body.isDirectory
		              (fetchShareFilesCommand token state.currentDir)
		              Cmd.none))))

(ann directSharePreviewMedia? (Fn [String] Bool))
(defn directSharePreviewMedia? [mediaType]
  (or (= mediaType MediaType.TEXT)
      (= mediaType MediaType.IMAGE)
      (= mediaType MediaType.PDF)
      (= mediaType MediaType.AUDIO)
      (= mediaType MediaType.VIDEO)))

(ann directShareViewingMedia? (Fn [String] Bool))
(defn directShareViewingMedia? [mediaType]
  (or (= mediaType MediaType.TEXT)
      (= mediaType MediaType.IMAGE)
      (= mediaType MediaType.PDF)))

(ann shareDirectFileHref (Fn [AppState ShareInfoResponse] (Option String)))
(defn shareDirectFileHref [state response]
  (match state.shareToken
    nil nil
    (some token)
      (if (or response.body.isDirectory
              (shareWorkspacePath? state.pathname)
              (= response.body.mediaType MediaType.TEXT)
              (not (directSharePreviewMedia? response.body.mediaType)))
          nil
          (let [path (shareInfoPath response)]
	            (if (or (= response.body.mediaType MediaType.AUDIO)
	                    (= response.body.mediaType MediaType.VIDEO))
	                (shareMediaHref token "" nil path false)
		                (shareMediaHref token "" path nil false))))))

(ann shareDirectFileState (Fn [AppState ShareInfoResponse] AppState))
(defn shareDirectFileState [state response]
  (if (or response.body.isDirectory
          (shareWorkspacePath? state.pathname)
          (not (directSharePreviewMedia? response.body.mediaType)))
      state
      (if (= response.body.mediaType MediaType.TEXT)
          (merge state {:shareTextPath "."
                        :shareTextContent ""
                        :shareTextPending true
                        :shareTextError nil
                        :shareTextSaving false
                        :shareImageZoom 0
                        :shareImageRotation 0
                        :shareAudioRepeat false
                        :shareVideoCompact false})
          (if (directShareViewingMedia? response.body.mediaType)
              (merge state {:shareTextPath ""
                            :shareTextContent ""
                            :shareTextPending false
                            :shareTextError nil
                            :shareTextSaving false
                            :shareImageZoom 0
                            :shareImageRotation 0
                            :shareAudioRepeat false
                            :shareVideoCompact false})
              (match (shareDirectFileHref state response)
                nil (merge state {:shareTextPath ""
                                  :shareTextContent ""
                                  :shareTextPending false
                                  :shareTextError nil
                                  :shareTextSaving false
                                  :shareAudioRepeat false
                                  :shareVideoCompact false})
                (some href)
                  (merge (routeMerge state href)
                         {:shareTextPath ""
                          :shareTextContent ""
                          :shareTextPending false
                          :shareTextError nil
                          :shareTextSaving false
                          :shareAudioRepeat false
                          :shareVideoCompact false}))))))

(ann shareDirectFileCommand (Fn [AppState ShareInfoResponse] (Cmd AppMsg)))
(defn shareDirectFileCommand [state response]
  (match state.shareToken
    nil Cmd.none
    (some token)
      (if (or response.body.isDirectory
              (shareWorkspacePath? state.pathname)
              response.body.needsPasscode
              (not response.body.authorized))
	          Cmd.none
	          (if (= response.body.mediaType MediaType.TEXT)
	              (match state.viewingPath
	                nil (shareViewCommand token ".")
	                (some _path)
	                  (Cmd.batch [(fetchShareTextCommand (buildShareMediaUrl token "" (shareInfoPath response)))
	                              (shareViewCommand token ".")]))
	              (if (directSharePreviewMedia? response.body.mediaType)
	                  (shareViewCommand token ".")
	                  Cmd.none)))))

(ann shareImageFileMatchesPath? (Fn [AppState FileItem String] Bool))
(defn shareImageFileMatchesPath? [state file path]
  (or (= file.path path)
      (= (shareRelativePath state file.path) path)))

(ann shareImageFilesForUpdate (Fn [AppState] (Vector FileItem)))
(defn shareImageFilesForUpdate [state]
  (filter state.shareFiles (fn [file] (= file.type MediaType.IMAGE))))

(ann shareImageIndexForUpdate (Fn [AppState (Vector FileItem) String] Number))
(defn shareImageIndexForUpdate [state images path]
  (let [hit (find (map (range 0 (count images))
                       (fn [index] {:index index :file (nth images index)}))
                  (fn [entry] (shareImageFileMatchesPath? state entry.file path)))]
    (if (some? hit) hit.index -1)))

(ann nextShareImagePathByStepForUpdate (Fn [AppState Number] (Option String)))
(defn nextShareImagePathByStepForUpdate [state step]
  (match state.viewingPath
    nil nil
    (some path)
      (let [images (shareImageFilesForUpdate state)
            total (count images)]
        (if (= total 0)
            nil
            (let [index (shareImageIndexForUpdate state images path)
                  nextIndex (if (< index 0) 0 (mod (+ (+ index step) total) total))
                  file (nth images nextIndex)]
              (shareRelativePath state file.path))))))

(ann nextAdminImagePathForUpdate (Fn [AppState Number] (Option String)))
(defn nextAdminImagePathForUpdate [state step]
  (match state.viewingPath
    nil nil
    (some path)
      (let [images (adminImageFilesForUpdate state)
            total (count images)]
        (if (= total 0)
            nil
	            (let [index (adminImageIndexForUpdate images path)
	                  nextIndex (if (< index 0) 0 (mod (+ (+ index step) total) total))
	                  file (nth images nextIndex)]
	              file.path)))))

(ann workspaceActiveImageWindow (Fn [AppState] (Option WorkspaceTabWindow)))
(defn workspaceActiveImageWindow [state]
  (let [activeId state.workspace.activeWindowId
        win (if (string? activeId) (findWorkspaceWindow state.workspace activeId) nil)
        file (if (some? win) (workspaceWindowFileItem win) (workspaceEmptyFileItem))]
    (if (and (some? win) (= file.type MediaType.IMAGE)) win nil)))

(ann workspaceImageFilesForUpdate (Fn [AppState] (Vector FileItem)))
(defn workspaceImageFilesForUpdate [state]
  (filter (workspaceCurrentFilesForSnapshot state)
          (fn [file] (= file.type MediaType.IMAGE))))

(ann workspaceWindowImageFilesForUpdate (Fn [AppState WorkspaceTabWindow] (Vector FileItem)))
(defn workspaceWindowImageFilesForUpdate [state win]
  (let [snapshot win.initialState.imageFiles]
    (match snapshot
      nil (workspaceImageFilesForUpdate state)
      (some files) (if (> (count files) 0) files (workspaceImageFilesForUpdate state)))))

(ann nextWorkspaceImageFileForUpdate (Fn [AppState Number] (Option FileItem)))
(defn nextWorkspaceImageFileForUpdate [state step]
  (let [win (workspaceActiveImageWindow state)]
    (if (not (some? win))
        nil
        (let [current (workspaceWindowFileItem win)
              images (workspaceWindowImageFilesForUpdate state win)
              total (count images)]
          (if (= total 0)
              nil
              (let [index (adminImageIndexForUpdate images current.path)
                    nextIndex (if (< index 0) 0 (mod (+ (+ index step) total) total))]
                (nth images nextIndex)))))))

(ann workspaceImageNavigateState (Fn [AppState Number] AppState))
(defn workspaceImageNavigateState [state step]
  (let [win (workspaceActiveImageWindow state)
        nextFile (nextWorkspaceImageFileForUpdate state step)]
    (if (or (not (some? win)) (not (some? nextFile)))
        state
        (merge (setWorkspaceState state
                                  (updateWorkspaceViewerWindowState state
                                                                    state.workspace
                                                                    (workspaceWindowId win)
                                                                    nextFile))
               {:adminImageZoom 0
                :adminImageRotation 0}))))

(ann updatePure (Fn [AppState AppMsg] UpdateResult))
(defn updatePure [state msg]
  (match (text-editor-update state msg)
    (some result) result
	    nil
	      (match (media-player-update state msg)
	        (some result) result
	        nil
	  (match msg
		    {:kind :route-changed :href href}
		      (let [sessionHref (hrefWithWorkspaceSession href)
		            routed (routeMerge state sessionHref)
			            next0 (merge routed
	                            {:viewMode (if (or (shareRoute? routed) (shareWorkspacePath? routed.pathname))
	                                            state.viewMode
	                                            (viewModeFromViewModes state.viewModes routed.currentDir))
	                             :viewModeTouched false
	                             :workspaceStorageLoaded false
	                             :workspaceHasPersistedDraft false})
			            next (stateWithMediaAudioMetadataKey next0)
			            loading (if (shareWorkspacePath? next.pathname)
		                        (markShareLoading next)
	                        (if (shareRoute? next)
	                            (markShareLoading next)
	                            (if (and (or (browserRoute? next) (= next.pathname "/workspace"))
                                       (not (publicBrowserShellRoute? next)))
	                                (markBrowserLoading next)
	                                next)))]
	        [(closeContextMenu loading)
	         (if (not (= sessionHref href))
	             (Cmd.batch [(loadWorkspaceStorageCommand next)
                         (replaceBrowserHref sessionHref)
                         (loadRouteCommand next)])
	             (Cmd.batch [(loadWorkspaceStorageCommand next)
                         (loadRouteCommand next)]))])
      {:kind :startup-view-mode-loaded :value value}
        [(merge state {:viewMode (viewModeFromStoredValue value)}) Cmd.none]
      {:kind :startup-snap-assist-loaded :value value}
        [(merge state {:workspaceSnapAssistEnabled (workspaceSnapAssistFromStoredValue value)}) Cmd.none]
	      {:kind :startup-preferred-snap-loaded :value value}
	        [(merge state {:workspaceAssistGridShape (workspaceAssistGridShapeFromStoredValue value)}) Cmd.none]
	      {:kind :startup-theme-mode-loaded :value value}
	        (let [mode (normalizedThemeMode value)
	              next (merge state {:themeMode mode})]
	          [next (documentThemeCommand next.themePalette mode)])
	      {:kind :startup-theme-palette-loaded :value value}
	        (let [palette (normalizedThemePalette value)
	              next (merge state {:themePalette palette})]
	          [next (documentThemeCommand palette next.themeMode)])
	      {:kind :startup-preferences-load-failed :error _error}
	        [state Cmd.none]
	    {:kind :sse-refresh}
	      (if (or (shareRoute? state) (shareWorkspacePath? state.pathname))
	          (match state.shareToken
	            nil [state Cmd.none]
	            (some token)
	              (if (and state.shareAuthorized state.shareIsDirectory)
	                  [state (fetchShareFilesCommand token state.currentDir)]
	                  [state Cmd.none]))
	          (if (or (browserRoute? state) (= state.pathname "/workspace"))
	              [state (fetchFilesCommand state.currentDir)]
	              [state Cmd.none]))
    {:kind :login-password :value value}
      [(merge state {:loginPassword value :loginError nil})
       Cmd.none]
    {:kind :login-submit}
      [(merge state {:loginPending true :loginError nil})
       (loginCommand state.loginPassword)]
    {:kind :login-ok :value response}
      (if response.ok
          [(merge (stateFromUrl "/")
                  {:loginPassword "" :loginPending false :loginError nil})
           {:kind :browser/location-assign :url "/"}]
          [(merge state {:loginPending false :loginError (loginErrorMessage response)})
           Cmd.none])
    {:kind :login-failed :error error}
      [(merge state {:loginPending false :loginError error})
       Cmd.none]
    {:kind :auth-loaded :value response}
      (if response.ok
          [(merge state {:authPending false
                         :authError nil
                         :editableFolders response.body.editableFolders
                         :mediaRoots (mediaRootsFromAuth response)
                         :shareLinkDomain response.body.shareLinkDomain})
           (if (and (or (browserRoute? state) (= state.pathname "/workspace"))
                    (not (publicBrowserShellRoute? state)))
               (openAdminSseCommand)
               Cmd.none)]
          [(merge state {:authPending false
                         :authError (responseErrorMessage response.status)})
           (maybeRedirectUnauthorized response.status)])
    {:kind :auth-failed :error error}
      [(merge state {:authPending false :authError error})
       Cmd.none]
    {:kind :settings-loaded :value response}
      (if response.ok
          (let [presets (workspaceLayoutPresetsFromBody response.body [])
                workspaceWithPins (if (shareWorkspacePath? state.pathname)
                                      state.workspace
                                      (workspaceWithTaskbarPins
                                       state.workspace
                                       response.body.workspaceTaskbarPins))
                loaded (merge state {:settingsPending false
                                     :settingsError nil
                                     :viewMode (if state.viewModeTouched
                                                 state.viewMode
                                                 (viewModeFromSettings response.body state.currentDir))
                                     :viewModes response.body.viewModes
                                     :favorites response.body.favorites
                                     :knowledgeBases response.body.knowledgeBases
                                     :workspace workspaceWithPins
                                     :workspaceLayoutPresets presets
                                     :workspaceLayoutPresetsReady true})
                applied (workspaceApplyPresetFromReadyPresets loaded presets)
                refreshCmd (if (browserRoute? applied)
                               (fetchFilesCommand applied.currentDir)
                               Cmd.none)]
            [applied (Cmd.batch [(replaceWorkspaceUrlIfChangedCommand loaded applied)
                                 refreshCmd])])
          [(merge state {:settingsPending false
                         :settingsError (responseErrorMessage response.status)})
           Cmd.none])
    {:kind :settings-failed :error error}
      [(merge state {:settingsPending false :settingsError error})
       Cmd.none]
    {:kind :kb-search-open}
      [(merge state {:kbSearchOpen true})
       (focusSelectorCommand "input[type='search'][placeholder*='Search']" true false)]
    {:kind :kb-search-close}
      [(merge state {:kbSearchOpen false :kbSearchQuery ""}) Cmd.none]
    {:kind :kb-search-query :value value}
      [(merge state {:kbSearchQuery value}) Cmd.none]
    {:kind :shares-loaded :value response}
      (if response.ok
          [(merge state {:sharesPending false
                         :sharesError nil
                         :shares response.body.shares})
           Cmd.none]
          [(merge state {:sharesPending false
                         :sharesError (responseErrorMessage response.status)})
           Cmd.none])
    {:kind :shares-failed :error error}
      [(merge state {:sharesPending false :sharesError error})
       Cmd.none]
	    {:kind :files-loaded :value response}
	      (if response.ok
	          (let [viewing state.viewingPath
	                textPending (if (string? viewing)
	                                (let [file (find response.body.files (fn [item] (= item.path viewing)))]
	                                  (and (some? file) (= file.type MediaType.TEXT)))
	                                false)
	                next (merge state {:filesPending false
	                                    :filesError nil
	                                    :files response.body.files
	                                    :adminTextPending textPending
	                                    :adminTextError nil})
	                textCmd (if (string? viewing)
	                            (let [file (find response.body.files (fn [item] (= item.path viewing)))]
	                              (if (and (some? file) (= file.type MediaType.TEXT))
	                                  (fetchAdminTextCommand viewing)
	                                  Cmd.none))
	                             Cmd.none)]
	            [next textCmd])
          [(merge state {:filesPending false
                         :filesError (responseErrorMessage response.status)
                         :files []})
           (maybeRedirectUnauthorized response.status)])
    {:kind :files-failed :error error}
      [(merge state {:filesPending false :filesError error :files []})
       Cmd.none]
    {:kind :refresh-files}
      [(merge state {:filesPending true :filesError nil})
       (fetchFilesCommand state.currentDir)]
		    {:kind :navigate-dir :path path}
		      (let [href (browserMediaHref path nil state.playingPath state.audioOnly)
		            next (merge (routeMerge state href)
		                        {:filesPending true
	                         :filesError nil
	                         :files []
	                         :scrollY 0
	                         :kbSearchOpen false
	                         :kbSearchQuery ""
	                         :viewMode (viewModeFromViewModes state.viewModes path)
	                         :viewModeTouched false})]
	        (withScrollTopAndPushBrowserHref href (closeContextMenu next) (fetchFilesCommand path)))
		    {:kind :open-file :file file}
		      (if file.isDirectory
		          (let [href (browserMediaHref file.path nil state.playingPath state.audioOnly)
		                next (merge (routeMerge state href)
		                            {:filesPending true
		                             :filesError nil
	                         :files []
	                         :kbSearchOpen false
	                         :kbSearchQuery ""
	                         :scrollY 0
	                         :viewMode (viewModeFromViewModes state.viewModes file.path)
	                         :viewModeTouched false})]
	            (withScrollTopAndPushBrowserHref href (closeContextMenu next) (fetchFilesCommand file.path)))
	          (let [href (if (or (= file.type MediaType.AUDIO) (= file.type MediaType.VIDEO))
	                         (browserMediaHref state.currentDir nil file.path false)
	                         (browserMediaHref state.currentDir file.path state.playingPath state.audioOnly))]
	            (withPushBrowserHref href (merge (closeContextMenu (routeMerge state href))
	                     {:pendingViewPath file.path
	                      :shareAudioRepeat false
	                      :shareVideoCompact false
	                      :adminImageZoom (if (= file.type MediaType.IMAGE) 0 state.adminImageZoom)
	                      :adminImageRotation (if (= file.type MediaType.IMAGE) 0 state.adminImageRotation)
	                      :adminTextPath (if (= file.type MediaType.TEXT) file.path state.adminTextPath)
	                      :adminTextPending (= file.type MediaType.TEXT)
	                      :adminTextError nil}) (if (= file.type MediaType.TEXT)
	                  (Cmd.batch [(viewCountCommand file.path)
	                              (fetchAdminTextCommand file.path)])
	                  (viewCountCommand file.path)))))
    {:kind :view-mode-picked :value value}
      (let [mode (if (= value "grid") "grid" "list")]
        [(merge state {:viewMode mode
                       :viewModes (object-assoc state.viewModes state.currentDir mode)
                       :viewModeTouched true})
         (Cmd.batch [(storageSetCommand "workspace-view-mode" mode)
                     (saveViewModeCommand state.currentDir mode)])])
    {:kind :view-mode-saved :value _response}
      [state Cmd.none]
    {:kind :view-mode-save-failed :error _error}
      [state Cmd.none]
    {:kind :toggle-favorite :path path}
      [(closeContextMenu state) (favoriteCommand path)]
    {:kind :favorite-loaded :value response}
      (if response.ok
          (let [favorites (favoritesFromResponse response state.favorites)
                next (merge state {:favorites favorites})]
            [next (if (= state.currentDir virtualFolderFavorites)
                      (fetchFilesCommand state.currentDir)
                      Cmd.none)])
          [state Cmd.none])
    {:kind :favorite-failed :error _error}
      [state Cmd.none]
    {:kind :view-stats-loaded :value response}
      (if response.ok
          [(merge state {:viewCounts (viewStatsViewsFromResponse response)
                         :shareViewCounts (viewStatsShareViewsFromResponse response)})
           Cmd.none]
          [state Cmd.none])
    {:kind :view-stats-failed :error _error}
      [state Cmd.none]
    {:kind :view-count-loaded :value response}
      (if response.ok
          (let [path state.pendingViewPath
                count (responseViewCount response)]
            (match path
              nil [(merge state {:pendingViewPath nil}) Cmd.none]
              (some value)
                [(merge state {:pendingViewPath nil
                               :viewCounts (object-assoc state.viewCounts value count)
                               :files (updateFilesViewCount state.files value count)})
                 (fetchViewStatsCommand)]))
          [(merge state {:pendingViewPath nil}) Cmd.none])
    {:kind :view-count-failed :error _error}
      [(merge state {:pendingViewPath nil}) Cmd.none]
    {:kind :file-context-menu :file file :x x :y y}
      [(merge state {:menuOpen true
                     :menuKind "file"
                     :menuPath file.path
                     :menuFile file
                     :menuIsDirectory file.isDirectory
                     :menuX x
                     :menuY y})
       Cmd.none]
    {:kind :workspace-file-context-menu :windowId windowId :file file :x x :y y}
      [(merge state {:menuOpen true
                     :menuKind "workspace-file"
                     :menuPath file.path
                     :menuFile file
                     :menuIsDirectory file.isDirectory
                     :workspaceContextMenuWindowId windowId
                     :menuX x
                     :menuY y})
       Cmd.none]
	    {:kind :breadcrumb-context-menu :path path :x x :y y}
	      [(merge state {:menuOpen true
	                     :menuKind "breadcrumb"
	                     :menuPath path
	                     :menuFile nil
	                     :menuIsDirectory true
	                     :menuX x
	                     :menuY y})
	       Cmd.none]
	    {:kind :breadcrumb-path-menu-toggle :mode mode}
		      [(merge state {:menuOpen (not (and state.menuOpen (= state.menuKind mode)))
		                     :menuKind mode
		                     :menuPath ""
		                     :menuFile nil
		                     :menuIsDirectory true
		                     :menuX 0
	                     :menuY 0})
	       Cmd.none]
	    {:kind :breadcrumb-path-menu-close}
	      [(closeContextMenu state) Cmd.none]
		    {:kind :breadcrumb-path-pick :path path}
		      (let [href (browserMediaHref path nil state.playingPath state.audioOnly)
		            next (merge (routeMerge state href)
		                        {:filesPending true
		                         :filesError nil
		                         :files []
		                         :kbSearchOpen false
		                         :kbSearchQuery ""
		                         :viewMode (viewModeFromViewModes state.viewModes path)
		                         :viewModeTouched false})]
		        (withPushBrowserHref href (closeContextMenu next) (fetchFilesCommand path)))
	    {:kind :close-context-menu}
	      [(closeContextMenu state) Cmd.none]
	    {:kind :admin-upload-menu-toggle}
	      [(merge state {:adminUploadMenuOpen (not state.adminUploadMenuOpen)})
	       Cmd.none]
	    {:kind :admin-upload-file-selected :selected? selected?}
	      (if (and selected? (adminCurrentPathEditable? state))
	          [(merge state {:adminUploadMenuOpen true
	                         :adminUploadPending true
	                         :adminUploadStatus "Uploading"})
	           (adminUploadCommand state.currentDir "request-body-multipart-files")]
	          [(merge state {:adminUploadMenuOpen false}) Cmd.none])
	    {:kind :admin-upload-input-selected :selected? selected? :testId testId}
	      (if (and selected? (adminCurrentPathEditable? state))
	          [(merge state {:adminUploadMenuOpen true
	                         :adminUploadPending true
	                         :adminUploadStatus "Uploading"})
	           (adminUploadCommand state.currentDir testId)]
	          [(merge state {:adminUploadMenuOpen false}) Cmd.none])
	    {:kind :admin-upload-loaded :value response}
	      (if response.ok
	          [(merge state {:adminUploadMenuOpen false
	                         :adminUploadPending false
	                         :adminUploadStatus "Upload complete"
	                         :filesPending true
	                         :filesError nil})
	           (fetchFilesCommand state.currentDir)]
	          [(merge state {:adminUploadMenuOpen false
	                         :adminUploadPending false
	                         :adminUploadStatus (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-upload-failed :error error}
	      [(merge state {:adminUploadMenuOpen false
	                     :adminUploadPending false
	                     :adminUploadStatus error})
	       Cmd.none]
	    {:kind :admin-drag-enter-upload}
	      (if (adminCurrentPathEditable? state)
	          [(merge state {:adminExternalDragOver true}) Cmd.none]
	          [state Cmd.none])
	    {:kind :admin-drag-leave-upload}
	      [(merge state {:adminExternalDragOver false}) Cmd.none]
	    {:kind :admin-open-create :createKind createKind}
	      [(merge state {:adminCreateKind createKind
	                     :adminCreateName ""
	                     :adminCreatePending false
	                     :adminCreateError nil})
	       Cmd.none]
	    {:kind :admin-create-name :value value}
	      [(merge state {:adminCreateName value :adminCreateError nil})
	       Cmd.none]
	    {:kind :admin-create-submit}
	      (let [name (adminCreateNameWithDefault state state.adminCreateKind (trim state.adminCreateName))
	            path (destinationChildPath state.currentDir name)]
	        (if (or (= name "")
	                (= state.adminCreateKind "none")
	                (not (adminCurrentPathEditable? state)))
	            [state Cmd.none]
	            [(merge state {:adminCreatePending true :adminCreateError nil})
	             (adminCreateCommand state.adminCreateKind path)]))
	    {:kind :admin-create-loaded :value response}
	      (if response.ok
	          (let [kind state.adminCreateKind
	                name (adminCreateNameWithDefault state kind (trim state.adminCreateName))
	                path (destinationChildPath state.currentDir name)
	                cleared {:adminCreateKind "none"
	                         :adminCreateName ""
	                         :adminCreatePending false
	                         :adminCreateError nil
	                         :filesPending true
	                         :filesError nil}]
	            (if (= kind "file")
	                (let [href (browserMediaHref state.currentDir path state.playingPath state.audioOnly)]
	                  (withPushBrowserHref href (merge (routeMerge state href) cleared) (fetchFilesCommand state.currentDir)))
	                [(merge state cleared)
	                 (fetchFilesCommand state.currentDir)]))
	          [(merge state {:adminCreatePending false
	                         :adminCreateError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-create-failed :error error}
	      [(merge state {:adminCreatePending false :adminCreateError error})
	       Cmd.none]
	    {:kind :admin-open-rename :path path :name name :isDirectory isDirectory}
	      [(merge (closeContextMenu state)
	              {:adminRenameOpen true
	               :adminRenameOldPath path
	               :adminRenameName name
	               :adminRenameIsDirectory isDirectory
	               :adminRenamePending false
	               :adminRenameError nil})
	       Cmd.none]
	    {:kind :admin-rename-name :value value}
	      [(merge state {:adminRenameName value :adminRenameError nil})
	       Cmd.none]
	    {:kind :admin-rename-submit}
	      (let [name (trim state.adminRenameName)
	            newPath (shareSiblingPath state.adminRenameOldPath name)]
	        (if (or (= name "")
	                (= newPath state.adminRenameOldPath)
	                (not (adminCurrentPathEditable? state)))
	            [state Cmd.none]
	            [(merge state {:adminRenamePending true :adminRenameError nil})
	             (adminRenameCommand state.adminRenameOldPath newPath)]))
	    {:kind :admin-rename-loaded :value response}
	      (if response.ok
	          [(merge state {:adminRenameOpen false
	                         :adminRenameOldPath ""
	                         :adminRenameName ""
	                         :adminRenamePending false
	                         :adminRenameError nil
	                         :filesPending true
	                         :filesError nil})
	           (fetchFilesCommand state.currentDir)]
	          [(merge state {:adminRenamePending false
	                         :adminRenameError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-rename-failed :error error}
	      [(merge state {:adminRenamePending false :adminRenameError error})
	       Cmd.none]
	    {:kind :admin-open-delete :path path :name name :isDirectory isDirectory}
	      [(merge (closeContextMenu state)
	              {:adminDeleteOpen true
	               :adminDeletePath path
	               :adminDeleteName name
	               :adminDeleteIsDirectory isDirectory
	               :adminDeletePending false
	               :adminDeleteError nil})
	       Cmd.none]
	    {:kind :admin-delete-submit}
	      (if (or (= state.adminDeletePath "") (not (adminCurrentPathEditable? state)))
	          [state Cmd.none]
	          [(merge state {:adminDeletePending true :adminDeleteError nil})
	           (adminDeleteCommand state.adminDeletePath)])
	    {:kind :admin-delete-loaded :value response}
	      (if response.ok
	          [(merge state {:adminDeleteOpen false
	                         :adminDeletePath ""
	                         :adminDeleteName ""
	                         :adminDeletePending false
	                         :adminDeleteError nil
	                         :filesPending true
	                         :filesError nil})
	           (fetchFilesCommand state.currentDir)]
	          [(merge state {:adminDeletePending false
	                         :adminDeleteError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-delete-failed :error error}
	      [(merge state {:adminDeletePending false :adminDeleteError error})
	       Cmd.none]
	    {:kind :admin-open-transfer :mode mode :path path :name name :isDirectory isDirectory}
	      [(merge (closeContextMenu state)
	              {:adminTransferMode mode
	               :adminTransferPath path
	               :adminTransferName name
	               :adminTransferIsDirectory isDirectory
	               :adminTransferBrowsePath state.currentDir
	               :adminTransferPending false
	               :adminTransferError nil})
	       Cmd.none]
	    {:kind :admin-transfer-pick :path path}
	      [(merge state {:adminTransferBrowsePath path :adminTransferError nil})
	       Cmd.none]
	    {:kind :admin-transfer-submit}
	      (let [destination state.adminTransferBrowsePath
	            newPath (destinationChildPath destination (adminFileNameFromPath state.adminTransferPath))]
	        (if (or (= state.adminTransferPath "")
	                (= state.adminTransferMode "none")
	                (and (= state.adminTransferMode "move")
	                     (not (pathCanMoveInto? state.adminTransferPath destination))))
	            [state Cmd.none]
	            (if (= state.adminTransferMode "copy")
	                [(merge state {:adminTransferPending true :adminTransferError nil})
	                 (adminCopyCommand state.adminTransferPath destination)]
	                [(merge state {:adminTransferPending true :adminTransferError nil})
	                 (adminMoveCommand state.adminTransferPath newPath)])))
	    {:kind :admin-transfer-loaded :value response}
	      (if response.ok
	          [(merge state {:adminTransferMode "none"
	                         :adminTransferPath ""
	                         :adminTransferName ""
	                         :adminTransferBrowsePath ""
	                         :adminTransferPending false
	                         :adminTransferError nil
	                         :filesPending true
	                         :filesError nil})
	           (fetchFilesCommand state.currentDir)]
	          [(merge state {:adminTransferPending false
	                         :adminTransferError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-transfer-failed :error error}
	      [(merge state {:adminTransferPending false :adminTransferError error})
	       Cmd.none]
	    {:kind :admin-close-dialog}
	      [(merge state {:adminCreateKind "none"
	                     :adminCreateName ""
	                     :adminCreatePending false
	                     :adminCreateError nil
	                     :adminRenameOpen false
	                     :adminRenameOldPath ""
	                     :adminRenameName ""
	                     :adminRenamePending false
	                     :adminRenameError nil
	                     :adminDeleteOpen false
	                     :adminDeletePath ""
	                     :adminDeleteName ""
	                     :adminDeletePending false
	                     :adminDeleteError nil
	                     :adminTransferMode "none"
	                     :adminTransferPath ""
	                     :adminTransferName ""
	                     :adminTransferBrowsePath ""
	                     :adminTransferPending false
	                     :adminTransferError nil
		                     :adminShareOpen false
		                     :adminSharePath ""
		                     :adminShareName ""
		                     :adminShareIsDirectory false
		                     :adminShareCreateOpen false
		                     :adminShareEditable false
		                     :adminShareAllowUpload true
		                     :adminShareAllowEdit true
		                     :adminShareAllowDelete true
		                     :adminSharePending false
		                     :adminShareError nil
		                     :adminShareDeletingToken ""
		                     :adminPasteOpen false
		                     :adminPastePending false
	                     :adminPasteError nil
	                     :adminMarkdownImageOpen false
	                     :adminIconDialogOpen false
	                     :adminIconPath ""
	                     :adminIconName ""
	                     :adminIconPending false
	                     :adminIconError nil
	                     :themeMenuOpen false
	                     :adminUploadMenuOpen false})
	       Cmd.none]
		    {:kind :admin-open-share :path path :name name :isDirectory isDirectory}
		      [(merge (closeContextMenu state)
		              {:adminShareOpen true
		               :adminSharePath path
		               :adminShareName name
		               :adminShareIsDirectory isDirectory
		               :adminShareCreateOpen false
		               :adminShareEditable false
		               :adminShareAllowUpload true
		               :adminShareAllowEdit true
		               :adminShareAllowDelete true
		               :adminSharePending false
		               :adminShareError nil
		               :adminShareDeletingToken ""})
		       Cmd.none]
		    {:kind :admin-share-show-create}
		      [(merge state {:adminShareCreateOpen true :adminShareError nil}) Cmd.none]
		    {:kind :admin-share-editable :editable editable}
		      [(merge state {:adminShareEditable editable}) Cmd.none]
		    {:kind :admin-share-allow-upload :enabled enabled}
		      [(merge state {:adminShareAllowUpload enabled}) Cmd.none]
		    {:kind :admin-share-allow-edit :enabled enabled}
		      [(merge state {:adminShareAllowEdit enabled}) Cmd.none]
		    {:kind :admin-share-allow-delete :enabled enabled}
		      [(merge state {:adminShareAllowDelete enabled}) Cmd.none]
		    {:kind :admin-share-create}
		      (if (= state.adminSharePath "")
		          [state Cmd.none]
		          [(merge state {:adminSharePending true :adminShareError nil})
		           (adminCreateShareCommand state.adminSharePath
		                                    state.adminShareIsDirectory
		                                    state.adminShareEditable
		                                    state.adminShareAllowUpload
		                                    state.adminShareAllowEdit
		                                    state.adminShareAllowDelete)])
		    {:kind :admin-share-created :value response}
		      (if response.ok
		          [(merge state {:adminShareCreateOpen false
		                         :adminSharePending false
		                         :adminShareError nil})
		           (Cmd.batch [(fetchSharesCommand)
		                       (fetchFilesCommand state.currentDir)])]
		          [(merge state {:adminSharePending false
		                         :adminShareError (responseErrorMessage response.status)})
		           Cmd.none])
		    {:kind :admin-share-create-failed :error error}
		      [(merge state {:adminSharePending false :adminShareError error}) Cmd.none]
		    {:kind :admin-share-delete :token token}
		      [(merge state {:adminShareDeletingToken token :adminShareError nil})
		       (adminDeleteShareCommand token)]
		    {:kind :admin-share-deleted :value response}
		      (if response.ok
		          [(merge state {:adminShareDeletingToken ""
		                         :adminShareError nil})
		           (Cmd.batch [(fetchSharesCommand)
		                       (fetchFilesCommand state.currentDir)])]
		          [(merge state {:adminShareDeletingToken ""
		                         :adminShareError (responseErrorMessage response.status)})
		           Cmd.none])
		    {:kind :admin-share-delete-failed :error error}
		      [(merge state {:adminShareDeletingToken "" :adminShareError error}) Cmd.none]
		    {:kind :admin-paste :text text}
	      (if (and (adminCurrentPathEditable? state) (not (= (trim text) "")))
	          [(merge state {:adminPasteOpen true
	                         :adminPasteContent text
	                         :adminPasteName "pasted.txt"
	                         :adminPastePending false
	                         :adminPasteError nil})
	           Cmd.none]
	          [state Cmd.none])
	    {:kind :admin-paste-name :value value}
	      [(merge state {:adminPasteName value :adminPasteError nil}) Cmd.none]
	    {:kind :admin-paste-submit}
	      (let [name (trim state.adminPasteName)
	            path (destinationChildPath state.currentDir name)]
	        (if (= name "")
	            [state Cmd.none]
	            [(merge state {:adminPastePending true :adminPasteError nil})
	             (adminCreateTextCommand path state.adminPasteContent)]))
	    {:kind :admin-paste-created :value response}
	      (if response.ok
	          (let [path (destinationChildPath state.currentDir (trim state.adminPasteName))
	                file {:name (workspacePathNameFromPath path)
	                      :path path
	                      :type MediaType.TEXT
	                      :size 0
	                      :extension (workspaceExtensionFromPath path)
	                      :isDirectory false
	                      :isVirtual nil
	                      :viewCount nil
	                      :shareToken nil
	                      :thumbnailGenerated true}]
	            (if (workspaceRoute? state)
	                [(merge (setWorkspaceState state
	                                           (openWorkspaceFileForWindowState state
	                                                                            state.workspace
	                                                                            state.workspace.activeWindowId
	                                                                            file
	                                                                            "new-window"))
	                        {:adminPasteOpen false
	                         :adminPastePending false
	                         :adminPasteError nil
	                         :adminTextPath path
	                         :adminTextContent state.adminPasteContent
	                         :adminTextDraft state.adminPasteContent
	                         :adminTextPending false
	                         :adminTextError nil
	                         :adminTextReadOnly false
	                         :filesPending true
	                         :filesError nil})
	                 (fetchFilesCommand state.currentDir)]
	                (let [href (browserMediaHref state.currentDir path state.playingPath state.audioOnly)]
	                  (withPushBrowserHref href (merge (routeMerge state href)
	                           {:adminPasteOpen false
	                            :adminPastePending false
	                            :adminPasteError nil
	                            :adminTextPath path
	                            :adminTextContent state.adminPasteContent
	                            :adminTextDraft state.adminPasteContent
	                            :adminTextPending false
	                            :adminTextError nil
	                            :adminTextReadOnly false
	                            :filesPending true
	                            :filesError nil}) (fetchFilesCommand state.currentDir)))))
	          [(merge state {:adminPastePending false
	                         :adminPasteError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-paste-failed :error error}
	      [(merge state {:adminPastePending false :adminPasteError error}) Cmd.none]
    {:kind :admin-markdown-image-open :src src}
	      [(merge state {:adminMarkdownImageOpen true :adminMarkdownImageSrc src}) Cmd.none]
	    {:kind :admin-markdown-image-close}
	      [(merge state {:adminMarkdownImageOpen false :adminMarkdownImageSrc ""}) Cmd.none]
	    {:kind :admin-image-zoom-in}
	      [(merge state {:adminImageZoom (if (= state.adminImageZoom 0) 125 (+ state.adminImageZoom 25))})
	       Cmd.none]
	    {:kind :admin-image-zoom-out}
	      [(merge state {:adminImageZoom (if (<= state.adminImageZoom 125) 0 (- state.adminImageZoom 25))})
	       Cmd.none]
	    {:kind :admin-image-fit}
	      [(merge state {:adminImageZoom 0 :adminImageRotation 0}) Cmd.none]
	    {:kind :admin-image-rotate}
	      [(merge state {:adminImageRotation (mod (+ state.adminImageRotation 90) 360)})
	       Cmd.none]
	    {:kind :admin-image-next}
	      (match (nextAdminImagePathForUpdate state 1)
	        nil [state Cmd.none]
	        (some path)
	          (let [href (browserMediaHref state.currentDir path state.playingPath state.audioOnly)]
	            (withPushBrowserHref href (merge (routeMerge state href)
	                     {:adminImageZoom 0
	                      :adminImageRotation 0}) Cmd.none)))
	    {:kind :admin-image-previous}
	      (match (nextAdminImagePathForUpdate state -1)
	        nil [state Cmd.none]
	        (some path)
	          (let [href (browserMediaHref state.currentDir path state.playingPath state.audioOnly)]
	            (withPushBrowserHref href (merge (routeMerge state href)
	                     {:adminImageZoom 0
	                      :adminImageRotation 0}) Cmd.none)))
	    {:kind :admin-open-icon :path path :name name}
	      [(merge (closeContextMenu state)
	              {:adminIconDialogOpen true
	               :adminIconPath path
	               :adminIconName ""
	               :adminIconPending false
	               :adminIconError nil})
	       Cmd.none]
	    {:kind :admin-icon-pick :name name}
	      [(merge state {:adminIconName name :adminIconError nil}) Cmd.none]
	    {:kind :admin-icon-save}
	      (if (or (= state.adminIconPath "") (= state.adminIconName ""))
	          [state Cmd.none]
	          [(merge state {:adminIconPending true :adminIconError nil})
	           (adminIconCommand state.adminIconPath state.adminIconName)])
	    {:kind :admin-icon-saved :value response}
	      (if response.ok
	          [(merge state {:adminIconDialogOpen false
	                         :adminIconPath ""
	                         :adminIconName ""
	                         :adminIconPending false
	                         :adminIconError nil})
	           (fetchSettingsCommand)]
	          [(merge state {:adminIconPending false
	                         :adminIconError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-icon-failed :error error}
	      [(merge state {:adminIconPending false :adminIconError error}) Cmd.none]
	    {:kind :theme-menu-toggle}
	      [(merge state {:themeMenuOpen (not state.themeMenuOpen)}) Cmd.none]
	    {:kind :theme-pick :mode mode}
	      (let [nextMode (normalizedThemeMode mode)
	            next (merge state {:themeMenuOpen false :themeMode nextMode})]
	        [next (Cmd.batch [(storageSetCommand "theme-mode" nextMode)
	                          (documentThemeCommand state.themePalette nextMode)])])
	    {:kind :theme-palette-pick :palette palette}
	      (let [nextPalette (normalizedThemePalette palette)
	            next (merge state {:themePalette nextPalette})]
	        [next (Cmd.batch [(storageSetCommand "theme-palette" nextPalette)
	                          (documentThemeCommand nextPalette state.themeMode)])])
	    {:kind :share-open-workspace}
	      (match state.shareToken
	        nil [(merge state {:themeMenuOpen false}) Cmd.none]
	        (some token)
	          (let [href (hrefWithWorkspaceSession (shareWorkspaceHrefForState state token state.currentDir))
	                next (merge (routeMerge state href) {:themeMenuOpen false})]
	            (withPushBrowserHref href next Cmd.none)))
				    {:kind :window-scroll :y y}
				      [(merge state {:scrollY y}) Cmd.none]
		    {:kind :scroll-playing-file}
		      [state (scrollToPlayingFileCommand)]
			    {:kind :global-keydown :key key :ctrlKey ctrlKey :metaKey metaKey :targetEditable targetEditable}
			      (if (and (not targetEditable) (keySearchShortcut? key ctrlKey metaKey))
                [(merge state {:kbSearchOpen true})
                 (focusSelectorCommand "input[type='search'][placeholder*='Search']" true false)]
                (if (and targetEditable (or (= key "ArrowRight") (= key "ArrowLeft")))
                    [state Cmd.none]
			        (if (= key "ArrowRight")
			          (if (workspaceRoute? state)
			              [(workspaceImageNavigateState state 1) Cmd.none]
			              (if (shareRoute? state)
		              (match state.shareToken
		                nil [state Cmd.none]
		                (some token)
		                  (match (nextShareImagePathByStepForUpdate state 1)
		                    nil [state Cmd.none]
		                    (some path)
		                      (let [href (shareMediaHref token state.currentDir path nil false)]
		                        (withPushBrowserHref href (merge (routeMerge state href)
		                                 {:shareImageZoom 0
		                                  :shareImageRotation 0}) Cmd.none))))
		              (match (nextAdminImagePathForUpdate state 1)
		                nil [state Cmd.none]
		                (some path)
		                  (let [href (browserMediaHref state.currentDir path state.playingPath state.audioOnly)]
		                    (withPushBrowserHref href (merge (routeMerge state href)
		                             {:adminImageZoom 0
		                              :adminImageRotation 0}) Cmd.none)))))
			          (if (= key "ArrowLeft")
			              (if (workspaceRoute? state)
			                  [(workspaceImageNavigateState state -1) Cmd.none]
			                  (if (shareRoute? state)
		                  (match state.shareToken
		                    nil [state Cmd.none]
		                    (some token)
		                      (match (nextShareImagePathByStepForUpdate state -1)
		                        nil [state Cmd.none]
		                        (some path)
		                          (let [href (shareMediaHref token state.currentDir path nil false)]
		                            (withPushBrowserHref href (merge (routeMerge state href)
		                                     {:shareImageZoom 0
		                                      :shareImageRotation 0}) Cmd.none))))
		                  (match (nextAdminImagePathForUpdate state -1)
		                    nil [state Cmd.none]
		                    (some path)
		                      (let [href (browserMediaHref state.currentDir path state.playingPath state.audioOnly)]
		                        (withPushBrowserHref href (merge (routeMerge state href)
		                                 {:adminImageZoom 0
		                                  :adminImageRotation 0}) Cmd.none)))))
			              (if (= key "Escape")
			                  [(closeTransientUi state) Cmd.none]
		                  [state Cmd.none])))))
		    {:kind :drag-start :path path}
		      [(merge state {:draggedPath path}) Cmd.none]
	    {:kind :drag-end}
	      (do
	        (boxSet currentDragPathBox "")
	        [(merge state {:draggedPath nil}) Cmd.none])
	    {:kind :drop-on-folder :sourcePath sourcePath :destPath destPath}
	      (let [actualSourcePath (if (= sourcePath "")
	                                (match state.draggedPath nil "" (some path) path)
	                                sourcePath)
	            name (adminFileNameFromPath actualSourcePath)
	            newPath (destinationChildPath destPath name)]
	        (do
	          (boxSet currentDragPathBox "")
	          (if (and (adminCurrentPathEditable? state)
	                   (pathCanMoveInto? actualSourcePath destPath))
	              [(merge state {:draggedPath nil})
	               (adminMoveCommand actualSourcePath newPath)]
	              [(merge state {:draggedPath nil}) Cmd.none])))
	    {:kind :admin-move-loaded :value response}
	      (if response.ok
	          [(merge state {:adminTransferMode "none"
	                         :adminTransferPath ""
	                         :adminTransferName ""
	                         :adminTransferBrowsePath ""
	                         :adminTransferPending false
	                         :adminTransferError nil
	                         :filesPending true
	                         :filesError nil})
	           (fetchFilesCommand state.currentDir)]
	          [(merge state {:adminTransferPending false
	                         :adminTransferError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :admin-move-failed :error error}
	      [(merge state {:adminTransferPending false :adminTransferError error})
	       Cmd.none]
    {:kind :context-favorite}
      [(closeContextMenu state) (favoriteCommand state.menuPath)]
    {:kind :context-open-workspace}
      [(closeContextMenu state)
       (match state.shareToken
         nil (openUrlCommand (workspaceHref state.menuPath))
         (some token) (openUrlCommand (shareWorkspaceHref token (shareRelativePath state state.menuPath))))]
    {:kind :context-toggle-knowledge-base}
      [(closeContextMenu state) (knowledgeBaseCommand state.menuPath)]
    {:kind :knowledge-base-updated :value response}
      (if response.ok
          [(merge state {:knowledgeBases (knowledgeBasesFromResponse response state.knowledgeBases)})
           Cmd.none]
          [state Cmd.none])
    {:kind :knowledge-base-update-failed :error _error}
      [state Cmd.none]
    {:kind :download-url :url url :filename filename}
      [(closeContextMenu state) (downloadUrlCommand url filename)]
    {:kind :open-url-new-tab :url url}
      [(closeContextMenu state) (openUrlCommand url)]
	    {:kind :close-viewer}
	      (let [href (browserMediaHref state.currentDir nil state.playingPath state.audioOnly)]
	        (withPushBrowserHref href (merge (routeMerge state href)
	                 {:adminImageZoom 0
	                  :adminImageRotation 0}) Cmd.none))
	    {:kind :close-player}
	      (let [href (browserMediaHref state.currentDir state.viewingPath nil false)]
	        (withPushBrowserHref href (merge (routeMerge state href)
	                 {:shareAudioRepeat false
	                  :shareVideoCompact false}) Cmd.none))
	    {:kind :audio-only :enabled enabled :currentTime currentTime}
	      (let [href (browserMediaHref state.currentDir state.viewingPath state.playingPath enabled)]
	        (withPushBrowserHref href
	                             (routeMerge state href)
	                             (if (and (not enabled) (> currentTime 0))
	                                 (restoreMediaCurrentTimeCommand "video" currentTime)
	                                 Cmd.none)))
	    {:kind :share-info-loaded :value response}
	      (if response.ok
	          (let [nextBase0 (shareInfoState state response)
	                nextBase (if (and (shareWorkspacePath? state.pathname)
	                                  (some? response.body.workspaceTaskbarPins))
	                             (merge nextBase0
	                                    {:workspace (workspaceWithTaskbarPins
	                                                 nextBase0.workspace
	                                                 response.body.workspaceTaskbarPins)})
	                             nextBase0)
	                presets (workspaceLayoutPresetsFromBody response.body [])
		                nextWithPresets (merge nextBase
		                                       {:workspaceLayoutPresets presets
		                                        :workspaceLayoutPresetsReady true})
		                nextHydrated (if (shareWorkspacePath? state.pathname)
		                                 (workspaceApplyPresetFromReadyPresets nextWithPresets presets)
		                                 nextWithPresets)
			                shouldAuto (and response.body.needsPasscode
			                                (not response.body.authorized)
			                                (some? state.sharePasscodeParam)
			                                (not state.sharePasscodeAutoTried))
			                nextDirect (shareDirectFileState nextHydrated response)
			                next (stateWithMediaAudioMetadataKey
			                      (merge nextDirect {:sharePasscodeAutoTried shouldAuto}))
			                redirectCmd (if (and (shareWorkspacePath? state.pathname)
			                                     (not response.body.isDirectory))
			                                (redirectShareWorkspaceFileRoute state)
			                                Cmd.none)
			                directHref (shareDirectFileHref nextHydrated response)
			                directRouteCmd (match directHref
			                                 nil Cmd.none
			                                 (some href) (replaceBrowserHref href))]
			            [next (Cmd.batch [(if (and response.body.authorized response.body.isDirectory)
			                                  (match state.shareToken
			                                    nil Cmd.none
			                                    (some token) (openShareSseCommand token))
			                                  Cmd.none)
			                              redirectCmd
			                              directRouteCmd
			                              (replaceWorkspaceUrlIfChangedCommand nextWithPresets nextHydrated)
			                              (shareInfoFollowupCommand state response)
			                              (shareDirectFileCommand nextHydrated response)
			                              (mediaAudioMetadataCommandForState next)])])
          [(merge state {:shareInfoPending false
                         :shareInfoStatus response.status
                         :shareInfoError (responseErrorMessage response.status)})
           Cmd.none])
    {:kind :share-info-failed :error error}
      [(merge state {:shareInfoPending false
                     :shareInfoStatus 0
                     :shareInfoError error})
       Cmd.none]
    {:kind :share-passcode-input :value value}
      [(merge state {:sharePasscodeInput value :sharePasscodeError nil})
       Cmd.none]
    {:kind :share-passcode-submit}
      (match state.shareToken
        nil [state Cmd.none]
        (some token)
          [(merge state {:sharePasscodePending true :sharePasscodeError nil})
           (verifySharePasscodeCommand token state.sharePasscodeInput)])
	    {:kind :share-verify-loaded :value response}
	      (if response.ok
	          (match state.shareToken
	            nil [(merge state {:sharePasscodePending false}) Cmd.none]
	            (some token)
	              [(merge state {:sharePasscodePending false
	                             :sharePasscodeError nil
	                             :shareAuthorized true
	                             :shareInfoPending true
	                             :shareInfoError nil
	                             :shareFilesError nil})
	               (fetchShareInfoCommand token)])
          [(merge state {:sharePasscodePending false
                         :sharePasscodeError (responseErrorMessage response.status)})
           Cmd.none])
    {:kind :share-verify-failed :error error}
      [(merge state {:sharePasscodePending false :sharePasscodeError error})
       Cmd.none]
    {:kind :share-files-loaded :value response}
      (if response.ok
          [(merge state {:shareFilesPending false
                         :shareFilesError nil
                         :shareFiles response.body.files})
           Cmd.none]
          [(merge state {:shareFilesPending false
                         :shareFilesError (responseErrorMessage response.status)
                         :shareFiles []})
           Cmd.none])
	    {:kind :share-files-failed :error error}
	      [(merge state {:shareFilesPending false :shareFilesError error :shareFiles []})
	       Cmd.none]
	    {:kind :share-view-mode-picked :value value}
	      (let [mode (if (= value "grid") "grid" "list")]
	        [(merge state {:viewMode mode
	                       :viewModeTouched true})
	         (storageSetCommand "workspace-view-mode" mode)])
	    {:kind :share-upload-menu-toggle}
	      [(merge state {:shareUploadMenuOpen (not state.shareUploadMenuOpen)})
	       Cmd.none]
	    {:kind :share-upload-file-selected :selected? selected?}
	      (if (and selected? state.shareAllowUpload)
	          (match state.shareToken
	            nil [state Cmd.none]
	            (some token)
		              [(merge state {:shareUploadSelected selected?
		                             :shareUploadPending true
		                             :shareUploadStatus "Uploading"})
		               (shareUploadCommand token state.currentDir)])
	          [(merge state {:shareUploadSelected selected?}) Cmd.none])
	    {:kind :share-upload-submit}
	      (if (and state.shareUploadSelected state.shareAllowUpload)
	          (match state.shareToken
	            nil [state Cmd.none]
	            (some token)
		              [(merge state {:shareUploadPending true
		                             :shareUploadStatus "Uploading"})
		               (shareUploadCommand token state.currentDir)])
	          [state Cmd.none])
	    {:kind :share-upload-loaded :value response}
	      (if response.ok
	          (match state.shareToken
		            nil [(merge state {:shareUploadPending false
		                               :shareUploadMenuOpen false
		                               :shareUploadStatus "Upload complete"
		                               :shareUploadSelected false})
		                 Cmd.none]
		            (some token)
		              [(merge state {:shareUploadPending false
		                             :shareUploadMenuOpen false
		                             :shareUploadStatus "Upload complete"
		                             :shareUploadSelected false
		                             :shareFilesPending true
	                             :shareFilesError nil})
	               (fetchShareFilesCommand token state.currentDir)])
		          [(merge state {:shareUploadPending false
		                         :shareUploadMenuOpen false
		                         :shareUploadStatus (responseErrorMessage response.status)})
		           Cmd.none])
	    {:kind :share-upload-failed :error error}
	      [(merge state {:shareUploadPending false
	                     :shareUploadMenuOpen false
	                     :shareUploadStatus error})
	       Cmd.none]
	    {:kind :share-open-create :createKind createKind}
	      [(merge state {:shareCreateKind createKind
	                     :shareCreateName ""
	                     :shareCreatePending false
	                     :shareCreateError nil})
	       Cmd.none]
	    {:kind :share-create-name :value value}
	      [(merge state {:shareCreateName value :shareCreateError nil})
	       Cmd.none]
	    {:kind :share-create-submit}
	      (let [name (shareCreateNameWithDefault state.shareCreateKind (trim state.shareCreateName))
	            path (shareChildPath state.currentDir name)]
	        (if (or (= name "") (not state.shareAllowUpload))
	            [state Cmd.none]
	            (match state.shareToken
	              nil [state Cmd.none]
	              (some token)
	                [(merge state {:shareCreatePending true :shareCreateError nil})
	                 (shareCreateCommand token state.shareCreateKind path)])))
	    {:kind :share-create-loaded :value response}
	      (if response.ok
	          (match state.shareToken
	            nil [(merge state {:shareCreateKind "none"
	                               :shareCreateName ""
	                               :shareCreatePending false
	                               :shareCreateError nil})
	                 Cmd.none]
	            (some token)
	              [(merge state {:shareCreateKind "none"
	                             :shareCreateName ""
	                             :shareCreatePending false
	                             :shareCreateError nil
	                             :shareFilesPending true
	                             :shareFilesError nil})
	               (fetchShareFilesCommand token state.currentDir)])
	          [(merge state {:shareCreatePending false
	                         :shareCreateError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :share-create-failed :error error}
	      [(merge state {:shareCreatePending false :shareCreateError error})
	       Cmd.none]
	    {:kind :share-open-rename :file file}
	      [(merge (closeContextMenu state)
	              {:shareRenameOpen true
	               :shareRenameOldPath (shareRelativePath state file.path)
	               :shareRenameName file.name
	               :shareRenamePending false
	               :shareRenameError nil})
	       Cmd.none]
	    {:kind :share-rename-name :value value}
	      [(merge state {:shareRenameName value :shareRenameError nil})
	       Cmd.none]
	    {:kind :share-rename-submit}
	      (let [name (trim state.shareRenameName)
	            newPath (shareSiblingPath state.shareRenameOldPath name)]
	        (if (or (= name "") (= newPath state.shareRenameOldPath) (not state.shareAllowEdit))
	            [state Cmd.none]
	            (match state.shareToken
	              nil [state Cmd.none]
	              (some token)
	                [(merge state {:shareRenamePending true :shareRenameError nil})
	                 (shareRenameCommand token state.shareRenameOldPath newPath)])))
	    {:kind :share-rename-loaded :value response}
	      (if response.ok
	          (match state.shareToken
	            nil [(merge state {:shareRenameOpen false
	                               :shareRenameOldPath ""
	                               :shareRenameName ""
	                               :shareRenamePending false
	                               :shareRenameError nil})
	                 Cmd.none]
	            (some token)
	              [(merge state {:shareRenameOpen false
	                             :shareRenameOldPath ""
	                             :shareRenameName ""
	                             :shareRenamePending false
	                             :shareRenameError nil
	                             :shareFilesPending true
	                             :shareFilesError nil})
	               (fetchShareFilesCommand token state.currentDir)])
	          [(merge state {:shareRenamePending false
	                         :shareRenameError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :share-rename-failed :error error}
	      [(merge state {:shareRenamePending false :shareRenameError error})
	       Cmd.none]
	    {:kind :share-open-delete :file file}
	      [(merge (closeContextMenu state)
	              {:shareDeleteOpen true
	               :shareDeletePath (shareRelativePath state file.path)
	               :shareDeleteName file.name
	               :shareDeletePending false
	               :shareDeleteError nil})
	       Cmd.none]
	    {:kind :share-delete-submit}
	      (if (or (= state.shareDeletePath "") (not state.shareAllowDelete))
	          [state Cmd.none]
	          (match state.shareToken
	            nil [state Cmd.none]
	            (some token)
	              [(merge state {:shareDeletePending true :shareDeleteError nil})
	               (shareDeleteCommand token state.shareDeletePath)]))
	    {:kind :share-delete-loaded :value response}
	      (if response.ok
	          (match state.shareToken
	            nil [(merge state {:shareDeleteOpen false
	                               :shareDeletePath ""
	                               :shareDeleteName ""
	                               :shareDeletePending false
	                               :shareDeleteError nil})
	                 Cmd.none]
	            (some token)
	              [(merge state {:shareDeleteOpen false
	                             :shareDeletePath ""
	                             :shareDeleteName ""
	                             :shareDeletePending false
	                             :shareDeleteError nil
	                             :shareFilesPending true
	                             :shareFilesError nil})
	               (fetchShareFilesCommand token state.currentDir)])
	          [(merge state {:shareDeletePending false
	                         :shareDeleteError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :share-delete-failed :error error}
	      [(merge state {:shareDeletePending false :shareDeleteError error})
	       Cmd.none]
    {:kind :share-close-dialog}
	      [(merge state {:shareCreateKind "none"
	                     :shareCreateName ""
	                     :shareCreatePending false
	                     :shareCreateError nil
	                     :shareRenameOpen false
	                     :shareRenameOldPath ""
	                     :shareRenameName ""
	                     :shareRenamePending false
	                     :shareRenameError nil
	                     :shareDeleteOpen false
	                     :shareDeletePath ""
	                     :shareDeleteName ""
	                     :shareDeletePending false
	                     :shareDeleteError nil
	                     :shareUploadMenuOpen false})
	       Cmd.none]
	    {:kind :share-navigate-dir :path path}
	      (match state.shareToken
	        nil [state Cmd.none]
	        (some token)
          (let [href (shareMediaHref token path nil state.playingPath state.audioOnly)
                next (merge (routeMerge state href)
                            {:shareFilesPending true
                             :shareFilesError nil
                             :shareFiles []})]
            (withPushBrowserHref href next (fetchShareFilesCommand token path))))
	    {:kind :share-open-file :file file}
	      (match state.shareToken
	        nil [state Cmd.none]
	        (some token)
	          (let [relative (shareRelativePath state file.path)]
	            (if file.isDirectory
                (let [href (shareMediaHref token relative nil state.playingPath state.audioOnly)
                      next (merge (routeMerge state href)
                                  {:shareFilesPending true
                                   :shareFilesError nil
                                   :shareFiles []})]
                  (withPushBrowserHref href next (fetchShareFilesCommand token relative)))
		                (if (or (= file.type MediaType.AUDIO) (= file.type MediaType.VIDEO))
		                    (let [href (shareMediaHref token state.currentDir nil relative false)]
		                      (withPushBrowserHref href (merge (routeMerge state href)
		                               {:shareAudioRepeat false
		                                :shareVideoCompact false}) (shareViewCommand token relative)))
		                    (if (= file.type MediaType.TEXT)
		                        (let [href (shareMediaHref token state.currentDir relative state.playingPath state.audioOnly)]
		                          (withPushBrowserHref href (merge (routeMerge state href)
		                                   {:shareTextPath relative
		                                    :shareTextContent ""
		                                    :shareTextPending true
		                                    :shareTextError nil
		                                    :shareTextSaving false
		                                    :shareImageZoom 0
		                                    :shareImageRotation 0}) (fetchShareTextCommand (buildShareMediaUrl token state.sharePath file.path))))
		                        (let [href (shareMediaHref token state.currentDir relative state.playingPath state.audioOnly)]
		                          (withPushBrowserHref href (merge (routeMerge state href)
		                                   {:shareImageZoom 0
		                                    :shareImageRotation 0}) (shareViewCommand token relative))))))))
	    {:kind :share-close-viewer}
	      (match state.shareToken
	        nil [state Cmd.none]
	        (some token)
	          (let [href (shareMediaHref token state.currentDir nil state.playingPath state.audioOnly)]
	            (withPushBrowserHref href (merge (routeMerge state href)
	                     {:shareImageZoom 0
	                      :shareImageRotation 0
	                      :shareAudioRepeat false
	                      :shareVideoCompact false
	                      :shareTextPath ""
	                      :shareTextContent ""
	                      :shareTextPending false
	                      :shareTextError nil
	                      :shareTextSaving false}) Cmd.none)))
		    {:kind :share-close-player}
		      (match state.shareToken
		        nil [state Cmd.none]
		        (some token)
	          (let [href (shareMediaHref token state.currentDir state.viewingPath nil false)]
	            (withPushBrowserHref href (merge (routeMerge state href)
	                     {:shareAudioRepeat false
	                      :shareVideoCompact false}) Cmd.none)))
			    {:kind :workspace-open-browser}
			      [(setWorkspaceState state (openWorkspaceBrowserState state state.workspace state.currentDir))
			       Cmd.none]
			    {:kind :workspace-exit-to-share}
			      (match state.shareToken
			        nil [state Cmd.none]
			        (some token)
			          [state (assignBrowserHref (shareClassicHrefForState state token))])
			    {:kind :workspace-storage-loaded :key key :value value}
			      (if (or (not (workspaceRoute? state))
			              (not (= key (workspaceStorageKeyForState state))))
			          [state Cmd.none]
		          (let [loaded (parsePersistedWorkspaceState value)
		                next (workspaceApplyStorageHydrationState state loaded)]
		            [next (replaceWorkspaceUrlIfChangedCommand state next)]))
		    {:kind :workspace-storage-load-failed :error _error}
		      [(merge state {:workspaceStorageLoaded true
		                     :workspaceHasPersistedDraft false})
		       Cmd.none]
		    {:kind :workspace-settings-open}
		      [(merge state {:workspaceSettingsOpen true}) Cmd.none]
		    {:kind :workspace-settings-close}
		      [(merge state {:workspaceSettingsOpen false}) Cmd.none]
		    {:kind :workspace-layout-menu-toggle :x _x :y _y}
		      [(merge (closeContextMenu state)
		              {:workspaceLayoutMenuOpen true
		               :workspaceLayoutSaveOpen false})
		       Cmd.none]
		    {:kind :workspace-layout-menu-close}
		      [(merge state {:workspaceLayoutMenuOpen false}) Cmd.none]
		    {:kind :workspace-layout-save-open}
		      [(merge state {:workspaceLayoutMenuOpen false
		                     :workspaceLayoutSaveOpen true
		                     :workspaceLayoutSaveName ""})
		       Cmd.none]
		    {:kind :workspace-layout-save-close}
		      [(merge state {:workspaceLayoutSaveOpen false
		                     :workspaceLayoutSaveName ""})
		       Cmd.none]
		    {:kind :workspace-layout-save-name :value value}
		      [(merge state {:workspaceLayoutSaveName value}) Cmd.none]
		    {:kind :workspace-layout-save-submit}
		      (let [name (trim state.workspaceLayoutSaveName)]
		        (if (or (= name "") (not state.workspaceLayoutPresetsReady))
		            [state Cmd.none]
		            (let [preset (workspaceLayoutPresetWithCurrentSnapshot state name)
		                  nextPresets (conj state.workspaceLayoutPresets preset)
		                  next0 (merge state {:workspaceLayoutPresets nextPresets
		                                      :workspaceLayoutMenuOpen false
		                                      :workspaceLayoutSaveOpen false
		                                      :workspaceLayoutSaveName ""
		                                      :workspaceLayoutBaselineSnapshot (normalizeWorkspaceStateValue preset.snapshot nil)
		                                      :workspaceLayoutBaselinePresetId preset.id})
		                  next (match (workspacePresetParam next0)
		                         nil next0
		                         (some _value) (clearWorkspacePresetParamState next0))]
		              [next (Cmd.batch [(replaceWorkspaceUrlIfChangedCommand next0 next)
		                                (workspaceLayoutPresetsCommand state.shareToken nextPresets)])])))
		    {:kind :workspace-layout-presets-saved :value response}
		      (if response.ok
		          [(merge state {:workspaceLayoutPresets (workspaceLayoutPresetsFromBody response.body state.workspaceLayoutPresets)
		                         :workspaceLayoutPresetsReady true
		                         :workspaceLayoutMenuOpen false
		                         :workspaceLayoutSaveOpen false
		                         :workspaceLayoutSaveName ""})
		           Cmd.none]
		          [(merge state {:settingsError (responseErrorMessage response.status)})
		           Cmd.none])
		    {:kind :workspace-layout-presets-save-failed :error error}
		      [(merge state {:settingsError error}) Cmd.none]
		    {:kind :workspace-layout-restore-preset :id id}
		      (match (resolveWorkspaceDeferredPresetApply
		              {:presetParam id
		               :presetsReadyNow state.workspaceLayoutPresetsReady
		               :hasPersistedDraft false
		               :presetsList state.workspaceLayoutPresets
		               :layoutScope (workspaceLayoutScopeForState state)})
		        nil [state Cmd.none]
		        (some outcome)
		          (let [outcomeState (workspaceStateFromPresetOutcome state outcome)
		                next (merge outcomeState {:workspaceLayoutMenuOpen false})]
		            [next (replaceWorkspaceUrlIfChangedCommand state outcomeState)]))
		    {:kind :workspace-layout-revert-baseline}
		      (match state.workspaceLayoutBaselineSnapshot
		        nil [(merge state {:workspaceLayoutMenuOpen false}) Cmd.none]
		        (some snapshot)
		          [(merge (setWorkspaceState state snapshot)
		                  {:workspaceLayoutMenuOpen false})
		           Cmd.none])
		    {:kind :workspace-layout-update-preset :id id}
		      (if (not state.workspaceLayoutPresetsReady)
		          [state Cmd.none]
		          (let [preset (find state.workspaceLayoutPresets (fn [item] (= item.id id)))]
		            (if (not (some? preset))
		                [state Cmd.none]
		                (let [updated (workspaceUpdatedPresetFromCurrent state preset)
		                      nextPresets (map state.workspaceLayoutPresets
		                                       (fn [item]
		                                         (if (= item.id id) updated item)))
		                      next0 (merge state {:workspaceLayoutPresets nextPresets
		                                          :workspaceLayoutMenuOpen false
		                                          :workspaceLayoutBaselineSnapshot (if (= state.workspaceLayoutBaselinePresetId id)
		                                                                              (normalizeWorkspaceStateValue updated.snapshot nil)
		                                                                              state.workspaceLayoutBaselineSnapshot)})
		                      next (match (workspacePresetParam next0)
		                             nil next0
		                             (some _value) (clearWorkspacePresetParamState next0))]
		                  [next (Cmd.batch [(replaceWorkspaceUrlIfChangedCommand next0 next)
		                                    (workspaceLayoutPresetsCommand state.shareToken nextPresets)])]))))
		    {:kind :workspace-layout-delete-preset :id id}
		      (if (not state.workspaceLayoutPresetsReady)
		          [state Cmd.none]
		          (let [nextPresets (filter state.workspaceLayoutPresets (fn [preset] (not (= preset.id id))))
		                deletingBaseline (= state.workspaceLayoutBaselinePresetId id)
		                next0 (merge state {:workspaceLayoutPresets nextPresets
		                                    :workspaceLayoutBaselinePresetId (if deletingBaseline nil state.workspaceLayoutBaselinePresetId)
		                                    :workspaceLayoutBaselineSnapshot (if deletingBaseline nil state.workspaceLayoutBaselineSnapshot)})
		                next (match (workspacePresetParam next0)
		                       nil next0
		                       (some _value) (if deletingBaseline (clearWorkspacePresetParamState next0) next0))]
		            [next (Cmd.batch [(replaceWorkspaceUrlIfChangedCommand next0 next)
		                              (workspaceLayoutPresetsCommand state.shareToken nextPresets)])]))
		    {:kind :workspace-snap-assist-toggle :enabled enabled}
		      [(merge state {:workspaceSnapAssistEnabled enabled})
		       (storageSetCommand "workspace-snap-assist" (if enabled "true" "false"))]
		    {:kind :workspace-file-open-target :target target}
		      (let [nextTarget (if (= target "new-tab") "new-tab" "new-window")]
		        [(setWorkspaceState (merge state {:workspaceFileOpenTarget nextTarget})
		                            (object-assoc state.workspace "fileOpenTarget" nextTarget))
		         Cmd.none])
		    {:kind :workspace-browser-tab-title :value value}
		      [(setWorkspaceState state
		                          (merge state.workspace
		                                 {:browserTabTitle (sanitizeBrowserTabTitle value)}))
		       Cmd.none]
		    {:kind :workspace-browser-tab-icon :value value}
		      (let [icon (sanitizeBrowserTabIcon value)]
		        [(setWorkspaceState state
		                            (merge state.workspace
		                                   {:browserTabIcon icon
		                                    :browserTabIconColor (match icon
		                                                           nil nil
		                                                           (some _iconName) state.workspace.browserTabIconColor)}))
		         Cmd.none])
		    {:kind :workspace-browser-tab-icon-color :value value}
		      (let [color (sanitizeBrowserTabIconColor value)]
		        (if (and (not (= (trim value) "")) (not (some? color)))
		            [state Cmd.none]
		            [(setWorkspaceState state
		                                (merge state.workspace {:browserTabIconColor color}))
		             Cmd.none]))
		    {:kind :workspace-browser-tab-reset}
		      [(setWorkspaceState state
		                          (merge state.workspace
		                                 {:browserTabTitle nil
		                                  :browserTabIcon nil
		                                  :browserTabIconColor nil}))
		       Cmd.none]
		    {:kind :workspace-close-window :index index}
		      (match (workspaceWindowIdAtIndex state index)
		        nil [state Cmd.none]
		        (some id) [(setWorkspaceState state (closeWorkspaceWindowState state.workspace id)) Cmd.none])
	    {:kind :workspace-focus-window :index index}
	      (match (workspaceWindowIdAtIndex state index)
	        nil [state Cmd.none]
	        (some id) [(setWorkspaceState state (focusWorkspaceWindowState state.workspace id)) Cmd.none])
	    {:kind :workspace-close-window-id :id id}
	      [(setWorkspaceState state (closeWorkspaceWindowState state.workspace id)) Cmd.none]
	    {:kind :workspace-focus-window-id :id id}
	      [(setWorkspaceState state (focusWorkspaceWindowState state.workspace id)) Cmd.none]
	    {:kind :workspace-minimize-window :id id :minimized minimized}
	      [(setWorkspaceState state (minimizeWorkspaceWindowState state.workspace id minimized)) Cmd.none]
	    {:kind :workspace-toggle-fullscreen :id id}
	      [(setWorkspaceState state (toggleFullscreenWorkspaceWindowState state.workspace id)) Cmd.none]
	    {:kind :workspace-window-drag-start :groupId groupId :id id :grabDx grabDx :grabDy grabDy :canvasLeft canvasLeft :canvasTop canvasTop :canvasWidth canvasWidth :canvasHeight canvasHeight :x x :y y :width width :height height :restore restore}
	      (let [focused (focusWorkspaceWindowState state.workspace id)
	            startBounds {:x x :y y :width width :height height}
	            nextWorkspace (if restore
	                              (updateWorkspaceWindowBoundsState focused id startBounds)
	                              focused)]
	        [(merge (setWorkspaceState state nextWorkspace)
	                {:workspaceWindowDrag {:groupId groupId
	                                       :windowId id
	                                       :grabDx grabDx
	                                       :grabDy grabDy
	                                       :canvasLeft canvasLeft
	                                       :canvasTop canvasTop
	                                       :canvasWidth canvasWidth
	                                       :canvasHeight canvasHeight
	                                       :clientX (+ canvasLeft x grabDx)
	                                       :clientY (+ canvasTop y grabDy)
                                         :assistActive false
	                                       :liveBounds startBounds}})
	         Cmd.none])
	    {:kind :workspace-window-drag-move :value event}
	      (match state.workspaceWindowDrag
	        nil [state Cmd.none]
	        (some drag)
	          (let [assistActive (or (= drag.assistActive true)
                                   (workspaceWindowDragTriggersAssist? state drag event.clientX event.clientY))
                  activeDrag (merge drag {:assistActive assistActive})
                  nextBounds (workspaceWindowDragNextBounds activeDrag event.clientX event.clientY)
	                nextSpan (workspaceWindowDragNextSnapSpan state activeDrag event.clientX event.clientY)
	                nextDrag (merge drag {:clientX event.clientX
	                                      :clientY event.clientY
                                        :assistActive assistActive
	                                      :liveBounds nextBounds
	                                      :snapSpan nextSpan})]
	            [(merge (setWorkspaceState state
	                                      (updateWorkspaceWindowBoundsState state.workspace
	                                                                        drag.windowId
	                                                                        nextBounds))
	                    {:workspaceWindowDrag nextDrag})
	             Cmd.none]))
	    {:kind :workspace-window-drag-end :value event}
	      (match state.workspaceWindowDrag
	        nil [state Cmd.none]
	        (some drag)
	          [(merge (workspaceWindowDragDropState state drag event.clientX event.clientY)
	                  {:workspaceWindowDrag nil})
	           Cmd.none])
	    {:kind :workspace-assist-hover :gridCols gridCols :gridRows gridRows :gc0 gc0 :gc1 gc1 :gr0 gr0 :gr1 gr1}
	      (match state.workspaceWindowDrag
	        nil [state Cmd.none]
	        (some drag)
	          [(merge state {:workspaceWindowDrag
	                         (merge drag {:assistActive true
                                        :snapSpan {:gridCols gridCols
	                                                 :gridRows gridRows
	                                                 :gc0 gc0
	                                                 :gc1 gc1
	                                                 :gr0 gr0
	                                                 :gr1 gr1}})})
	           Cmd.none])
	    {:kind :workspace-update-bounds :id id :x x :y y :width width :height height}
	      [(setWorkspaceState state
	                          (updateWorkspaceWindowBoundsState state.workspace
	                                                            id
	                                                            {:x x
	                                                             :y y
	                                                             :width width
	                                                             :height height}))
	       Cmd.none]
	    {:kind :workspace-resize-start :id id :direction direction :startX startX :startY startY :canvasWidth canvasWidth :canvasHeight canvasHeight :x x :y y :width width :height height}
	      (let [startBounds {:x x :y y :width width :height height}]
	        [(merge (setWorkspaceState state (focusWorkspaceWindowState state.workspace id))
	                {:workspaceWindowResize {:windowId id
	                                         :direction direction
	                                         :startX startX
	                                         :startY startY
	                                         :canvasWidth canvasWidth
	                                         :canvasHeight canvasHeight
	                                         :startBounds startBounds}})
	         Cmd.none])
	    {:kind :workspace-resize-move :value event}
	      (match state.workspaceWindowResize
	        nil [state Cmd.none]
	        (some resize)
	          (let [nextBounds (workspaceClampResizeBounds
	                            (workspaceResizeNextBounds resize event.clientX event.clientY)
	                            resize)]
	            [(setWorkspaceState state
	                                (resizeWorkspaceWindowBoundsState state.workspace
	                                                                  resize.windowId
	                                                                  nextBounds
	                                                                  resize.direction))
	             Cmd.none]))
	    {:kind :workspace-resize-end :value _event}
	      [(merge state {:workspaceWindowResize nil}) Cmd.none]
		    {:kind :workspace-video-metadata-loaded :windowId windowId :path path :width width :height height}
		      [(setWorkspaceState state
		                          (resizeWorkspaceVideoViewerForMetadataState state.workspace
		                                                                       windowId
		                                                                       path
		                                                                       width
		                                                                       height))
		       Cmd.none]
		    {:kind :workspace-snap-window :id id :zone zone}
		      [(setWorkspaceState state (snapWorkspaceWindowState state.workspace id zone)) Cmd.none]
	    {:kind :workspace-merge-window :sourceId sourceId :targetId targetId :insertIndex insertIndex}
	      [(setWorkspaceState state (mergeWindowIntoGroupState state.workspace sourceId targetId insertIndex)) Cmd.none]
	    {:kind :workspace-split-window :id id}
	      [(setWorkspaceState state (splitWindowFromGroupState state.workspace id nil)) Cmd.none]
	    {:kind :workspace-select-tab :groupId groupId :tabId tabId}
	      (let [activeMap state.workspace.activeTabMap
	            withTab (object-assoc (object-assoc state.workspace
	                                                "activeWindowId"
	                                                tabId)
	                                  "activeTabMap"
	                                  (object-assoc activeMap groupId tabId))]
	        [(setWorkspaceState state (focusWorkspaceWindowState withTab tabId)) Cmd.none])
	    {:kind :workspace-tab-drag-start :groupId groupId :tabId tabId :startX startX :startY startY :canvasLeft canvasLeft :canvasTop canvasTop :canvasWidth canvasWidth :canvasHeight canvasHeight}
	      (let [activeMap state.workspace.activeTabMap
	            withTab (object-assoc (object-assoc state.workspace
	                                                "activeWindowId"
	                                                tabId)
	                                  "activeTabMap"
	                                  (object-assoc activeMap groupId tabId))]
	        [(merge (setWorkspaceState state (focusWorkspaceWindowState withTab tabId))
	                {:workspaceTabDrag {:groupId groupId
	                                    :tabId tabId
	                                    :startX startX
	                                    :startY startY
	                                    :canvasLeft canvasLeft
	                                    :canvasTop canvasTop
	                                    :canvasWidth canvasWidth
	                                    :canvasHeight canvasHeight}})
	         Cmd.none])
	    {:kind :workspace-tab-drag-end :value event}
	      (match state.workspaceTabDrag
	        nil [state Cmd.none]
	        (some drag)
	          [(merge (if (= event.type "pointercancel")
	                      state
	                      (workspaceTabDragDropState state drag event.clientX event.clientY))
	                  {:workspaceTabDrag nil})
	           Cmd.none])
	    {:kind :workspace-close-tab :id id}
	      [(setWorkspaceState state (closeWorkspaceTabState state.workspace id)) Cmd.none]
		    {:kind :workspace-toggle-tab-pinned :id id}
		      (match (findWorkspaceWindow state.workspace id)
		        nil [state Cmd.none]
		        (some win)
		          [(merge (setWorkspaceState state (setTabPinnedAndReorderState state.workspace id (not (= win.tabPinned true))))
		                  {:workspaceTabMenuOpen false
		                   :workspaceTabMenuTabId ""
		                   :workspaceTabMenuX 0
		                   :workspaceTabMenuY 0})
		           Cmd.none])
		    {:kind :workspace-tab-menu-open :id id :x x :y y}
		      [(merge (closeContextMenu state)
		              {:workspaceTabMenuOpen true
		               :workspaceTabMenuTabId id
		               :workspaceTabMenuX x
		               :workspaceTabMenuY y})
		       Cmd.none]
		    {:kind :workspace-tab-menu-close}
		      [(merge state {:workspaceTabMenuOpen false
		                     :workspaceTabMenuTabId ""
		                     :workspaceTabMenuX 0
		                     :workspaceTabMenuY 0})
		       Cmd.none]
		    {:kind :workspace-tab-use-split-left :id id}
		      [(merge (setWorkspaceState state (setSplitLeftTabFromContextState state.workspace id))
		              {:workspaceTabMenuOpen false
		               :workspaceTabMenuTabId ""
		               :workspaceTabMenuX 0
		               :workspaceTabMenuY 0})
		       Cmd.none]
			    {:kind :workspace-tab-exit-split :groupId groupId}
			      [(merge (setWorkspaceState state (exitSplitViewState state.workspace groupId))
			              {:workspaceTabMenuOpen false
			               :workspaceTabMenuTabId ""
			               :workspaceTabMenuX 0
			               :workspaceTabMenuY 0})
			       Cmd.none]
			    {:kind :workspace-split-resize-start :groupId groupId :groupLeft groupLeft :groupWidth groupWidth}
			      [(merge state {:workspaceSplitResize {:groupId groupId
			                                            :groupLeft groupLeft
			                                            :groupWidth groupWidth}})
			       Cmd.none]
			    {:kind :workspace-split-resize-move :value event}
			      (match state.workspaceSplitResize
			        nil [state Cmd.none]
			        (some resize)
			          [(setWorkspaceState state
			                              (setSplitFractionState state.workspace
			                                                     resize.groupId
			                                                     (workspaceSplitResizeFraction resize event.clientX)))
			           Cmd.none])
			    {:kind :workspace-split-resize-end :value _event}
			      [(merge state {:workspaceSplitResize nil}) Cmd.none]
			    {:kind :workspace-set-split-fraction :groupId groupId :fraction fraction}
			      [(setWorkspaceState state (setSplitFractionState state.workspace groupId fraction))
			       Cmd.none]
			    {:kind :workspace-open-layout-picker :id id :x x :y y}
		      [(merge state {:workspaceLayoutPickerOpen true
		                     :workspaceLayoutPickerWindowId id
		                     :workspaceLayoutPickerX x
		                     :workspaceLayoutPickerY y})
		       Cmd.none]
		    {:kind :workspace-close-layout-picker}
		      [(merge state {:workspaceLayoutPickerOpen false
		                     :workspaceLayoutPickerWindowId ""
		                     :workspaceLayoutPickerX 0
		                     :workspaceLayoutPickerY 0})
		       Cmd.none]
		    {:kind :workspace-tiling-pick :id id :gridCols gridCols :gridRows gridRows :gc0 gc0 :gc1 gc1 :gr0 gr0 :gr1 gr1}
		      [(merge (setWorkspaceState state
		                                (tilingPickWorkspaceState state.workspace
		                                                          id
		                                                          {:gridCols gridCols
		                                                           :gridRows gridRows
		                                                           :gc0 gc0
		                                                           :gc1 gc1
		                                                           :gr0 gr0
		                                                           :gr1 gr1}))
		              {:workspaceLayoutPickerOpen false
		               :workspaceLayoutPickerWindowId ""
		               :workspaceLayoutPickerX 0
		               :workspaceLayoutPickerY 0})
		       Cmd.none]
	    {:kind :workspace-navigate-dir :path path}
	      (if (shareWorkspacePath? state.pathname)
	          (match state.shareToken
	            nil [state Cmd.none]
	            (some token)
	              (let [href (shareWorkspaceHrefForState state token path)
	                    next (merge (routeMerge state href)
	                                {:shareFilesPending true
	                                 :shareFilesError nil
	                                 :shareFiles []
	                                 :viewModeTouched false})]
	                (withPushBrowserHref href (closeContextMenu next) (fetchShareFilesCommand token path))))
		          (let [href (workspaceHrefForState state path)
		                next (merge (routeMerge state href)
		                            {:filesPending true
		                             :filesError nil
		                             :files []
		                             :viewMode (viewModeFromViewModes state.viewModes path)
		                             :viewModeTouched false})]
	                  (withPushBrowserHref href (closeContextMenu next) (fetchFilesCommand path))))
	    {:kind :workspace-open-file :file file}
	      (let [activeId state.workspace.activeWindowId]
	        (if (string? activeId)
	          [(setWorkspaceState state
	                              (openWorkspaceFileForWindowState state
	                                                               state.workspace
	                                                               activeId
	                                                               file
	                                                               state.workspaceFileOpenTarget))
	           Cmd.none]
	          [state Cmd.none]))
	    {:kind :workspace-navigate-dir-for-window :windowId windowId :path path}
	      (let [nextWorkspace (updateWorkspaceBrowserWindowState state.workspace windowId path)]
	        (if (shareWorkspacePath? state.pathname)
	            (match state.shareToken
	              nil [(setWorkspaceState state nextWorkspace) Cmd.none]
	              (some token)
	                (let [href (shareWorkspaceHrefForState state token path)
	                      next (setWorkspaceState
	                            (merge (routeMerge state href)
	                                   {:shareFilesPending true
	                                    :shareFilesError nil
	                                    :shareFiles []
	                                    :viewModeTouched false})
	                            nextWorkspace)]
	                  (withPushBrowserHref href (closeContextMenu next) (fetchShareFilesCommand token path))))
		            (let [href (workspaceHrefForState state path)
		                  next (setWorkspaceState
		                        (merge (routeMerge state href)
		                               {:filesPending true
		                                :filesError nil
		                                :files []
		                                :viewMode (viewModeFromViewModes state.viewModes path)
		                                :viewModeTouched false})
		                        nextWorkspace)]
              (withPushBrowserHref href (closeContextMenu next) (fetchFilesCommand path)))))
	    {:kind :workspace-admin-text-loaded :value response}
	      (if response.ok
	          (let [body (if (string? response.body) response.body "")]
	            [(merge state {:adminTextContent body
	                           :adminTextDraft body
	                           :adminTextPending false
	                           :adminTextError nil})
	             Cmd.none])
	          [(merge state {:adminTextPending false
	                         :adminTextError (responseErrorMessage response.status)})
	           Cmd.none])
	    {:kind :workspace-admin-text-failed :error error}
	      [(merge state {:adminTextPending false :adminTextError error}) Cmd.none]
	    {:kind :workspace-open-file-for-window :windowId windowId :file file}
	      (if file.isDirectory
	          (let [path (if (shareWorkspacePath? state.pathname)
	                       (shareRelativePath state file.path)
	                       file.path)
	                nextWorkspace (updateWorkspaceBrowserWindowState state.workspace windowId path)]
	            (if (shareWorkspacePath? state.pathname)
	                (match state.shareToken
	                  nil [(setWorkspaceState state nextWorkspace) Cmd.none]
	                  (some token)
	                    (let [href (shareWorkspaceHrefForState state token path)
	                          next (setWorkspaceState
	                                (merge (routeMerge state href)
	                                       {:shareFilesPending true
	                                        :shareFilesError nil
	                                        :shareFiles []
	                                        :viewModeTouched false})
	                                nextWorkspace)]
	                      (withPushBrowserHref href (closeContextMenu next) (fetchShareFilesCommand token path))))
		                (let [href (workspaceHrefForState state path)
		                      next (setWorkspaceState
		                            (merge (routeMerge state href)
		                                   {:filesPending true
		                                    :filesError nil
		                                    :files []
		                                    :viewMode (viewModeFromViewModes state.viewModes path)
		                                    :viewModeTouched false})
		                            nextWorkspace)]
	                  (withPushBrowserHref href (closeContextMenu next) (fetchFilesCommand path)))))
	          (if (= file.type MediaType.AUDIO)
	              (let [next (merge state {:workspaceAudioPath file.path
	                                       :workspaceAudioName file.name
	                                       :workspaceAudioDir (workspaceWindowFileDir file state.currentDir)
	                                       :workspaceAudioOpen false
	                                       :workspaceAudioRepeat state.workspaceAudioRepeat
	                                       :workspaceAudioDuration 2
	                                       :workspaceAudioVideoWindowId ""
	                                       :workspaceAudioVideoHidden false})]
	                [next (workspaceAudioStartCommands next true)])
	          (let [nextWorkspace (openWorkspaceFileForWindowState state
	                                                               state.workspace
	                                                               windowId
	                                                               file
	                                                               state.workspaceFileOpenTarget)
	                base (setWorkspaceState state nextWorkspace)]
	            (if (shareWorkspacePath? state.pathname)
	                (match state.shareToken
	                  nil [base Cmd.none]
	                  (some token)
	                    (let [relative (shareRelativePath state file.path)]
	                      (if (= file.type MediaType.TEXT)
	                          [(merge base {:shareTextPath relative
	                                        :shareTextContent ""
	                                        :shareTextPending true
	                                        :shareTextError nil
	                                        :shareTextSaving false})
	                           (fetchShareTextCommand (buildShareMediaUrl token state.sharePath file.path))]
	                          [base (shareViewCommand token relative)])))
	                (if (= file.type MediaType.TEXT)
	                    [(merge base {:adminTextPath file.path
	                                  :adminTextContent ""
	                                  :adminTextDraft ""
	                                  :adminTextPending true
	                                  :adminTextError nil
	                                  :adminTextSaving false
	                                  :pendingViewPath file.path
	                                  :adminTextReadOnly (not (and (not (isVirtualFolderPath file.path))
	                                                               (isPathEditable file.path state.editableFolders state.mediaRoots)))
	                                  :adminImageZoom 0
	                                  :adminImageRotation 0})
	                     (Cmd.batch [(viewCountCommand file.path)
	                                 (fetchWorkspaceAdminTextCommand file.path)])]
	                    [(merge base {:adminImageZoom (if (= file.type MediaType.IMAGE) 0 state.adminImageZoom)
	                                  :adminImageRotation (if (= file.type MediaType.IMAGE) 0 state.adminImageRotation)
	                                  :pendingViewPath file.path})
                     (viewCountCommand file.path)])))))
		    {:kind :workspace-open-in-new-tab :windowId windowId :file file}
		      (if file.isDirectory
		          (let [path (if (shareWorkspacePath? state.pathname)
		                       (shareRelativePath state file.path)
		                       file.path)
		                nextWorkspace (openWorkspaceFileForWindowState state
		                                                               state.workspace
		                                                               windowId
		                                                               file
		                                                               "new-tab")]
		            (if (shareWorkspacePath? state.pathname)
		                (match state.shareToken
		                  nil [(setWorkspaceState (closeContextMenu state) nextWorkspace) Cmd.none]
		                  (some token)
		                    (let [href (shareWorkspaceHrefForState state token path)
		                          next (setWorkspaceState
		                                (merge (routeMerge (closeContextMenu state) href)
		                                       {:shareFilesPending true
		                                        :shareFilesError nil
		                                        :shareFiles []
		                                        :viewModeTouched false})
		                                nextWorkspace)]
		                      (withPushBrowserHref href next (fetchShareFilesCommand token path))))
			                (let [href (workspaceHrefForState state path)
			                      next (setWorkspaceState
			                            (merge (routeMerge (closeContextMenu state) href)
			                                   {:filesPending true
			                                    :filesError nil
			                                    :files []
			                                    :viewMode (viewModeFromViewModes state.viewModes path)
			                                    :viewModeTouched false})
			                            nextWorkspace)]
		                  (withPushBrowserHref href next (fetchFilesCommand path)))))
		          [(closeContextMenu
		            (merge (setWorkspaceState state
		                                      (openWorkspaceFileForWindowState state
		                                                                       state.workspace
		                                                                       windowId
		                                                                       file
		                                                                       "new-tab"))
		                   (if (= file.type MediaType.TEXT)
		                       {:adminTextPath file.path
		                        :adminTextContent ""
		                        :adminTextDraft ""
		                        :adminTextPending true
		                        :adminTextError nil
		                        :adminTextSaving false
		                        :adminTextReadOnly (not (and (not (isVirtualFolderPath file.path))
		                                                     (isPathEditable file.path state.editableFolders state.mediaRoots)))}
		                       {})))
		           (if (= file.type MediaType.TEXT) (fetchWorkspaceAdminTextCommand file.path) Cmd.none)])
		    {:kind :workspace-drop-file-tab :windowId windowId :path path :isDirectory isDirectory :insertIndex insertIndex}
		      (let [file (workspaceFileItemFromDrag path isDirectory)]
		        [(setWorkspaceState state
		                            (openInNewTabInGroupState state.workspace
		                                                       windowId
		                                                       file
		                                                       (workspaceParentDir path)
		                                                       insertIndex
		                                                       (workspaceSourceForState state)))
		         Cmd.none])
		    {:kind :workspace-open-in-split-view :windowId windowId :file file}
		      [(closeContextMenu
		        (merge (setWorkspaceState state
		                                  (openWorkspaceFileForWindowState state
		                                                                   state.workspace
		                                                                   windowId
		                                                                   file
		                                                                   "split-view"))
		               (if (= file.type MediaType.TEXT)
		                   {:adminTextPath file.path
		                    :adminTextContent ""
		                    :adminTextDraft ""
		                    :adminTextPending true
		                    :adminTextError nil
		                    :adminTextSaving false
		                    :adminTextReadOnly (not (and (not (isVirtualFolderPath file.path))
		                                                 (isPathEditable file.path state.editableFolders state.mediaRoots)))}
		                   {})))
		       (if (= file.type MediaType.TEXT) (fetchWorkspaceAdminTextCommand file.path) Cmd.none)]
		    {:kind :workspace-add-taskbar :file file}
		      (let [nextWorkspace (addWorkspaceTaskbarPinState state file)
		            nextState (closeContextMenu (setWorkspaceState state nextWorkspace))]
		        [nextState (workspaceTaskbarPinsCommand state.shareToken nextWorkspace.pinnedTaskbarItems)])
		    {:kind :workspace-pin-context-menu :id id :x x :y y}
		      [(merge (closeContextMenu state)
		              {:menuOpen true
		               :menuKind "workspace-pin"
		               :menuPath id
		               :menuFile nil
		               :menuIsDirectory false
		               :menuX x
		               :menuY y})
		       Cmd.none]
		    {:kind :workspace-remove-taskbar-pin :id id}
		      (let [nextWorkspace (removeWorkspaceTaskbarPinState state id)
		            nextState (closeContextMenu (setWorkspaceState state nextWorkspace))]
		        [nextState (workspaceTaskbarPinsCommand state.shareToken nextWorkspace.pinnedTaskbarItems)])
		    {:kind :workspace-open-taskbar-pin :path path :isDirectory isDirectory :title title}
		      (let [file (if isDirectory
		                   {:name title
		                    :path path
		                    :type MediaType.FOLDER
		                    :size 0
		                    :extension ""
		                    :isDirectory true
		                    :isVirtual nil
		                    :viewCount nil
		                    :shareToken nil
		                    :thumbnailGenerated nil}
		                   (workspaceFileItemFromPath path))]
		        (if isDirectory
		            (let [nextWorkspace (openWorkspaceBrowserState state state.workspace path)
		                  nextState (setWorkspaceState state nextWorkspace)]
		              (if (shareWorkspacePath? state.pathname)
		                  (match state.shareToken
		                    nil [nextState Cmd.none]
		                    (some token) [nextState (fetchShareFilesCommand token (shareRelativePath state path))])
		                  [nextState (fetchFilesCommand path)]))
		            (let [nextWorkspace (openWorkspaceFileInNewWindowState state state.workspace file)
		                  base (setWorkspaceState state nextWorkspace)]
		              (if (= file.type MediaType.TEXT)
		                  [(merge base {:adminTextPath file.path
		                                :adminTextContent ""
		                                :adminTextDraft ""
		                                :adminTextPending true
		                                :adminTextError nil
		                                :adminTextSaving false
		                                :adminTextReadOnly (not (and (not (isVirtualFolderPath file.path))
		                                                             (isPathEditable file.path state.editableFolders state.mediaRoots)))})
		                   (fetchWorkspaceAdminTextCommand file.path)]
		                  [base Cmd.none]))))
	    {:kind :share-audio-only :enabled enabled :currentTime currentTime}
	      (match state.shareToken
	        nil [state Cmd.none]
	        (some token)
	          (let [href (shareMediaHref token state.currentDir state.viewingPath state.playingPath enabled)]
	            (withPushBrowserHref href
	                                 (routeMerge state href)
	                                 (if (and (not enabled) (> currentTime 0))
	                                     (restoreMediaCurrentTimeCommand "video" currentTime)
	                                     Cmd.none))))
	    {:kind :share-image-zoom-in}
	      [(merge state {:shareImageZoom (if (= state.shareImageZoom 0) 125 (+ state.shareImageZoom 25))})
	       Cmd.none]
	    {:kind :share-image-zoom-out}
	      [(merge state {:shareImageZoom (if (<= state.shareImageZoom 125) 0 (- state.shareImageZoom 25))})
	       Cmd.none]
	    {:kind :share-image-fit}
	      [(merge state {:shareImageZoom 0 :shareImageRotation 0}) Cmd.none]
	    {:kind :share-image-rotate}
	      [(merge state {:shareImageRotation (mod (+ state.shareImageRotation 90) 360)})
	       Cmd.none]
	    {:kind :share-image-next}
	      (match state.shareToken
	        nil [state Cmd.none]
	        (some token)
	          (match (nextShareImagePathByStepForUpdate state 1)
	            nil [state Cmd.none]
	            (some path)
	              (let [href (shareMediaHref token state.currentDir path nil false)]
	                (withPushBrowserHref href (merge (routeMerge state href)
	                         {:shareImageZoom 0
	                          :shareImageRotation 0}) Cmd.none))))
	    {:kind :share-image-previous}
	      (match state.shareToken
	        nil [state Cmd.none]
	        (some token)
	          (match (nextShareImagePathByStepForUpdate state -1)
	            nil [state Cmd.none]
	            (some path)
	              (let [href (shareMediaHref token state.currentDir path nil false)]
	                (withPushBrowserHref href (merge (routeMerge state href)
	                         {:shareImageZoom 0
	                          :shareImageRotation 0}) Cmd.none))))
	    _ [state Cmd.none]))))

(ann update (Fn [AppState AppMsg] UpdateResult))
(defn update [state msg]
  (match (updatePure state msg)
    [nextState cmd]
      [nextState (withAppEffectCommands cmd state nextState)]))

(ann pathParts (Fn [String] (Vector String)))
(defn pathParts [path]
  (let [safePath (if (string? path) path "")]
    (filter (split safePath "/") (fn [part] (not (= part ""))))))

(ann parentDir (Fn [String] String))
(defn parentDir [path]
  (let [parts (pathParts path)]
    (if (<= (count parts) 1)
        ""
        (join (slice parts 0 (- (count parts) 1)) "/"))))

(ann crumbPathAt (Fn [String Number] String))
(defn crumbPathAt [path index]
  (join (slice (pathParts path) 0 (+ index 1)) "/"))

(ann selectedViewingName (Fn [AppState] String))
(defn selectedViewingName [state]
  (match state.viewingPath
    nil ""
    (some value)
      (let [parts (pathParts value)]
        (if (= (count parts) 0) value (nth parts (- (count parts) 1))))))

(ann emptyFileItem (Fn [] FileItem))
(defn emptyFileItem []
  {:name ""
   :path ""
   :type MediaType.OTHER
   :size 0
   :extension ""
   :isDirectory false
   :isVirtual nil
   :viewCount nil
   :shareToken nil
   :thumbnailGenerated nil})

(ann menuFileOrEmpty (Fn [AppState] FileItem))
(defn menuFileOrEmpty [state]
  (match state.menuFile
    nil (emptyFileItem)
    (some file) file))

(ann fileNameFromPath (Fn [String] String))
(defn fileNameFromPath [path]
  (let [parts (pathParts path)
        name (last parts)]
    (if (some? name) name path)))

(ann fileDragStartMessage (Fn [String Js] AppMsg))
(defn fileDragStartMessage [path event]
  (let [transfer event.dataTransfer]
    (do
      (boxSet currentDragPathBox path)
      (if (some? transfer)
          (do
            (transfer.setData "text/plain" path)
            (transfer.setData "application/x-closkell-file-path" path)
            nil)
          nil)
      {:kind :drag-start :path path})))

(ann workspaceFileDragPayload (Fn [AppState FileItem] Js))
(defn workspaceFileDragPayload [state file]
  {:path file.path
   :isDirectory file.isDirectory
   :sourceKind (if (shareWorkspacePath? state.pathname) "share" "local")
   :sourceToken state.shareToken})

(ann workspaceFileDragStartMessage (Fn [AppState FileItem Js] AppMsg))
(defn workspaceFileDragStartMessage [state file event]
  (let [transfer event.dataTransfer]
    (do
      (boxSet currentDragPathBox file.path)
      (if (some? transfer)
          (do
            (transfer.setData workspaceFileDragMime (json-stringify (workspaceFileDragPayload state file)))
            (transfer.setData "text/plain" file.path)
            (transfer.setData "application/x-closkell-file-path" file.path)
            nil)
          nil)
      {:kind :drag-start :path file.path})))

(ann parseWorkspaceFileDragPayload (Fn [String] (Option WorkspaceFileDragPayload)))
(defn parseWorkspaceFileDragPayload [raw]
  (let [result (json-parse-result raw)
        parsed (unwrap-or result nil)]
    (if (and (ok? result)
             (object? parsed)
             (string? (get parsed :path))
             (bool? (get parsed :isDirectory)))
        (unsafe-cast WorkspaceFileDragPayload parsed)
        nil)))

(ann workspaceTabDropMessage (Fn [String Number Js] AppMsg))
(defn workspaceTabDropMessage [windowId insertIndex event]
  (let [transfer event.dataTransfer
        raw (if (some? transfer) (transfer.getData workspaceFileDragMime) "")
        parsed (if (and (string? raw) (not (= raw ""))) (parseWorkspaceFileDragPayload raw) nil)]
    (unsafe-cast Js
                 (match parsed
                   nil {:kind :noop}
                   (some data)
                     {:kind :workspace-drop-file-tab
                      :windowId windowId
                      :path data.path
                      :isDirectory data.isDirectory
                      :insertIndex insertIndex}))))

(ann dropSourcePath (Fn [Js] String))
(defn dropSourcePath [event]
  (let [transfer event.dataTransfer]
    (if (some? transfer)
        (let [custom (transfer.getData "application/x-closkell-file-path")]
          (if (= custom "") (transfer.getData "text/plain") custom))
        "")))

(ann dropSourcePathForState (Fn [AppState Js] String))
(defn dropSourcePathForState [state event]
  (let [fromEvent (dropSourcePath event)]
    (if (not (= fromEvent ""))
        fromEvent
        (let [fromState (match state.draggedPath nil "" (some path) path)]
          (if (not (= fromState ""))
              fromState
              (let [boxed (boxGet currentDragPathBox)]
                (if (string? boxed) boxed "")))))))

(ann selectedShareFileOrEmpty (Fn [AppState] FileItem))
(defn selectedShareFileOrEmpty [state]
  (let [viewing (selectedShareViewingFile state)]
    (match viewing
      (some file) file
      nil (match (selectedSharePlayingFile state)
            nil (emptyFileItem)
            (some file) file))))

(ann menuShareFileOrEmpty (Fn [AppState] FileItem))
(defn menuShareFileOrEmpty [state]
  (let [file (find state.shareFiles (fn [item] (= item.path state.menuPath)))]
    (if (some? file) file (emptyFileItem))))

(ann shareImageFiles (Fn [AppState] (Vector FileItem)))
(defn shareImageFiles [state]
  (filter state.shareFiles (fn [file] (= file.type MediaType.IMAGE))))

(ann shareImageIndex (Fn [AppState (Vector FileItem) String] Number))
(defn shareImageIndex [state images path]
  (let [hit (find (map (range 0 (count images))
                       (fn [index] {:index index :file (nth images index)}))
                  (fn [entry] (shareFileMatchesPath? state entry.file path)))]
    (if (some? hit) hit.index -1)))

(ann nextShareImagePath (Fn [AppState] (Option String)))
(defn nextShareImagePath [state]
  (match state.viewingPath
    nil nil
    (some path)
      (let [images (shareImageFiles state)
            total (count images)]
        (if (= total 0)
            nil
	            (let [index (shareImageIndex state images path)
	                  nextIndex (if (< index 0) 0 (mod (+ index 1) total))
	                  file (nth images nextIndex)]
	              (shareRelativePath state file.path))))))

