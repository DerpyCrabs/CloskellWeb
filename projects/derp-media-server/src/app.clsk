   :key key
   :value value})

(ann storageStringOrDefault (Fn [Js] String))
(defn storageStringOrDefault [value]
  (if (string? value) value ""))

(ann startupPreferencesCommand (Fn [] (Cmd AppMsg)))
(defn startupPreferencesCommand []
  (Cmd.batch [(Cmd.storage/get "workspace-view-mode"
                                :text
                                (fn [value] {:kind :startup-view-mode-loaded
                                             :value (storageStringOrDefault value)})
                                :startup-preferences-load-failed)
              (Cmd.storage/get "workspace-snap-assist"
                                :text
                                (fn [value] {:kind :startup-snap-assist-loaded
                                             :value (storageStringOrDefault value)})
                                :startup-preferences-load-failed)
	              (Cmd.storage/get "workspace-preferred-snap"
	                                :text
	                                (fn [value] {:kind :startup-preferred-snap-loaded
	                                             :value (storageStringOrDefault value)})
	                                :startup-preferences-load-failed)
	              (Cmd.storage/get "theme-mode"
	                                :text
	                                (fn [value] {:kind :startup-theme-mode-loaded
	                                             :value (storageStringOrDefault value)})
	                                :startup-preferences-load-failed)
	              (Cmd.storage/get "theme-palette"
	                                :text
	                                (fn [value] {:kind :startup-theme-palette-loaded
	                                             :value (storageStringOrDefault value)})
	                                :startup-preferences-load-failed)]))

(ann workspaceSessionForState (Fn [AppState] (Option String)))
(defn workspaceSessionForState [state]
  (workspaceSessionFromSearch state.search))

(ann workspaceStorageKeyForState (Fn [AppState] String))
(defn workspaceStorageKeyForState [state]
  (let [base (workspaceStorageBaseKey state.shareToken)]
    (match (workspaceSessionForState state)
      nil base
      (some session) (workspaceStorageSessionKey base session))))

(ann loadWorkspaceStorageCommand (Fn [AppState] (Cmd AppMsg)))
(defn loadWorkspaceStorageCommand [state]
  (if (workspaceRoute? state)
      (let [key (workspaceStorageKeyForState state)]
        (Cmd.storage/get key
                         :text
                         (fn [value] {:kind :workspace-storage-loaded
                                      :key key
                                      :value (storageStringOrDefault value)})
	                         :workspace-storage-load-failed))
      Cmd.none))

(ann stateWithMediaAudioMetadataKey (Fn [AppState] AppState))
(defn stateWithMediaAudioMetadataKey [state]
  (match state.playingPath
    nil (merge state {:mediaAudioMetadataKey ""
                      :mediaAudioDuration 0
                      :mediaAudioTitle nil
                      :mediaAudioArtist nil
                      :mediaAudioCoverArt nil})
    (some path)
      (let [key (mediaAudioMetadataKeyForPath state path)]
        (if (= state.mediaAudioMetadataKey key)
	            state
	            (merge state {:mediaAudioMetadataKey key
	                          :mediaAudioDuration 0
	                          :mediaAudioTitle nil
	                          :mediaAudioArtist nil
	                          :mediaAudioCoverArt nil})))))

(ann mediaAudioMetadataCommandForState (Fn [AppState] (Cmd AppMsg)))
(defn mediaAudioMetadataCommandForState [state]
  (match state.playingPath
    nil Cmd.none
    (some path)
      (if (= state.mediaAudioMetadataKey "")
          Cmd.none
          (fetchMediaAudioMetadataCommand state.mediaAudioMetadataKey
                                          (mediaAudioMetadataUrlForPath state path)))))

(ann normalizedThemeMode (Fn [String] String))
(defn normalizedThemeMode [mode]
  (if (or (= mode "light") (= mode "dark") (= mode "system"))
      mode
      "dark"))

(ann normalizedThemePalette (Fn [String] String))
(defn normalizedThemePalette [palette]
  (if (or (= palette "default") (= palette "caffeine") (= palette "cosmic-night"))
      palette
      "default"))

(ann themeDocumentValue (Fn [String String] String))
(defn themeDocumentValue [palette mode]
  (let [resolvedPalette (normalizedThemePalette palette)
        resolvedMode (normalizedThemeMode mode)]
    (str resolvedPalette "-" (if (= resolvedMode "light") "light" "dark"))))

(ann documentThemeCommand (Fn [String String] (Cmd AppMsg)))
(defn documentThemeCommand [palette mode]
  {:kind :dom/document-set-attribute
   :name "data-theme"
   :value (themeDocumentValue palette mode)})

(ann documentTitlePartFromPath (Fn [String String] String))
(defn documentTitlePartFromPath [path fallback]
  (let [safePath (if (string? path) path "")
        parts (filter (split safePath "/") (fn [part] (not (= part ""))))
        name (last parts)]
    (if (some? name) name fallback)))

(ann workspaceDocumentTitle (Fn [WorkspaceState] String))
(defn workspaceDocumentTitle [workspace]
  (match workspace.browserTabTitle
    nil "Workspace · Media Server"
    (some value)
      (let [title (trim value)]
        (if (= title "")
            "Workspace · Media Server"
            (str title " · Media Server")))))

(ann appDocumentTitle (Fn [AppState] String))
(defn appDocumentTitle [state]
  (if (workspaceRoute? state)
      (workspaceDocumentTitle state.workspace)
      (if (shareRoute? state)
          (str (documentTitlePartFromPath state.currentDir
                                          (if (= (trim state.shareName) "") "Shared media" state.shareName))
               " - Media Server")
          (if (= state.pathname "/login")
              "Media Server"
              (str (documentTitlePartFromPath state.currentDir "Home") " - Media Server")))))

(ann documentTitleForStateCommand (Fn [AppState] (Cmd AppMsg)))
(defn documentTitleForStateCommand [state]
  (documentTitleCommand (appDocumentTitle state)))

(ann breadcrumbAdaptiveCommand (Fn [] (Cmd AppMsg)))
(defn breadcrumbAdaptiveCommand []
  {:kind :dom/breadcrumb-adaptive})

(ann focusSelectorCommand (Fn [String Bool Bool] (Cmd AppMsg)))
(defn focusSelectorCommand [selector defer whenBody]
  {:kind :dom/focus-selector
   :selector selector
   :defer defer
   :whenBody whenBody})

(ann withCommand (Fn [(Cmd AppMsg) AppState (Cmd AppMsg)] UpdateResult))
(defn withCommand [extra nextState cmd]
  [nextState (Cmd.batch [extra cmd])])

(ann withPushBrowserHref (Fn [String AppState (Cmd AppMsg)] UpdateResult))
(defn withPushBrowserHref [href nextState cmd]
  (withCommand (pushBrowserHref href) nextState cmd))

(ann withReplaceBrowserHref (Fn [String AppState (Cmd AppMsg)] UpdateResult))
(defn withReplaceBrowserHref [href nextState cmd]
  (withCommand (replaceBrowserHref href) nextState cmd))

(ann withScrollTopAndPushBrowserHref (Fn [String AppState (Cmd AppMsg)] UpdateResult))
(defn withScrollTopAndPushBrowserHref [href nextState cmd]
  [nextState (Cmd.batch [(scrollToTopCommand) (pushBrowserHref href) cmd])])

(ann loadRouteCommand (Fn [AppState] (Cmd AppMsg)))
(defn loadRouteCommand [state]
  (if (shareWorkspacePath? state.pathname)
      (Cmd.batch [(closeAdminSseCommand)
                  (match state.shareToken
                    nil Cmd.none
                    (some token) (fetchShareInfoCommand token))])
      (match state.shareToken
        (some token)
          (Cmd.batch [(closeAdminSseCommand)
                      (fetchShareInfoCommand token)])
	        nil (if (or (browserRoute? state) (= state.pathname "/workspace"))
	                (if (publicBrowserShellRoute? state)
	                    Cmd.none
	                    (Cmd.batch [(closeShareSseCommand)
	                                (fetchAuthCommand)
	                                (fetchSettingsCommand)
	                                (fetchViewStatsCommand)
	                                (fetchSharesCommand)
	                                (fetchFilesCommand state.currentDir)
	                                (mediaAudioMetadataCommandForState state)]))
	                Cmd.none))))

(ann init (Fn [BrowserBoot] [AppState (Cmd AppMsg)]))
(defn init [boot]
  (let [href (hrefWithWorkspaceSession boot.currentUrl)
        state (stateFromUrl href)
	        next0 (if (shareWorkspacePath? state.pathname)
		                 (markShareLoading state)
	                 (if (shareRoute? state)
		                 (markShareLoading state)
		                 (if (and (or (browserRoute? state) (= state.pathname "/workspace"))
	                              (not (publicBrowserShellRoute? state)))
		                     (markBrowserLoading state)
		                     state)))
	        next (stateWithMediaAudioMetadataKey next0)]
    [next (if (not (= href boot.currentUrl))
              (Cmd.batch [(startupPreferencesCommand)
	                          (breadcrumbAdaptiveCommand)
	                          (loadWorkspaceStorageCommand next)
	                          (documentTitleForStateCommand next)
	                          (if (browserRoute? next)
	                              (focusSelectorCommand "[data-testid='file-browser']" true true)
	                              Cmd.none)
	                          (replaceBrowserHref href)
	                          (loadRouteCommand next)])
	              (Cmd.batch [(startupPreferencesCommand)
	                          (breadcrumbAdaptiveCommand)
	                          (loadWorkspaceStorageCommand next)
	                          (documentTitleForStateCommand next)
	                          (if (browserRoute? next)
	                              (focusSelectorCommand "[data-testid='file-browser']" true true)
	                              Cmd.none)
	                          (loadRouteCommand next)]))]))

