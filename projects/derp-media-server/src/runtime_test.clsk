  (test "computes live snap preview bounds"
    (let [canvas {:width 1200 :height 800}
          windows [{:id "left"
                    :type "browser"
                    :tabGroupId nil
                    :layout {:bounds {:x 0 :y 0 :width 500 :height 400}
                             :snapZone "top-left-third"
