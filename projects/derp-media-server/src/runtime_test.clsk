  (test "resolves workspace bootstrap hydration decisions"
    (let [source {:kind "local" :rootPath nil :token nil :sharePath nil}
          bounds {:x 24 :y 24 :width 420 :height 360}
          preset-snapshot {:windows [{:id "preset-win"
                                      :type "browser"
                                      :source source
                                      :initialState {:dir "/preset"}
                                      :layout {:bounds bounds}}]
                           :activeWindowId "preset-win"
                           :activeTabMap (hash-map)
                           :nextWindowId 2
                           :pinnedTaskbarItems []
                           :tabGroupSplits (hash-map)
                           :browserTabTitle nil
                           :browserTabIcon nil
                           :browserTabIconColor nil
                           :fileOpenTarget nil}
          presets [{:id "p1" :scope "admin" :snapshot preset-snapshot}]
          dir-out (resolveWorkspaceInitialHydrationWithBounds
                    {:dirParam "Favorites/Sub"
                     :presetParam "p1"
                     :loaded nil
                     :presetsReadyNow true
                     :presetsList presets
                     :layoutScope "admin"
                     :source source}
                    bounds)
          loaded-out (resolveWorkspaceInitialHydrationWithBounds
                       {:dirParam nil
                        :presetParam "p1"
                        :loaded preset-snapshot
                        :presetsReadyNow true
                        :presetsList presets
                        :layoutScope "admin"
                        :source source}
                       bounds)
          preset-out (resolveWorkspaceInitialHydrationWithBounds
                       {:dirParam nil
                        :presetParam "p1"
                        :loaded nil
                        :presetsReadyNow true
                        :presetsList presets
                        :layoutScope "admin"
                        :source source}
                       bounds)
          missing-out (resolveWorkspaceInitialHydrationWithBounds
                        {:dirParam nil
                         :presetParam "missing"
                         :loaded nil
                         :presetsReadyNow true
                         :presetsList presets
                         :layoutScope "admin"
                         :source source}
                        bounds)
          deferred-out (resolveWorkspaceInitialHydrationWithBounds
                         {:dirParam nil
                          :presetParam "p1"
                          :loaded nil
                          :presetsReadyNow false
                          :presetsList []
                          :layoutScope "admin"
                          :source source}
                         bounds)
          deferred-apply (resolveWorkspaceDeferredPresetApply
                           {:presetParam "p1"
                            :presetsReadyNow true
                            :hasPersistedDraft false
                            :presetsList presets
                            :layoutScope "admin"})
          default-state (defaultPersistedStateWithBounds source bounds)]
      (expect= (workspaceDirParamTitle "Favorites/Sub") "Sub")
      (expect= (workspaceDirParamTitle "///") "Browser 1")
      (expect= (buildWorkspaceFromDirParamWithBounds "Favorites" source bounds)
               {:windows [{:id "workspace-window-1"
                           :type "browser"
                           :title "Favorites"
                           :iconName nil
                           :iconPath "Favorites"
                           :iconType "folder"
                           :iconIsVirtual true
                           :source source
                           :initialState {:dir "Favorites"}
                           :tabGroupId nil
                           :layout {:bounds bounds
                                    :fullscreen false
                                    :snapZone nil
                                    :minimized false
                                    :zIndex 1
                                    :restoreBounds nil}}]
                :activeWindowId "workspace-window-1"
                :activeTabMap (hash-map)
                :nextWindowId 2
                :pinnedTaskbarItems []
                :tabGroupSplits (hash-map)
                :browserTabTitle nil
                :browserTabIcon nil
                :browserTabIconColor nil
                :fileOpenTarget nil})
      (expect= (get dir-out :kind) "set-workspace")
      (expect= (get dir-out :stripPresetFromUrl) true)
      (expect= (get (nth (get (get dir-out :workspace) :windows) 0) :iconIsVirtual) true)
      (expect= (get (nth (get (get loaded-out :workspace) :windows) 0) :id) "preset-win")
      (expect= (get loaded-out :baselinePresetId) nil)
      (expect= (get (nth (get (get preset-out :workspace) :windows) 0) :id) "preset-win")
      (expect= (get preset-out :baselinePresetId) "p1")
      (expect= (get (nth (get (get preset-out :baselineSnapshot) :windows) 0) :id) "preset-win")
      (expect= (get (nth (get (get missing-out :workspace) :windows) 0) :id) "workspace-window-1")
      (expect= (get missing-out :stripPresetFromUrl) true)
      (expect= deferred-out {:kind "defer-preset"})
      (expect= (get deferred-apply :kind) "apply")
      (expect= (get deferred-apply :baselinePresetId) "p1")
      (expect= (resolveWorkspaceDeferredPresetApply
                 {:presetParam "bad"
                  :presetsReadyNow true
                  :hasPersistedDraft false
                  :presetsList presets
                  :layoutScope "admin"})
               {:kind "noop" :stripPresetFromUrl true})
      (expect= (get (nth (get default-state :windows) 0) :title) "Browser 1")
      (expect= (get (get (nth (get default-state :windows) 0) :layout) :bounds) bounds)))

  (test "handles tab group ordering split visibility and pinned insert bounds"
    (let [tabs [{:id "left"
                 :type "browser"
                 :tabGroupId "g1"
                 :layout {:minimized false}
                 :tabPinned true}
                {:id "viewer"
                 :type "viewer"
                 :tabGroupId "g1"
                 :layout {:minimized false}
                 :tabPinned true}
                {:id "chat"
                 :type "chat"
                 :tabGroupId "g1"
                 :layout {:minimized false}
                 :tabPinned false}
                {:id "hidden"
                 :type "browser"
                 :tabGroupId "g2"
                 :layout {:minimized true}
                 :tabPinned nil}
                {:id "solo"
                 :type "viewer"
                 :tabGroupId nil
                 :layout {:minimized false}
                 :tabPinned nil}]
          splits (unsafe-cast TestTabGroupSplits {"g1" {:leftTabId "left" :leftPaneFraction 0.5}})
          activeMap (unsafe-cast TestActiveTabMap {"g1" "left"})]
      (expect= (groupIdForWindow (nth tabs 4)) "solo")
      (expect= (orderedVisibleGroupIds tabs) ["g1" "solo"])
      (expect= (orderedAllGroupIds tabs) ["g1" "g2" "solo"])
      (expect= (map (tabsInGroup tabs "g1") (fn [tab] tab.id)) ["left" "viewer" "chat"])
      (expect= (visibleTabIdAfterPlayerRemoved tabs "g1" splits) "viewer")
      (expect= (resolveGroupVisibleTabId {:windows tabs
                                          :activeTabMap activeMap
                                          :tabGroupSplits splits}
                                        "g1")
               "viewer")
      (expect= (insertIndexAfterAllRightTabs (tabsInGroup tabs "g1") "left") 3)
      (expect= (rightStripIndexToGroupInsertIndex (tabsInGroup tabs "g1") "left" 1) 2)
      (expect= (mergeInsertIndexToRightStripSlot (tabsInGroup tabs "g1") "left" 3) 2)
      (expect= (pinnedCountInGroup tabs "g1") 2)
      (expect= (leadingPinnedTabCount (tabsInGroup tabs "g1")) 2)
      (expect= (clampTabInsertIndex tabs "g1" 0) 2)
      (expect= (mergeTargetGroupSignature [(nth tabs 0) (nth tabs 4)])
               (str "left"
                    tabGroupSignatureSeparator
                    "g1"
                    tabGroupSignatureSeparator
                    "solo"
                    tabGroupSignatureSeparator
                    "solo"
                    tabGroupSignatureSeparator))))

  (test "maps workspace tab icon color keys"
    (expect= (count workspaceTabIconSwatches) 21)
    (expect= (isWorkspaceTabIconColorKey "blue-500") true)
    (expect= (isWorkspaceTabIconColorKey "not-a-color") false)
    (expect= (workspaceTabIconColorKeyToHex "rose-500") "#f43f5e")
    (expect= (workspaceTabIconColorKeyToHex "not-a-color") nil))

  (test "parses and filters taskbar pins for admin and share scopes"
    (let [pins (parseWorkspaceTaskbarPins [local-pin
                                           unsafe-local-pin
                                           share-root-pin
                                           share-child-pin
                                           {:id "missing-fields"}
                                           {:id "bad-share"
                                            :path "SharedContent/Other"
                                            :isDirectory true
                                            :title "Other"
                                            :source {:kind "share"}}])
          admin (filterAdminWorkspaceTaskbarPins pins)
          share (filterShareWorkspaceTaskbarPins "SharedContent" "tok" pins)]
      (expect= (count pins) 4)
      (expect= (map admin (fn [pin] pin.id)) ["local-docs"])
      (expect= (map share (fn [pin] pin.id)) ["share-root" "share-child"])))

  (test "formats workspace browser and knowledge-base titles"
    (expect= (workspaceBrowserDirTitle "") "Home")
    (expect= (workspaceBrowserDirTitle "Root\\Nested") "Nested")
    (expect= (workspaceBrowserDirTitle "Root/  ") "  ")
    (expect= (workspaceKbRootDisplayName "") "Knowledge base")
    (expect= (workspaceKbRootDisplayName "Root/  ") "Knowledge base")
    (expect= (workspaceKbChatWindowTitle "Notes/Project") "Project Chat"))

  (test "recognizes workspace routes and default browser titles"
    (expect= (isWorkspaceRoute "/workspace") true)
    (expect= (isWorkspaceRoute "/share/tok/workspace") true)
    (expect= (isWorkspaceRoute "/share/tok/workspace/") true)
    (expect= (isWorkspaceRoute "/share/tok") false)
    (expect= (defaultInitialBrowserTitle {:kind "local"
                                          :rootPath nil
                                          :token nil
                                          :sharePath nil})
             "Browser 1")
    (expect= (defaultInitialBrowserTitle {:kind "share"
                                          :rootPath nil
                                          :token "t"
                                          :sharePath "D:\\media\\Work"})
             "Work")
    (expect= (defaultInitialBrowserTitle {:kind "share"
                                          :rootPath nil
                                          :token "t"
                                          :sharePath "/var/media/Work"})
             "Work"))

  (test "builds workspace layout scopes"
    (expect= (workspaceLayoutScopeFromShareToken nil) "admin")
    (expect= (workspaceLayoutScopeFromShareToken "") "admin")
    (expect= (workspaceLayoutScopeFromShareToken "tok") "share:tok"))

  (test "parses and sanitizes workspace layout presets"
    (let [parsed (parseWorkspaceLayoutPresetsListWithNow [{:id "admin-a"
                                                           :name "  First layout  "
                                                           :scope "admin"
                                                           :snapshot admin-layout-snapshot}
                                                          {:id "missing-snapshot"
                                                           :name "Missing"
                                                           :scope "admin"}
                                                          {:id "null-snapshot"
                                                           :name "Null snapshot"
                                                           :scope "admin"
                                                           :snapshot nil
                                                           :createdAt "older"
                                                           :updatedAt "newer"}
                                                          {:id "bad-scope"
                                                           :name "Bad"
                                                           :scope "classic"
                                                           :snapshot admin-layout-snapshot}]
                                                         "now-iso")]
      (expect= (count parsed) 2)
      (expect= (get (nth parsed 0) :name) "First layout")
      (expect= (get (nth parsed 0) :createdAt) "now-iso")
      (expect= (get (nth parsed 0) :updatedAt) nil)
      (expect= (get (nth parsed 1) :snapshot) nil)
      (expect= (get (nth parsed 1) :updatedAt) "newer"))
    (let [admin-presets [{:id "admin-ok"
                          :name "Admin"
                          :scope "admin"
                          :snapshot admin-layout-snapshot
                          :createdAt "a"
                          :updatedAt nil}
                         {:id "admin-bad-path"
                          :name "Bad path"
                          :scope "admin"
                          :snapshot admin-layout-bad-path-snapshot
                          :createdAt "a"
                          :updatedAt nil}
                         {:id "admin-bad-pin"
                          :name "Bad pin"
                          :scope "admin"
                          :snapshot admin-layout-bad-pin-snapshot
                          :createdAt "a"
                          :updatedAt nil}
                         {:id "admin-empty"
                          :name ""
                          :scope "admin"
                          :snapshot admin-layout-snapshot
                          :createdAt "a"
                          :updatedAt nil}
                         {:id "share-in-admin"
                          :name "Share"
                          :scope "share:tok"
                          :snapshot share-layout-snapshot
                          :createdAt "a"
                          :updatedAt nil}]
          share-presets [{:id "share-ok"
                          :name "Share"
                          :scope "share:tok"
                          :snapshot share-layout-snapshot
                          :createdAt "s"
                          :updatedAt nil}
                         {:id "share-outside"
                          :name "Outside"
                          :scope "share:tok"
                          :snapshot share-layout-outside-snapshot
                          :createdAt "s"
                          :updatedAt nil}
                         {:id "share-wrong-token"
                          :name "Wrong token"
                          :scope "share:tok"
                          :snapshot share-layout-wrong-token-snapshot
                          :createdAt "s"
                          :updatedAt nil}
                         {:id "admin-in-share"
                          :name "Admin"
                          :scope "admin"
                          :snapshot admin-layout-snapshot
                          :createdAt "s"
                          :updatedAt nil}]
          capped (sanitizeAdminWorkspaceLayoutPresets
                   (map (range 0 40)
                        (fn [index]
                          {:id (str "preset-" index)
                           :name (str "Preset " index)
                           :scope "admin"
                           :snapshot admin-layout-snapshot
                           :createdAt "a"
                           :updatedAt nil})))]
      (expect= (map (sanitizeAdminWorkspaceLayoutPresets admin-presets) (fn [preset] preset.id))
               ["admin-ok"])
      (expect= (map (sanitizeShareWorkspaceLayoutPresets "SharedContent" "tok" share-presets)
                    (fn [preset] preset.id))
               ["share-ok"])
      (expect= (count capped) 32)
      (expect= (get (last capped) :id) "preset-31")))

  (test "normalizes workspace state core decisions"
    (expect= (clampSplitPaneFraction 0.2) 0.3)
    (expect= (clampSplitPaneFraction 0.8) 0.7)
    (expect= (clampSplitPaneFraction "bad") 0.5)
    (expect= (workspaceStorageBaseKey nil) "workspace-state")
    (expect= (workspaceStorageBaseKey "tok") "workspace-state-share-tok")
    (expect= (workspaceStorageSessionKey "workspace-state" "abc") "workspace-state-ws-abc")
    (expect= (parseWorkspaceFileOpenTargetField "new-tab") "new-tab")
    (expect= (parseWorkspaceFileOpenTargetField "bad") nil)
    (expect= (workspaceSourceToMediaContext {:kind "local" :rootPath nil :token nil :sharePath nil}) nil)
    (expect= (workspaceSourceToMediaContext {:kind "share" :rootPath nil :token "tok" :sharePath "Shared"})
             {:shareToken "tok" :sharePath "Shared"})
    (expect= (resolveNewTabAnchorWindowId {:windows [{:id "browser"
                                                       :type "browser"
                                                       :fileOpenTargetWindowId "viewer"}
                                                      {:id "viewer"
                                                       :type "viewer"
                                                       :fileOpenTargetWindowId nil}]}
                                            "browser")
             "viewer")
    (expect= (resolveNewTabAnchorWindowId {:windows [{:id "browser"
                                                       :type "browser"
                                                       :fileOpenTargetWindowId "missing"}]}
                                            "browser")
             "browser")
    (expect= (getWorkspaceWindowTitle {:title "KB Chat"
                                       :type "chat"
                                       :source {:kind "local" :rootPath nil :token nil :sharePath nil}
                                       :initialState {"kbRoot" "Notes/Project"}})
             "Project Chat")
    (expect= (getWorkspaceWindowTitle {:title ""
                                       :type "viewer"
                                       :source {:kind "share" :rootPath nil :token "tok" :sharePath "Shared"}
                                       :initialState {}})
             "Share Viewer")))
