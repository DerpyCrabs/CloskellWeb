                                                   {:width 1000 :height 800})
             {:x 0 :y 700})))

(describe "paste data helpers"
  (test "recognizes text file paste payloads"
    (expect= (includes? textFileExtensions "tsx") true)
    (expect= (pastedFileExtension "README.MD") "md")
    (expect= (pastedFileExtension "README") nil)
    (expect= (isTextFileType "text/plain" "binary.bin") true)
    (expect= (isTextFileType "" "config.yaml") true)
    (expect= (isTextFileType "application/octet-stream" "image.png") false)))

(describe "pasted knowledge-base image helpers"
  (test "maps pasted image mime types"
    (expect= (pastedImageExtensionForMimeType "") "png")
    (expect= (pastedImageExtensionForMimeType "image/png") "png")
    (expect= (pastedImageExtensionForMimeType "image/jpeg") "jpg")
    (expect= (pastedImageExtensionForMimeType "image/jpg") "jpg")
    (expect= (pastedImageExtensionForMimeType "image/gif") "gif")
    (expect= (pastedImageExtensionForMimeType "image/webp") "webp"))

  (test "formats pasted image file names and splices strings"
    (expect= (formatObsidianPastedImageFileNameWithStamp "20260102030405" "image/webp")
             "Pasted image 20260102030405.webp")
    (expect= (spliceString "hello world" 5 6 ",") "hello,world")
    (expect= (spliceString "abcdef" 1 4 "X") "aXef")))

(describe "markdown image url resolution"
  (test "resolves bare kb images for admin and share media urls"
    (expect= (resolveMarkdownImageUrl "Notes/page.md" nil ["Notes"] "photo.png")
             "/api/media/Notes/images/photo.png")
    (expect= (resolveMarkdownImageUrl "Notes/sub/page.md"
                                      {:token "tok" :sharePath "Notes" :isDirectory true}
                                      ["Notes"]
                                      "diagram.png")
             "/api/share/tok/media/images/diagram.png"))

  (test "preprocesses Obsidian image embeds for markdown rendering"
    (expect= (preprocessObsidianImages "before ![[photo.png]] after")
             "before ![photo.png](<photo.png>) after")
    (expect= (preprocessObsidianImages "![[folder/photo.JPG|Alt | more]]")
             "![Alt | more](<folder/photo.JPG>)")
    (expect= (preprocessObsidianImages "![[note.md]] and ![[diagram.svg]]")
             "![[note.md]] and ![diagram.svg](<diagram.svg>)")
    (expect= (preprocessObsidianImages "broken ![[photo.png")
             "broken ![[photo.png")
    (expect= (stripAngleSrc "< folder/photo.png >") "folder/photo.png")
    (expect= (stripAngleSrc " folder/photo.png ") "folder/photo.png")))

