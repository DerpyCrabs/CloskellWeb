(describe "workspace helpers"
  (test "computes tab drop insert indexes"
    (expect= tabDropBeforeFraction 0.4)
    (expect= (insertIndexFromTabBodyPointer 130 100 100 2) 2)
    (expect= (insertIndexFromTabBodyPointer 170 100 100 2) 3)
    (expect= (insertIndexFromTabBodyPointer 170 100 0 2) 3))

  (test "derives browser parent paths"
    (expect= (workspaceBrowserPaneParentDir "") "")
    (expect= (workspaceBrowserPaneParentDir "Root") "")
    (expect= (workspaceBrowserPaneParentDir "Root/Nested/File.txt") "Root/Nested")
    (expect= (workspaceBrowserPaneParentDir "Root\\Nested\\File.txt") "Root/Nested"))

  (test "computes snapped resize handles"
    (expect= snapResizeEdgeTolerance 6)
    (expect= (getWorkspaceSnapResizeHandleMap false "left" nil nil) "all")
    (expect= (getWorkspaceSnapResizeHandleMap true nil nil nil) "all")
    (expect= (getWorkspaceSnapResizeHandleMap true "top-left" nil nil)
             {:top false
              :bottom true
              :left false
              :right true
              :topLeft false
              :topRight false
              :bottomLeft false
              :bottomRight true})
    (expect= (getWorkspaceSnapResizeHandleMap true
                                              "assist-custom"
                                              {:x 100 :y 10 :width 300 :height 200}
                                              {:width 800 :height 600})
             {:top true
              :bottom true
              :left true
              :right true
              :topLeft true
              :topRight true
              :bottomLeft true
              :bottomRight true})
    (expect= (snapResizeHandlesFromBounds {:x 0 :y 0 :width 800 :height 600}
                                          {:width 800 :height 600})
             {:top false
              :bottom false
              :left false
              :right false
              :topLeft false
              :topRight false
              :bottomLeft false
              :bottomRight false}))

  (test "computes workspace geometry and snap reconciliation"
    (let [canvas {:width 1280 :height 720}
          fallback {:x 10 :y 20 :width 300 :height 200}
          snapped [{:id "a"
                    :type "browser"
                    :tabGroupId nil
                    :layout {:snapZone "left"
                             :bounds {:x 0 :y 0 :width 640 :height 720}
                             :fullscreen false
                             :minimized false
                             :zIndex 2}}
                   {:id "b"
                    :type "browser"
                    :tabGroupId nil
                    :layout {:snapZone "top-right"
                             :bounds {:x 900 :y 0 :width 50 :height 360}
                             :fullscreen false
                             :minimized false
                             :zIndex 4}}
                   {:id "c"
                    :type "browser"
                    :tabGroupId nil
                    :layout {:snapZone "bottom-right"
                             :bounds {:x 900 :y 500 :width 50 :height 100}
                             :fullscreen false
                             :minimized false
                             :zIndex 3}}]
          reconciled (reconcileLayoutBoundsFromSnapZonesForCanvas snapped canvas)
          scaled (scaleSnappedWindowsBoundsForCanvasResize [(nth snapped 0)]
                                                           {:width 640 :height 720}
                                                           canvas)
          inserted (insertWindowAtGroupIndex [{:id "left"
                                               :type "browser"
                                               :tabGroupId "g"
                                               :layout {}}
                                              {:id "right"
                                               :type "viewer"
                                               :tabGroupId "g"
                                               :layout {}}
                                              {:id "solo"
                                               :type "browser"
                                               :tabGroupId nil
                                               :layout {}}]
                                             {:id "new"
                                              :type "viewer"
                                              :tabGroupId "g"
                                              :layout {}}
                                             "g"
                                             1)]
      (expect= workspaceTitleBarPx 32)
      (expect= workspaceWindowMinVisiblePx 100)
      (expect= (createDefaultBoundsForViewport 0 "browser" canvas)
               {:x 24 :y 24 :width 435 :height 418})
      (expect= (createFullscreenBoundsForCanvas {:width 100 :height 100})
               {:x 0 :y 0 :width 360 :height 240})
      (expect= (createWindowLayout nil fallback 7)
               {:bounds fallback
                :fullscreen false
                :snapZone nil
                :minimized false
                :zIndex 7
                :restoreBounds nil})
      (expect= (getPlayerBoundsForAspectRatioInViewport (/ 16 9) nil canvas)
               {:x 71 :y 24 :width 1138 :height 672})
      (expect= (snapZoneToBoundsWithOccupied "top-right"
                                             [{:bounds {:x 0 :y 0 :width 640 :height 720}
                                               :snapZone "left"}]
                                             canvas)
               {:x 640 :y 0 :width 640 :height 360})
      (expect= (maxWorkspaceWindowZ snapped) 4)
      (expect= (get (get (get (nth scaled 0) :layout) :bounds) :width) 1280)
      (expect= (get (get (get (nth reconciled 1) :layout) :bounds) :x) 640)
      (expect= (get (get (get (nth reconciled 2) :layout) :bounds) :y) 360)
      (expect= (map inserted (fn [win] win.id)) ["left" "new" "right" "solo"])
      (expect= (getPlaybackTitle nil) "Video Player")
      (expect= (getPlaybackTitle "Movies\\sample.mp4") "sample.mp4")
      (expect= (isVideoPath "clip.MP4") true)
      (expect= (isVideoPath "notes.txt") false)))

  (test "computes workspace video intrinsic preload helpers"
    (let [local-source {:kind "local" :rootPath nil :token nil :sharePath nil}
          share-source {:kind "share" :rootPath nil :token "tok" :sharePath "Shared/Root"}
          viewport {:width 1280 :height 720}]
      (expect= (workspaceVideoIntrinsicsCacheKey local-source "Movies/a.mp4")
               "local::Movies/a.mp4")
      (expect= (workspaceVideoIntrinsicsCacheKey share-source "Shared/Root/a.mp4")
               "share:tok:Shared/Root/a.mp4")
      (expect= (validVideoIntrinsics 1920 1080) true)
      (expect= (validVideoIntrinsics 0 1080) false)
      (expect= (mediaUrlForVideoIntrinsicsPreload local-source "Folder/a b.mp4" "")
               "/api/media/Folder/a%20b.mp4")
      (expect= (mediaUrlForVideoIntrinsicsPreload share-source
                                                  "Shared/Root/sub/a b.mp4"
                                                  "Shared\\Root")
               "/api/share/tok/media/sub/a%20b.mp4")
      (expect= (viewerBoundsForVideoOpenInViewport "Movies/a.mp4" local-source nil 1 viewport)
               {:x 52 :y 52 :width 435 :height 418})
      (expect= (viewerBoundsForVideoOpenInViewport "Movies/a.mp4"
                                                   local-source
                                                   {:width 1920 :height 1080}
                                                   1
                                                   viewport)
               {:x 71 :y 24 :width 1138 :height 672})
      (expect= (viewerBoundsForVideoOpenInViewport "Movies/a.mp4"
                                                   local-source
                                                   {:width 0 :height 1080}
                                                   1
                                                   viewport)
               {:x 52 :y 52 :width 435 :height 418})))

  (test "computes workspace layout preview groups"
    (let [canvas {:width 1000 :height 500}
          state {:windows [{:id "left"
                            :title " Browser "
                            :type "browser"
                            :tabGroupId "g"
                            :tabPinned true
                            :layout {:bounds {:x 100 :y 50 :width 500 :height 300}
                                     :zIndex 3
                                     :minimized false
                                     :fullscreen false}}
                           {:id "right"
                            :title "1234567890123456789012345"
                            :type "viewer"
                            :tabGroupId "g"
                            :tabPinned false
                            :layout {:bounds {:x 100 :y 50 :width 500 :height 300}
                                     :zIndex 4
                                     :minimized false
                                     :fullscreen false}}]
                 :tabGroupSplits {"g" {:leftTabId "left" :leftPaneFraction 0.1}}}
          detail (computeLayoutPreviewDetailForCanvas state canvas)
          norm (computeLayoutPreviewNormForCanvas state canvas)]
      (expect= tabLabelMax 22)
      (expect= (truncateTabTitle "   ") "Untitled")
      (expect= (truncateTabTitle "1234567890123456789012345") "123456789012345678901…")
      (expect= (get detail :aspectRatio) 2)
      (expect= (get (nth (get detail :groups) 0) :mode) "split")
      (expect= (get (nth (get detail :groups) 0) :leftPaneFraction) 0.3)
      (expect= (get (nth (get (nth (get detail :groups) 0) :leftTabs) 0) :pinned) true)
      (expect= (get (nth (get (nth (get detail :groups) 0) :rightTabs) 0) :label)
               "123456789012345678901…")
      (expect= (get (nth (get norm :panes) 0) :leftPct) 10)
      (expect= (get (nth (get norm :panes) 0) :widthPct) 50)))

  (test "picks workspace file-open target windows"
    (let [windows [{:id "back"
                    :type "browser"
                    :tabGroupId nil
                    :layout {:bounds {:x 0 :y 0 :width 300 :height 200}
                             :zIndex 1
