      (expect= (pickerPickWorkspaceWindowAtClientPoint windows rect 900 900) nil)
      (expect= (pickerLayoutBoundsForWindowHighlight windows "hidden") nil)
      (expect= (pickerLayoutBoundsForWindowHighlight windows "group-right")
               {:x 200 :y 10 :width 100 :height 100})))

  (test "computes snapped session resize siblings"
    (let [windows [{:id "left"
                    :type "browser"
                    :tabGroupId nil
                    :layout {:bounds {:x 0 :y 0 :width 600 :height 400}
                             :snapZone "left"}}
                   {:id "right-a"
