  {:leftTabId (Option String)
   :leftPaneFraction (Option Number)})

(type TestTabGroupSplits (Map String TestTabGroupSplit))

(describe "source context"
  (test "normalizes separators and strips share prefixes"
    (expect= (normalizeSlashes "share\\root\\file.png") "share/root/file.png")
    (expect= (stripSharePrefix "/share/root/sub/file.png" "") "/share/root/sub/file.png")
    (expect= (stripSharePrefix "/share/root/sub/file.png" "/share/root") "sub/file.png")
    (expect= (stripSharePrefix "/share/root" "/share/root") "")
    (expect= (stripSharePrefix "/other/file.png" "/share/root") "/other/file.png")))

(describe "download urls"
  (test "builds admin and share download hrefs"
    (expect= (fileDownloadHref "/a/b c" nil)
             (str "/api/files/download?path=" (encode-uri-component "/a/b c")))
    (expect= (fileDownloadHref "/share/root/sub/file.png"
                               {:token "tok" :sharePath "/share/root"})
             (str "/api/share/tok/download?path="
                  (encode-uri-component "sub/file.png")))))

(describe "media urls"
  (test "builds admin and share media urls with original encoding rules"
    (expect= (buildAdminMediaUrl "Folder/a b.mp4") "/api/media/Folder/a%20b.mp4")
    (expect= (buildMediaUrl "Folder/a b.mp4" nil) "/api/media/Folder/a%20b.mp4")
    (expect= (buildShareMediaUrl "tok" "Shared\\Root" "Shared/Root/sub/a b.mp4")
             "/api/share/tok/media/sub/a%20b.mp4")
    (expect= (buildShareMediaUrl "tok" "Shared/Root" "Shared/Root")
             "/api/share/tok/media/.")
    (expect= (buildAudioExtractUrl "Folder/a b.mp3" nil)
             "/api/audio/extract/Folder/a b.mp3")
    (expect= (buildAudioMetadataUrl "Shared/Root/sub/a b.mp3"
                                    {:token "tok" :sharePath "Shared/Root"})
             "/api/share/tok/audio/metadata/sub/a%20b.mp3")
    (expect= (buildThumbnailUrl "Folder/a b.jpg" nil)
             "/api/thumbnail/Folder/a%20b.jpg")))

(describe "media utils"
  (test "maps extensions to media types"
    (expect= (getMediaType "MP4") "video")
    (expect= (getMediaType "mp3") "audio")
    (expect= (getMediaType "png") "image")
    (expect= (getMediaType "pdf") "pdf")
    (expect= (getMediaType "tsx") "text")
    (expect= (getMediaType "bin") "other"))

  (test "maps extensions to mime types"
    (expect= (getMimeType "JPG") "image/jpeg")
    (expect= (getMimeType "ogg") "video/ogg")
    (expect= (getMimeType "unknown") "application/octet-stream"))

  (test "formats file sizes with original units and rounding"
    (expect= (formatFileSize 0) "0 Bytes")
    (expect= (formatFileSize 1023) "1023 Bytes")
    (expect= (formatFileSize 1024) "1 KB")
    (expect= (formatFileSize 1536) "1.5 KB")
    (expect= (formatFileSize 1048576) "1 MB")
    (expect= (formatFileSize 123456789) "117.74 MB")))

(describe "fixed menu placement"
  (test "keeps fixed menus inside the viewport"
    (expect= fixedMenuViewportEdge 8)
    (expect= (clampFixedMenuPositionInViewport {:w 320 :h 240}
                                                {:preferredLeft 40
                                                 :width 100
                                                 :height 80
                                                 :flip {:anchorTop 30
                                                        :anchorBottom 60
                                                        :gap 6}})
             {:left 40 :top 66})
    (expect= (clampFixedMenuPositionInViewport {:w 320 :h 240}
                                                {:preferredLeft 280
                                                 :width 100
                                                 :height 80
                                                 :flip {:anchorTop 180
                                                        :anchorBottom 220
                                                        :gap 6}})
             {:left 212 :top 94})
    (expect= (clampFixedMenuPositionInViewport {:w 120 :h 80}
                                                {:preferredLeft -20
                                                 :width 200
                                                 :height 200
                                                 :flip {:anchorTop 4
                                                        :anchorBottom 8
                                                        :gap 6}})
             {:left 8 :top 8})))

(describe "workspace assist grid"
  (test "maps assist shapes and segments"
    (expect= snapEdgeThresholdPx 36)
    (expect= topSnapAssistCenterHalfWidthPx 150)
    (expect= (isAssistGridShape "3x2") true)
    (expect= (isAssistGridShape "4x4") false)
    (expect= (assistShapeToDims "2x3") {:cols 2 :rows 3})
    (expect= (assistShapeMatchingSpan {:gridCols 3
                                       :gridRows 3
                                       :gc0 1
                                       :gc1 1
                                       :gr0 0
                                       :gr1 0})
             "3x3")
    (expect= (assistShapeMatchingSpan {:gridCols 4
                                       :gridRows 4
                                       :gc0 0
                                       :gc1 0
                                       :gr0 0
                                       :gr1 0})
             nil)
    (expect= (segmentIndex 10 300 3) 0)
    (expect= (segmentIndex 150 300 3) 1)
    (expect= (segmentIndex 301 300 3) 2)
    (expect= (segmentIndex 10 0 3) 0))

  (test "detects edge spans and converts grid geometry"
    (expect= (detectEdgeAssistGridSpan 320 10 900 600 "3x2" {:suppressTopEdgeSpans false})
             {:gridCols 3 :gridRows 2 :gc0 0 :gc1 1 :gr0 0 :gr1 0})
    (expect= (detectEdgeAssistGridSpan 450 10 900 600 "3x2" {:suppressTopEdgeSpans true})
             nil)
    (let [span {:gridCols 3 :gridRows 2 :gc0 1 :gc1 2 :gr0 0 :gr1 0}]
      (expect= (assistGridSpanToBounds {:width 900 :height 600} span)
               {:x 300 :y 0 :width 600 :height 300})
      (expect= (assistSpanToGridLines span)
               {:colStart 3 :colEnd 6 :rowStart 1 :rowEnd 2})
      (expect= (assistGridSpansEqual span span) true)
      (expect= (assistGridSpansEqual span {:gridCols 3 :gridRows 2 :gc0 1 :gc1 1 :gr0 0 :gr1 0})
               false))
    (expect= (assistGridSpanToBounds {:width 80 :height 70}
                                      {:gridCols 2 :gridRows 2 :gc0 0 :gc1 0 :gr0 0 :gr1 0})
             {:x 0 :y 0 :width 80 :height 70})))

  (test "matches snap assist picks and gutter slop geometry"
    (let [cell {:gridCols 3 :gridRows 2 :gc0 1 :gc1 1 :gr0 0 :gr1 0}
          col-span {:gridCols 3 :gridRows 2 :gc0 0 :gc1 1 :gr0 0 :gr1 0}
          row-span {:gridCols 3 :gridRows 2 :gc0 1 :gc1 1 :gr0 0 :gr1 1}
          junction {:gridCols 3 :gridRows 2 :gc0 0 :gc1 1 :gr0 0 :gr1 1}
          pick {:kind "grid-span" :span cell}
          rect {:left 10 :top 20 :right 16 :bottom 60 :width 6 :height 40}]
      (expect= assistGutterSlopPx 3)
      (expect= (narrowPickToAssistShape pick "3x2") pick)
      (expect= (narrowPickToAssistShape pick "2x2") nil)
      (expect= (narrowPickToAssistShape nil "3x2") nil)
      (expect= (spanGutterKind cell) nil)
      (expect= (spanGutterKind col-span) "v")
      (expect= (spanGutterKind row-span) "h")
      (expect= (spanGutterKind junction) "j")
      (expect= (rectArea rect) 240)
      (expect= (rectArea {:left 0 :top 0 :right 0 :bottom 0 :width -1 :height 5}) 0)
      (expect= (pointInRect 10 20 rect) true)
      (expect= (pointInRect 9 20 rect) false)
      (expect= (pointInRect 10 20 {:left 10 :top 20 :right 16 :bottom 60 :width 0 :height 40})
               false)
      (expect= (slopInflatedRect rect "v")
               {:left 7 :top 20 :right 19 :bottom 60 :width 12 :height 40})
      (expect= (slopInflatedRect rect "h")
               {:left 10 :top 17 :right 16 :bottom 63 :width 6 :height 46})
      (expect= (slopInflatedRect rect "j")
               {:left 7 :top 17 :right 19 :bottom 63 :width 12 :height 46})
      (expect= (normalizeAssistGridSpan 0 1 0 0 3 2)
               {:gridCols 3 :gridRows 2 :gc0 0 :gc1 1 :gr0 0 :gr1 0})
      (expect= (normalizeAssistGridSpan 2 1 0 0 3 2) nil)
      (expect= (normalizeAssistGridSpan 0 3 0 0 3 2) nil)
      (expect= (normalizeAssistGridSpan "0" 1 0 0 3 2) nil)
      (expect= (assistPickMatchesGridSpan pick cell) true)
      (expect= (assistPickMatchesGridSpan pick col-span) false)
      (expect= (assistPickMatchesGridSpan nil cell) false)))

(describe "file drag data"
  (test "serializes and parses drag payloads"
    (let [local {:path "Documents/readme.txt"
                 :isDirectory false
                 :sourceKind "local"}
          share {:path "SharedContent/subfolder"
                 :isDirectory true
                 :sourceKind "share"
                 :sourceToken "abc123"}]
      (expect= (parseFileDragData (fileDragPayloadText local)) local)
      (expect= (parseFileDragData (fileDragPayloadText share)) share)))

  (test "rejects empty malformed and incomplete drag payloads"
    (expect= (parseFileDragData "") nil)
    (expect= (parseFileDragData "not json") nil)
    (expect= (parseFileDragData (json-stringify {:isDirectory true})) nil)
    (expect= (parseFileDragData (json-stringify {:path "test" :sourceKind "local"})) nil))

  (test "reads data-transfer shaped objects"
    (let [data {:path "Videos/sample.mp4"
                :isDirectory false
                :sourceKind "local"}
          dt {:types [fileDragMime]
              :getData (fn [mime] (if (= mime fileDragMime) (fileDragPayloadText data) ""))}]
      (expect= (hasFileDragData dt) true)
      (expect= (getFileDragData dt) data)))

  (test "checks drag source compatibility"
    (expect= (isCompatibleSource {:sourceKind "local"} {:path "a" :isDirectory false :sourceKind "local"}) true)
    (expect= (isCompatibleSource {:sourceKind "share" :sourceToken "tok1"}
                                  {:path "a" :isDirectory false :sourceKind "share" :sourceToken "tok1"})
             true)
    (expect= (isCompatibleSource {:sourceKind "share" :sourceToken "tok1"}
                                  {:path "a" :isDirectory false :sourceKind "share" :sourceToken "tok2"})
             false)
    (expect= (isCompatibleSource {:sourceKind "local"}
                                  {:path "a" :isDirectory false :sourceKind "share" :sourceToken "tok1"})
             false)
    (expect= (isCompatibleSource {:sourceKind "share" :sourceToken "tok1"}
                                  {:path "a" :isDirectory false :sourceKind "local"})
             false)))

(describe "mcp helpers"
  (test "namespaces and sanitizes ai tool keys"
    (expect= (mcpAiToolKey "vkusvill" "search") "vkusvill__search")
    (expect= (mcpAiToolKey "my-server" "tool.name") "my_server__tool_name")
    (expect= (= (mcpAiToolKey "a" "b") (mcpAiToolKey "a_" "b")) false))

  (test "validates mcp urls"
    (expect= (validMcpUrl? "https://mcp001.vkusvill.ru/mcp") true)
    (expect= (validMcpUrl? "http://127.0.0.1:3000/mcp") true)
    (expect= (validMcpUrl? "not a url") false)
    (expect= (validMcpUrl? "/relative") false))

  (test "parses cursor-style mcp config"
    (let [parsed (parseMcpConfig {:mcp {:servers {:vkusvill {:url "https://mcp001.vkusvill.ru/mcp"}
                                                   :other {:url "http://127.0.0.1:3000/mcp"}}}})
          cfg (match parsed
                (some current) current
                nil {:servers {}})]
      (expect= cfg.servers.vkusvill.url "https://mcp001.vkusvill.ru/mcp")
      (expect= cfg.servers.other.url "http://127.0.0.1:3000/mcp")))

  (test "drops invalid mcp server entries and empty configs"
    (let [parsed (parseMcpConfig {:mcp {:servers {"" {:url "http://x.test/mcp"}
                                                   :bad {:url "not a url"}
                                                   :good {:url "https://example.com/mcp"}}}})
          cfg (match parsed
                (some current) current
                nil {:servers {}})]
      (expect= (object-keys cfg.servers) ["good"])
      (expect= cfg.servers.good.url "https://example.com/mcp")
      (expect= (parseMcpConfig {}) nil)
      (expect= (parseMcpConfig {:mcp {}}) nil)
      (expect= (parseMcpConfig {:mcp {:servers {}}}) nil))))

(describe "knowledge-base paths"
  (test "finds knowledge-base roots"
    (expect= (getKnowledgeBaseRootForPath "Notes/file.md" []) nil)
    (expect= (getKnowledgeBaseRootForPath "Notes" ["Notes"]) "Notes")
    (expect= (getKnowledgeBaseRootForPath "Notes/subfolder/file.md" ["Notes"]) "Notes")
    (expect= (getKnowledgeBaseRootForPath "Documents/file.md" ["Notes"]) nil)
    (expect= (getKnowledgeBaseRootForPath "Notes\\subfolder" ["Notes"]) "Notes")
    (expect= (getKnowledgeBaseRootForPath "NotesExtra/file.md" ["Notes"]) nil))

  (test "detects allowed knowledge-base image paths"
    (let [kbs ["Notes"]]
      (expect= (isKnowledgeBaseImagePath "Notes/images/diagram.png" "Notes" kbs) true)
      (expect= (isKnowledgeBaseImagePath "Notes/images/../../../etc/passwd" "Notes" kbs) false)
      (expect= (isKnowledgeBaseImagePath "../Notes/images/diagram.png" "Notes" kbs) false)
      (expect= (isKnowledgeBaseImagePath "Notes/images/" "Notes" kbs) false)
      (expect= (isKnowledgeBaseImagePath "Notes/images/sub/diagram.png" "Notes" kbs) false)
      (expect= (isKnowledgeBaseImagePath "Notes/welcome.md" "Notes" kbs) false)
      (expect= (isKnowledgeBaseImagePath "Documents/images/pic.png" "Documents" kbs) false)
      (expect= (isKnowledgeBaseImagePath "Notes\\images\\..\\secret.txt" "Notes" kbs) false))))

(describe "knowledge-base chat filesystem paths"
  (test "maps kb-relative and media paths"
    (expect= (kbChatRelativeToMediaPath "Notes" "") "Notes")
    (expect= (kbChatRelativeToMediaPath "Notes" "foo/bar.md") "Notes/foo/bar.md")
    (expect= (kbChatRelativeToMediaPath "Notes" "Notes/Logs") "Notes/Logs")
    (expect= (kbChatRelativeToMediaPath "Vault" "Vault/a/Vault/b") "Vault/a/Vault/b")
    (expect= (mediaPathToKbChatRelative "Notes" "Notes") "")
    (expect= (mediaPathToKbChatRelative "Notes" "Notes/foo.md") "foo.md"))

  (test "canonicalizes repeated kb root segments"
    (expect= (canonicalKbChatRelativePath "Notes" "Notes/Notes/Logs/x.md") "Logs/x.md")
    (expect= (canonicalKbChatRelativePath "Notes" "Logs/x.md") "Logs/x.md")))

(describe "knowledge-base chat message helpers"
  (test "resolves media links under the knowledge-base root"
    (expect= (isMediaPathUnderKb "Notes/images/a.png" "Notes") true)
    (expect= (isMediaPathUnderKb "\\Notes\\images\\a.png\\" "/Notes/") true)
    (expect= (isMediaPathUnderKb "NotesExtra/a.png" "Notes") false)
    (expect= (isMediaPathUnderKb "Notes/a.png" "") false)
    (expect= (resolveMediaPathForKbChat "images/a.png" "Notes") "Notes/images/a.png")
    (expect= (resolveMediaPathForKbChat "Notes/images/a.png" "Notes") "Notes/images/a.png")
    (expect= (resolveMediaPathForKbChat "" "Notes") "Notes")
    (expect= (resolveMediaPathForKbChat "/images/a.png/" nil) "images/a.png")
    (expect= (formatKbChatAnswerSeconds 1.234) "1.23s")
    (expect= (formatKbChatAnswerSeconds 1.235) "1.24s")
    (expect= (formatKbChatAnswerSeconds -1) "")
    (expect= (formatKbChatAnswerSeconds "bad") "")))

(def dir-share
  {:token "test-token"
   :path "SharedContent"
   :isDirectory true
   :editable false
   :createdAt 0})

(def file-share
  {:token "test-token"
   :path "Documents/readme.txt"
   :isDirectory false
   :editable false
   :createdAt 0})

(def restricted-share
  {:token "restricted"
   :path "SharedContent"
   :isDirectory true
   :editable true
   :passcode nil
   :createdAt 0
   :restrictions {:allowDelete false
                  :allowUpload nil
                  :allowEdit true
                  :maxUploadBytes 100}
   :usedBytes 40})

(describe "share path resolution"
  (test "resolves directory share subpaths"
    (expect= (resolveShareSubPath dir-share "") "SharedContent")
    (expect= (resolveShareSubPath dir-share ".") "SharedContent")
    (expect= (resolveShareSubPath dir-share "subfolder") "SharedContent/subfolder")
    (expect= (resolveShareSubPath dir-share "sub/deep/file.txt") "SharedContent/sub/deep/file.txt")
    (expect= (resolveShareSubPath dir-share "..") nil)
    (expect= (resolveShareSubPath dir-share "subfolder/../../etc") nil)
    (expect= (resolveShareSubPath dir-share "../outside") nil)
    (expect= (resolveShareSubPath dir-share "..\\outside") nil)
    (expect= (resolveShareSubPath dir-share "a/../../../etc/passwd") nil))

  (test "restricts file share subpaths"
    (expect= (resolveShareSubPath file-share "") "Documents/readme.txt")
    (expect= (resolveShareSubPath file-share ".") "Documents/readme.txt")
    (expect= (resolveShareSubPath file-share "other.txt") nil)
    (expect= (resolveShareSubPath file-share "..") nil)))

(describe "share restrictions"
  (test "applies defaults and upload quotas"
    (expect= defaultMaxUploadBytes 2147483648)
    (expect= positiveInfinity (/ 1 0))
    (expect= (getEffectiveRestrictions dir-share)
             {:allowDelete true
              :allowUpload true
              :allowEdit true
              :maxUploadBytes 2147483648})
    (expect= (getEffectiveRestrictions restricted-share)
             {:allowDelete false
              :allowUpload true
              :allowEdit true
              :maxUploadBytes 100})
    (expect= (checkUploadQuota restricted-share 60) {:allowed true :remaining 60})
    (expect= (checkUploadQuota restricted-share 61) {:allowed false :remaining 60})
    (expect= (checkUploadQuota (assoc restricted-share
                                      :restrictions {:allowDelete nil
                                                     :allowUpload nil
                                                     :allowEdit nil
                                                     :maxUploadBytes 0})
                               999999)
             {:allowed true :remaining (/ 1 0)})))

(describe "media roots"
  (test "normalizes legacy and multi-root media config"
    (expect= (normalizeMediaRoots "test-media" ["Notes"] nil)
             [{:name "test-media" :path "test-media" :editableFolders ["Notes"]}])
    (expect= (map (normalizeMediaRoots "ignored"
                                        []
                                        [{:path "/srv/media/movies"
                                          :editableFolders ["Incoming"]}
                                         {:path "/srv/media/shows"
                                          :editableFolders ["Downloads"]}])
                  (fn [root] root.name))
             ["movies" "shows"])
    (expect= (map (normalizeMediaRoots "ignored"
                                        []
                                        [{:path "/srv/a/media" :name "Movies"}
                                         {:path "/srv/b/media" :name "Shows"}])
                  (fn [root] root.name))
             ["Movies" "Shows"]))

  (test "builds media library keys"
    (let [roots (normalizeMediaRoots "ignored"
                                      []
                                      [{:path "/srv/a/media" :name "Movies"}
                                       {:path "/srv/b/media" :name "Shows"}])]
      (expect= (getLibraryKey "test-media" [{:name "test-media"
                                             :path "test-media"
                                             :editableFolders ["Notes"]}])
               "test-media")
      (expect= (getLibraryKey "ignored" roots)
               "Movies:/srv/a/media|Shows:/srv/b/media"))))

(describe "virtual folders and client paths"
  (test "recognizes virtual folder roots and descendants"
    (expect= virtualFolderMostPlayed "Most Played")
    (expect= virtualFolderFavorites "Favorites")
    (expect= virtualFolderShares "Shares")
    (expect= (isVirtualFolderPath "Favorites") true)
    (expect= (isVirtualFolderPath "Favorites/song.mp3") true)
    (expect= (isVirtualFolderPath "Favorites\\song.mp3") true)
    (expect= (isVirtualFolderPath "Favorites2/song.mp3") false))

  (test "checks client editability for single and multiple roots"
    (expect= (isPathEditable "Notes/page.md" ["Notes"] nil) true)
    (expect= (isPathEditable "NotesExtra/page.md" ["Notes"] nil) false)
    (expect= (isPathEditable "Movies/Incoming/new.txt"
                             ["Movies/Incoming"]
                             [{:name "Movies" :editableFolders ["Incoming"]}
                              {:name "Shows" :editableFolders ["Downloads"]}])
             true)
    (expect= (isPathEditable "Shows/Incoming/new.txt"
                             ["Movies/Incoming"]
                             [{:name "Movies" :editableFolders ["Incoming"]}
                              {:name "Shows" :editableFolders ["Downloads"]}])
             false))

  (test "finds client knowledge-base roots"
    (expect= (getClientKnowledgeBaseRoot "Notes/page.md" ["Notes"]) "Notes")
    (expect= (getClientKnowledgeBaseRoot "Notes\\page.md" ["Notes"]) "Notes")
    (expect= (getClientKnowledgeBaseRoot "NotesExtra/page.md" ["Notes"]) nil)))

(describe "theme and player position helpers"
  (test "resolves theme names and validates stored values"
    (expect= (isThemePalette "default") true)
    (expect= (isThemePalette "bad") false)
    (expect= (isThemeMode "system") true)
    (expect= (isThemeMode "auto") false)
    (expect= (normalizeLegacyThemePalette "cosmic-night") "cosmic-night")
    (expect= (normalizeLegacyThemePalette "other") "default")
    (expect= (normalizeLegacyThemeMode "light") "light")
    (expect= (normalizeLegacyThemeMode "other") "dark")
    (expect= (resolveThemeFromPreference "default" "system" true) "default-dark")
    (expect= (resolveThemeFromPreference "caffeine" "system" false) "caffeine-light")
    (expect= (resolveThemeFromPreference "cosmic-night" "dark" false) "cosmic-night-dark"))

  (test "computes video player default and constrained positions"
    (expect= defaultVideoPlayerPosition {:x 0 :y 0})
    (expect= (defaultVideoPlayerPositionForViewport {:width 1000 :height 800})
             {:x 664 :y 420})
    (expect= (defaultVideoPlayerPositionForViewport {:width 200 :height 200})
             {:x 0 :y 0})
