{
  "name": "derp-media-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:closkell": "node scripts/closkell-entries.mjs check",
    "build:closkell": "node scripts/closkell-entries.mjs build",
    "test:clsk": "npm run build:closkell && node ../../packages/closkell-runner.cjs test src/runtime_test.clsk",
    "dev": "npm run build:closkell && node --watch .closkell/build/server/main.mjs",
    "build": "npm run build:closkell && vite build",
    "start": "npm run build && NODE_ENV=production node .closkell/build/server/main.mjs",
    "test": "npm run test:clsk && playwright test",
    "test:unit": "npm run test:clsk",
    "test:e2e": "playwright test",
    "test:batch": "node tests/run-batches.mjs",
    "test:generate-media": "node tests/fixtures/generate-media-cache.mjs",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.72",
    "@ai-sdk/provider": "^3.0.10",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@tailwindcss/typography": "^0.5.20",
    "ai": "^6.0.207",
    "archiver": "^8.0.0",
    "clsx": "^2.1.1",
    "fastify": "^5.8.5",
    "lucide-static": "^1.20.0",
    "markdown-it": "^14.2.0",
    "music-metadata": "11.13.0",
    "sharp": "^0.35.1",
    "strip-json-comments": "^5.0.3",
    "tailwind-merge": "^3.6.0",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@closkell/vite-plugin": "file:../../packages/vite-plugin-closkell",
    "@fastify/middie": "^9.3.2",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/archiver": "^8.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.3",
    "@types/turndown": "^5.0.6",
    "happy-dom": "^20.10.5",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.16"
  }
}
