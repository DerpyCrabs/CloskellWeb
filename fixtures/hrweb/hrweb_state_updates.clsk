(def initial-state
  {:message "Ready"
   :selectedLogId "warmup"
   :entries [{:id "warmup"
              :exerciseType "LISS"
              :hiddenAt nil}
             {:id "intervals"
              :exerciseType "HIIT"
              :hiddenAt nil}]
   :zones [{:id 1 :min 90 :max 110}
           {:id 2 :min 111 :max 130}]})

(defn set-exercise-type [entries entry-id exercise-type]
  (map entries
       (fn [entry]
         (if (= entry.id entry-id)
             (assoc entry :exerciseType exercise-type)
             entry))))

(defn hide-entry [entries entry-id hidden-at]
  (map entries
       (fn [entry]
         (if (= entry.id entry-id)
             (assoc entry :hiddenAt hidden-at)
             entry))))

(defn set-zone-boundary [zones index value]
  (map-indexed zones
               (fn [zone zone-index]
                 (if (= zone-index index)
                     (assoc zone :max value)
                     (if (= zone-index (+ index 1))
                         (assoc zone :min (+ value 1))
                         zone)))))

(defn import-complete [state entries]
  (merge state
         {:entries entries
          :selectedLogId (let [first-entry (nth entries 0)]
                           first-entry.id)
          :message "Imported"}))

(defn clear-message [state]
  (dissoc state :message))

(def updated-state
  (let [typed (set-exercise-type initial-state.entries "warmup" "Strength")
        hidden (hide-entry typed "intervals" 4242)
        zones (set-zone-boundary initial-state.zones 0 125)
        imported (import-complete initial-state hidden)]
    (assoc (clear-message imported)
           :zones zones
           :visibleCount (count (filter hidden (fn [entry] (not (some? entry.hiddenAt))))))))

(def nested-state
  {:summary {:value 1
             :label "Warmup"}
   :status "Ready"})

(def bumped-summary
  (update-in nested-state [:summary :value] (fn [value] (+ value 1))))

(def relabeled-summary
  (update-in bumped-summary [:summary :label] (fn [label suffix] (str label suffix)) "!"))

(def nested-summary-value
  (get-in relabeled-summary [:summary :value]))

(def equal-records
  (= {:kind :ok
      :items [1 2]
      :tags (set "tempo" "steady")
      :registry (hash-map "zone2" {:id "zone2"})}
     {:registry (hash-map "zone2" {:id "zone2"})
      :tags (set "steady" "tempo")
      :items [1 2]
      :kind :ok}))

(def unequal-records
  (= {:items [1 2]} {:items [2 1]}))

(def identical-shared
  (let [value nested-state]
    (identical? value nested-state)))

(def identical-distinct
  (identical? {:value 1} {:value 1}))
