(defn in-zone? [zone bpm]
  (and (>= bpm zone.min)
       (<= bpm zone.max)))

(defn fallback-interval [readings]
  (if (> (count readings) 1)
      (let [first-reading (nth readings 0)
            second-reading (nth readings 1)]
        (max 0 (- second-reading.time first-reading.time)))
      0))

(defn interval-ms [readings duration-ms index reading]
  (let [next-reading (nth readings (+ index 1))
        fallback (fallback-interval readings)
        fallback-end (+ reading.time fallback)
        workout-end (if (> duration-ms 0) duration-ms fallback-end)
        next-time (if (some? next-reading)
                      next-reading.time
                      (max reading.time workout-end))]
    (max 0 (- next-time reading.time))))

(defn zone-duration-ms [entry zone-id]
  (let [zone (find entry.zones (fn [zone] (= zone.id zone-id)))]
    (if (some? zone)
        (reduce-indexed entry.readings 0
          (fn [sum reading index]
            (let [interval (interval-ms entry.readings entry.durationMs index reading)]
              (if (in-zone? zone reading.bpm)
                  (+ sum interval)
                  sum))))
        0)))

(defn zone-stat [entry zone]
  (let [duration (zone-duration-ms entry zone.id)]
    {:id zone.id
     :name zone.name
     :color zone.color
     :durationMs duration
     :percent (if (> entry.durationMs 0)
                  (round (* (/ duration entry.durationMs) 100))
                  0)}))

(defn zone-stats [entry]
  (map entry.zones (fn [zone] (zone-stat entry zone))))

(defn tracked-zone-duration-ms [entry]
  (sum (map entry.zones (fn [zone] (zone-duration-ms entry zone.id)))))

(defn zone-display-stat [entry tracked-duration-ms zone]
  (let [duration (zone-duration-ms entry zone.id)]
    {:id zone.id
     :name zone.name
     :color zone.color
     :durationMs duration
     :percent (if (> tracked-duration-ms 0)
                  (round (* (/ duration tracked-duration-ms) 100))
                  0)}))

(defn zone-display-stats [entry]
  (let [tracked-duration-ms (tracked-zone-duration-ms entry)]
    (map entry.zones
         (fn [zone] (zone-display-stat entry tracked-duration-ms zone)))))

(defn calculate-zone2-adherence [entry]
  (if (or (empty? entry.readings)
          (<= entry.durationMs 0))
      nil
      (round (* (/ (zone-duration-ms entry 2) entry.durationMs) 100))))

(defn trimp-zone-sum [entry zones]
  (reduce zones 0
    (fn [sum zone]
      (+ sum (* (/ (zone-duration-ms entry zone.id) 60000) zone.id)))))

(defn calculate-trimp [entry]
  (if (empty? entry.readings)
      0
      (/ (round (* (trimp-zone-sum entry entry.zones) 10)) 10)))

(defn average-bpm [readings]
  (if (empty? readings)
      nil
      (round (/ (sum (map readings (fn [reading] reading.bpm)))
                (count readings)))))

(defn min-bpm [readings]
  (if (empty? readings)
      nil
      (min-of (map readings (fn [reading] reading.bpm)))))

(defn max-bpm [readings]
  (if (empty? readings)
      nil
      (max-of (map readings (fn [reading] reading.bpm)))))

(defn stat-value [value]
  (if (some? value)
      (str value)
      "--"))

(defn normalized-exercise-type [exercise-type]
  (if (some? exercise-type)
      (lower-case (trim exercise-type))
      ""))

(defn matches-liss-type? [exercise-type]
  (if (some? exercise-type)
      (regex-test? (trim exercise-type) "liss|steady|aerob" "i")
      false))

(defn matches-strength-type? [exercise-type]
  (if (some? exercise-type)
      (regex-test? (trim exercise-type) "strength|weights?|weight" "i")
      false))

(defn matches-hiit-type? [exercise-type]
  (if (some? exercise-type)
      (regex-test? (trim exercise-type) "hiit|interval|tabata" "i")
      false))

(defn matches-hrr-type? [exercise-type]
  (or (matches-strength-type? exercise-type)
      (matches-hiit-type? exercise-type)))

(defn get-metrics-for-type [exercise-type]
  (if (matches-liss-type? exercise-type)
      ["zone2" "trimp"]
      (if (matches-hrr-type? exercise-type)
          ["hrr" "trimp"]
          ["trimp"])))

(defn metric-enabled? [enabled metric]
  (includes? enabled metric))

(def hrr-recovery-ms 60000)
(def hrr-min-peak-bpm 120)
(def hrr-min-peak-gap-ms 30000)

(defn reading-at-or-after [readings target-time]
  (let [found (find readings (fn [reading] (>= reading.time target-time)))]
    (if (some? found)
        found
        (nth readings (- (count readings) 1)))))

(defn valid-hrr-peak? [readings index current]
  (let [previous (nth readings (- index 1))
        next (nth readings (+ index 1))]
    (and (> index 0)
         (< index (- (count readings) 1))
         (>= current.bpm previous.bpm)
         (> current.bpm next.bpm)
         (>= current.bpm hrr-min-peak-bpm))))

(defn valid-hrr-recovery? [current recovery-reading]
  (and (some? recovery-reading)
       (>= recovery-reading.time (+ current.time (* hrr-recovery-ms 0.9)))))

(defn hrr-step [readings acc current index]
  (if (valid-hrr-peak? readings index current)
      (let [recovery-reading (reading-at-or-after readings (+ current.time hrr-recovery-ms))]
        (if (valid-hrr-recovery? current recovery-reading)
            (let [drop-bpm (- current.bpm recovery-reading.bpm)
                  in-peak-gap? (and (some? acc.lastPeakTime)
                                    (< (- current.time acc.lastPeakTime) hrr-min-peak-gap-ms))]
              (if in-peak-gap?
                  (if (> drop-bpm acc.lastDropBpm)
                      {:sum (+ (- acc.sum acc.lastDropBpm) drop-bpm)
                       :count acc.count
                       :lastPeakTime current.time
                       :lastDropBpm drop-bpm}
                      acc)
                  {:sum (+ acc.sum drop-bpm)
                   :count (+ acc.count 1)
                   :lastPeakTime current.time
                   :lastDropBpm drop-bpm}))
            acc))
      acc))

(defn calculate-workout-hrr [entry]
  (if (< (count entry.readings) 3)
      nil
      (let [events (reduce-indexed entry.readings
                     {:sum 0 :count 0 :lastPeakTime nil :lastDropBpm 0}
                     (fn [acc reading index]
                       (hrr-step entry.readings acc reading index)))]
        (if (= events.count 0)
            nil
            (round (/ events.sum events.count))))))

(defn entry-summary [entry]
  {:avg (average-bpm entry.readings)
   :min (min-bpm entry.readings)
   :max (max-bpm entry.readings)
   :zone2 (calculate-zone2-adherence entry)
   :trimp (calculate-trimp entry)
   :hrr (calculate-workout-hrr entry)
   :zones (zone-stats entry)})

(defn metric-value [value suffix]
  (if (some? value)
      (str value suffix)
      "--"))

(def untyped-label "Untyped")

(defn normalized-type-label [exercise-type]
  (let [trimmed (if (some? exercise-type)
                    (trim exercise-type)
                    "")]
    (if (= trimmed "")
        untyped-label
        trimmed)))

(defn type-sort-key [label]
  (if (= label untyped-label)
      "~~~~"
      (lower-case label)))

(defn upsert-entry-group [groups entry]
  (let [label (normalized-type-label entry.exerciseType)
        found (find groups (fn [group] (= group.type label)))]
    (if (some? found)
        (map groups
             (fn [group]
               (if (= group.type label)
                   (assoc group :entries (conj group.entries entry))
                   group)))
        (conj groups {:type label :entries [entry]}))))

(defn sorted-type-group [group]
  {:type group.type
   :entries (sort-by-desc group.entries (fn [entry] entry.stoppedAt))})

(defn group-entries-by-type [entries]
  (map (sort-by (reduce entries [] upsert-entry-group)
                (fn [group] (type-sort-key group.type)))
       sorted-type-group))

(defn bucket-start [timestamp grouping]
  (if (= grouping "month")
      (date-start-of-month timestamp)
      (date-start-of-week timestamp)))

(defn format-group-label [timestamp grouping]
  (if (= grouping "month")
      (date-format timestamp :month-year)
      (let [end (date-add-days timestamp 6)]
        (if (= (date-month timestamp) (date-month end))
            (str (date-format timestamp :month) " " (date-day timestamp) "-" (date-day end))
            (str (date-format timestamp :month-day) "-" (date-format end :day))))))

(defn upsert-average-bucket [grouping value-for-entry buckets entry]
  (let [value (value-for-entry entry)]
    (if (some? value)
        (let [timestamp (bucket-start entry.stoppedAt grouping)
              found (find buckets (fn [bucket] (= bucket.timestamp timestamp)))]
          (if (some? found)
              (map buckets
                   (fn [bucket]
                     (if (= bucket.timestamp timestamp)
                         (assoc bucket
                                :sum (+ bucket.sum value)
                                :count (+ bucket.count 1))
                         bucket)))
              (conj buckets {:timestamp timestamp :sum value :count 1})))
        buckets)))

(defn bucket->trend-point [grouping bucket]
  {:label (format-group-label bucket.timestamp grouping)
   :value (/ (round (* (/ bucket.sum bucket.count) 10)) 10)
   :timestamp bucket.timestamp})

(defn group-average-trend [entries value-for-entry grouping]
  (map (sort-by (reduce entries []
                        (fn [buckets entry]
                          (upsert-average-bucket grouping value-for-entry buckets entry)))
                (fn [bucket] bucket.timestamp))
       (fn [bucket] (bucket->trend-point grouping bucket))))

(defn build-zone2-trend [entries grouping]
  (group-average-trend entries calculate-zone2-adherence grouping))

(defn build-hrr-trend [entries grouping]
  (group-average-trend entries calculate-workout-hrr grouping))

(defn build-trimp-trend [entries grouping]
  (group-average-trend entries calculate-trimp grouping))

(defn build-trimp-bars [entries limit]
  (map (take-last (sort-by entries (fn [entry] entry.stoppedAt)) limit)
       (fn [entry]
         {:label (date-format entry.stoppedAt :month-day)
          :value (calculate-trimp entry)
          :timestamp entry.stoppedAt})))
